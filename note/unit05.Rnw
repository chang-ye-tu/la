%=============================================================================
\section{Triangular Solution and Factorisation}\label{sec:5.3}
%=============================================================================

\subsection{Forward and back substitution}\label{sec:5.3.1}

\begin{theorem}[Triangular substitution]\label{thm:triangular-substitution}
Let \(\bU=(u_{ij})\in\Real^{n\times n}\) be upper triangular with
\(u_{ii}\neq0\).  The unique solution of \(\bU\bx=\bbb\) is generated by
\[
x_n=\frac{b_n}{u_{nn}},
\qquad
x_i=\frac{b_i-\sum_{j=i+1}^n u_{ij}x_j}{u_{ii}}
\quad(i=n-1,\ldots,1).
\]
Let \(\bL=(\ell_{ij})\in\Real^{n\times n}\) be lower triangular with
\(\ell_{ii}\neq0\).  The unique solution of \(\bL\bx=\bbb\) is generated by
\[
x_1=\frac{b_1}{\ell_{11}},
\qquad
x_i=\frac{b_i-\sum_{j=1}^{i-1}\ell_{ij}x_j}{\ell_{ii}}
\quad(i=2,\ldots,n).
\]
For nonsingular upper block-triangular \(\bA=(\bA_{ij})_{i,j=1}^s\), with
conformable partitions \(\bX=(\bX_1',\ldots,\bX_s')'\) and
\(\bB=(\bB_1',\ldots,\bB_s')'\),
\[
\bX_i=\bA_{ii}^{-1}
\left(\bB_i-\sum_{j=i+1}^s\bA_{ij}\bX_j\right)
\quad(i=s,\ldots,1).
\]
The lower block-triangular formula is
\[
\bX_i=\bA_{ii}^{-1}
\left(\bB_i-\sum_{j=1}^{i-1}\bA_{ij}\bX_j\right)
\quad(i=1,\ldots,s).
\]
The upper recursions are \emph{back substitution}; the lower recursions are
\emph{forward substitution}.
\origin{H Eqs.~11.8.2--11.8.6}
\end{theorem}

\begin{proof}
The \(i\)th upper-triangular equation is
\[
u_{ii}x_i+\sum_{j=i+1}^n u_{ij}x_j=b_i.
\]
Starting at \(i=n\), division by \(u_{ii}\neq0\) determines exactly one
\(x_i\) at each step.  The lower-triangular recursion follows from
\[
\sum_{j=1}^{i-1}\ell_{ij}x_j+\ell_{ii}x_i=b_i
\]
in the order \(i=1,\ldots,n\).  Replacing scalars by blocks gives the two block
formulas; nonsingularity of each diagonal block gives existence and uniqueness at
each step.
\end{proof}

\begin{example}[Two triangular solves]\label{ex:triangular-solves}
\[
\underbrace{\begin{pmatrix}1&0&0\\2&1&0\\-1&3&1\end{pmatrix}}_{\bL}
\by=
\begin{pmatrix}-8\\-23\\-7\end{pmatrix}
\ie
\by=\begin{pmatrix}-8\\-7\\6\end{pmatrix},
\]
and
\[
\underbrace{\begin{pmatrix}2&2&-4\\0&-1&-4\\0&0&3\end{pmatrix}}_{\bU}
\bx=\by
\ie
\bx=\begin{pmatrix}1\\-1\\2\end{pmatrix}.
\]
Thus \(\bL\bU\bx=(-8,-23,-7)'\), using two recursive solves and no matrix
inverse.
\origin{Course formulation from H Eqs.~11.8.3 and 11.8.6}
\end{example}

\subsection{LDU and LU factorisations}\label{sec:5.3.2}

\begin{definition}[LDU and LU factorisations]\label{def:ldu-lu}
An \emph{LDU factorisation} of \(\bA\in\Real^{n\times n}\) is
\[
\bA=\bL\bD\bU,
\]
where \(\bL\) is unit lower triangular, \(\bD\) is diagonal, and \(\bU\) is
unit upper triangular; \emph{unit} means that every diagonal entry is \(1\).
An \emph{LU factorisation} is
\(\bA=\widetilde{\bL}\widetilde{\bU}\), where \(\widetilde{\bL}\) is unit lower
triangular and \(\widetilde{\bU}\) is upper triangular.  Every LDU factorisation
gives the LU factorisation \(\bA=\bL(\bD\bU)\).
\origin{H \S14.5 preceding Lemma~14.5.1; S \S11.1}
\end{definition}

\begin{lemma}[Bordered LDU identities]\label{lem:bordered-ldu}
For \(n\geqslant2\), partition
\[
\bA=\begin{pmatrix}\bA_*&\ba\\\bbb'&c\end{pmatrix},\quad
\bL=\begin{pmatrix}\bL_*&\bzero\\\boldsymbol{\ell}'&1\end{pmatrix},\quad
\bD=\begin{pmatrix}\bD_*&\bzero\\\bzero'&d\end{pmatrix},\quad
\bU=\begin{pmatrix}\bU_*&\bu\\\bzero'&1\end{pmatrix}.
\]
Then \(\bA=\bL\bD\bU\) if and only if
\[
\bA_*=\bL_*\bD_*\bU_*,\qquad
\ba=\bL_*\bD_*\bu,
\qquad
\bbb=\bU_*'\bD_*\boldsymbol{\ell},
\qquad
d=c-\boldsymbol{\ell}'\bD_*\bu.
\]
\origin{H Lemma~14.5.1}
\end{lemma}

\begin{proof}
Block multiplication gives
\[
\bL\bD\bU=
\begin{pmatrix}
\bL_*\bD_*\bU_*&\bL_*\bD_*\bu\\
\boldsymbol{\ell}'\bD_*\bU_*&
\boldsymbol{\ell}'\bD_*\bu+d
\end{pmatrix}.
\]
Equating the four blocks is equivalent to the displayed identities.
\end{proof}

\begin{theorem}[Existence and recursive construction of LDU]\label{thm:ldu-criterion}
For \(i=1,\ldots,n\), let \(\bA_i\) be the leading \(i\times i\) principal
submatrix of \(\bA=(a_{ij})\), formed from rows and columns \(1,\ldots,i\).
For \(i\geqslant2\), write
\[
\bA_i=\begin{pmatrix}\bA_{i-1}&\ba_i\\\bbb_i'&a_{ii}\end{pmatrix}.
\]
Then \(\bA\) has an LDU factorisation if and only if
\[
\ba_i\in\col(\bA_{i-1}),
\qquad
\bbb_i'\in\row(\bA_{i-1})
\quad(i=2,\ldots,n).
\]
Starting with \(\bL_1=\bU_1=(1)\), \(\bD_1=(a_{11})\), choose
\(\boldsymbol{\ell}_i,\bu_i\) satisfying
\[
\bU_{i-1}'\bD_{i-1}\boldsymbol{\ell}_i=\bbb_i,
\qquad
\bL_{i-1}\bD_{i-1}\bu_i=\ba_i,
\]
and set
\[
d_i=a_{ii}-\boldsymbol{\ell}_i'\bD_{i-1}\bu_i,
\]
\[
\bL_i=\begin{pmatrix}\bL_{i-1}&\bzero\\\boldsymbol{\ell}_i'&1\end{pmatrix},
\quad
\bD_i=\begin{pmatrix}\bD_{i-1}&\bzero\\\bzero'&d_i\end{pmatrix},
\quad
\bU_i=\begin{pmatrix}\bU_{i-1}&\bu_i\\\bzero'&1\end{pmatrix}.
\]
Then \(\bA_i=\bL_i\bD_i\bU_i\) for every \(i\).
\origin{H Thm.~14.5.4}
\end{theorem}

\begin{proof}
Suppose the containment conditions hold and
\(\bA_{i-1}=\bL_{i-1}\bD_{i-1}\bU_{i-1}\).  Write
\[
\ba_i=\bA_{i-1}\br,\qquad
\bbb_i'=\bs'\bA_{i-1}.
\]
Then
\[
\bu_i=\bU_{i-1}\br,\qquad
\boldsymbol{\ell}_i=\bL_{i-1}'\bs
\]
satisfy the two systems.  Lemma~\ref{lem:bordered-ldu} gives
\(\bA_i=\bL_i\bD_i\bU_i\); induction gives \(i=2,\ldots,n\).

Conversely, an LDU factorisation of \(\bA\) restricts, by block multiplication,
to an LDU factorisation of every \(\bA_i\).  Lemma~\ref{lem:bordered-ldu} gives
\[
\ba_i=\bL_{i-1}\bD_{i-1}\bu_i
=\bA_{i-1}\bU_{i-1}^{-1}\bu_i\in\col(\bA_{i-1}),
\]
and
\[
\bbb_i'=\boldsymbol{\ell}_i'\bD_{i-1}\bU_{i-1}
=\boldsymbol{\ell}_i'\bL_{i-1}^{-1}\bA_{i-1}
\in\row(\bA_{i-1}).
\]
\end{proof}

\begin{corollary}[Leading principal minors and uniqueness]
\label{cor:leading-minors-ldu}
Let \(\Delta_i=\det(\bA_i)\) and \(\Delta_0=1\).  If
\[
\Delta_1\Delta_2\cdots\Delta_{n-1}\neq0,
\]
then \(\bA\) has a unique LDU factorisation.  Its diagonal entries satisfy
\[
d_i=\frac{\Delta_i}{\Delta_{i-1}}\quad(i=1,\ldots,n),
\qquad
\det(\bA)=\prod_{i=1}^n d_i.
\]
If \(\bA\) is nonsingular, the condition is also necessary for an unpivoted LU
factorisation with unit lower factor.
\origin{H Cor.~14.5.7 and Ex.~14.15; S Thm.~11.1}
\end{corollary}

\begin{proof}
For \(n=1\), \(\bA=(1)(a_{11})(1)\), and all assertions hold.  Assume \(n\geqslant2\).
For \(i\geqslant2\), nonsingularity of \(\bA_{i-1}\) gives both containments in
Theorem~\ref{thm:ldu-criterion}, hence existence.  Uniqueness follows by induction.
For the bordered step, the LDU factorisation of \(\bA_{i-1}\) is unique, and the
nonsingular matrices
\(\bL_{i-1}\bD_{i-1}\) and
\(\bU_{i-1}'\bD_{i-1}\) determine \(\bu_i,\boldsymbol{\ell}_i\) uniquely;
then \(d_i\) is unique.

Triangular determinants give
\[
\Delta_i
=\det(\bL_i)\det(\bD_i)\det(\bU_i)
=\prod_{k=1}^i d_k,
\]
so \(d_i=\Delta_i/\Delta_{i-1}\) and \(\det(\bA)=\prod_i d_i\).
If a nonsingular \(\bA=\bL\widetilde{\bU}\), then its leading blocks satisfy
\(\bA_i=\bL_i\widetilde{\bU}_i\), and both triangular factors are nonsingular;
hence \(\Delta_i\neq0\).
\end{proof}

\Needspace{.68\textheight}
\begin{theorem}[Scalar LDU recursion]\label{thm:scalar-ldu}
Under the hypotheses of Corollary~\ref{cor:leading-minors-ldu}, the entries of
\(\bL=(\ell_{ij})\), \(\bD=\diag(d_1,\ldots,d_n)\), and
\(\bU=(u_{ij})\) are generated, for \(i=1,\ldots,n\), by
\begin{align*}
d_i&=a_{ii}-\sum_{k=1}^{i-1}\ell_{ik}d_k u_{ki},\\
u_{ij}&=\frac{a_{ij}-\sum_{k=1}^{i-1}\ell_{ik}d_k u_{kj}}{d_i}
&& (j=i+1,\ldots,n),\\
\ell_{ji}&=\frac{a_{ji}-\sum_{k=1}^{i-1}\ell_{jk}d_k u_{ki}}{d_i}
&& (j=i+1,\ldots,n),
\end{align*}
where empty sums equal \(0\), \(\ell_{ii}=u_{ii}=1\), and the two divisions are
performed only for \(i<n\).
\origin{H \S14.5e, Eq.~14.5.15}
\end{theorem}

\begin{proof}
For \(i\leqslant j\), the \((i,j)\) entry of \(\bL\bD\bU\) is
\[
a_{ij}=\sum_{k=1}^{i}\ell_{ik}d_k u_{kj}
=\sum_{k=1}^{i-1}\ell_{ik}d_k u_{kj}+d_i u_{ij}.
\]
Taking \(j=i\) gives the first recursion; taking \(j>i\) gives the second.
For \(j>i\), the \((j,i)\) entry is
\[
a_{ji}=\sum_{k=1}^{i}\ell_{jk}d_k u_{ki}
=\sum_{k=1}^{i-1}\ell_{jk}d_k u_{ki}+\ell_{ji}d_i,
\]
which gives the third.  Corollary~\ref{cor:leading-minors-ldu} gives
\(d_i\neq0\) for \(i<n\).
\end{proof}

\begin{example}[An exact LDU factorisation]\label{ex:exact-ldu}
\[
\begin{pmatrix}
2&2&-4\\4&3&-12\\-2&-5&-5
\end{pmatrix}
=
\underbrace{\begin{pmatrix}1&0&0\\2&1&0\\-1&3&1\end{pmatrix}}_{\bL}
\underbrace{\begin{pmatrix}2&0&0\\0&-1&0\\0&0&3\end{pmatrix}}_{\bD}
\underbrace{\begin{pmatrix}1&1&-2\\0&1&4\\0&0&1\end{pmatrix}}_{\bU}.
\]
The leading principal minors are \(2,-2,-6\), and
\[
(d_1,d_2,d_3)=\left(2,\frac{-2}{2},\frac{-6}{-2}\right)=(2,-1,3).
\]
\origin{Course formulation from H Eq.~14.5.15 and Ex.~14.15}
\end{example}

\subsection{Row pivoting and repeated right-hand sides}\label{sec:5.3.3}

\begin{definition}[Exact pivoting and partial pivoting]\label{def:pivoting}
After the first \(k-1\) pivot rows and columns have been processed, rows and
columns \(k,\ldots,n\) form the \emph{active submatrix}; its first diagonal entry
is the \emph{candidate pivot}.  If that entry is zero while another entry in the
active pivot column is nonzero, elimination in that column requires a row
interchange; if the active pivot column is zero, no row interchange supplies a
pivot there.  \emph{Partial pivoting} interchanges the candidate row with an
active row whose pivot-column entry \(p\) has largest absolute value.  The
subsequent multipliers in that column satisfy
\[
m_i=\frac{a_{ik}}{p},\qquad |m_i|\leqslant1.
\]
\origin{Course formulation from A\&M Ex.~6.13; S \S12 opening}
\end{definition}

\Needspace{.26\textheight}
\begin{theorem}[Pivoted LU]\label{thm:pivoted-lu}
For every nonsingular \(\bA\in\Real^{n\times n}\), there exist a permutation
matrix \(\bP\), a unit lower triangular matrix \(\bL\), and a nonsingular upper
triangular matrix \(\bU\) such that
\[
\bP\bA=\bL\bU.
\]
\origin{Course formulation from A\&M Ex.~6.13 and 6.26; S Thm.~11.1}
\end{theorem}

\begin{proof}
Induct on \(n\).  For \(n=1\), take \(\bP=\bL=(1)\), \(\bU=\bA\).  For
\(n>1\), nonsingularity gives a nonzero entry in column \(1\).  A row
interchange \(\bP_1\) gives
\[
\bP_1\bA=
\begin{pmatrix}\alpha&\br'\\\bc&\bB\end{pmatrix},
\qquad \alpha\neq0,
\qquad
\bs=\bc/\alpha,
\qquad
\bS=\bB-\bs\br'.
\]
\tcbbreak
The Schur determinant identity gives
\(\det(\bP_1\bA)=\alpha\det(\bS)\), so \(\bS\) is nonsingular.  By induction,
\(\bP_2\bS=\bL_2\bU_2\).  Then
\[
\underbrace{\begin{pmatrix}1&\bzero'\\\bzero&\bP_2\end{pmatrix}\bP_1}_{\bP}
\bA
=
\underbrace{\begin{pmatrix}1&\bzero'\\\bP_2\bs&\bL_2\end{pmatrix}}_{\bL}
\underbrace{\begin{pmatrix}\alpha&\br'\\\bzero&\bU_2\end{pmatrix}}_{\bU}.
\]
The three displayed factors have the required forms.
\end{proof}

\begin{corollary}[Factor once, solve many right-hand sides]
\label{cor:factor-once}
If \(\bP\bA=\bL\bU\) and \(\bB\in\Real^{n\times p}\), then
\[
\bA\bX=\bB
\iff
\bL\bY=\bP\bB,\qquad \bU\bX=\bY.
\]
The factors depend on \(\bA\), not on \(\bB\); each added column of \(\bB\)
requires only one forward and one back substitution.
\origin{H \S7.1 and Eqs.~11.8.2--11.8.6; S \S11.1}
\end{corollary}

\begin{proof}
Set \(\bY=\bU\bX\).  Then
\(\bA\bX=\bB\iff\bP\bA\bX=\bP\bB\iff\bL\bY=\bP\bB\);
nonsingularity of \(\bL,\bU\) gives unique \(\bY,\bX\), columnwise.
\end{proof}

%=============================================================================
\Needspace{.28\textheight}
\section{Computation: Numerical Checks in R}\label{sec:5.4}
%=============================================================================

\subsection{An elementary product and its RREF}\label{sec:5.4.1}

<<elementary-rref>>=
A <- rbind(c(1, 2, -1, 0),
           c(2, 4,  0, 2),
           c(0, 0,  2, 2))
E1 <- diag(3); E1[2, 1] <- -2
E2 <- diag(3); E2[3, 2] <- -1
E3 <- diag(c(1, 1 / 2, 1))
E4 <- diag(3); E4[1, 2] <- 1
E <- E4 %*% E3 %*% E2 %*% E1
R_manual <- rbind(c(1, 2, 0, 1),
                  c(0, 0, 1, 1),
                  c(0, 0, 0, 0))
E %*% A - R_manual
solve(E, R_manual) - A
@

\subsection{Augmented tracking}\label{sec:5.4.2}

<<augmented-tracking>>=
A <- rbind(c(1, 2, -1), c(2, 4, 0))
b <- c(1, 4)
E1 <- rbind(c(1, 0), c(-2, 1))
E2 <- diag(c(1, 1 / 2))
E3 <- rbind(c(1, 1), c(0, 1))
E <- E3 %*% E2 %*% E1
aug_manual <- rbind(c(1, 2, 0, 2), c(0, 0, 1, 1))
E %*% cbind(A, b) - aug_manual
x0 <- c(2, 0, 1)
z <- c(-2, 1, 0)
cbind(particular_residual = A %*% x0 - b,
      null_residual = A %*% z)
@

\subsection{LDU reconstruction, determinant, and solve}\label{sec:5.4.3}

<<ldu-checks>>=
L <- rbind(c(1, 0, 0), c(2, 1, 0), c(-1, 3, 1))
D <- diag(c(2, -1, 3))
U <- rbind(c(1, 1, -2), c(0, 1, 4), c(0, 0, 1))
A <- rbind(c(2, 2, -4), c(4, 3, -12), c(-2, -5, -5))
b <- c(-8, -23, -7)
x_formula <- c(1, -1, 2)
x_package <- solve(A, b)
cbind(reconstruction = A - L %*% D %*% U,
      solve_residual = A %*% x_formula - b)
c(det_formula_difference = -6 - prod(diag(D)),
  det_package_difference = det(A) - (-6),
  solution_difference = max(abs(x_formula - x_package)))
@

\subsection{Pivoted LU with two right-hand sides}\label{sec:5.4.4}

<<pivoted-lu-many-rhs>>=
A <- rbind(c(0, 2, 1), c(1, 1, 0), c(2, 3, 4))
P <- rbind(c(0, 0, 1), c(0, 1, 0), c(1, 0, 0))
L <- rbind(c(1, 0, 0), c(1 / 2, 1, 0), c(0, -4, 1))
U <- rbind(c(2, 3, 4), c(0, -1 / 2, -2), c(0, 0, -7))
X_true <- cbind(c(1, -1, 2), c(0, 3, -2))
B <- A %*% X_true
Y <- solve(L, P %*% B)
X_factor <- solve(U, Y)
cbind(factor_residual = P %*% A - L %*% U,
      solve_residual = A %*% X_factor - B)
X_factor - solve(A, B)
@

%=============================================================================
\section{Pitfalls}\label{sec:5.5}
%=============================================================================

\subsection{A zero candidate pivot is not singularity}\label{sec:5.5.1}

\[
\bA=\begin{pmatrix}0&1\\1&1\end{pmatrix},
\qquad
\det(\bA)=-1,
\qquad
\begin{pmatrix}0&1\\1&0\end{pmatrix}\bA
=\begin{pmatrix}1&1\\0&1\end{pmatrix}.
\]
The zero in position \((1,1)\) prevents an unpivoted LDU factorisation because
the first row and column are not both zero.  One row interchange supplies a
nonzero pivot.

\subsection{Partial pivoting bounds column multipliers}\label{sec:5.5.2}

\[
\bA_\varepsilon=
\begin{pmatrix}\varepsilon&1\\1&1\end{pmatrix},
\qquad 0<|\varepsilon|<1.
\]
No interchange is required in exact arithmetic.  Without one, the elimination
multiplier is \(1/\varepsilon\); after interchanging the rows it is
\(\varepsilon\).  Partial pivoting bounds these column multipliers; it makes no
assertion about other arithmetic quantities.  A small nonzero candidate pivot
does not obstruct exact elimination.

\subsection{Row operations do not preserve column space}\label{sec:5.5.3}

\[
\bA=\begin{pmatrix}1&0\\0&0\end{pmatrix},
\qquad
\bE_{12}\bA=\begin{pmatrix}0&0\\1&0\end{pmatrix},
\]
\[
\col(\bA)=\spn\{(1,0)'\}\neq
\spn\{(0,1)'\}=\col(\bE_{12}\bA).
\]
Row operations preserve row space, null space, and rank.  Pivot indices in an
RREF identify basis columns of the original matrix; the RREF columns themselves
belong to a transformed column space.

\subsection{The right-hand side must undergo the same operations}\label{sec:5.5.4}

\[
\bE(\bA:\bbb)=(\bE\bA:\bE\bbb).
\]
Replacing this by \((\bE\bA:\bbb)\) changes the equations unless
\(\bE\bbb=\bbb\).  Eliminate the entire augmented matrix or retain \(\bE\).

%=============================================================================
\section{Exercises}\label{sec:5.6}
%=============================================================================

\begin{exercise}[Rank-one formulas for elementary matrices]\label{ex:elementary-formulas}
For \(i\neq j\), derive
\[
\bE_{ij}=\bI-(\eu_i-\eu_j)(\eu_i-\eu_j)',\quad
\bE_i(\lambda)=\bI+(\lambda-1)\eu_i\eu_i',\quad
\bE_i(\lambda\mid j)=\bI+\lambda\eu_i\eu_j'.
\]
Use the last formula to prove
\[
\bE_i(\lambda\mid j)\bE_i(\mu\mid j)
=\bE_i(\lambda+\mu\mid j).
\]
\origin{A\&M Ex.~6.3 and 6.5}
\end{exercise}
\begin{solution}
The identity decomposition \(\bI=\sum_k\eu_k\eu_k'\) gives
\begin{align*}
\bE_{ij}
&=\sum_{k\notin\{i,j\}}\eu_k\eu_k'
+\eu_i\eu_j'+\eu_j\eu_i'
=\bI-(\eu_i-\eu_j)(\eu_i-\eu_j)',\\
\bE_i(\lambda)
&=\sum_{k\neq i}\eu_k\eu_k'+\lambda\eu_i\eu_i'
=\bI+(\lambda-1)\eu_i\eu_i',\\
\bE_i(\lambda\mid j)
&=\bI+\lambda\eu_i\eu_j'.
\end{align*}
Since \(\eu_j'\eu_i=0\),
\[
(\bI+\lambda\eu_i\eu_j')(\bI+\mu\eu_i\eu_j')
=\bI+(\lambda+\mu)\eu_i\eu_j'.
\]
\end{solution}

\begin{exercise}[Retaining the augmented transformation]\label{ex:augmented-transform}
For
\[
\bA=\begin{pmatrix}1&2&-1\\2&4&1\end{pmatrix},
\qquad
\bbb=\begin{pmatrix}1\\5\end{pmatrix},
\]
find \(\bE\) such that
\[
\bE(\bA:\bbb)=
\begin{pmatrix}1&2&0&2\\0&0&1&1\end{pmatrix}.
\]
Use the transformed system to give every solution.
\origin{Course formulation from A\&M Ex.~6.21}
\end{exercise}
\begin{solution}
Apply \(R_2\leftarrow R_2-2R_1\),
\(R_2\leftarrow R_2/3\), and \(R_1\leftarrow R_1+R_2\):
\[
\bE=
\begin{pmatrix}1&1\\0&1\end{pmatrix}
\begin{pmatrix}1&0\\0&1/3\end{pmatrix}
\begin{pmatrix}1&0\\-2&1\end{pmatrix}
=\begin{pmatrix}1/3&1/3\\-2/3&1/3\end{pmatrix}.
\]
The transformed equations are \(x_1+2x_2=2\), \(x_3=1\).  Hence
\[
\bx=\begin{pmatrix}2\\0\\1\end{pmatrix}
+t\begin{pmatrix}-2\\1\\0\end{pmatrix},\qquad t\in\Real.
\]
\end{solution}

\begin{exercise}[Coordinates for a nonhomogeneous solution set]
\label{ex:affine-solutions}
Let \(\bA\in\Real^{m\times n}\) have rank \(r\), let \(\bB\neq\bO\), and
suppose \(\bA\bX=\bB\), \(\bX\in\Real^{n\times p}\), has a solution
\(\bX_0\).  If \(\bz_1,\ldots,\bz_{n-r}\) is a basis of \(\nul(\bA)\), set
\[
\bZ_{jk}=\bz_j\eu_k',\qquad \bX_{jk}=\bX_0+\bZ_{jk}
\quad(1\leqslant j\leqslant n-r,\ 1\leqslant k\leqslant p).
\]
Prove:
\begin{enumerate}[(a)]
\item the matrices \(\bZ_{jk}\) form a basis of
\(\{\bZ\in\Real^{n\times p}:\bA\bZ=\bO\}\);
\item \(\bX_0\) and the \(\bX_{jk}\) are linearly independent;
\item
\[
\{\bX:\bA\bX=\bB\}
=\left\{c_0\bX_0+\sum_{j,k}c_{jk}\bX_{jk}:
c_0+\sum_{j,k}c_{jk}=1\right\};
\]
\item the solution set is not a linear subspace of \(\Real^{n\times p}\).
\end{enumerate}
\origin{Course formulation from H Ex.~11.4}
\end{exercise}
\begin{solution}
For \(\bZ=(\bz^{(1)},\ldots,\bz^{(p)})\),
\[
\bA\bZ=\bO
\iff
\bz^{(k)}=\sum_{j=1}^{n-r}a_{jk}\bz_j\quad(1\leqslant k\leqslant p)
\iff
\bZ=\sum_{j,k}a_{jk}\bZ_{jk}.
\]
Columnwise comparison proves independence of the \(\bZ_{jk}\), hence (a).

If
\[
c_0\bX_0+\sum_{j,k}c_{jk}\bX_{jk}=\bO,
\qquad s=c_0+\sum_{j,k}c_{jk},
\]
then applying \(\bA\) gives \(s\bB=\bO\), so \(s=0\).  Thus
\(\sum_{j,k}c_{jk}\bZ_{jk}=\bO\), whence every \(c_{jk}=0\) and \(c_0=0\).
This proves (b).

When the coefficients sum to \(1\),
\[
c_0\bX_0+\sum_{j,k}c_{jk}\bX_{jk}
=\bX_0+\sum_{j,k}c_{jk}\bZ_{jk},
\]
which is a solution.  Conversely, every solution is
\(\bX_0+\sum_{j,k}a_{jk}\bZ_{jk}\); take
\(c_{jk}=a_{jk}\) and \(c_0=1-\sum_{j,k}a_{jk}\).  This proves (c).
Finally, \(\bO\) is not a solution because \(\bB\neq\bO\), proving (d).
\end{solution}

\begin{exercise}[A discrete difference system]\label{ex:path-incidence}
For \(n\geqslant2\), let
\[
\bD=(\eu_1-\eu_2,\eu_2-\eu_3,\ldots,\eu_{n-1}-\eu_n)
\in\Real^{n\times(n-1)}.
\]
Prove
\[
\rank(\bD)=n-1,
\qquad
\nul(\bD')=\spn\{\bone_n\}.
\]
Deduce that \(\bD\bx=\bbb\) is consistent if and only if
\(\bone_n'\bbb=0\), and in that case prove that its unique solution is
\[
x_j=\sum_{i=1}^j b_i\quad(1\leqslant j\leqslant n-1).
\]
\origin{Course formulation from H Thm.~7.3.1}
\end{exercise}
\begin{solution}
For \(\bx\in\Real^{n-1}\), the first \(n-1\) coordinates of
\(\bD\bx=\bzero\) give
\[
x_1=0,\qquad -x_{j-1}+x_j=0\quad(2\leqslant j\leqslant n-1),
\]
so \(\bx=\bzero\) and \(\rank(\bD)=n-1\).  Also
\[
\bD'\bk=\bzero
\iff k_i-k_{i+1}=0\quad(1\leqslant i<n)
\iff \bk=c\bone_n.
\]
Consistency and compatibility therefore give
\[
\bD\bx=\bbb\text{ is consistent}
\iff
\bk'\bbb=0\quad(\bk\in\nul(\bD'))
\iff
\bone_n'\bbb=0.
\]
Under this condition, the stated \(x_j\) satisfy
\[
(\bD\bx)_1=b_1,\quad
(\bD\bx)_j=-x_{j-1}+x_j=b_j\ (2\leqslant j<n),\quad
(\bD\bx)_n=-x_{n-1}=b_n.
\]
Full column rank gives uniqueness.
\end{solution}

\begin{exercise}[Two-sided annihilation at nullity one]\label{ex:rank-n-minus-one}
Let \(\bA,\bZ\in\Real^{n\times n}\), \(\rank(\bA)=n-1\), and let nonzero
\(\bx,\by\in\Real^n\) satisfy
\[
\bA\bx=\bzero,\qquad \bA'\by=\bzero.
\]
Prove
\begin{enumerate}[(a)]
\item \(\bA\bZ=\bO\) if and only if \(\bZ=\bx\bk'\) for some \(\bk\in\Real^n\);
\item \(\bA\bZ=\bZ\bA=\bO\) if and only if
\(\bZ=c\bx\by'\) for some \(c\in\Real\).
\end{enumerate}
\origin{H Ex.~11.3}
\end{exercise}
\begin{solution}
Rank-nullity gives
\[
\nul(\bA)=\spn\{\bx\},\qquad
\nul(\bA')=\spn\{\by\}.
\]
(a) \(\bA\bZ=\bO\) exactly when every column of \(\bZ\) belongs to
\(\spn\{\bx\}\), exactly when \(\bZ=\bx\bk'\).

(b) By (a), \(\bZ=\bx\bk'\).  Since \(\bx\neq\bzero\),
\[
\bZ\bA=\bO
\iff \bk'\bA=\bzero'
\iff \bk\in\nul(\bA')
\iff \bk=c\by.
\]
The reverse implications are the same equalities read backward.
\end{solution}

\begin{exercise}[Premultiplication and the complete solution set]
\label{ex:premultiplication-equivalence}
Let \(\bA\in\Real^{m\times n}\), \(\bB\in\Real^{m\times p}\), and
\(\bC\in\Real^{q\times m}\), where \(p\geqslant1\).  Assume
\(\bC\bA\bX=\bC\bB\) is consistent.  Prove that it has exactly the same
solutions as \(\bA\bX=\bB\) if and only if
\[
\rank\!\bigl(\bC(\bA:\bB)\bigr)=\rank(\bA:\bB).
\]
\origin{H Ex.~11.7}
\end{exercise}
\begin{solution}[qedhere]
Set \(\bM=(\bA:\bB)\).  Since
\(\row(\bC\bM)\subseteq\row(\bM)\), rank equality gives a matrix \(\bD\) with
\(\bM=\bD\bC\bM\).  Thus
\[
\bC\bA\bX=\bC\bB
\ie
\bC\bM\begin{pmatrix}\bX\\-\bI_p\end{pmatrix}=\bO
\ie
\bM\begin{pmatrix}\bX\\-\bI_p\end{pmatrix}=\bO,
\]
so \(\bA\bX=\bB\).  The reverse inclusion of solution sets always holds.

Conversely, let \(\bX_0\) solve the premultiplied system.  Equivalence gives
\(\bA\bX_0=\bB\).  For \(\bz\in\nul(\bC\bA)\),
\(\bX_0+\bz\eu_1'\) also solves the premultiplied system; equivalence gives
\(\bA\bz=\bzero\).  Hence
\[
\nul(\bC\bA)=\nul(\bA),
\qquad
\rank(\bC\bA)=\rank(\bA).
\]
Since \(\bB=\bA\bX_0\) and \(\bC\bB=\bC\bA\bX_0\),
\[
\rank(\bA:\bB)=\rank(\bA)
=\rank(\bC\bA)=\rank(\bC\bA:\bC\bB)
\tag*{\textcolor{solFR}{$\blacksquare$}}
\]
\end{solution}

\begin{exercise}[When \(\bA\bX\) is invariant across solutions]
\label{ex:invariant-image}
Let \(\bA\in\Real^{q\times n}\), \(\bC\in\Real^{m\times q}\), and
\(\bB\in\Real^{m\times p}\), where \(p\geqslant1\).  Suppose
\(\bC\bA\bX=\bB\) is consistent.  Prove that \(\bA\bX\) has the same value for
every solution if and only if
\[
\rank(\bC\bA)=\rank(\bA).
\]
\origin{H Ex.~11.8}
\end{exercise}
\begin{solution}
Since \(\nul(\bA)\subseteq\nul(\bC\bA)\), rank equality is equivalent to
\(\nul(\bA)=\nul(\bC\bA)\).  For two solutions,
\[
\bC\bA(\bX_1-\bX_2)=\bO
\ie
\bA(\bX_1-\bX_2)=\bO,
\]
which proves invariance.

Conversely, fix a solution \(\bX_0\).  For every
\(\bz\in\nul(\bC\bA)\), \(\bX_0+\bz\eu_1'\) is another solution.  Invariance
gives \(\bA\bz\eu_1'=\bO\), hence \(\bA\bz=\bzero\).  Therefore the two null
spaces, and hence the two ranks, are equal.
\end{solution}

\begin{exercise}[A matrix requiring a row pivot]\label{ex:pivoted-example}
Let
\[
\bA=\begin{pmatrix}0&2&1\\1&1&0\\2&3&4\end{pmatrix}.
\]
Prove that \(\bA\) has no unpivoted LDU factorisation.  Find
\(\bP,\bL,\bU\) such that \(\bP\bA=\bL\bU\).
\origin{Course formulation from H Cor.~14.5.7; S Thm.~11.1}
\end{exercise}
\begin{solution}
If \(\bA=\bL\bD\bU\), its first bordered step requires
\[
(2)\in\col((0))=\{0\},
\]
a contradiction.  Interchange rows \(1,3\) and eliminate:
\[
\bP=\begin{pmatrix}0&0&1\\0&1&0\\1&0&0\end{pmatrix},\quad
\bL=\begin{pmatrix}1&0&0\\1/2&1&0\\0&-4&1\end{pmatrix},\quad
\bU=\begin{pmatrix}2&3&4\\0&-1/2&-2\\0&0&-7\end{pmatrix}.
\]
Direct multiplication gives
\[
\bL\bU=
\begin{pmatrix}2&3&4\\1&1&0\\0&2&1\end{pmatrix}=\bP\bA.
\]
\end{solution}

\begin{exercise}[When an LDU factorisation is unique]
\label{ex:ldu-uniqueness}
Suppose
\[
\bA=\bL\diag(d_1,\ldots,d_n)\bU
\]
is an LDU factorisation.  Prove that it is unique if and only if
\[
d_i\neq0\quad(1\leqslant i<n),
\]
equivalently, if and only if every leading principal submatrix of order less
than \(n\) is nonsingular.
\origin{H Ex.~14.16(a) and 14.19}
\end{exercise}
\begin{solution}
For the leading principal submatrix \(\bA_k\),
\[
\det(\bA_k)=\prod_{j=1}^k d_j.
\]
Thus \(d_i\neq0\) for \(i<n\) is equivalent to
\(\det(\bA_k)\neq0\) for \(k<n\), and
Corollary~\ref{cor:leading-minors-ldu} gives uniqueness.

Conversely, if \(d_i=0\) for some \(i<n\), then for every \(t\in\Real\),
\[
\bU_t=\bU+t\eu_i\eu_{i+1}'
\]
is unit upper triangular and
\[
\diag(d_1,\ldots,d_n)\bU_t
=\diag(d_1,\ldots,d_n)\bU.
\]
The choices \(t=0\) and \(t=1\) give distinct LDU factorisations of \(\bA\).
\end{solution}

\begin{exercise}[Determinants from LDU pivots]\label{ex:determinant-pivots}
Let \(\bA=\bL\diag(d_1,\ldots,d_n)\bU\) be an LDU factorisation, and let
\(\Delta_i\) be the determinant of its leading \(i\times i\) principal
submatrix, with \(\Delta_0=1\).  Prove
\[
\Delta_i=\prod_{k=1}^i d_k,\qquad
d_i=\frac{\Delta_i}{\Delta_{i-1}}\quad(\Delta_{i-1}\neq0),\qquad
\det(\bA)=\prod_{k=1}^n d_k.
\]
Evaluate \(\det(\bA)\) when \((d_1,d_2,d_3,d_4)=(2,-3,1/2,5)\).
\origin{H Ex.~14.15 and \S14.5e; S Thm.~11.1}
\end{exercise}
\begin{solution}
The leading factors satisfy \(\bA_i=\bL_i\bD_i\bU_i\), so
\[
\Delta_i=\det(\bL_i)\det(\bD_i)\det(\bU_i)
=1\left(\prod_{k=1}^i d_k\right)1.
\]
Division of consecutive identities gives the ratio.  At \(i=n\) it gives the
determinant formula.  In the stated case,
\[
\det(\bA)=2(-3)(1/2)5=-15.
\]
\end{solution}

\begin{exercise}[Substitution cost for many right-hand sides]
\label{ex:many-rhs-cost}
Let \(\bP\bA=\bL\bU\), where \(\bL\) is unit lower triangular and \(\bU\)
is nonsingular upper triangular.  For \(\bB\in\Real^{n\times p}\), count the
multiplication-subtractions and divisions needed after the factors are available to
solve \(\bA\bX=\bB\).  State the saving relative to refactorising for every
column.
\origin{H \S7.1 and Eqs.~11.8.2--11.8.6; S Prop.~11.1}
\end{exercise}
\begin{solution}
For one right-hand side, unit-lower substitution uses
\[
\sum_{i=1}^n(i-1)=\frac{n(n-1)}2
\]
multiplication-subtractions and no divisions.  Upper substitution uses the same
number of multiplication-subtractions and \(n\) divisions.  For \(p\) columns,
the total is
\[
pn(n-1)\text{ multiplication-subtractions},\qquad pn\text{ divisions}.
\]
The factorisation is performed once; separate solution would repeat it \(p\)
times, so factor-once avoids \(p-1\) factorisations.
\end{solution}

\begin{exercise}[Rank-revealing rectangular LDU]\label{ex:rectangular-ldu}
Let \(\bA\in\Real^{m\times n}\) have rank \(r>0\).
\begin{enumerate}[(a)]
\item Prove that permutation matrices \(\bP,\bQ\) can be chosen so that, in
\[
\bP\bA\bQ=
\begin{pmatrix}\bB_{11}&\bB_{12}\\\bB_{21}&\bB_{22}\end{pmatrix},
\]
the \(r\times r\) block \(\bB_{11}\) and all its leading principal submatrices
are nonsingular.
\item Prove the unique factorisation
\[
\bP\bA\bQ=
\begin{pmatrix}\bL_1\\\bL_2\end{pmatrix}
\bD
\begin{pmatrix}\bU_1&\bU_2\end{pmatrix},
\]
where \(\bB_{11}=\bL_1\bD\bU_1\) is its LDU factorisation, and derive
\[
\bL_2=\bB_{21}\bU_1^{-1}\bD^{-1},\qquad
\bU_2=\bD^{-1}\bL_1^{-1}\bB_{12}.
\]
\end{enumerate}
\origin{H Ex.~14.20}
\end{exercise}
\begin{solution}
(a) Rank \(r\) gives a nonsingular \(r\times r\) submatrix.  Row and column
permutations move it to the leading block \(\bC\).  Pivoted LU gives
\(\bP_0\bC=\bL_0\bU_0\).  Extend \(\bP_0\) by the identity on the remaining
rows.  The leading determinant of order \(i\leqslant r\) is
\[
\det((\bL_0)_i)\det((\bU_0)_i)=\prod_{k=1}^i u_{kk}\neq0.
\]

(b) Corollary~\ref{cor:leading-minors-ldu} gives the unique
\(\bB_{11}=\bL_1\bD\bU_1\), with all factors nonsingular.  Define
\(\bL_2,\bU_2\) by the displayed formulas.  Since
\(\rank(\bP\bA\bQ)=\rank(\bB_{11})=r\), the Schur rank identity gives
\[
\bB_{22}-\bB_{21}\bB_{11}^{-1}\bB_{12}=\bO.
\]
Therefore
\[
\begin{pmatrix}\bL_1\\\bL_2\end{pmatrix}
\bD
\begin{pmatrix}\bU_1&\bU_2\end{pmatrix}
=
\begin{pmatrix}
\bB_{11}&\bB_{12}\\
\bB_{21}&\bB_{21}\bB_{11}^{-1}\bB_{12}
\end{pmatrix}
=\bP\bA\bQ.
\]
The leading block fixes \(\bL_1,\bD,\bU_1\); the two off-diagonal block
equalities then fix \(\bL_2,\bU_2\).
\end{solution}

\begin{exercise}[A block LU solve through a Schur complement]
\label{ex:block-lu-solve}
Let
\[
\bM=\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix},
\qquad
\bS=\bD-\bC\bA^{-1}\bB,
\]
where \(\bA\) and \(\bS\) are nonsingular.  Derive a solution of
\[
\bM\begin{pmatrix}\bx\\\by\end{pmatrix}
=\begin{pmatrix}\bfeta\\\bg\end{pmatrix}
\]
using one solve with \(\bS\) and two solves with \(\bA\).  Do not form
\(\bM^{-1}\).
\origin{H Lemma~14.5.1; S \S11.1.1}
\end{exercise}
\begin{solution}
Block elimination gives
\[
\begin{pmatrix}\bI&\bO\\-\bC\bA^{-1}&\bI\end{pmatrix}
\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix}
=\begin{pmatrix}\bA&\bB\\\bO&\bS\end{pmatrix}.
\]
Thus compute
\[
\bA\bz=\bfeta,\qquad
\bS\by=\bg-\bC\bz,\qquad
\bA\bx=\bfeta-\bB\by.
\]
Then \(\bA\bx+\bB\by=\bfeta\), and
\[
\bC\bx+\bD\by
=\bC\bA^{-1}(\bfeta-\bB\by)+\bD\by
=\bC\bz+\bS\by=\bg.
\]
\end{solution}

