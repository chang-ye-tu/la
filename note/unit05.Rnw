%=============================================================================
\section{Linear Systems}\label{sec:5.2}
%=============================================================================

\subsection{Consistency and complete solution sets}\label{sec:5.2.1}

\begin{definition}[Linear system and consistency]\label{def:linear-system}
For \(\bA\in\Real^{m\times n}\) and \(\bB\in\Real^{m\times p}\),
\[
\bA\bX=\bB
\]
is a \emph{linear system} in \(\bX\in\Real^{n\times p}\).  The matrices
\(\bA\), \(\bB\), and \((\bA:\bB)\) are its \emph{coefficient matrix},
\emph{right-hand side}, and \emph{augmented matrix}.  A value of \(\bX\)
satisfying the equality is a \emph{solution}.  The system is \emph{consistent}
if a solution exists and \emph{homogeneous} if \(\bB=\bO\).
\origin{H \S\S7.1--7.2; A\&M \S\S6.4--6.5}
\end{definition}

\begin{theorem}[Classification of a linear system]\label{thm:system-classification}
For \(\bA\in\Real^{m\times n}\) and \(\bB\in\Real^{m\times p}\), the following
are equivalent:
\[
\bA\bX=\bB\text{ is consistent},
\qquad
\col(\bB)\subseteq\col(\bA),
\qquad
\rank(\bA:\bB)=\rank(\bA).
\]
If \(\bX_0\) is one solution, then the complete solution set is
\[
\{\bX:\bA\bX=\bB\}
=\{\bX_0+\bZ:\bA\bZ=\bO\}.
\]
It contains exactly one member if and only if \(\rank(\bA)=n\).  For \(p=1\),
\(\dim\nul(\bA)=n-\rank(\bA)\).
\origin{H Thm.~7.2.1 and Lemma~11.3.1; A\&M Ex.~6.42, 6.44, and 6.45}
\end{theorem}

\begin{proof}
Writing \(\bB=(\bbb_1,\ldots,\bbb_p)\) and
\(\bX=(\bx_1,\ldots,\bx_p)\),
\[
\bA\bX=\bB
\iff
\bbb_j=\bA\bx_j\in\col(\bA)\quad(1\leqslant j\leqslant p)
\iff
\col(\bA:\bB)=\col(\bA).
\]
Taking dimensions gives the rank condition.  If \(\bA\bX_0=\bB\), then
\[
\bA\bX=\bB
\iff
\bA(\bX-\bX_0)=\bO.
\]
Uniqueness is equivalent to \(\nul(\bA)=\{\bzero\}\), hence to
\(\rank(\bA)=n\) by rank-nullity.  The final dimension is rank-nullity.
\end{proof}

\begin{corollary}[Square systems]\label{cor:square-systems}
For \(\bA\in\Real^{n\times n}\), the following are equivalent:
\[
\begin{gathered}
\bA\bx=\bbb\text{ has a unique solution for every }\bbb\in\Real^n,\\
\rank(\bA)=n,\qquad \nul(\bA)=\{\bzero\},
\qquad \det(\bA)\neq0,\qquad \bA\text{ is nonsingular}.
\end{gathered}
\]
In this case the solution is \(\bx=\bA^{-1}\bbb\).
\origin{H \S11.1; A\&M Ex.~6.34 and 6.44; S \S11.1}
\end{corollary}

\begin{proof}
Theorem~\ref{thm:system-classification} gives the equivalence of the first three
conditions.  The inverse, determinant, and rank criteria for nonsingularity give
the remaining equivalences and the displayed solution.
\end{proof}

\subsection{Compatibility and row relations}\label{sec:5.2.2}

\begin{definition}[Compatibility]\label{def:compatibility}
The system \(\bA\bX=\bB\) is \emph{compatible} if
\[
\bk'\bA=\bzero'
\ie
\bk'\bB=\bzero'
\qquad(\bk\in\Real^m).
\]
Thus every linear relation among the rows of \(\bA\) must hold among the
corresponding rows of \(\bB\).
\origin{H \S7.3 preceding Thm.~7.3.1}
\end{definition}

\begin{theorem}[Consistency equals compatibility]\label{thm:compatibility}
The system \(\bA\bX=\bB\) is consistent if and only if it is compatible.
\origin{H Thm.~7.3.1}
\end{theorem}

\begin{proof}
If \(\bA\bX_0=\bB\), then
\[
\bk'\bA=\bzero'
\ie
\bk'\bB=\bk'\bA\bX_0=\bzero'.
\]

Conversely, let rows \(\ba_{i_1}',\ldots,\ba_{i_r}'\) form a basis of
\(\row(\bA)\), and let \(\bA_0,\bB_0\) contain the corresponding rows of
\(\bA,\bB\).  If \(r>0\), then \(\bA_0\) has full row rank, so
\(\bA_0\bX_0=\bB_0\) has a solution.  For every remaining row, write
\[
\ba_i'=\sum_{j=1}^r\lambda_{ij}\ba_{i_j}'.
\]
Compatibility applied to this row relation gives
\[
\bbb_i'=\sum_{j=1}^r\lambda_{ij}\bbb_{i_j}',
\qquad
\ba_i'\bX_0
=\sum_{j=1}^r\lambda_{ij}\ba_{i_j}'\bX_0
=\bbb_i'.
\]
Hence \(\bA\bX_0=\bB\).  If \(r=0\), then \(\bA=\bO\); compatibility with
\(\bk=\eu_i\) gives \(\bB=\bO\), and \(\bX_0=\bO\) is a solution.
\end{proof}

\begin{example}[A compatibility certificate]\label{ex:compatibility-certificate}
For
\[
\bA=\begin{pmatrix}1&2\\2&-1\\3&1\end{pmatrix},
\qquad
\bk=\begin{pmatrix}-1\\-1\\1\end{pmatrix},
\qquad
\bk'\bA=\bzero',
\]
the system \(\bA\bx=\bbb\) can be consistent only if
\[
\bk'\bbb=-b_1-b_2+b_3=0.
\]
For \(\bbb=(1,2,4)'\), this scalar equals \(1\), so the system is inconsistent.
For \(\bbb=(1,2,3)'\), row reduction gives \(\bx=(1,0)'\).
\origin{Course formulation from H Thm.~7.3.1}
\end{example}

\subsection{Augmented elimination}\label{sec:5.2.3}

\begin{theorem}[Tracking the augmented matrix]\label{thm:augmented-tracking}
Let \(\bbb\in\Real^m\), and let \(\bE\) be nonsingular.  If
\[
(\bR:\bc)=\bE(\bA:\bbb),
\]
then
\[
\bA\bx=\bbb\iff\bR\bx=\bc.
\]
If \((\bR:\bc)\) is in REF, the system is inconsistent exactly when its last
column is a pivot column.  Otherwise the pivot variables are determined by the
free variables; their number is \(n-\rank(\bA)\).
\origin{Course formulation from A\&M Ex.~6.41--6.47}
\end{theorem}

\begin{proof}
Nonsingularity of \(\bE\) gives
\[
\bA\bx=\bbb
\iff
\bE\bA\bx=\bE\bbb
\iff
\bR\bx=\bc.
\]
A pivot in the last column produces the equation \(0=1\).  Without such a
pivot, every nonzero row has a coefficient pivot; solving the pivot equations from
the last upward expresses each pivot variable in terms of the free variables.  The pivot count is
\(\rank(\bA)\), by Theorem~\ref{thm:pivot-data}.
\end{proof}

\begin{example}[Exact augmented reduction]\label{ex:augmented-reduction}
\[
\left(
\begin{array}{ccc|c}
1&2&-1&1\\
2&4&1&5
\end{array}
\right)
\sim_r
\left(
\begin{array}{ccc|c}
1&2&-1&1\\
0&0&1&1
\end{array}
\right)
\sim_r
\left(
\begin{array}{ccc|c}
1&2&0&2\\
0&0&1&1
\end{array}
\right).
\]
With \(x_2=t\),
\[
\bx=
\begin{pmatrix}2-2t\\t\\1\end{pmatrix}
=
\begin{pmatrix}2\\0\\1\end{pmatrix}
+t\begin{pmatrix}-2\\1\\0\end{pmatrix},
\qquad t\in\Real.
\]
\origin{Course formulation from A\&M Ex.~6.41 and 6.46}
\end{example}

% \periodmark{End of period 2 of 3.}

