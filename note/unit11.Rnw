%=============================================================================
\section{Singular systems and matrix factors}\label{sec:11.1}
%=============================================================================

\subsection{Full and compact decompositions}\label{sec:11.1.1}

\begin{definition}[Singular-value decomposition]\label{def:11-svd}
Let $\bA\in\Real^{m\times n}$, $m,n\geqslant1$, and $q=\min(m,n)$.
A \emph{singular-value decomposition} of $\bA$ is
\[
\bA=\bU\bSig\bV',
\]
where $\bU\in\Real^{m\times m}$ and
$\bV\in\Real^{n\times n}$ are orthogonal and
\[
\bSig_{ij}=
\begin{cases}
\sigma_i,&i=j\leqslant q,\\
0,&\text{otherwise},
\end{cases}
\qquad
\sigma_1\geqslant\cdots\geqslant\sigma_q\geqslant0.
\]
The $\sigma_i$ are the \emph{singular values}; write $\sigma_i(\bA)$ when
the matrix must be displayed.  If exactly $r$ are positive, write
\[
\bU=(\bU_r,\bU_0),
\qquad
\bV=(\bV_r,\bV_0),
\qquad
\bD=\diag(\sigma_1,\ldots,\sigma_r).
\]
Then
\[
\bA=\bU_r\bD\bV_r'
=\sum_{i=1}^r\sigma_i\bu_i\bv_i'
\]
is the \emph{compact SVD}; the empty sum is $\bO$ when $r=0$.
\origin{A\&M Ex.~8.38; H \S21.12(a), eqs.~(21.12.4)--(21.12.6); S Thm.~11.4}
\end{definition}

\begin{theorem}[Existence and singular-value uniqueness]
\label{thm:11-svd-existence}
Every $\bA\in\Real^{m\times n}$ has an SVD.  Moreover,
\[
\sigma_i^2=\lambda_i(\bA'\bA),
\qquad 1\leqslant i\leqslant q,
\]
where the eigenvalues of $\bA'\bA$ are in decreasing order.  Hence the
ordered singular values and
\[
r=\rank(\bA)=\#\{i:\sigma_i>0\}
\]
are unique; the singular vectors need not be unique.
\origin{A\&M Ex.~8.38; H Thm.~21.12.1, Cor.~21.12.2, and Thm.~21.12.3; S Thm.~11.4}
\end{theorem}

\begin{proof}
The matrix $\bA'\bA$ is symmetric positive semidefinite.  Its spectral
decomposition gives an orthonormal basis
$\bv_1,\ldots,\bv_n$ and
\[
\bA'\bA\bv_i=\lambda_i\bv_i,
\qquad
\lambda_1\geqslant\cdots\geqslant\lambda_n\geqslant0.
\]
Since
\[
\nul(\bA'\bA)=\nul(\bA),
\qquad
\rank(\bA'\bA)=\rank(\bA)=r,
\]
exactly $r$ of the $\lambda_i$ are positive.  Also $r\leqslant q$; set
$\sigma_i=\sqrt{\lambda_i}$ for $1\leqslant i\leqslant q$.  For $1\leqslant i\leqslant r$,
define
\[
\bu_i=\frac{\bA\bv_i}{\sigma_i}.
\]
Then
\[
\bu_i'\bu_j
=\frac{\bv_i'\bA'\bA\bv_j}{\sigma_i\sigma_j}
=\frac{\lambda_j\bv_i'\bv_j}{\sigma_i\sigma_j}
=\begin{cases}1,&i=j,\\0,&i\ne j.\end{cases}
\]
Extend $\bu_1,\ldots,\bu_r$ to an orthonormal basis of $\Real^m$ and
form $\bU$; form $\bV=(\bv_1,\ldots,\bv_n)$.  For $j>r$,
\[
\norm{\bA\bv_j}^2
=\bv_j'\bA'\bA\bv_j
=0,
\]
so $\bA\bv_j=\bzero$.  Therefore
\[
\bA\bV=\bU\bSig,
\qquad
\bA=\bU\bSig\bV'.
\]
For every SVD,
\[
\bA'\bA=\bV\bSig'\bSig\bV',
\]
so the ordered eigenvalues of $\bA'\bA$ determine the $\sigma_i$.
If a positive eigenvalue is repeated, its orthonormal eigenbasis may be
rotated; bases for either null space may also be changed.
\end{proof}

\begin{corollary}[Paired singular-vector equations]
\label{cor:11-singular-pairs}
For the compact SVD $\bA=\bU_r\bD\bV_r'$,
\[
\bA\bV_r=\bU_r\bD,
\qquad
\bA'\bU_r=\bV_r\bD,
\]
and hence
\[
\bA'\bA\bV_r=\bV_r\bD^2,
\qquad
\bA\bA'\bU_r=\bU_r\bD^2.
\]
Once either member of a positive singular pair is chosen, the other is
fixed by
\[
\bu_i=\sigma_i^{-1}\bA\bv_i,
\qquad
\bv_i=\sigma_i^{-1}\bA'\bu_i.
\]
\origin{A\&M Ex.~8.39; H Thm.~21.12.3, eqs.~(21.12.10)--(21.12.13)}
\end{corollary}

\begin{proof}
The first identity follows from $\bV_r'\bV_r=\bI_r$.
Transposition gives $\bA'=\bV_r\bD\bU_r'$ and the second identity.
Multiplication by $\bA'$ and $\bA$, respectively, gives the two symmetric
eigenproblems.  Taking column $i$ in the first two identities gives the
pairing formulas.
\end{proof}

\subsection{The four fundamental subspaces}\label{sec:11.1.2}

\begin{theorem}[Four subspaces from one SVD]\label{thm:11-four-subspaces}
Let $\bA=\bU_r\bD\bV_r'$ have rank $r$, with
$\bU=(\bU_r,\bU_0)$ and $\bV=(\bV_r,\bV_0)$.  Then
\[
\begin{array}{c@{\qquad}c}
\col(\bA)=\col(\bU_r),&\nul(\bA')=\col(\bU_0),\\[2mm]
\row(\bA)=\col(\bV_r),&\nul(\bA)=\col(\bV_0).
\end{array}
\]
Thus $\bU$ and $\bV$ give orthonormal bases for all four fundamental
subspaces.  Empty-column matrices represent the zero subspace.
\origin{H Ex.~21.28; S Thm.~11.4, eqs.~(11.4)--(11.5)}
\end{theorem}

\begin{proof}
From $\bA=\bU_r\bD\bV_r'$,
\[
\col(\bA)\subseteq\col(\bU_r),
\qquad
\bA\bV_r\bD^{-1}=\bU_r,
\]
so $\col(\bA)=\col(\bU_r)$.  Similarly,
$\row(\bA)=\col(\bV_r)$.  For $\bx\in\Real^n$,
\[
\bA\bx=\bzero
\iff \bD\bV_r'\bx=\bzero
\iff \bV_r'\bx=\bzero
\iff \bx\in\col(\bV_0).
\]
Applying the same argument to $\bA'=\bV_r\bD\bU_r'$ gives
$\nul(\bA')=\col(\bU_0)$.
\end{proof}

\begin{example}[A differencing matrix]\label{ex:11-difference-svd}
For
\[
\bA=
\begin{pmatrix}
1&-1&0\\
0&1&-1
\end{pmatrix},
\]
set
\[
\begin{array}{c@{\qquad}c}
\bu_1=2^{-1/2}(1,-1)',&
\bv_1=6^{-1/2}(1,-2,1)',\\
\bu_2=2^{-1/2}(1,1)',&
\bv_2=2^{-1/2}(1,0,-1)',\\
&\bv_0=3^{-1/2}(1,1,1)'.
\end{array}
\]
Direct multiplication gives
\[
\bA\bv_1=\sqrt3\,\bu_1,
\qquad
\bA\bv_2=\bu_2,
\qquad
\bA\bv_0=\bzero,
\]
and therefore
\[
\bA=\sqrt3\,\bu_1\bv_1'+\bu_2\bv_2',
\qquad
\nul(\bA)=\spn(\bv_0).
\]
\origin{Course formulation}
\end{example}

\subsection{Partial isometries and positive-semidefinite factors}
\label{sec:11.1.3}

\begin{definition}[Partial isometry]\label{def:11-partial-isometry}
A matrix $\bW\in\Real^{m\times n}$ is a \emph{partial isometry} with
initial space $\calS\subseteq\Real^n$ and final space
$\calT\subseteq\Real^m$ if
\[
\bW\bx=\bzero\quad(\bx\in\calS^\perp),
\qquad
(\bW\bx)'(\bW\by)=\bx'\by\quad(\bx,\by\in\calS),
\qquad
\bW\calS=\calT.
\]
\origin{Course formulation from H Ex.~21.27}
\end{definition}

\begin{definition}[Canonical rectangular polar decompositions]
\label{def:11-polar}
For $\bA\in\Real^{m\times n}$, a pair $(\bW,\bH)$ is its \emph{canonical
right polar decomposition} if
\[
\bA=\bW\bH,
\qquad
\bH=(\bA'\bA)^{1/2},
\]
and $\bW$ is a partial isometry with initial space $\row(\bA)$ and final
space $\col(\bA)$.  A pair $(\bK,\bW)$ is its \emph{canonical left polar
decomposition} if
\[
\bA=\bK\bW,
\qquad
\bK=(\bA\bA')^{1/2},
\]
with the same requirements on $\bW$.
\origin{Course formulation from A\&M Ex.~8.40; H Thm.~21.12.3; S Thm.~10.1}
\end{definition}

\begin{theorem}[Canonical rectangular polar decomposition]
\label{thm:11-polar}
Let $\bA=\bU_r\bD\bV_r'$ and define
\[
\bW=\bU_r\bV_r',
\qquad
\bH=\bV_r\bD\bV_r',
\qquad
\bK=\bU_r\bD\bU_r'.
\]
Then
\[
\bH=(\bA'\bA)^{1/2},
\qquad
\bK=(\bA\bA')^{1/2},
\qquad
\bA=\bW\bH=\bK\bW.
\]
Thus $(\bW,\bH)$ and $(\bK,\bW)$ are the canonical right and left polar
decompositions of $\bA$.  The matrix $\bW$ is the unique partial isometry
with initial space $\row(\bA)$, final space $\col(\bA)$, and
$\bA=\bW\bH$.  Moreover,
\[
\bW'\bW=\bV_r\bV_r',
\qquad
\bW\bW'=\bU_r\bU_r'.
\]
If $\bA$ has full column rank, $\bW'\bW=\bI_n$; only when $m=n=r$ is
$\bW$ orthogonal.
\origin{Adapted from A\&M Ex.~8.40; H Thm.~21.12.3; S Thm.~10.1}
\end{theorem}

\begin{proof}
The paired singular-vector equations give
\[
\bA'\bA=\bV_r\bD^2\bV_r',
\qquad
\bA\bA'=\bU_r\bD^2\bU_r'.
\]
Both $\bH$ and $\bK$ are positive semidefinite and square to the displayed
matrices; uniqueness of the positive semidefinite square root identifies
them.  Also,
\[
\bW\bH
=\bU_r\bV_r'\bV_r\bD\bV_r'
=\bA,
\qquad
\bK\bW
=\bU_r\bD\bU_r'\bU_r\bV_r'
=\bA.
\]
For $\bx=\bV_r\bc\in\row(\bA)$ and
$\by=\bV_r\bd\in\row(\bA)$,
\[
(\bW\bx)'(\bW\by)
=(\bU_r\bc)'(\bU_r\bd)
=\bc'\bd
=\bx'\by.
\]
Moreover, $\bW\bV_0=\bO$ and
$\bW\row(\bA)=\col(\bU_r)=\col(\bA)$, so $\bW$ has the stated partial
isometry.  If $\bZ$ has the same properties and $\bA=\bZ\bH$, then
\[
\sigma_i\bZ\bv_i
=\bZ\bH\bv_i
=\bA\bv_i
=\sigma_i\bu_i
\quad(1\leqslant i\leqslant r),
\qquad
\bZ\bV_0=\bO.
\]
Thus $\bZ\bV=\bW\bV$ and $\bZ=\bW$.  Finally,
\[
\bW'\bW=\bV_r\bV_r',
\qquad
\bW\bW'=\bU_r\bU_r'.
\]
The rank statements give the last assertions.
\end{proof}

% \periodmark{End of period 1 of 3.}

\newpage

%=============================================================================
\section{Norms, approximation, and rank thresholds}\label{sec:11.2}
%=============================================================================

\subsection{Spectral and Frobenius norms}\label{sec:11.2.1}

\begin{definition}[Two matrix norms]\label{def:11-matrix-norms}
For $\bA=(a_{ij})\in\Real^{m\times n}$, define
\[
\norm{\bA}_2
=\max_{\norm{\bx}=1}\norm{\bA\bx},
\qquad
\norm{\bA}_F
=\left(\sum_{i=1}^m\sum_{j=1}^n a_{ij}^2\right)^{1/2}
=\{\tr(\bA'\bA)\}^{1/2}.
\]
The first is the \emph{spectral norm}; the second is the
\emph{Frobenius norm}.
\origin{H eqs.~(6.1.5) and (6.1.9); S Def.~7.4 and \S7.1.4}
\end{definition}

\begin{theorem}[Norms from singular values]\label{thm:11-svd-norms}
Let $\bA\in\Real^{m\times n}$ have singular values
$\sigma_1\geqslant\cdots\geqslant\sigma_q\geqslant0$.  Then
\[
\norm{\bA}_2=\sigma_1,
\qquad
\norm{\bA}_F=\left(\sum_{i=1}^q\sigma_i^2\right)^{1/2}.
\]
If $\bP$ and $\bQ$ are conformable orthogonal matrices, then
\[
\norm{\bP\bA\bQ}_2=\norm{\bA}_2,
\qquad
\norm{\bP\bA\bQ}_F=\norm{\bA}_F.
\]
For conformable $\bA,\bB$,
\[
\norm{\bA\bB}_2\leqslant\norm{\bA}_2\norm{\bB}_2,
\qquad
\norm{\bA\bB}_F\leqslant
\min\{\norm{\bA}_2\norm{\bB}_F,
       \norm{\bA}_F\norm{\bB}_2\}.
\]
\origin{H Lemma~8.4.2 and eq.~(21.12.14); S \S7.1.4}
\end{theorem}

\begin{proof}
Write $\bx=\sum_{i=1}^n c_i\bv_i$ with $\sum_i c_i^2=1$.  Then
\[
\norm{\bA\bx}^2
=\sum_{i=1}^q\sigma_i^2c_i^2
\leqslant\sigma_1^2,
\qquad
\norm{\bA\bv_1}=\sigma_1.
\]
Thus $\norm{\bA}_2=\sigma_1$.  Cyclicity of trace gives
\[
\norm{\bA}_F^2
=\tr(\bV\bSig'\bSig\bV')
=\tr(\bSig'\bSig)
=\sum_{i=1}^q\sigma_i^2.
\]
If $\bA=\bU\bSig\bV'$, then
\[
\bP\bA\bQ=(\bP\bU)\bSig(\bQ'\bV)',
\]
an SVD with the same singular values.  This proves both invariances.
The definition of the spectral norm gives
\[
\norm{\bA\bB\bx}
\leqslant\norm{\bA}_2\norm{\bB\bx}
\leqslant\norm{\bA}_2\norm{\bB}_2\norm{\bx}.
\]
If $\bb_1,\ldots,\bb_s$ are the columns of $\bB$, then
\[
\norm{\bA\bB}_F^2
=\sum_{j=1}^s\norm{\bA\bb_j}^2
\leqslant\norm{\bA}_2^2\sum_{j=1}^s\norm{\bb_j}^2
=\norm{\bA}_2^2\norm{\bB}_F^2.
\]
Apply this inequality to $\bB'\bA'$ and use
$\norm{\bC'}_2=\norm{\bC}_2$ and
$\norm{\bC'}_F=\norm{\bC}_F$, which follow from the transposed SVD.
\end{proof}

\begin{corollary}[Rank-one norms]\label{cor:11-rank-one-norms}
For $\ba\in\Real^m$ and $\bb\in\Real^n$,
\[
\norm{\ba\bb'}_2=\norm{\ba\bb'}_F=\norm{\ba}\norm{\bb}.
\]
\origin{Course formulation from H Eq.~(6.1.9)}
\end{corollary}

\begin{proof}
The assertion is zero if either vector is zero.  Otherwise,
\[
\ba\bb'
=\frac{\ba}{\norm{\ba}}
 (\norm{\ba}\norm{\bb})
 \frac{\bb'}{\norm{\bb}}
\]
is a compact SVD with one singular value.
\end{proof}

\begin{definition}[Symmetric dilation]\label{def:11-symmetric-dilation}
For $\bM\in\Real^{m\times n}$, its \emph{symmetric dilation} is
\[
\calD(\bM)=
\begin{pmatrix}
\bO&\bM\\
\bM'&\bO
\end{pmatrix}
\in\Real^{(m+n)\times(m+n)}.
\]
\origin{Course formulation from S Thm.~6.3 and Prop.~6.2}
\end{definition}

\subsection{Eckart--Young--Mirsky approximation}\label{sec:11.2.2}

\begin{definition}[Truncated SVD]\label{def:11-truncated-svd}
For an SVD $\bA=\sum_{i=1}^q\sigma_i\bu_i\bv_i'$ and
$0\leqslant k\leqslant q$, define
\[
\bA_k=\sum_{i=1}^k\sigma_i\bu_i\bv_i',
\qquad
\bA_0=\bO,
\qquad
\sigma_{q+1}=0.
\]
Then $\rank(\bA_k)\leqslant k$ and $\bA_q=\bA$.
\origin{H \S21.12(c), preceding Thm.~21.12.4; MC \S15}
\end{definition}

\begin{theorem}[Eckart--Young--Mirsky]\label{thm:11-eym}
For $0\leqslant k\leqslant q$,
\[
\min_{\rank(\bB)\leqslant k}\norm{\bA-\bB}_2
=\norm{\bA-\bA_k}_2
=\sigma_{k+1},
\]
and
\[
\min_{\rank(\bB)\leqslant k}\norm{\bA-\bB}_F
=\norm{\bA-\bA_k}_F
=\left(\sum_{i=k+1}^q\sigma_i^2\right)^{1/2}.
\]
The sum is zero when $k=q$.
\origin{Course formulation from H Thm.~21.12.4; MC \S15}
\end{theorem}

\begin{proof}
For $k=q$, $\bA_q=\bA$ and both minima equal
$0=\sigma_{q+1}$.  Let $k<q$ and
$\rank(\bB)\leqslant k$.  Since
\[
\dim\spn(\bv_1,\ldots,\bv_{k+1})=k+1,
\qquad
\dim\nul(\bB)\geqslant n-k,
\]
the two subspaces have a common unit vector
$\bx=\sum_{i=1}^{k+1}c_i\bv_i$.  Hence
\[
\norm{\bA-\bB}_2^2
\geqslant\norm{(\bA-\bB)\bx}^2
=\norm{\bA\bx}^2
=\sum_{i=1}^{k+1}\sigma_i^2c_i^2
\geqslant\sigma_{k+1}^2.
\]

For $k\geqslant1$, choose $\bC\in\Real^{m\times k}$ with
$\bC'\bC=\bI_k$ and $\col(\bB)\subseteq\col(\bC)$.  Then
$\bB=\bC\bL$ for $\bL=\bC'\bB$, and
\[
\bC'(\bI-\bC\bC')=\bO.
\]
Therefore
\[
\begin{aligned}
\norm{\bA-\bC\bL}_F^2
&=\norm{(\bI-\bC\bC')\bA}_F^2
  +\norm{\bC'\bA-\bL}_F^2\\
&\geqslant\norm{\bA}_F^2-\tr(\bC'\bA\bA'\bC).
\end{aligned}
\]
The Ky Fan trace principle, applied to $\bA\bA'$, gives
\[
\tr(\bC'\bA\bA'\bC)\leqslant\sum_{i=1}^k\sigma_i^2.
\]
Thus
\[
\norm{\bA-\bB}_F^2\geqslant\sum_{i=k+1}^q\sigma_i^2.
\]
For $k=0$ the same inequality is
$\norm{\bA}_F^2=\sum_i\sigma_i^2$.
Finally, $\bA-\bA_k$ has singular values
$\sigma_{k+1},\ldots,\sigma_q$ and zeros, so $\bA_k$ attains both bounds.
\end{proof}

\subsection{Condition ratios and numerical rank}\label{sec:11.2.3}

\begin{definition}[Condition ratio and condition number]
\label{def:11-condition-rank}
For a nonzero matrix $\bA$ of rank $r$, define its nonzero singular-value
ratio by
\[
\gamma_2(\bA)=\frac{\sigma_1}{\sigma_r}.
\]
Only for a square nonsingular matrix is the \emph{spectral-norm condition
number} defined here:
\[
\kappa_2(\bA)=\norm{\bA}_2\norm{\bA^{-1}}_2.
\]
\origin{Course formulation from S \S7.1.4 and p.~200}
\end{definition}

\begin{definition}[Numerical rank at a threshold]
\label{def:11-numerical-rank}
For $\bA\in\Real^{m\times n}$, set $q=\min(m,n)$.  For an absolute
threshold $\tau\geqslant0$, define
\[
\rank_\tau(\bA)=\#\{i\in\{1,\ldots,q\}:\sigma_i>\tau\}.
\]
For $\bA\ne\bO$, a relative threshold $\varepsilon\geqslant0$ means
$\tau=\varepsilon\sigma_1$.
\origin{Course formulation}
\end{definition}

\begin{theorem}[Condition identities and right-hand-side sensitivity]
\label{thm:11-condition-identities}
If $\bA\in\Real^{n\times n}$ is nonsingular, then
\[
\kappa_2(\bA)=\gamma_2(\bA)=\frac{\sigma_1}{\sigma_n}.
\]
For $\bA\bx=\bb\ne\bzero$ and
$\bA\,\delta\bx=\delta\bb$,
\[
\frac{\norm{\delta\bx}}{\norm{\bx}}
\leqslant
\kappa_2(\bA)
\frac{\norm{\delta\bb}}{\norm{\bb}},
\]
and equality is attainable.  If a rectangular $\bA$ has full column rank,
then
\[
\kappa_2(\bA'\bA)=\gamma_2(\bA)^2;
\]
if it has full row rank, then
\[
\kappa_2(\bA\bA')=\gamma_2(\bA)^2.
\]
\origin{Course formulation from S \S7.1.4 and p.~200}
\end{theorem}

\begin{proof}
The transposed SVD gives
\[
\bA^{-1}=\bV\diag(\sigma_1^{-1},\ldots,\sigma_n^{-1})\bU',
\qquad
\norm{\bA^{-1}}_2=\sigma_n^{-1}.
\]
Moreover,
\[
\norm{\delta\bx}
\leqslant\norm{\bA^{-1}}_2\norm{\delta\bb},
\qquad
\norm{\bb}=\norm{\bA\bx}
\leqslant\norm{\bA}_2\norm{\bx}.
\]
Multiplication gives the bound.  With
\[
\bx=\bv_1,
\qquad
\delta\bb=t\bu_n\quad(t\ne0),
\]
one has $\bb=\sigma_1\bu_1$ and
$\delta\bx=t\sigma_n^{-1}\bv_n$, so equality holds.  For full column
rank, the eigenvalues of $\bA'\bA$ are
$\sigma_1^2,\ldots,\sigma_n^2$; the first identity follows.  The full-row
case follows from the nonzero eigenvalues of $\bA\bA'$.
\end{proof}

\begin{theorem}[Distance to lower rank]
\label{thm:11-rank-distance}
If $\bA\ne\bO$ has rank $r$, then
\[
\min_{\rank(\bB)<r}\norm{\bA-\bB}_2=\sigma_r,
\qquad
\frac{\sigma_r}{\norm{\bA}_2}=\frac{1}{\gamma_2(\bA)}.
\]
For every $\tau\geqslant0$,
\[
\rank_\tau(\bA)
=\min\{k\in\{0,\ldots,q\}:\norm{\bA-\bA_k}_2\leqslant\tau\}.
\]
\origin{Course formulation from H Thm.~21.12.4}
\end{theorem}

\begin{proof}
Set $k=r-1$ in Theorem~\ref{thm:11-eym}; then
$\sigma_{k+1}=\sigma_r$.  Division by
$\norm{\bA}_2=\sigma_1$ gives the relative identity.  Also,
\[
\norm{\bA-\bA_k}_2=\sigma_{k+1}\leqslant\tau
\iff
\#\{i:\sigma_i>\tau\}\leqslant k.
\]
The least such $k$ is $\rank_\tau(\bA)$.
\end{proof}

% \periodmark{End of period 2 of 3.}

\newpage

%=============================================================================
\section{Moore--Penrose inverse and coefficient penalties}
\label{sec:11.3}
%=============================================================================

\subsection{The four Penrose equations}\label{sec:11.3.1}

\begin{definition}[Moore--Penrose inverse]\label{def:11-mp}
For $\bA\in\Real^{m\times n}$, a matrix
$\bG\in\Real^{n\times m}$ is a \emph{Moore--Penrose inverse} of $\bA$ if
\[
\bA\bG\bA=\bA,
\qquad
\bG\bA\bG=\bG,
\qquad
(\bA\bG)'=\bA\bG,
\qquad
(\bG\bA)'=\bG\bA.
\]
These are the four \emph{Penrose equations}.
\origin{A\&M \S10.3, p.~185; H Thm.~20.1.1; S Thm.~11.5}
\end{definition}

\begin{theorem}[Existence, uniqueness, and SVD formula]\label{thm:11-mp}
Every real matrix has exactly one Moore--Penrose inverse.  For
\[
\bA=\bU_r\bD\bV_r',
\]
it is
\[
\bA^+=\bV_r\bD^{-1}\bU_r'.
\]
For $\bA=\bO$, this is the conformable null matrix.
\origin{A\&M Exs.~10.23--10.24; H Thm.~20.1.1 and \S21.12(b); S Thm.~11.5}
\end{theorem}

\begin{proof}
Let $\bG_0=\bV_r\bD^{-1}\bU_r'$.  Then
\[
\bA\bG_0=\bU_r\bU_r',
\qquad
\bG_0\bA=\bV_r\bV_r',
\]
so both products are symmetric.  Moreover,
\[
\bA\bG_0\bA=\bA,
\qquad
\bG_0\bA\bG_0=\bG_0.
\]
Thus $\bG_0$ satisfies all four equations.

For uniqueness, let $\bG$ satisfy them.  If $r=0$, then
$\bG=\bG\bA\bG=\bO$.  Suppose $r\geqslant1$, use a full SVD
$\bA=\bU\bSig\bV'$, and set $\bY=\bV'\bG\bU$.  Partition
\[
\bSig=
\begin{pmatrix}\bD&\bO\\\bO&\bO\end{pmatrix},
\qquad
\bY=
\begin{pmatrix}
\bY_{11}&\bY_{12}\\
\bY_{21}&\bY_{22}
\end{pmatrix},
\]
where $\bY_{11}\in\Real^{r\times r}$.  Orthogonal multiplication
transforms the Penrose equations into
\[
\bSig\bY\bSig=\bSig,
\quad
\bY\bSig\bY=\bY,
\quad
(\bSig\bY)'=\bSig\bY,
\quad
(\bY\bSig)'=\bY\bSig.
\]
The last two equations give
\[
\bD\bY_{12}=\bO,
\qquad
\bY_{21}\bD=\bO,
\]
hence $\bY_{12}=\bO$ and $\bY_{21}=\bO$.  The first equation gives
\[
\bD\bY_{11}\bD=\bD
\quad\Longrightarrow\quad
\bY_{11}=\bD^{-1}.
\]
The second then gives $\bY_{22}=\bO$.  Therefore
\[
\bG=\bV\bY\bU'=\bV_r\bD^{-1}\bU_r'=\bG_0.
\]
\end{proof}

\begin{corollary}[The two canonical projectors]\label{cor:11-mp-projectors}
For every $\bA\in\Real^{m\times n}$,
\[
\bA\bA^+=\bU_r\bU_r',
\qquad
\bA^+\bA=\bV_r\bV_r'.
\]
Thus $\bA\bA^+$ is the orthogonal projector onto $\col(\bA)$ and
$\bA^+\bA$ is the orthogonal projector onto $\row(\bA)$.  Also,
\[
\bI_m-\bA\bA^+\text{ projects onto }\nul(\bA'),
\qquad
\bI_n-\bA^+\bA\text{ projects onto }\nul(\bA).
\]
\origin{A\&M Ex.~10.26; H Thm.~20.5.1 and Cor.~20.5.2; S \S11.5, text following Prop.~11.5}
\end{corollary}

\begin{proof}
The SVD formula gives the first two identities.  The four-subspace theorem
identifies their column spaces.  Since
\[
\bI_m=\bU_r\bU_r'+\bU_0\bU_0',
\qquad
\bI_n=\bV_r\bV_r'+\bV_0\bV_0',
\]
the complementary-projector assertions follow.
\end{proof}

\begin{corollary}[Full-rank formulas]\label{cor:11-mp-full-rank}
If $\bA$ is square and nonsingular, $\bA^+=\bA^{-1}$.  If $\bA$ has
full column rank, then
\[
\bA^+=(\bA'\bA)^{-1}\bA'.
\]
\tcbbreak
If $\bA$ has full row rank, then
\[
\bA^+=\bA'(\bA\bA')^{-1}.
\]
\origin{A\&M Ex.~10.31; H Eqs.~(20.2.1)--(20.2.2); S Thm.~11.5 and p.~177}
\end{corollary}

\begin{proof}
For full column rank, $r=n$, $\bV_r=\bV$, and
\[
(\bA'\bA)^{-1}\bA'
=(\bV\bD^2\bV')^{-1}\bV\bD\bU_r'
=\bV\bD^{-1}\bU_r'
=\bA^+.
\]
The full-row formula follows by transposition.  In the square nonsingular
case either formula satisfies both inverse equations.
\end{proof}

\subsection{Minimum-norm least squares}\label{sec:11.3.2}

\begin{theorem}[All least-squares solutions and the shortest one]
\label{thm:11-minnorm-ls}
Let $\bA\in\Real^{m\times n}$ and $\bb\in\Real^m$.  The complete set of
minimisers of $\norm{\bb-\bA\bx}$ is
\[
\left\{
\bA^+\bb+(\bI_n-\bA^+\bA)\bz:
\bz\in\Real^n
\right\}.
\]
Every minimiser has fitted vector and residual
\[
\widehat{\bb}=\bA\bA^+\bb,
\qquad
\br=(\bI_m-\bA\bA^+)\bb.
\]
Among the minimisers, $\bA^+\bb$ is the unique vector of minimum norm.
\origin{A\&M Exs.~10.46--10.47; H Thm.~20.6.1; S Prop.~11.6}
\end{theorem}

\begin{proof}
Set $\bP=\bA\bA^+$.  Since $(\bI_m-\bP)\bb\in\nul(\bA')$ and
$\bP\bb-\bA\bx\in\col(\bA)$,
\[
\norm{\bb-\bA\bx}^2
=\norm{(\bI_m-\bP)\bb}^2
 +\norm{\bP\bb-\bA\bx}^2.
\]
Thus $\bx$ minimises the residual norm exactly when
\[
\bA\bx=\bP\bb=\bA\bA^+\bb.
\]
For every $\bz$,
\[
\bA\{\bA^+\bb+(\bI_n-\bA^+\bA)\bz\}
=\bP\bb.
\]
Conversely, $\bA\bx=\bP\bb$ implies
$\bx-\bA^+\bb\in\nul(\bA)$, and every $\bw\in\nul(\bA)$ satisfies
\[
\bw=(\bI_n-\bA^+\bA)\bw.
\]
This proves the parametrisation.  Finally,
\[
\bA^+\bb\in\row(\bA),
\qquad
(\bI_n-\bA^+\bA)\bz\in\nul(\bA),
\]
so
\[
\norm{\bA^+\bb+(\bI_n-\bA^+\bA)\bz}^2
=\norm{\bA^+\bb}^2
 +\norm{(\bI_n-\bA^+\bA)\bz}^2.
\]
Equality with the first term forces the null-space component to vanish.
\end{proof}

\subsection{Centered data and coefficient penalties}\label{sec:11.3.3}

\begin{theorem}[SVD coordinates of centered data]
\label{thm:11-centered-svd}
Let $\bX\in\Real^{m\times p}$, $m\geqslant2$, and
\[
\bC=\bI_m-\frac1m\bone\bone',
\qquad
\bZ=\bC\bX.
\]
For a compact SVD $\bZ=\bU_r\bD\bV_r'$,
\[
\frac1{m-1}\bZ'\bZ
=\bV_r\frac{\bD^2}{m-1}\bV_r',
\qquad
\bZ\bV_r=\bU_r\bD,
\qquad
\bone'\bU_r=\bzero'.
\]
Thus the right singular vectors are sample principal-component loading
directions, the score columns are $\bU_r\bD$, and their sample variances
are $\sigma_i^2/(m-1)$.  For $0\leqslant k\leqslant r$, with the empty sum
interpreted as $\bO$,
\[
\bZ_k=\sum_{i=1}^k\sigma_i\bu_i\bv_i',
\qquad
\norm{\bZ-\bZ_k}_F^2=\sum_{i=k+1}^r\sigma_i^2.
\]
\origin{Course formulation from H Thm.~21.12.3 and Eq.~(21.12.14)}
\end{theorem}

\begin{proof}
The first two identities follow by multiplying the compact SVD.  Since
$\bone'\bC=\bzero'$, one has
\[
\bzero'=\bone'\bZ\bV_r
=\bone'\bU_r\bD
\quad\Longrightarrow\quad
\bone'\bU_r=\bzero'.
\]
The sample-variance identities follow from the diagonal entries of
$\bD^2/(m-1)$.  The last identity is the Frobenius part of
Theorem~\ref{thm:11-eym}.
\end{proof}

\begin{definition}[Ridge criterion and estimator]\label{def:11-ridge}
For $\bX\in\Real^{m\times p}$, $\by\in\Real^m$, and $\lambda>0$, the function
$f_\lambda(\bb)=\norm{\by-\bX\bb}^2+\lambda\norm{\bb}^2$ is the
\emph{ridge criterion}; any minimiser is a \emph{ridge estimator}.
\origin{Course formulation from H Thm.~20.7.1}
\end{definition}

\begin{theorem}[Ridge as a singular-value filter]\label{thm:11-ridge}
Let $\bX\in\Real^{m\times p}$ have compact SVD
$\bX=\bU_r\bD\bV_r'$, let $\by\in\Real^m$, and let $\lambda>0$.
The ridge criterion in Definition~\ref{def:11-ridge} has the unique minimiser
\[
\widehat\bb_\lambda
=(\bX'\bX+\lambda\bI_p)^{-1}\bX'\by
=\sum_{i=1}^r
\frac{\sigma_i}{\sigma_i^2+\lambda}\,
\bv_i\bu_i'\by.
\]
Its fitted vector is
\[
\bX\widehat\bb_\lambda
=\sum_{i=1}^r
\frac{\sigma_i^2}{\sigma_i^2+\lambda}\,
\bu_i\bu_i'\by.
\]
As $\lambda\downarrow0$,
\[
\widehat\bb_\lambda\longrightarrow\bX^+\by,
\qquad
\bX\widehat\bb_\lambda\longrightarrow\bX\bX^+\by.
\]
Empty sums are zero when $\bX=\bO$.
\origin{Course formulation from H Thm.~20.7.1}
\end{theorem}

\begin{proof}
The matrix
$\bM=\bX'\bX+\lambda\bI_p$ is positive definite.  Set
$\widehat\bb_\lambda=\bM^{-1}\bX'\by$.  For
$\bd=\bb-\widehat\bb_\lambda$,
\[
f_\lambda(\bb)-f_\lambda(\widehat\bb_\lambda)
=\bd'\bM\bd,
\]
which is positive for $\bd\ne\bzero$.  This proves existence and
uniqueness without differentiation.

Complete $\bV_r$ to $\bV=(\bV_r,\bV_0)$.  Then
\[
\bM
=\bV_r(\bD^2+\lambda\bI_r)\bV_r'
 +\lambda\bV_0\bV_0',
\qquad
\bX'\by=\bV_r\bD\bU_r'\by.
\]
Multiplication by $\bM^{-1}$ gives the coefficient formula; multiplication
by $\bX$ gives the fitted formula.  Finally,
\[
\frac{\sigma_i}{\sigma_i^2+\lambda}\longrightarrow\frac1{\sigma_i},
\qquad
\frac{\sigma_i^2}{\sigma_i^2+\lambda}\longrightarrow1,
\]
which gives the two limits from the SVD formulas for $\bX^+$ and
$\bX\bX^+$.
\end{proof}

%=============================================================================
\section{Computation: Numerical Checks in R}\label{sec:11.4}
%=============================================================================

\subsection{SVD, four subspaces, and polar factors (§\ref{sec:11.1})}
\label{sec:11.4.1}

<<svd-polar>>=
A <- rbind(c(1, -1, 0), c(0, 1, -1))
s <- svd(A, nu = nrow(A), nv = ncol(A))
tol <- 1e-12
r <- sum(s$d > tol)
Ur <- s$u[, 1:r, drop = FALSE]
Vr <- s$v[, 1:r, drop = FALSE]
D <- diag(s$d[1:r], r, r)
H <- Vr %*% D %*% t(Vr)
K <- Ur %*% D %*% t(Ur)
W <- Ur %*% t(Vr)
c(singular_values = s$d,
  svd_reconstruction = norm(A - Ur %*% D %*% t(Vr), "F"),
  right_polar = norm(A - W %*% H, "F"),
  left_polar = norm(A - K %*% W, "F"),
  initial_projector = norm(t(W) %*% W - Vr %*% t(Vr), "F"),
  final_projector = norm(W %*% t(W) - Ur %*% t(Ur), "F"),
  null_residual = norm(A %*% s$v[, (r + 1):ncol(A), drop = FALSE], "F"))
@

The numerical rank uses the singular-value threshold $10^{-12}$.

\subsection{Norms and rank-one approximation (§\ref{sec:11.2.2})}
\label{sec:11.4.2}

<<norms-eym>>=
A1 <- s$d[1] * outer(s$u[, 1], s$v[, 1])
B <- outer(c(1, 0), c(1, 0, 0))
rbind(
  formula = c(spectral = s$d[2],
              frobenius = sqrt(sum(s$d[2:length(s$d)]^2))),
  truncated = c(spectral = norm(A - A1, "2"),
                frobenius = norm(A - A1, "F")),
  other_rank_one = c(spectral = norm(A - B, "2"),
                     frobenius = norm(A - B, "F")))
@

\subsection{Condition ratios and numerical rank (§\ref{sec:11.2.3})}
\label{sec:11.4.3}

<<condition-rank>>=
C <- diag(c(1, 1e-4, 1e-7))
dc <- svd(C)$d
C2 <- diag(c(1, 1e-4, 0))
c(condition_formula = dc[1] / dc[3],
  condition_package = kappa(C, exact = TRUE),
  gram_formula = (dc[1] / dc[3])^2,
  gram_package = kappa(crossprod(C), exact = TRUE),
  rank_tol_1e_6 = sum(dc > 1e-6),
  rank_tol_1e_8 = sum(dc > 1e-8),
  rank_loss_distance = norm(C - C2, "2"))
@

Here \texttt{kappa(..., exact = TRUE)} uses the singular values; the two
displayed numerical ranks use the stated absolute thresholds.

\subsection{Pseudoinverse and minimum-norm fit (§\ref{sec:11.3.2})}
\label{sec:11.4.4}

<<pseudoinverse-minimum-norm>>=
X <- rbind(c(1, 0, 1), c(0, 1, 1), c(1, 1, 2), c(2, -1, 1))
y <- c(1, 2, 0, 3)
sx <- svd(X)
manual_cutoff <- 1e-12
ginv_relative_tol <- 1e-12
ginv_cutoff <- ginv_relative_tol * sx$d[1]
rx <- sum(sx$d > manual_cutoff)
Xp <- sx$v[, 1:rx, drop = FALSE] %*%
  diag(1 / sx$d[1:rx], rx, rx) %*%
  t(sx$u[, 1:rx, drop = FALSE])
Xp_package <- MASS::ginv(X, tol = ginv_relative_tol)
c(manual_cutoff = manual_cutoff,
  ginv_cutoff = ginv_cutoff,
  manual_rank = rx,
  ginv_rank = sum(sx$d > ginv_cutoff),
  package_difference = norm(Xp - Xp_package, "F"),
  penrose_1 = norm(X %*% Xp %*% X - X, "F"),
  penrose_2 = norm(Xp %*% X %*% Xp - Xp, "F"),
  symmetry_left = norm(t(X %*% Xp) - X %*% Xp, "F"),
  symmetry_right = norm(t(Xp %*% X) - Xp %*% X, "F"))
xp <- drop(Xp %*% y)
xa <- xp + c(1, 1, -1)
rbind(
  minimum_norm = c(residual = sqrt(sum((y - X %*% xp)^2)),
                   coefficient = sqrt(sum(xp^2))),
  other_minimizer = c(residual = sqrt(sum((y - X %*% xa)^2)),
                      coefficient = sqrt(sum(xa^2))))
@

The manual SVD retains $d_i>10^{-12}$.  The call to
\texttt{MASS::ginv} uses the relative tolerance $10^{-12}$ and retains
$d_i>10^{-12}d_1$; the output gives both absolute cutoffs and ranks.

\subsection{Centered coordinates and ridge (§\ref{sec:11.3.3})}
\label{sec:11.4.5}

<<centered-ridge>>=
Xraw <- rbind(c(1, 2, 0), c(2, 0, 1), c(3, 1, 4),
              c(4, 3, 2), c(5, 2, 5))
Z <- scale(Xraw, center = TRUE, scale = FALSE)
sz <- svd(Z)
svd_cutoff <- 1e-12
rz <- sum(sz$d > svd_cutoff)
Uz <- sz$u[, 1:rz, drop = FALSE]
Vz <- sz$v[, 1:rz, drop = FALSE]
Dz <- diag(sz$d[1:rz], rz, rz)
S <- crossprod(Z) / (nrow(Z) - 1)
c(covariance_svd =
    norm(S - Vz %*% (Dz %*% Dz / (nrow(Z) - 1)) %*% t(Vz), "F"),
  score_identity = norm(Z %*% Vz - Uz %*% Dz, "F"),
  score_means = sqrt(sum(colSums(Uz %*% Dz)^2)))
y <- c(1, -1, 2, 0, 3)
lambdas <- c(0.1, 1, 10)
direct <- sapply(lambdas, function(lambda)
  solve(crossprod(Z) + lambda * diag(ncol(Z)), crossprod(Z, y)))
via_svd <- sapply(lambdas, function(lambda)
  drop(Vz %*%
    diag(sz$d[1:rz] / (sz$d[1:rz]^2 + lambda), rz, rz) %*%
    crossprod(Uz, y)))
ginv_relative_tol <- sqrt(.Machine$double.eps)
ginv_cutoff <- ginv_relative_tol * sz$d[1]
Zp <- MASS::ginv(Z, tol = ginv_relative_tol)
c(max_coefficient_difference = max(abs(direct - via_svd)),
  small_lambda_to_pseudoinverse =
    norm(matrix(solve(crossprod(Z) + 1e-8 * diag(ncol(Z)),
                      crossprod(Z, y)) - Zp %*% y,
                ncol = 1), "F"),
  ginv_relative_tol = ginv_relative_tol,
  ginv_cutoff = ginv_cutoff)
sapply(lambdas, function(lambda)
  sz$d[1:rz]^2 / (sz$d[1:rz]^2 + lambda))
@

The manual SVD rank uses the absolute threshold $10^{-12}$.
The default \texttt{MASS::ginv} relative tolerance is
$\sqrt{\texttt{.Machine\$double.eps}}$; equivalently, it retains
$d_i>\sqrt{\texttt{.Machine\$double.eps}}\,d_1$.  The output gives this
relative tolerance and its absolute cutoff.  The last matrix contains the
fitted-value filter factors $\sigma_i^2/(\sigma_i^2+\lambda)$.

%=============================================================================
\newpage
\section{Pitfalls}\label{sec:11.5}
%=============================================================================

\subsection{Solving two eigenproblems independently}\label{sec:11.5.1}

Positive singular vectors must satisfy
\[
\bA\bv_i=\sigma_i\bu_i,
\qquad
\bA'\bu_i=\sigma_i\bv_i.
\]
Independent eigensolvers may choose incompatible signs and, within a repeated
eigenspace, incompatible orthogonal rotations.  Compute one side and obtain
the other from the pairing equation.

\subsection{Calling a rectangular polar factor orthogonal}\label{sec:11.5.2}

For $\bW\in\Real^{m\times n}$ in the canonical polar decomposition,
\[
\bW'\bW=\bP_{\row(\bA)},
\qquad
\bW\bW'=\bP_{\col(\bA)}.
\]
Both products equal identity matrices only when $m=n=\rank(\bA)$.

\subsection{Calling singular values eigenvalues}\label{sec:11.5.3}

For
\[
\bA=\begin{pmatrix}0&1\\0&0\end{pmatrix},
\qquad
\operatorname{spec}(\bA)=\{0,0\},
\qquad
\operatorname{spec}(\bA'\bA)=\{1,0\}.
\]
Thus the singular values are $1,0$.  If $\bA=\bA'$ instead, then
$\bA'\bA=\bA^2$, so its singular values are the absolute values of its
eigenvalues, reordered decreasingly.

\subsection{Squaring a condition ratio outside its domain}\label{sec:11.5.4}

The identity
\[
\kappa_2(\bX'\bX)=\gamma_2(\bX)^2
\]
requires full column rank.  If $\bX$ is column-rank deficient, then
$\bX'\bX$ is singular and $\kappa_2(\bX'\bX)$ is not defined here.

\subsection{Reporting numerical rank without a scale}\label{sec:11.5.5}

For $c\ne0$,
\[
\rank_\tau(c\bA)=\rank_{\tau/|c|}(\bA).
\]
An absolute threshold is scale dependent; a relative threshold
$\tau=\varepsilon\sigma_1$ is invariant under nonzero scalar rescaling.

\subsection{Treating the pseudoinverse as identification}\label{sec:11.5.6}

If $\bX=(\bx,\bx)$, fitted vectors depend on $\beta_1+\beta_2$ only.  Among
all pairs with $\beta_1+\beta_2=s$,
\[
\beta_1^2+\beta_2^2
=\frac{s^2}{2}+\frac{(\beta_1-\beta_2)^2}{2}
\]
is minimised at $\beta_1=\beta_2=s/2$.  The pseudoinverse makes this
minimum-norm choice; the separate coefficients remain unidentified by the
fit.

\newpage

%=============================================================================
\section{Exercises}\label{sec:11.6}
%=============================================================================

\Needspace{.38\textheight}
\begin{exercise}[Rank-one structure]\label{ex:11-rank-one}
Let $\bzero\ne\ba\in\Real^m$, $\bzero\ne\bb\in\Real^n$, and
$\bA=\ba\bb'$.  Find a compact SVD of $\bA$, compute $\bA^+$, and
identify $\bA\bA^+$ and $\bA^+\bA$.
\origin{A\&M Ex.~10.33; S Ex.~11.9}
\end{exercise}

\begin{solution}
Set
\[
\bu=\frac{\ba}{\norm{\ba}},
\qquad
\bv=\frac{\bb}{\norm{\bb}},
\qquad
\sigma=\norm{\ba}\norm{\bb}.
\]
Then
\[
\bA=\bu\sigma\bv',
\qquad
\bA^+=\bv\sigma^{-1}\bu'
=\frac{\bb\ba'}{(\ba'\ba)(\bb'\bb)}.
\]
Consequently,
\[
\bA\bA^+=\frac{\ba\ba'}{\ba'\ba},
\qquad
\bA^+\bA=\frac{\bb\bb'}{\bb'\bb},
\]
the orthogonal projectors onto $\spn(\ba)$ and $\spn(\bb)$.
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[SVD of a symmetric matrix]\label{ex:11-symmetric-svd}
Let
\[
\bA=\bQ\diag(\lambda_1,\ldots,\lambda_n)\bQ',
\qquad
|\lambda_1|\geqslant\cdots\geqslant|\lambda_n|,
\]
be a spectral decomposition of a real symmetric matrix.  Construct an SVD
of $\bA$ and derive its Moore--Penrose inverse.
\origin{A\&M Ex.~10.35; H \S21.12(a)--(b), eqs.~(21.12.14)--(21.12.15)}
\end{exercise}

\begin{solution}
Define
\[
\delta_i=\begin{cases}1,&\lambda_i\geqslant0,\\-1,&\lambda_i<0,\end{cases}
\qquad
\bDelta=\diag(\delta_1,\ldots,\delta_n),
\qquad
\bSig=\diag(|\lambda_1|,\ldots,|\lambda_n|).
\]
Then $\bQ\bDelta$ and $\bQ$ are orthogonal and
\[
\bA=(\bQ\bDelta)\bSig\bQ'.
\]
Thus the singular values are the ordered $|\lambda_i|$.  With
\[
\lambda_i^+=\begin{cases}\lambda_i^{-1},&\lambda_i\ne0,\\0,&\lambda_i=0,
\end{cases}
\]
the SVD formula gives
\[
\bA^+=\bQ\diag(\lambda_1^+,\ldots,\lambda_n^+)\bQ'.
\]
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Transpose and involution]\label{ex:11-mp-transpose}
Prove
\[
(\bA')^+=(\bA^+)',
\qquad
(\bA^+)^+=\bA.
\]
Identify the nonzero singular values of $\bA^+$.
\origin{A\&M Ex.~10.25(a)--(b); H Thm.~20.5.3(1),(4) and \S21.12(b)}
\end{exercise}

\begin{solution}
If $\bA=\bU_r\bD\bV_r'$, then
\[
\bA'=\bV_r\bD\bU_r',
\qquad
(\bA')^+=\bU_r\bD^{-1}\bV_r'=(\bA^+)',
\]
and
\[
\bA^+=\bV_r\bD^{-1}\bU_r'
\quad\Longrightarrow\quad
(\bA^+)^+=\bU_r\bD\bV_r'=\bA.
\]
The nonzero singular values of $\bA^+$ are
$\sigma_1^{-1},\ldots,\sigma_r^{-1}$; decreasing order reverses this list.
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Characterising partial isometries]
\label{ex:11-partial-characterizations}
For $\bW\in\Real^{m\times n}$, prove that the following are equivalent:
\begin{enumerate}[(a)]
\item $\bW$ is a partial isometry with initial space $\row(\bW)$ and
      final space $\col(\bW)$;
\item $\bW'\bW$ is an orthogonal projector;
\item every singular value of $\bW$ is $0$ or $1$;
\item $\bW^+=\bW'$.
\end{enumerate}
Include $\bW=\bO$.
\origin{Adapted from H Ex.~20.2}
\end{exercise}

\begin{solution}
Let $\bW=\bU_r\bD\bV_r'$.  For
$\bx=\bV_r\bc\in\row(\bW)$,
\[
\norm{\bW\bx}^2=\bc'\bD^2\bc,
\qquad
\norm{\bx}^2=\bc'\bc.
\]
Moreover,
\[
\bW\col(\bV_0)=\{\bzero\},
\qquad
\bW\row(\bW)=\col(\bW).
\]
Hence (a) holds exactly when $\bD^2=\bI_r$.  Also,
\[
\bW'\bW=\bV_r\bD^2\bV_r',
\qquad
(\bW'\bW)^2=\bV_r\bD^4\bV_r',
\]
so (b) is equivalent to $\sigma_i^4=\sigma_i^2$, hence to (c).  Finally,
\[
\bW^+=\bV_r\bD^{-1}\bU_r',
\qquad
\bW'=\bV_r\bD\bU_r',
\]
so (c) is equivalent to (d).  For $r=0$, all four assertions hold with
initial and final spaces $\{\bzero\}$.
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Nearest orthogonal matrix]\label{ex:11-nearest-orthogonal}
Let $\bA\in\Real^{n\times n}$ have a full SVD
$\bA=\bU\bSig\bV'$.  Prove that
\[
\bQ_*=\bU\bV'
\]
minimises $\norm{\bA-\bQ}_F$ over all orthogonal $\bQ$, with
\[
\min_{\bQ'\bQ=\bI_n}\norm{\bA-\bQ}_F^2
=\sum_{i=1}^n(\sigma_i-1)^2.
\]
Prove uniqueness when $\bA$ is nonsingular.
\origin{S Ex.~10.4}
\end{exercise}

\begin{solution}
For orthogonal $\bQ$, set $\bR=\bU'\bQ\bV$.  Orthogonal invariance gives
\[
\begin{aligned}
\norm{\bA-\bQ}_F^2
&=\norm{\bSig-\bR}_F^2\\
&=\sum_{i=1}^n\sigma_i^2+n-2\sum_{i=1}^n\sigma_i r_{ii}\\
&\geqslant\sum_{i=1}^n\sigma_i^2+n-2\sum_{i=1}^n\sigma_i
=\sum_{i=1}^n(\sigma_i-1)^2,
\end{aligned}
\]
because $r_{ii}\leqslant1$.  The choice $\bR=\bI_n$, equivalently
$\bQ=\bU\bV'$, attains the bound.  If every $\sigma_i>0$, equality forces
$r_{ii}=1$ for every $i$.  The unit norm of each row of $\bR$ then forces
all off-diagonal entries to vanish, so $\bR=\bI_n$.
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[A rank-loss certificate]\label{ex:11-rank-loss}
Let $\bA\ne\bO$ have rank $r$ and compact SVD
$\sum_{i=1}^r\sigma_i\bu_i\bv_i'$.  Construct a matrix of rank $r-1$ at
spectral distance $\sigma_r$ from $\bA$.  Prove that
\[
\norm{\bE}_2<\sigma_r
\quad\Longrightarrow\quad
\rank(\bA+\bE)\geqslant r.
\]
\origin{Course formulation from H Thm.~21.12.4}
\end{exercise}

\begin{solution}
Set
\[
\bB=\sum_{i=1}^{r-1}\sigma_i\bu_i\bv_i'.
\]
Then $\rank(\bB)=r-1$ and
$\norm{\bA-\bB}_2=\sigma_r$.  Theorem~\ref{thm:11-rank-distance}
shows that no lower-rank matrix is closer.  If $\rank(\bA+\bE)<r$, then
\[
\sigma_r
\leqslant\norm{\bA-(\bA+\bE)}_2
=\norm{\bE}_2,
\]
contradicting the strict inequality.
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Symmetric dilation and singular-value perturbation]
\label{ex:11-symmetric-dilation}
For $\bA\in\Real^{m\times n}$, set $q=\min(m,n)$.  Show that the eigenvalues
of the symmetric dilation $\calD(\bA)$ from
Definition~\ref{def:11-symmetric-dilation}, in decreasing order, consist of
\[
\sigma_1(\bA),\ldots,\sigma_q(\bA),
\quad |m-n|\text{ additional zeros},\quad
-\sigma_q(\bA),\ldots,-\sigma_1(\bA).
\]
Deduce, for $\bA,\bB\in\Real^{m\times n}$ and $1\leqslant i\leqslant q$, that
\[
|\sigma_i(\bA)-\sigma_i(\bB)|\leqslant\norm{\bA-\bB}_2.
\]
\origin{Course formulation from S Thm.~6.3 and Prop.~6.2}
\end{exercise}

\begin{solution}
Take a full SVD $\bA=\bU\bSig\bV'$.  For $1\leqslant i\leqslant q$,
\[
\bA\bv_i=\sigma_i\bu_i,
\qquad
\bA'\bu_i=\sigma_i\bv_i.
\]
Hence
\[
\calD(\bA)\frac1{\sqrt2}
\begin{pmatrix}\bu_i\\ \bv_i\end{pmatrix}
=\sigma_i\frac1{\sqrt2}
\begin{pmatrix}\bu_i\\ \bv_i\end{pmatrix},
\qquad
\calD(\bA)\frac1{\sqrt2}
\begin{pmatrix}\bu_i\\-\bv_i\end{pmatrix}
=-\sigma_i\frac1{\sqrt2}
\begin{pmatrix}\bu_i\\-\bv_i\end{pmatrix}.
\]
These $2q$ vectors are orthonormal, including when $\sigma_i=0$.  If
$m>n$, then
\[
\begin{pmatrix}\bu_j\\\bzero\end{pmatrix},
\qquad n<j\leqslant m,
\]
are $m-n$ further zero-eigenvectors because
$\bu_j\in\nul(\bA')$.  If $n>m$, then
\[
\begin{pmatrix}\bzero\\\bv_j\end{pmatrix},
\qquad m<j\leqslant n,
\]
are $n-m$ further zero-eigenvectors because
$\bv_j\in\nul(\bA)$.  In each case the displayed vectors form an
orthonormal basis of $\Real^{m+n}$.  Hence the spectral list holds,
including $\bA=\bO$.  In particular,
\[
\norm{\calD(\bA)-\calD(\bB)}_2
=\norm{\calD(\bA-\bB)}_2
=\sigma_1(\bA-\bB)
=\norm{\bA-\bB}_2.
\]
The first $q$ ordered eigenvalues of $\calD(\bA)$ are
$\sigma_i(\bA)$.  The earlier Weyl perturbation bound for symmetric matrices
states that, for $\bM=\bM'$ and $\bN=\bN'$ of the same order,
\[
|\lambda_i(\bM)-\lambda_i(\bN)|
\leqslant\norm{\bM-\bN}_2.
\]
Since $\calD(\bA)$ and $\calD(\bB)$ are symmetric of order $m+n$,
\[
|\sigma_i(\bA)-\sigma_i(\bB)|
\leqslant\norm{\calD(\bA)-\calD(\bB)}_2
=\norm{\bA-\bB}_2.
\]
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Block-diagonal pseudoinverse]\label{ex:11-block-mp}
For arbitrary real matrices $\bA$ and $\bB$, prove
\[
\begin{pmatrix}\bA&\bO\\\bO&\bB\end{pmatrix}^{+}
=
\begin{pmatrix}\bA^+&\bO\\\bO&\bB^+\end{pmatrix}.
\]
\origin{A\&M Ex.~10.34}
\end{exercise}

\begin{solution}
Let $\bM=\diag(\bA,\bB)$ and
$\bG=\diag(\bA^+,\bB^+)$.  Block multiplication gives
\[
\bM\bG\bM=\diag(\bA\bA^+\bA,\bB\bB^+\bB)=\bM,
\]
\[
\bG\bM\bG=\diag(\bA^+\bA\bA^+,\bB^+\bB\bB^+)=\bG.
\]
Also $\bM\bG$ and $\bG\bM$ are block diagonal with symmetric diagonal
blocks.  Hence $\bG$ satisfies the four Penrose equations and equals
$\bM^+$.
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Failure and recovery of the reverse-order law]
\label{ex:11-reverse-order}
\begin{enumerate}[(a)]
\item Give exact pseudoinverses showing that
$(\bA\bB)^+=\bB^+\bA^+$ need not hold, using
\[
\bA=\begin{pmatrix}1&1\\1&1\end{pmatrix},
\qquad
\bB=\begin{pmatrix}1&1\\1&0\end{pmatrix}.
\]
\item Let $\bA\in\Real^{m\times r}$ have full column rank and
$\bB\in\Real^{r\times n}$ have full row rank.  Prove
\[
(\bA\bB)^+=\bB^+\bA^+.
\]
\end{enumerate}
\origin{A\&M Ex.~10.36(b); H Ex.~20.1; S Prop.~11.5 and p.~177}
\end{exercise}

\begin{solution}
For part (a), the rank-one formula and the inverse of $\bB$ give
\[
(\bA\bB)^+
=\frac1{10}\begin{pmatrix}2&2\\1&1\end{pmatrix},
\qquad
\bA^+=\frac14\begin{pmatrix}1&1\\1&1\end{pmatrix},
\qquad
\bB^+=\bB^{-1}=\begin{pmatrix}0&1\\1&-1\end{pmatrix}.
\]
Hence
\[
\bB^+\bA^+
=\frac14\begin{pmatrix}1&1\\0&0\end{pmatrix}
\ne(\bA\bB)^+.
\]

For part (b), set $\bG=\bB^+\bA^+$.  The rank assumptions give
\[
\bA^+\bA=\bI_r,
\qquad
\bB\bB^+=\bI_r.
\]
Therefore
\[
\bA\bB\bG=\bA\bA^+,
\qquad
\bG\bA\bB=\bB^+\bB,
\]
which are symmetric, and
\[
(\bA\bB)\bG(\bA\bB)=\bA\bB,
\qquad
\bG(\bA\bB)\bG=\bG.
\]
Thus $\bG$ satisfies the Penrose equations for $\bA\bB$.
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Consistent systems]\label{ex:11-consistent-system}
For $\bA\in\Real^{m\times n}$ and $\bb\in\Real^m$, prove
\[
\bA\bx=\bb\text{ is consistent}
\iff
\bA\bA^+\bb=\bb.
\]
When it is consistent, prove that all solutions are
\[
\bx=\bA^+\bb+(\bI_n-\bA^+\bA)\bz,
\qquad \bz\in\Real^n,
\]
and identify the unique minimum-norm solution.
\origin{A\&M Exs.~10.45--10.46; S Prop.~11.6}
\end{exercise}

\begin{solution}
If $\bb=\bA\bx$, then
\[
\bA\bA^+\bb=\bA\bA^+\bA\bx=\bA\bx=\bb.
\]
Conversely, $\bA\bA^+\bb=\bb$ makes $\bA^+\bb$ a solution.  Under this
condition, exact solutions are precisely the least-squares solutions in
Theorem~\ref{thm:11-minnorm-ls}, giving the displayed parametrisation.
The same theorem gives the unique minimum-norm solution $\bA^+\bb$.
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[The equation \texorpdfstring{$\bA\bX\bB=\bC$}{AXB=C}]
\label{ex:11-two-sided-equation}
Let
\[
\bA\in\Real^{m\times n},
\qquad
\bB\in\Real^{p\times q},
\qquad
\bC\in\Real^{m\times q}.
\]
Prove that $\bA\bX\bB=\bC$, with
$\bX\in\Real^{n\times p}$, is consistent if and only if
\[
\bA\bA^+\bC\bB^+\bB=\bC.
\]
When it is consistent, prove that all solutions are
\[
\bX
=\bA^+\bC\bB^+
 +\bZ-\bA^+\bA\bZ\bB\bB^+,
\qquad
\bZ\in\Real^{n\times p}.
\]
\origin{A\&M Ex.~10.49; S Ex.~11.13}
\end{exercise}

\begin{solution}
If $\bC=\bA\bX\bB$, then
\[
\bA\bA^+\bC\bB^+\bB
=\bA\bA^+\bA\bX\bB\bB^+\bB
=\bA\bX\bB
=\bC.
\]
Conversely, the displayed condition gives
\[
\bA(\bA^+\bC\bB^+)\bB
=\bA\bA^+\bC\bB^+\bB
=\bC.
\]
Under this condition, for every $\bZ\in\Real^{n\times p}$,
\[
\begin{aligned}
\bA\{\bA^+\bC\bB^+
 +\bZ-\bA^+\bA\bZ\bB\bB^+\}\bB
&=\bC+\bA\bZ\bB-\bA\bZ\bB\\
&=\bC.
\end{aligned}
\]
If $\bA\bX\bB=\bC$, choosing $\bZ=\bX$ gives
\[
\bA^+\bC\bB^++\bX-\bA^+\bA\bX\bB\bB^+
=\bX.
\]
Hence the displayed family is exact.
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Equal Moore--Penrose projectors]
\label{ex:11-equal-mp-projectors}
For $\bA\in\Real^{n\times n}$, prove
\[
\bA\bA^+=\bA^+\bA
\iff
\col(\bA)=\row(\bA).
\]
Deduce the equality when $\bA=\bA'$.  Give a nonsymmetric singular
matrix for which the equality also holds.
\origin{A\&M Ex.~10.37; H Ex.~20.8}
\end{exercise}

\begin{solution}
The two matrices are the orthogonal projectors onto $\col(\bA)$ and
$\row(\bA)$, respectively.  Orthogonal projectors are equal exactly when
their ranges are equal; hence
\[
\bA\bA^+=\bA^+\bA
\iff
\col(\bA)=\row(\bA).
\]
If $\bA=\bA'$, then
\[
\row(\bA)=\col(\bA')=\col(\bA).
\]
The converse fails.  For
\[
\bA=
\begin{pmatrix}
1&1&0\\
0&1&0\\
0&0&0
\end{pmatrix},
\qquad
\bA^+=
\begin{pmatrix}
1&-1&0\\
0& 1&0\\
0& 0&0
\end{pmatrix},
\]
Corollary~\ref{cor:11-mp-full-rank} and
Exercise~\ref{ex:11-block-mp} give
\[
\bA\bA^+=\bA^+\bA=\diag(1,1,0),
\qquad
\bA\ne\bA'.
\]
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Orthogonal sums of matrices]\label{ex:11-orthogonal-sum}
Let $\bA,\bB\in\Real^{m\times n}$ satisfy
\[
\bA'\bB=\bO,
\qquad
\bA\bB'=\bO.
\]
Prove
\[
(\bA+\bB)^+=\bA^++\bB^+.
\]
\origin{H Ex.~20.6}
\end{exercise}

\begin{solution}
Take compact SVDs
\[
\bA=\bU_A\bD_A\bV_A',
\qquad
\bB=\bU_B\bD_B\bV_B'.
\]
Empty blocks are omitted when either matrix is zero.  The two hypotheses
state, respectively, that the column spaces and row spaces are orthogonal.
Thus
\[
\bU_A'\bU_B=\bO,
\qquad
\bV_A'\bV_B=\bO.
\]
Consequently,
\[
\bA+\bB
=(\bU_A,\bU_B)
\begin{pmatrix}\bD_A&\bO\\\bO&\bD_B\end{pmatrix}
(\bV_A,\bV_B)'
\]
is a compact SVD up to reordering its positive diagonal entries.  Taking
reciprocals gives
\[
(\bA+\bB)^+
=\bV_A\bD_A^{-1}\bU_A'
 +\bV_B\bD_B^{-1}\bU_B'
=\bA^++\bB^+.
\]
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Order reversal for singular pseudoinverses]
\label{ex:11-singular-inverse-order}
Let $\bA,\bB\in\Real^{n\times n}$ be symmetric and satisfy
\[
\bO\psdle\bA\psdle\bB.
\]
Prove
\[
\bA^+-\bB^+\psdge\bO
\iff
\rank(\bA)=\rank(\bB).
\]
\origin{H Ex.~20.13}
\end{exercise}

\begin{solution}
Exercise~\ref{ex:11-symmetric-svd} gives, for
$\bM=\bM'\psdge\bO$,
\[
\bM^+\psdge\bO,
\qquad
\nul(\bM^+)=\nul(\bM).
\]
If $\bx\in\nul(\bB)$, then
\[
0\leqslant\bx'\bA\bx\leqslant\bx'\bB\bx=0
\quad\Longrightarrow\quad
\bA\bx=\bzero.
\]
Thus $\nul(\bB)\subseteq\nul(\bA)$.

Suppose $\bA^+-\bB^+\psdge\bO$.  For
$\bx\in\nul(\bA)$,
\[
0
\leqslant\bx'(\bA^+-\bB^+)\bx
=-\bx'\bB^+\bx
\leqslant0,
\]
so $\bB^+\bx=\bzero$ and
$\bx\in\nul(\bB)$.  Hence
\[
\nul(\bA)=\nul(\bB)
\quad\Longrightarrow\quad
\rank(\bA)=\rank(\bB).
\]

Conversely, suppose both ranks equal $r$.  The null-space inclusion and
rank--nullity give
\[
\nul(\bA)=\nul(\bB)=\calN.
\]
If $r=0$, then $\bA=\bB=\bO$ and the conclusion holds.  Let $r\geqslant1$, let
$\bQ_r$ have orthonormal columns spanning $\calN^\perp$, and set
\[
\bA_r=\bQ_r'\bA\bQ_r,
\qquad
\bB_r=\bQ_r'\bB\bQ_r.
\]
For $\bzero\ne\bc\in\Real^r$, the positive-semidefinite null criterion
gives
\[
\bc'\bA_r\bc=0
\Longrightarrow
\bA\bQ_r\bc=\bzero
\Longrightarrow
\bQ_r\bc\in\calN,
\]
which contradicts $\bQ_r\bc\in\calN^\perp\setminus\{\bzero\}$.  Thus,
with $\bP=\bQ_r\bQ_r'$,
\[
\bM(\bI_n-\bP)=\bO=(\bI_n-\bP)\bM
\quad(\bM=\bA,\bB),
\qquad
\bM=\bP\bM\bP.
\]
Congruence now gives
\[
\bO\psdlt\bA_r\psdle\bB_r,
\qquad
\bA=\bQ_r\bA_r\bQ_r',
\qquad
\bB=\bQ_r\bB_r\bQ_r'.
\]
The inverse-order theorem gives
\[
\bA_r^{-1}-\bB_r^{-1}\psdge\bO.
\]
For $\bM=\bA,\bB$, write
$\bM=\bQ_r\bM_r\bQ_r'$ and
$\bG=\bQ_r\bM_r^{-1}\bQ_r'$.  Then
\[
\bM\bG=\bG\bM=\bQ_r\bQ_r',
\qquad
\bM\bG\bM=\bM,
\qquad
\bG\bM\bG=\bG.
\]
The Penrose equations and uniqueness give
\[
\bA^+=\bQ_r\bA_r^{-1}\bQ_r',
\qquad
\bB^+=\bQ_r\bB_r^{-1}\bQ_r',
\]
and therefore
\[
\bA^+-\bB^+
=\bQ_r(\bA_r^{-1}-\bB_r^{-1})\bQ_r'
\psdge\bO.
\]
\end{solution}

\Needspace{.38\textheight}
\begin{exercise}[Ridge as augmented least squares]\label{ex:11-ridge-augmented}
Let $\bX\in\Real^{m\times p}$, $\by\in\Real^m$, and $\lambda>0$.
Define
\[
\widetilde\bX=
\begin{pmatrix}\bX\\\sqrt\lambda\,\bI_p\end{pmatrix},
\qquad
\widetilde\by=
\begin{pmatrix}\by\\\bzero\end{pmatrix}.
\]
Prove that $\widetilde\bX$ has full column rank and that ordinary least
squares for $(\widetilde\bX,\widetilde\by)$ gives
\[
\widehat\bb_\lambda
=(\bX'\bX+\lambda\bI_p)^{-1}\bX'\by.
\]
If $\widehat\bb_0$ is any ordinary least-squares minimiser for
$(\bX,\by)$, prove
\[
\norm{\widehat\bb_\lambda}\leqslant\norm{\widehat\bb_0}.
\]
\origin{Course formulation from H Thm.~20.7.1}
\end{exercise}

\begin{solution}
For $\bb\ne\bzero$,
\[
\norm{\widetilde\bX\bb}^2
=\norm{\bX\bb}^2+\lambda\norm{\bb}^2>0,
\]
so $\widetilde\bX$ has full column rank.  Also,
\[
\norm{\widetilde\by-\widetilde\bX\bb}^2
=\norm{\by-\bX\bb}^2+\lambda\norm{\bb}^2,
\]
and its normal equations are
\[
(\bX'\bX+\lambda\bI_p)\bb=\bX'\by.
\]
Let $R(\bb)=\norm{\by-\bX\bb}^2$ and
$R_0=R(\widehat\bb_0)$.  Ridge optimality and ordinary least-squares
optimality give
\[
R(\widehat\bb_\lambda)+\lambda\norm{\widehat\bb_\lambda}^2
\leqslant
R_0+\lambda\norm{\widehat\bb_0}^2,
\qquad
R(\widehat\bb_\lambda)\geqslant R_0.
\]
Subtracting yields the asserted norm inequality.
\end{solution}

\end{document}
