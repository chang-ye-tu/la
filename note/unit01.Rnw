%==============================================================================
\section{Vectors in \texorpdfstring{$\Real^n$}{R\^{}n}}\label{sec:1.1}
%==============================================================================

\subsection{Vectors, linear combinations, geometry}\label{sec:1.1.1}

\begin{definition}[Real $n$-vector]\label{def:vector}
Let $n$ be a positive integer. A \emph{real $n$-vector} is an ordered list of $n$ real
numbers, written as a column,
\[
\bx = \begin{pmatrix} x_1 \\ x_2 \\ \vdots \\ x_n\end{pmatrix},
\qquad x_i \in \Real .
\]
The number $x_i$ is the \emph{$i$th component} of $\bx$. The set of all real $n$-vectors is
written $\Real^n$. Two vectors are equal when all their components are equal.
\origin{A\&M p.~1}
\end{definition}

\begin{definition}[Addition and scalar multiplication]\label{def:vecops}
For $\bx,\by\in\Real^n$ and $\alpha\in\Real$, define $\bx+\by$ and $\alpha\bx$ componentwise:
\[
(\bx+\by)_i = x_i + y_i, \qquad (\alpha\bx)_i = \alpha x_i , \qquad i=1,\ldots,n .
\]
Write $\bzero$ for the vector with every component $0$, and $-\bx$ for $(-1)\bx$.
\origin{A\&M pp.~1--2}
\end{definition}

\begin{theorem}[Arithmetic of vectors]\label{thm:vecaxioms}
For all $\bx,\by,\bz\in\Real^n$ and all $\alpha,\beta\in\Real$:
\begin{enumerate}[label=\textup{(\roman*)}]
\item $\bx+\by=\by+\bx$;
\item $(\bx+\by)+\bz=\bx+(\by+\bz)$;
\item $\bx+\bzero=\bx$ and $\bx+(-\bx)=\bzero$;
\item $\alpha(\bx+\by)=\alpha\bx+\alpha\by$ and $(\alpha+\beta)\bx=\alpha\bx+\beta\bx$;
\item $(\alpha\beta)\bx=\alpha(\beta\bx)$ and $1\bx=\bx$.
\end{enumerate}
\origin{Course formulation from A\&M Ex.~1.3--1.5}
\end{theorem}

\begin{proof}
For $i=1,\ldots,n$, the field axioms give
\begin{align*}
(\bx+\by)_i&=x_i+y_i=y_i+x_i=(\by+\bx)_i,\\
((\bx+\by)+\bz)_i&=(x_i+y_i)+z_i=x_i+(y_i+z_i)
  =(\bx+(\by+\bz))_i,\\
(\bx+\bzero)_i&=x_i+0=x_i,
& (\bx+(-\bx))_i&=x_i-x_i=0,\\
(\alpha(\bx+\by))_i&=\alpha(x_i+y_i)=\alpha x_i+\alpha y_i
  =(\alpha\bx+\alpha\by)_i,\\
((\alpha+\beta)\bx)_i&=(\alpha+\beta)x_i=\alpha x_i+\beta x_i
  =(\alpha\bx+\beta\bx)_i,\\
((\alpha\beta)\bx)_i&=(\alpha\beta)x_i=\alpha(\beta x_i)
  =(\alpha(\beta\bx))_i,
& (1\bx)_i&=1x_i=x_i.
\end{align*}
Equality in every component gives each vector identity.
\end{proof}

\begin{definition}[Linear combination]\label{def:lincomb}
Given $\bx_1,\ldots,\bx_k\in\Real^n$ and $\alpha_1,\ldots,\alpha_k\in\Real$, the vector
$\sum_{j=1}^{k}\alpha_j\bx_j$ is a \emph{linear combination} of $\bx_1,\ldots,\bx_k$ with
\emph{coefficients} $\alpha_1,\ldots,\alpha_k$.
\origin{S \S1.1.1}
\end{definition}

\begin{definition}[Two standard vectors]\label{def:eu-one}
For $j=1,\ldots,n$, the \emph{$j$th standard coordinate vector} $\eu_j\in\Real^n$ has $j$th
component $1$ and all other components $0$. The vector $\bone\in\Real^n$ has every
component equal to $1$.
\origin{A\&M p.~2}
\end{definition}

\begin{theorem}[Coordinates]\label{thm:coords}
Every $\bx\in\Real^n$ satisfies $\bx=\sum_{j=1}^{n}x_j\eu_j$, and the coefficients in such
a representation are unique: if $\sum_j\alpha_j\eu_j=\sum_j\beta_j\eu_j$ then
$\alpha_j=\beta_j$ for every $j$.
\origin{A\&M Ex.~1.13(b); S \S1.1.1.1}
\end{theorem}

\begin{proof}
For $i=1,\ldots,n$,
\[
\left(\sum_{j=1}^n x_j\eu_j\right)_i
=\sum_{j=1}^n x_j(\eu_j)_i=x_i.
\]
If $\sum_j\alpha_j\eu_j=\sum_j\beta_j\eu_j$, comparison of component $i$ gives
$\alpha_i=\beta_i$.
\end{proof}

\begin{example}[A linear combination]\label{ex:lincomb}
With $\bx=\begin{pmatrix}3\\1\end{pmatrix}$ and $\by=\begin{pmatrix}1\\2\end{pmatrix}$
in $\Real^2$,
\[
2\bx-\by=\begin{pmatrix}6\\2\end{pmatrix}-\begin{pmatrix}1\\2\end{pmatrix}
=\begin{pmatrix}5\\0\end{pmatrix},
\qquad
\bx+\by=\begin{pmatrix}4\\3\end{pmatrix}.
\]
\origin{Course formulation}
\end{example}

