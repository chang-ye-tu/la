%=============================================================================
\section{Quadratic forms and factorisations}\label{sec:9.1}
%=============================================================================

\subsection{Definiteness and congruence}\label{sec:9.1.1}

\begin{definition}[Quadratic form and congruence]\label{def:quadratic-congruence}
For \(\bA\in\Real^{n\times n}\), the function
\[
q_{\bA}(\bx)=\bx'\bA\bx,\qquad \bx\in\Real^n,
\]
is the \emph{quadratic form represented by \(\bA\)}.  Symmetric matrices
\(\bA,\bB\in\Real^{n\times n}\) are \emph{congruent} if
\[
\bB=\bP'\bA\bP
\]
for some nonsingular \(\bP\in\Real^{n\times n}\).  Under the coordinate
change \(\bx=\bP\by\),
\[
q_{\bA}(\bx)=q_{\bP'\bA\bP}(\by).
\]
\origin{H \S14.1; S \S1.3.4}
\end{definition}

\begin{lemma}[The symmetric representative]\label{lem:symmetric-representative}
For every \(\bA\in\Real^{n\times n}\),
\[
q_{\bA}=q_{(\bA+\bA')/2}.
\]
If \(\bS\) and \(\bT\) are symmetric, then
\[
q_{\bS}(\bx)=q_{\bT}(\bx)\quad(\bx\in\Real^n)
\iff \bS=\bT.
\]
\origin{A\&M Exs.~8.1 and 8.3; H Lemma~14.1.1 and Cor.~14.1.3}
\end{lemma}

\begin{proof}
The scalar \(\bx'\bA\bx\) equals its transpose, so
\[
\bx'\bA\bx
=\frac12\{\bx'\bA\bx+\bx'\bA'\bx\}
=\bx'\frac{\bA+\bA'}2\bx.
\]
Let \(\bD=\bS-\bT=(d_{ij})\).  If \(\bx'\bD\bx=0\) for every \(\bx\), then
\[
d_{ii}=\eu_i'\bD\eu_i=0,
\]
and, for \(i\ne j\),
\[
0=(\eu_i+\eu_j)'\bD(\eu_i+\eu_j)
=d_{ii}+2d_{ij}+d_{jj}=2d_{ij}.
\]
Thus \(\bD=\bO\).  If \(\bS=\bT\), their quadratic forms are equal.
\end{proof}

\begin{definition}[Definiteness]\label{def:definiteness}
Let \(\bA=\bA'\in\Real^{n\times n}\).
\[
\begin{array}{rcl}
\bA\psdge\bO&\iff&\bx'\bA\bx\geqslant0\quad(\bx\in\Real^n),\\[2mm]
\bA\psdgt\bO&\iff&\bx'\bA\bx>0\quad(\bzero\ne\bx\in\Real^n).
\end{array}
\]
The first condition is \emph{positive semidefiniteness}; the second is
\emph{positive definiteness}.  The matrix is \emph{indefinite} if its
quadratic form takes both positive and negative values.
\origin{A\&M \S8.1 opening; H \S14.2a; S \S1.3.5}
\end{definition}

\begin{theorem}[Spectral and Gram characterisations]\label{thm:psd-characterisations}
Let \(\bA=\bA'\in\Real^{n\times n}\), with eigenvalues
\(\lambda_1,\ldots,\lambda_n\).  The following are equivalent:
\[
\bA\psdge\bO;
\qquad \lambda_i\geqslant0\ (i=1,\ldots,n);
\qquad \bA=\bG'\bG\text{ for some }\bG\in\Real^{n\times n}.
\]
Under these conditions,
\[
\bx'\bA\bx=0\iff \bA\bx=\bzero,
\qquad
\rank(\bA)=\rank(\bG)
\]
for the spectral Gram factor constructed in the proof.  Moreover,
\[
\bA\psdgt\bO
\iff \lambda_i>0\ (i=1,\ldots,n)
\iff \bA\psdge\bO\text{ and }\bA\text{ is nonsingular}.
\]
\origin{A\&M Exs.~8.10--8.14 and 8.21; H Thm.~14.3.7 and Thm.~21.8.5}
\end{theorem}

\begin{proof}
By the real spectral theorem,
\[
\bA=\bQ\diag(\lambda_1,\ldots,\lambda_n)\bQ',
\qquad \bQ'\bQ=\bI_n.
\]
For \(\by=\bQ'\bx\),
\[
\bx'\bA\bx=\sum_{i=1}^n\lambda_i y_i^2.
\]
This is nonnegative for every \(\by\) exactly when every \(\lambda_i\geqslant0\),
and positive for every \(\by\ne\bzero\) exactly when every \(\lambda_i>0\).
When \(\lambda_i\geqslant0\), set
\[
\bG=\diag(\sqrt{\lambda_1},\ldots,\sqrt{\lambda_n})\bQ'.
\]
Then \(\bG'\bG=\bA\).  Conversely, \(\bA=\bG'\bG\) gives
\(\bx'\bA\bx=\norm{\bG\bx}^2\geqslant0\).  For the displayed \(\bG\),
\[
\bx'\bA\bx=0
\iff \sqrt{\lambda_i}y_i=0\ (i=1,\ldots,n)
\iff \lambda_i y_i=0\ (i=1,\ldots,n)
\iff \bA\bx=\bzero.
\]
Both \(\rank(\bA)\) and \(\rank(\bG)\) equal the number of nonzero
\(\lambda_i\).  Finally, all \(\lambda_i>0\) exactly when they are all
nonnegative and none is zero, which is equivalent to nonsingularity.
\end{proof}

\begin{theorem}[Rectangular congruence transforms]
\label{thm:congruence-definiteness}
Let \(\bA=\bA'\in\Real^{n\times n}\) and
\(\bP\in\Real^{n\times m}\).
\[
\bA\psdge\bO\implies \bP'\bA\bP\psdge\bO.
\]
If \(\bA\psdgt\bO\), then
\[
\bP'\bA\bP\psdgt\bO\iff\rank(\bP)=m.
\]
Consequently, for square nonsingular \(\bP\),
\[
\bP'\bA\bP\psdge\bO\iff\bA\psdge\bO,
\qquad
\bP'\bA\bP\psdgt\bO\iff\bA\psdgt\bO.
\]
\origin{A\&M Exs.~8.26 and 8.28; H Thm.~14.2.9 and Cor.~14.2.10}
\end{theorem}

\begin{proof}
For \(\bx\in\Real^m\),
\[
\bx'\bP'\bA\bP\bx=(\bP\bx)'\bA(\bP\bx).
\]
This proves the semidefinite implication.  If \(\bA\psdgt\bO\), the last
quantity is positive for every \(\bx\ne\bzero\) exactly when
\(\ker(\bP)=\{\bzero\}\), equivalently \(\rank(\bP)=m\).  For square
nonsingular \(\bP\), apply the first implications to \(\bP\) and to
\(\bP^{-1}\), using
\[
\bA=(\bP^{-1})'(\bP'\bA\bP)\bP^{-1}.
\]
\end{proof}

\begin{lemma}[Entry restrictions]\label{lem:psd-entries}
If \(\bA=(a_{ij})=\bA'\psdge\bO\), then
\[
a_{ii}\geqslant0,
\qquad
a_{ij}^2\leqslant a_{ii}a_{jj}.
\]
If \(a_{ii}=0\), then row \(i\) and column \(i\) are zero.
\origin{A\&M Ex.~8.7; H Cor.~14.5.14}
\end{lemma}

\begin{proof}
First, \(a_{ii}=\eu_i'\bA\eu_i\geqslant0\).  Fix \(i\ne j\).  If
\(a_{ii}>0\), then
\[
0\leqslant
\left(-\frac{a_{ij}}{a_{ii}}\eu_i+\eu_j\right)'
\bA
\left(-\frac{a_{ij}}{a_{ii}}\eu_i+\eu_j\right)
=a_{jj}-\frac{a_{ij}^2}{a_{ii}}.
\]
If \(a_{ii}=0\) and \(a_{ij}\ne0\), take
\(t=-(a_{jj}+1)/(2a_{ij})\).  Then
\[
(t\eu_i+\eu_j)'\bA(t\eu_i+\eu_j)
=2a_{ij}t+a_{jj}=-1,
\]
a contradiction.  Thus \(a_{ij}=0\) for every \(j\), and symmetry also gives
the zero column.  The stated inequality then holds in the remaining case.
\end{proof}

\begin{example}[Three signs]\label{ex:three-signs}
For \(\bx=(x,y)'\),
\[
\begin{array}{c|c|c}
\bA&\bx'\bA\bx&\text{classification}\\ \hline
\begin{pmatrix}2&1\\1&2\end{pmatrix}
&(x+y)^2+x^2+y^2&\bA\psdgt\bO\\[3mm]
\begin{pmatrix}1&1\\1&1\end{pmatrix}
&(x+y)^2&\bA\psdge\bO\text{ and singular}\\[3mm]
\begin{pmatrix}1&0\\0&-1\end{pmatrix}
&x^2-y^2&\text{indefinite}.
\end{array}
\]
\origin{Adapted from A\&M Ex.~8.2 and H \S14.2a}
\end{example}

\subsection{Leading principal minors}\label{sec:9.1.2}

\begin{definition}[Principal and leading principal minors]\label{def:principal-minors}
For \(I\subseteq\{1,\ldots,n\}\), the matrix \(\bA[I,I]\) is the
\emph{principal submatrix indexed by \(I\)}, and
\(\det\bA[I,I]\) is its \emph{principal minor}.  For
\(I=\{1,\ldots,k\}\), write
\[
\bA_k=\bA[1{:}k,1{:}k],
\qquad
\Delta_k=\det(\bA_k),
\qquad \Delta_0=1;
\]
these are the \emph{leading} principal submatrices and minors.
\origin{A\&M Exs.~8.30--8.32; H \S14.9c}
\end{definition}

\begin{theorem}[Sylvester's criterion]\label{thm:sylvester}
For \(\bA=\bA'\in\Real^{n\times n}\), \(n\geqslant1\),
\[
\bA\psdgt\bO
\iff
\Delta_k>0\quad(k=1,\ldots,n).
\]
Nonnegativity of the leading principal minors alone does not characterise
positive semidefiniteness.
\origin{A\&M Exs.~8.31--8.33; H Thm.~14.9.5}
\end{theorem}

\begin{proof}
If \(\bA\psdgt\bO\), set \(\bP_k=(\eu_1,\ldots,\eu_k)\).  Then
\[
\bA_k=\bP_k'\bA\bP_k,
\qquad
\rank(\bP_k)=k.
\]
Theorem~\ref{thm:congruence-definiteness} gives
\(\bA_k\psdgt\bO\).  Its eigenvalues are positive, so \(\Delta_k>0\).

Conversely, suppose every \(\Delta_k>0\).  The leading-principal-minor LDU
result gives a unique factorisation
\[
\bA=\bL\bD\bU,
\qquad
\bD=\diag(d_1,\ldots,d_n),
\qquad
d_k=\frac{\Delta_k}{\Delta_{k-1}}>0.
\]
Since \(\bA=\bA'=\bU'\bD\bL'\), uniqueness gives
\(\bU=\bL'\).  For \(\bx\ne\bzero\), \(\bL'\bx\ne\bzero\), and
\[
\bx'\bA\bx=(\bL'\bx)'\bD(\bL'\bx)>0.
\]
The matrix
\[
\begin{pmatrix}0&0&1\\0&-1&0\\1&0&0\end{pmatrix}
\]
has leading principal minors \(0,0,1\), but its quadratic form takes both
signs.
\end{proof}

\subsection{Cholesky factorisations}\label{sec:9.1.3}

\begin{theorem}[Positive definite Cholesky factorisation]\label{thm:chol-pd}
If \(\bA=\bA'\psdgt\bO\), there is a unique lower triangular matrix
\(\bL\) with positive diagonal such that
\[
\bA=\bL\bL'.
\]
Moreover,
\[
\det(\bA)=\left(\prod_{i=1}^n\ell_{ii}\right)^2.
\]
\origin{A\&M Ex.~8.23; H Thm.~14.5.11; S Thm.~11.2}
\end{theorem}

\begin{proof}
The proof of Sylvester's criterion gives
\[
\bA=\bC\bD\bC',
\qquad
\bC\text{ unit lower triangular},
\qquad
\bD=\diag(d_1,\ldots,d_n),\quad d_i>0.
\]
Thus \(\bL=\bC\diag(\sqrt{d_1},\ldots,\sqrt{d_n})\) has the required
properties.  If also \(\bA=\widetilde{\bL}\widetilde{\bL}'\), set
\(\bT=\widetilde{\bL}^{-1}\bL\).  Then \(\bT\) is lower triangular with
positive diagonal and
\[
\bT\bT'=\bI_n,
\qquad
\bT'=\bT^{-1}.
\]
The left side of the second equality is upper triangular and the right side is
lower triangular; hence \(\bT\) is diagonal.  Its positive diagonal entries
satisfy \(t_{ii}^2=1\), so \(\bT=\bI_n\) and
\(\widetilde{\bL}=\bL\).  Taking determinants gives the last identity.
\end{proof}

\begin{theorem}[Semidefinite Cholesky factorisation]\label{thm:chol-psd}
If \(\bA=\bA'\psdge\bO\) has rank \(r\), there is a unique lower triangular
\(\bL=(\ell_{ij})\) such that
\[
\bA=\bL\bL',
\qquad
\ell_{ii}\geqslant0,
\qquad
\ell_{ii}=0\implies \bL\eu_i=\bzero.
\]
Exactly \(r\) diagonal entries are positive.  For \(\bA=\bO\), the factor is
\(\bL=\bO\).
\origin{A\&M Ex.~8.23; H Thm.~14.5.16}
\end{theorem}

\begin{proof}
Induct on \(n\).  For \(n=1\),
\[
\bA=(a_{11}),
\qquad
\bL=(\sqrt{a_{11}}).
\]
For \(n>1\), write
\[
\bA=\begin{pmatrix}a&\br'\\\br&\bB\end{pmatrix}.
\]
If \(a=0\), Lemma~\ref{lem:psd-entries} gives \(\br=\bzero\).  Apply
induction to \(\bB\) and place a zero first row and column in its factor;
\(\rank(\bA)=\rank(\bB)\), so the diagonal count is preserved.

If \(a>0\), set \(c=\sqrt a\), \(\bv=\br/c\), and
\(\bS=\bB-\bv\bv'\).  For every \(\by\), taking
\(t=-\br'\by/a\) gives
\[
\by'\bS\by
=\begin{pmatrix}t\\\by\end{pmatrix}'
\bA
\begin{pmatrix}t\\\by\end{pmatrix}
\geqslant0.
\]
By induction, \(\bS=\bL_*\bL_*'\) with the stated convention.  Then
\[
\bL=\begin{pmatrix}c&\bzero'\\\bv&\bL_*\end{pmatrix},
\qquad
\bL\bL'=\bA.
\]
Also
\[
\bA=
\begin{pmatrix}c&\bzero'\\\bv&\bI\end{pmatrix}
\begin{pmatrix}1&\bzero'\\\bzero&\bS\end{pmatrix}
\begin{pmatrix}c&\bv'\\\bzero&\bI\end{pmatrix},
\]
so \(\rank(\bA)=1+\rank(\bS)\).  Thus the number of positive diagonal
entries equals \(r\).  At each induction step, \(a\) determines \(c\); if
\(c>0\), \(\br\) determines \(\bv\), and if \(c=0\), the null-column
condition determines the first column.  Induction gives uniqueness.
\end{proof}

% \periodmark{End of period 1 of 3.}

%=============================================================================
\section{Square roots and matrix order}\label{sec:9.2}
%=============================================================================

\subsection{The symmetric square root}\label{sec:9.2.1}

\begin{theorem}[Positive semidefinite square root]\label{thm:psd-square-root}
For every \(\bA=\bA'\psdge\bO\), there is a unique symmetric positive
semidefinite matrix \(\bR\) satisfying \(\bR^2=\bA\).  If
\[
\bA=\bQ\diag(\lambda_1,\ldots,\lambda_n)\bQ',
\qquad \lambda_i\geqslant0,
\]
then
\[
\bA^{1/2}:=\bR
=\bQ\diag(\sqrt{\lambda_1},\ldots,\sqrt{\lambda_n})\bQ'.
\]
It is positive definite exactly when \(\bA\) is positive definite.
\origin{A\&M Ex.~8.24; H Thm.~21.9.1; S Thm.~6.1}
\end{theorem}

\begin{proof}
The displayed matrix is symmetric positive semidefinite and its square is
\(\bA\).  Suppose \(\bS=\bS'\psdge\bO\) and \(\bS^2=\bA\).  Then
\[
\bS\bA=\bS^3=\bA\bS.
\]
Commuting symmetric matrices are simultaneously orthogonally diagonalizable.
In a common eigenbasis, \(\bS^2=\bA\) becomes
\[
s_i^2=\lambda_i,
\qquad s_i\geqslant0,
\]
so \(s_i=\sqrt{\lambda_i}\) for every \(i\).  Hence \(\bS=\bR\).
The square root has positive eigenvalues exactly when every
\(\sqrt{\lambda_i}>0\), equivalently every \(\lambda_i>0\).
\end{proof}

\begin{corollary}[Inverse square root]\label{cor:inverse-square-root}
If \(\bA\psdgt\bO\), define
\[
\bA^{-1/2}
=\bQ\diag(\lambda_1^{-1/2},\ldots,\lambda_n^{-1/2})\bQ'.
\]
Then
\[
\bA^{-1/2}=(\bA^{1/2})^{-1}=(\bA^{-1})^{1/2},
\qquad
\bA^{-1/2}\bA\bA^{-1/2}=\bI_n.
\]
\origin{A\&M Ex.~8.25; H Thm.~21.9.1}
\end{corollary}

\begin{proof}
All four matrices are diagonal in the same orthonormal eigenbasis, and their
diagonal entries satisfy
\[
(\sqrt{\lambda_i})^{-1}=\lambda_i^{-1/2}
=\sqrt{\lambda_i^{-1}},
\qquad
\lambda_i^{-1/2}\lambda_i\lambda_i^{-1/2}=1.
\]
\end{proof}

\begin{example}[Cholesky factor versus symmetric square root]
\label{ex:chol-versus-root}
For
\[
\bA=\begin{pmatrix}2&1\\1&2\end{pmatrix},
\]
the lower Cholesky factor and the symmetric square root are
\[
\bL=\begin{pmatrix}\sqrt2&0\\1/\sqrt2&\sqrt{3/2}\end{pmatrix},
\qquad
\bA^{1/2}=\frac12
\begin{pmatrix}\sqrt3+1&\sqrt3-1\\\sqrt3-1&\sqrt3+1\end{pmatrix}.
\]
Thus \(\bL\bL'=\bA=(\bA^{1/2})^2\), but
\(\bL\ne\bA^{1/2}\).
\origin{Course formulation from H Thm.~14.5.11 and Thm.~21.9.1}
\end{example}

\subsection{The Löwner order}\label{sec:9.2.2}

\begin{definition}[Löwner order]\label{def:loewner}
For symmetric \(\bA,\bB\in\Real^{n\times n}\),
\[
\bA\psdge\bB\iff\bA-\bB\psdge\bO,
\qquad
\bA\psdgt\bB\iff\bA-\bB\psdgt\bO.
\]
\origin{A\&M \S8.1 opening; H \S18.3b; S \S5.1.3}
\end{definition}

\begin{theorem}[Order algebra]\label{thm:loewner-order}
The relation \(\psdge\) is reflexive, antisymmetric, and transitive, hence a
partial order on symmetric matrices.  If
\(\bA\psdge\bB\), then, for every conformable \(\bP\),
\[
\bP'\bA\bP\psdge\bP'\bB\bP.
\]
If also \(\bC\psdge\bD\) and \(\alpha\geqslant0\), then
\[
\bA+\bC\psdge\bB+\bD,
\qquad
\alpha\bA\psdge\alpha\bB.
\]
\origin{A\&M \S8.1 opening; H Lemmas~14.2.2--14.2.4 and Thm.~14.2.9}
\end{theorem}

\begin{proof}
Reflexivity follows from \(\bA-\bA=\bO\psdge\bO\).  If
\(\bA\psdge\bB\) and \(\bB\psdge\bA\), then
\[
0\leqslant\bx'(\bA-\bB)\bx\leqslant0
\quad(\bx\in\Real^n),
\]
so \(\bA-\bB=\bO\) by Lemma~\ref{lem:symmetric-representative}.  If
\(\bA\psdge\bB\psdge\bC\), then
\[
\bA-\bC=(\bA-\bB)+(\bB-\bC)\psdge\bO.
\]
For congruence,
\[
\bx'\bP'(\bA-\bB)\bP\bx
=(\bP\bx)'(\bA-\bB)(\bP\bx)\geqslant0.
\]
For addition and nonnegative scaling,
\[
\begin{split}
\bx'\{(\bA+\bC)-(\bB+\bD)\}\bx
&=\bx'(\bA-\bB)\bx+\bx'(\bC-\bD)\bx\geqslant0,\\
\bx'\{\alpha\bA-\alpha\bB\}\bx
&=\alpha\bx'(\bA-\bB)\bx\geqslant0.
\end{split}
\]
\end{proof}

\begin{theorem}[Spectral, rank, trace, and determinant consequences]
\label{thm:order-consequences}
Let \(\bA\psdge\bB\), and arrange their eigenvalues as
\(\lambda_1\geqslant\cdots\geqslant\lambda_n\).
Then
\[
\lambda_k(\bA)\geqslant\lambda_k(\bB),
\qquad k=1,\ldots,n,
\]
and \(\tr(\bA)\geqslant\tr(\bB)\).  If
\(\bA\psdge\bB\psdge\bO\), then
\[
\det(\bA)\geqslant\det(\bB),
\qquad
\ker(\bA)\subseteq\ker(\bB),
\qquad
\rank(\bA)\geqslant\rank(\bB).
\]
\origin{A\&M Ex.~12.8; H Cor.~18.1.8; S Thm.~6.3}
\end{theorem}

\begin{proof}
The Courant--Fischer formula gives
\[
\lambda_k(\bA)
=\min_{\dim\calS=n-k+1}\ \max_{\bzero\ne\bx\in\calS}
\frac{\bx'\bA\bx}{\bx'\bx}
\geqslant
\min_{\dim\calS=n-k+1}\ \max_{\bzero\ne\bx\in\calS}
\frac{\bx'\bB\bx}{\bx'\bx}
=\lambda_k(\bB).
\]
Summing gives the trace inequality.  Under semidefiniteness, every eigenvalue
is nonnegative, so multiplying the componentwise inequalities gives the
determinant inequality.  If \(\bx\in\ker(\bA)\), then
\[
0\leqslant\bx'\bB\bx\leqslant\bx'\bA\bx=0.
\]
The null criterion in Theorem~\ref{thm:psd-characterisations} gives
\(\bB\bx=\bzero\).  Nullity and rank then give the last inequality.
\end{proof}

\begin{theorem}[Inverse reverses order]\label{thm:inverse-order}
If \(\bA\psdge\bB\psdgt\bO\), then
\[
\bB^{-1}\psdge\bA^{-1}.
\]
Equality holds exactly when \(\bA=\bB\); if \(\bA\psdgt\bB\), then
\(\bB^{-1}\psdgt\bA^{-1}\).
\origin{A\&M Ex.~12.16; H Thm.~18.3.4}
\end{theorem}

\begin{proof}
Set \(\bC=\bB^{-1/2}\bA\bB^{-1/2}\).  Then \(\bC\psdge\bI_n\), so
the eigenvalues \(c_i\) of \(\bC\) satisfy \(c_i\geqslant1\).  Hence
\[
\bI_n-\bC^{-1}\psdge\bO,
\qquad
\bB^{-1}-\bA^{-1}
=\bB^{-1/2}(\bI_n-\bC^{-1})\bB^{-1/2}\psdge\bO.
\]
The middle matrix is zero exactly when every \(c_i=1\), equivalently
\(\bC=\bI_n\) and \(\bA=\bB\).  If \(\bA-\bB\psdgt\bO\), then
\(\bC-\bI_n\psdgt\bO\), every \(c_i>1\), and
\(\bI_n-\bC^{-1}\psdgt\bO\).
\end{proof}

\subsection{Generalized eigenvalues}\label{sec:9.2.3}

\begin{definition}[Symmetric generalized eigenproblem]
\label{def:generalized-eigen}
Let \(\bA=\bA'\) and \(\bB=\bB'\psdgt\bO\).  A scalar
\(\lambda\in\Real\) and a vector \(\bzero\ne\bx\in\Real^n\) form a
\emph{generalized eigenpair} of \((\bA,\bB)\) if
\[
\bA\bx=\lambda\bB\bx.
\]
Equivalently, \(\det(\bA-\lambda\bB)=0\).
\origin{H \S21.14, Eqs.~21.14.3 and 21.14.6; A\&M Ex.~8.37}
\end{definition}

\begin{theorem}[Symmetric reduction and generalized Rayleigh quotient]
\label{thm:generalized-reduction}
Let
\[
\bC=\bB^{-1/2}\bA\bB^{-1/2}=\bC'.
\]
The generalized eigenvalues of \((\bA,\bB)\) are the real eigenvalues
\(\lambda_1\geqslant\cdots\geqslant\lambda_n\) of \(\bC\).  There is a
basis \(\bx_1,\ldots,\bx_n\) such that
\[
\bA\bx_i=\lambda_i\bB\bx_i,
\qquad
\bx_i'\bB\bx_j=\begin{cases}1,&i=j,\\0,&i\ne j.\end{cases}
\]
Moreover,
\[
\lambda_n
=\min_{\bx\ne\bzero}\frac{\bx'\bA\bx}{\bx'\bB\bx},
\qquad
\lambda_1
=\max_{\bx\ne\bzero}\frac{\bx'\bA\bx}{\bx'\bB\bx},
\]
and, for every \(t\in\Real\),
\[
\bA\psdge t\bB\iff\lambda_n\geqslant t.
\]
Finally,
\[
\det(\bA-t\bB)=\det(\bB)\det(\bC-t\bI_n).
\]
\origin{A\&M Ex.~8.37; H \S21.14, Eqs.~21.14.1--21.14.7; S Prop.~6.1}
\end{theorem}

\begin{proof}
Choose an orthonormal eigenbasis \(\bu_i\) of \(\bC\), and set
\(\bx_i=\bB^{-1/2}\bu_i\).  Multiplication of
\(\bC\bu_i=\lambda_i\bu_i\) by \(\bB^{1/2}\) gives
\[
\bA\bx_i=\lambda_i\bB\bx_i,
\qquad
\bx_i'\bB\bx_j=\bu_i'\bu_j.
\]
Since \(\bB^{-1/2}\) is nonsingular, the \(\bx_i\) form a basis.  With
\(\by=\bB^{1/2}\bx\),
\[
\frac{\bx'\bA\bx}{\bx'\bB\bx}
=\frac{\by'\bC\by}{\by'\by};
\]
the two extrema are the Rayleigh extrema of \(\bC\).  Also
\[
\bB^{-1/2}(\bA-t\bB)\bB^{-1/2}=\bC-t\bI_n,
\]
so congruence and the spectral characterisation give the order equivalence.
The factorisation
\[
\bA-t\bB=\bB^{1/2}(\bC-t\bI_n)\bB^{1/2}
\]
gives the determinant identity.
\end{proof}

% \periodmark{End of period 2 of 3.}

\newpage

%=============================================================================
\section{Block covariance structure}\label{sec:9.3}
%=============================================================================

\subsection{Block definiteness}\label{sec:9.3.1}

\begin{theorem}[Schur-complement criterion]\label{thm:block-definiteness}
Let
\[
\bM=\begin{pmatrix}\bA&\bB\\\bB'&\bC\end{pmatrix},
\qquad
\bA=\bA'\psdgt\bO,
\qquad
\bC=\bC',
\]
and set \(\bS=\bC-\bB'\bA^{-1}\bB\).  Then
\[
\bM\psdge\bO\iff\bS\psdge\bO,
\qquad
\bM\psdgt\bO\iff\bS\psdgt\bO.
\]
More generally, for every symmetric \(\bW\) conformable with \(\bC\),
\[
\bM-\begin{pmatrix}\bO&\bO\\\bO&\bW\end{pmatrix}\psdge\bO
\iff \bS\psdge\bW.
\]
\origin{H Cor.~14.8.6; S Ex.~11.6}
\end{theorem}

\begin{proof}
The block factorisation is
\[
\bM=
\underbrace{\begin{pmatrix}\bI&\bO\\\bB'\bA^{-1}&\bI\end{pmatrix}}_{\bP}
\begin{pmatrix}\bA&\bO\\\bO&\bS\end{pmatrix}
\underbrace{\begin{pmatrix}\bI&\bA^{-1}\bB\\\bO&\bI\end{pmatrix}}_{\bP'}.
\]
The matrix \(\bP\) is nonsingular.  Congruence preserves definiteness, and
\[
\begin{pmatrix}\bx\\\by\end{pmatrix}'
\begin{pmatrix}\bA&\bO\\\bO&\bS\end{pmatrix}
\begin{pmatrix}\bx\\\by\end{pmatrix}
=\bx'\bA\bx+\by'\bS\by.
\]
This proves both equivalences.  Replacing \(\bC\) by \(\bC-\bW\) replaces
\(\bS\) by \(\bS-\bW\), proving the last assertion.
\end{proof}

\subsection{Expectation and covariance transformations}\label{sec:9.3.2}

\begin{definition}[Expectation and covariance]\label{def:expectation-covariance}
On a real vector space \(\calL\) of real random variables, an
\emph{expectation} is a positive linear map \(\expc:\calL\to\Real\)
with \(\expc[1]=1\): whenever the displayed variables belong to
\(\calL\),
\[
\expc[aU+bV]=a\expc[U]+b\expc[V],
\qquad
U\geqslant0\implies\expc[U]\geqslant0.
\]
For random vectors \(\bX\in\Real^p\) and \(\bY\in\Real^q\), with all
displayed expectations finite, define
\[
\bmu_{\bX}=\expc[\bX]
:=(\expc[X_1],\ldots,\expc[X_p])',
\qquad
\bmu_{\bY}=\expc[\bY]
:=(\expc[Y_1],\ldots,\expc[Y_q])',
\]
\[
\cov(\bX,\bY)
=\expc[(\bX-\bmu_{\bX})(\bY-\bmu_{\bY})'],
\qquad
\cov(\bX)=\cov(\bX,\bX).
\]
\tcbbreak
The first matrix is the \emph{cross-covariance}; the second is the
\emph{covariance matrix}.
For a scalar \(U\),
\(\var(U)=\expc[(U-\expc[U])^2]\).
For a positive integer \(r\) and \(\bW\in\Real^{r\times p}\), set
\[
\bZ=\bW(\bX-\bmu_{\bX}).
\]
If \(\cov(\bZ)=\bI_r\), then \(\bW\) is a
\emph{whitening matrix} for \(\bX\), and \(\bZ\) is the
\emph{whitened vector}.
\origin{Course formulation}
\end{definition}

\begin{theorem}[Covariance calculus]\label{thm:covariance-calculus}
Let \(\bX\in\Real^p\), \(\bY\in\Real^q\), and let all displayed second
moments be finite.  For constant matrices \(\bC,\bD\) and constant vectors
\(\bc,\bd\),
\[
\expc[\bC\bX+\bc]=\bC\bmu_{\bX}+\bc,
\]
\[
\cov(\bC\bX+\bc,\bD\bY+\bd)
=\bC\cov(\bX,\bY)\bD',
\]
\[
\cov(\bY,\bX)=\cov(\bX,\bY)'.
\]
\tcbbreak
The matrix \(\bSig=\cov(\bX)\) is symmetric positive
semidefinite, and
\[
\ba'\bSig\bbb
=\cov(\ba'\bX,\bbb'\bX),
\qquad
\ker(\bSig)=\{\ba:\var(\ba'\bX)=0\}.
\]
\origin{Course formulation from H \S14.2a}
\end{theorem}

\begin{proof}
Linearity of expectation gives the first identity.  Subtracting that mean
gives
\[
(\bC\bX+\bc)-\expc[\bC\bX+\bc]
=\bC(\bX-\bmu_{\bX}),
\]
and similarly for \(\bY\); substitution gives the second identity.
Transposition gives the third.  With
\(\widetilde{\bX}=\bX-\bmu_{\bX}\),
\[
\bSig'=\expc[(\widetilde{\bX}\widetilde{\bX}')']
=\bSig,
\qquad
\ba'\bSig\ba=\expc[(\ba'\widetilde{\bX})^2]\geqslant0.
\]
Moreover,
\[
\ba'\bSig\bbb
=\expc[(\ba'\widetilde{\bX})(\bbb'\widetilde{\bX})]
=\cov(\ba'\bX,\bbb'\bX).
\]
Finally,
\[
\var(\ba'\bX)=\ba'\bSig\ba=0
\iff \bSig\ba=\bzero
\]
by the null criterion for a positive semidefinite matrix.
\end{proof}

\newpage

\begin{theorem}[Whitening, including singular covariance]\label{thm:whitening}
Let \(\bX\in\Real^p\), let
\(\cov(\bX)=\bSig\psdge\bO\), and set
\(r=\rank(\bSig)\), so \(0\leqslant r\leqslant p\).  If \(r=0\), then
\(\bSig=\bO\), and there are no nonzero-variance coordinates to whiten.
If \(r>0\), write the positive spectral part as
\[
\bSig=\bQ_r\bLam_r\bQ_r',
\qquad
\bQ_r'\bQ_r=\bI_r,
\qquad
\bLam_r=\diag(\lambda_1,\ldots,\lambda_r)\psdgt\bO.
\]
Then
\[
\bW_r=\bLam_r^{-1/2}\bQ_r',
\qquad
\bZ=\bW_r(\bX-\bmu_{\bX})
\]
satisfies
\[
\expc[\bZ]=\bzero,
\qquad
\cov(\bZ)=\bI_r.
\]
If \(r=p\), the square whitening matrix \(\bSig^{-1/2}\) gives the whitened
vector
\[
\widetilde{\bZ}=\bSig^{-1/2}(\bX-\bmu_{\bX})=\bQ_r\bZ,
\qquad
\cov(\widetilde{\bZ})=\bI_p.
\]
Conversely, let \(s\) be a positive integer.  If
\(\bZ\in\Real^s\), \(\expc[\bZ]=\bzero\),
\(\cov(\bZ)=\bI_s\), \(\bC\in\Real^{p\times s}\), and
\(\bmu\in\Real^p\), then
\[
\bY:=\bmu+\bC\bZ
\quad\Longrightarrow\quad
\expc[\bY]=\bmu,
\qquad
\cov(\bY)=\bC\bC'.
\]
\origin{Course formulation from A\&M Exs.~8.21 and 8.24; H Thm.~21.9.1}
\end{theorem}

\begin{proof}
If \(r=0\), the spectral characterisation gives \(\bSig=\bO\), and
\[
\var(\ba'\bX)=\ba'\bSig\ba=0
\qquad(\ba\in\Real^p).
\]
Let \(r>0\).  Covariance calculus gives
\[
\cov(\bZ)
=\bLam_r^{-1/2}\bQ_r'\bSig\bQ_r\bLam_r^{-1/2}
=\bLam_r^{-1/2}\bLam_r\bLam_r^{-1/2}
=\bI_r,
\]
and
\[
\expc[\bZ]
=\bW_r\{\expc[\bX]-\bmu_{\bX}\}
=\bzero.
\]
If \(r=p\), functional calculus gives
\(\bQ_r\bLam_r^{-1/2}\bQ_r'=\bSig^{-1/2}\), hence
\(\widetilde{\bZ}=\bQ_r\bZ\); orthogonal congruence preserves \(\bI_p\).
The converse is
\[
\expc[\bY]=\expc[\bmu+\bC\bZ]=\bmu,
\qquad
\cov(\bY)
=\cov(\bmu+\bC\bZ)
=\bC\bI_s\bC'=\bC\bC'.
\]
\end{proof}

\subsection{Residual covariance and Mahalanobis distance}\label{sec:9.3.3}

\begin{theorem}[Minimum linear-residual covariance]\label{thm:residual-covariance}
Let the joint covariance of \(\bX\in\Real^p\) and \(\bY\in\Real^q\) be
\[
\cov\begin{pmatrix}\bX\\\bY\end{pmatrix}
=\begin{pmatrix}
\bSig_{XX}&\bSig_{XY}\\
\bSig_{YX}&\bSig_{YY}
\end{pmatrix},
\qquad
\bSig_{XX}\psdgt\bO.
\]
For \(\bB\in\Real^{q\times p}\), set
\[
\bR_{\bB}=(\bY-\bmu_{\bY})-\bB(\bX-\bmu_{\bX}),
\qquad
\bB_*=\bSig_{YX}\bSig_{XX}^{-1},
\]
and
\[
\bS=\bSig_{YY}
-\bSig_{YX}\bSig_{XX}^{-1}\bSig_{XY}.
\]
Then \(\bS\psdge\bO\) and
\[
\cov(\bR_{\bB})
=\bS+(\bB-\bB_*)\bSig_{XX}(\bB-\bB_*)'
\psdge\bS.
\]
Equality holds exactly when \(\bB=\bB_*\).
\origin{Course formulation from H Cor.~14.8.6; S Ex.~11.6}
\end{theorem}

\begin{proof}
The joint covariance is positive semidefinite by covariance calculus, so the
block criterion gives \(\bS\psdge\bO\).  Direct expansion gives
\[
\cov(\bR_{\bB})
=\bSig_{YY}-\bB\bSig_{XY}-\bSig_{YX}\bB'
+\bB\bSig_{XX}\bB'.
\]
Since
\(\bB_*\bSig_{XX}=\bSig_{YX}\) and
\(\bSig_{XX}\bB_*'=\bSig_{XY}\), completing the matrix square gives the
stated identity.  The added term is positive semidefinite.  It is the Gram
matrix of \(\bSig_{XX}^{1/2}(\bB-\bB_*)'\), hence is zero if and only if
\[
\bSig_{XX}^{1/2}(\bB-\bB_*)'=\bO,
\]
equivalently \(\bB=\bB_*\), because \(\bSig_{XX}^{1/2}\) is nonsingular.
\end{proof}

\begin{definition}[Mahalanobis distance]\label{def:mahalanobis}
For \(\bSig=\bSig'\psdgt\bO\) and \(\bx,\bmu\in\Real^p\), define
\[
d_{\bSig}(\bx,\bmu)
=\sqrt{(\bx-\bmu)'\bSig^{-1}(\bx-\bmu)}.
\]
\tcbbreak
Equivalently,
\[
d_{\bSig}(\bx,\bmu)
=\norm{\bSig^{-1/2}(\bx-\bmu)}.
\]
\origin{Course formulation from H \S14.10a and Thm.~21.9.1}
\end{definition}

\begin{theorem}[Affine invariance of Mahalanobis distance]
\label{thm:mahalanobis-invariance}
Let \(\bC\in\Real^{p\times p}\) be nonsingular, \(\bd\in\Real^p\), and
\[
\by=\bC\bx+\bd,
\qquad
\boldsymbol{\nu}=\bC\bmu+\bd,
\qquad
\bOmega=\bC\bSig\bC'.
\]
Then \(\bOmega\psdgt\bO\) and
\[
d_{\bOmega}(\by,\boldsymbol{\nu})=d_{\bSig}(\bx,\bmu).
\]
\origin{Course formulation from A\&M Ex.~8.28; H Cor.~14.2.10}
\end{theorem}

\begin{proof}
Congruence gives \(\bOmega\psdgt\bO\), and
\[
\bOmega^{-1}=(\bC')^{-1}\bSig^{-1}\bC^{-1}.
\]
Since \(\by-\boldsymbol{\nu}=\bC(\bx-\bmu)\),
\[
(\by-\boldsymbol{\nu})'\bOmega^{-1}(\by-\boldsymbol{\nu})
=(\bx-\bmu)'\bSig^{-1}(\bx-\bmu).
\]
Both distances are the nonnegative square roots of these quantities.
\end{proof}

\begin{example}[A scalar linear residual]\label{ex:scalar-residual}
Suppose
\[
\cov\begin{pmatrix}X\\Y\end{pmatrix}
=\begin{pmatrix}4&2\\2&3\end{pmatrix}.
\]
For \(R_b=(Y-\expc[Y])-b(X-\expc[X])\),
\[
b_*=\frac24=\frac12,
\qquad
\var(R_b)
=3-4b+4b^2
=2+4\left(b-\frac12\right)^2.
\]
Thus the minimum residual variance is the Schur complement
\(3-2(4^{-1})2=2\).
\origin{Course formulation from H Cor.~14.8.6}
\end{example}

%=============================================================================
\section{Computation: Numerical Checks in R}\label{sec:9.4}
%=============================================================================

\subsection{Eigenvalue, minor, and Cholesky diagnostics}\label{sec:9.4.1}

<<definiteness-diagnostics>>=
A_pd <- rbind(c(4, 2, 0), c(2, 5, 1), c(0, 1, 2))
A_psd <- rbind(c(1, 1, 0), c(1, 2, 0), c(0, 0, 0))
A_ind <- rbind(c(0, 0, 1), c(0, -1, 0), c(1, 0, 0))

diagnose <- function(A, tol = 1e-10) {
  ev <- eigen(A, symmetric = TRUE)$values
  leading <- vapply(seq_len(nrow(A)), function(k)
    det(A[seq_len(k), seq_len(k), drop = FALSE]), numeric(1))
  c(min_eigenvalue = min(ev),
    min_leading_minor = min(leading),
    numerical_rank = qr(A, tol = tol)$rank,
    chol_success = as.numeric(!inherits(try(chol(A), silent = TRUE),
                                        "try-error")))
}
rbind(positive_definite = diagnose(A_pd),
      positive_semidefinite = diagnose(A_psd),
      indefinite = diagnose(A_ind))
@

The numerical rank uses the QR method in \texttt{qr()} with tolerance
\(10^{-10}\).  Eigenvalues in \([-10^{-10},0)\) are treated as roundoff
for a numerical semidefinite decision.  Both \(\bA_{\rm psd}\) and
\(\bA_{\rm ind}\) have minimum
leading minor zero; the negative eigenvalue of \(\bA_{\rm ind}\) separates
them and confirms that nonnegative leading minors do not test
semidefiniteness.

\subsection{Cholesky factor and symmetric square root}\label{sec:9.4.2}

<<two-square-roots>>=
A <- rbind(c(2, 1), c(1, 2))
L <- t(chol(A))
eA <- eigen(A, symmetric = TRUE)
R <- eA$vectors %*% diag(sqrt(eA$values)) %*% t(eA$vectors)
c(cholesky_reconstruction = max(abs(L %*% t(L) - A)),
  root_reconstruction = max(abs(R %*% R - A)),
  factor_difference = max(abs(L - R)))

A0 <- rbind(c(1, 1, 0), c(1, 2, 0), c(0, 0, 0))
L0 <- rbind(c(1, 0, 0), c(1, 1, 0), c(0, 0, 0))
e0 <- eigen(A0, symmetric = TRUE)
R0 <- e0$vectors %*% diag(sqrt(pmax(e0$values, 0))) %*% t(e0$vectors)
c(semidefinite_cholesky_residual = max(abs(L0 %*% t(L0) - A0)),
  semidefinite_root_residual = max(abs(R0 %*% R0 - A0)),
  base_chol_success = as.numeric(!inherits(try(chol(A0), silent = TRUE),
                                            "try-error")))
@

The positive part \texttt{pmax(e0\$values, 0)} removes only roundoff-sized
negative eigenvalues introduced by floating-point eigensolution.

\subsection{Order reversal and generalized eigenvalues}\label{sec:9.4.3}

<<order-and-generalized>>=
B <- rbind(c(2, 0.5), c(0.5, 1.5))
u <- c(1, -2)
A <- B + tcrossprod(u)
eB <- eigen(B, symmetric = TRUE)
Binvhalf <- eB$vectors %*% diag(eB$values^(-1 / 2)) %*% t(eB$vectors)
C <- Binvhalf %*% A %*% Binvhalf
lambda_symmetric <- sort(eigen(C, symmetric = TRUE)$values,
                         decreasing = TRUE)
lambda_direct <- sort(Re(eigen(solve(B, A))$values), decreasing = TRUE)
c(min_eigen_A_minus_B = min(eigen(A - B, symmetric = TRUE)$values),
  min_eigen_inverse_gap = min(eigen(solve(B) - solve(A),
                                    symmetric = TRUE)$values),
  generalized_route_difference = max(abs(lambda_symmetric - lambda_direct)))
lambda_symmetric
@

The generalized problem is reduced to the symmetric matrix
\(\bB^{-1/2}\bA\bB^{-1/2}\); \texttt{solve(B, A)} is printed only as an
additional eigenvalue check.  Order-test eigenvalues no smaller than
\(-10^{-12}\) are treated as zero.

\subsection{Schur complement and residual covariance}\label{sec:9.4.4}

<<residual-covariance>>=
Sigma_XX <- rbind(c(2, 0.5), c(0.5, 1))
Sigma_YX <- matrix(c(0.6, 0.4), nrow = 1)
Sigma_YY <- matrix(2, 1, 1)
Sigma_joint <- rbind(cbind(Sigma_XX, t(Sigma_YX)),
                     cbind(Sigma_YX, Sigma_YY))
B_star <- Sigma_YX %*% solve(Sigma_XX)
S <- Sigma_YY - B_star %*% t(Sigma_YX)
B_trial <- matrix(c(1, -0.5), nrow = 1)
residual_direct <- Sigma_YY - B_trial %*% t(Sigma_YX) -
  Sigma_YX %*% t(B_trial) + B_trial %*% Sigma_XX %*% t(B_trial)
residual_completed <- S +
  (B_trial - B_star) %*% Sigma_XX %*% t(B_trial - B_star)
c(min_joint_eigenvalue = min(eigen(Sigma_joint, symmetric = TRUE)$values),
  schur_complement = S,
  completion_difference = max(abs(residual_direct - residual_completed)),
  excess_residual_variance = residual_direct - S)
@

\subsection{Deterministic whitening and Mahalanobis distance}\label{sec:9.4.5}

<<whitening-mahalanobis>>=
Sigma <- rbind(c(4, 1.2), c(1.2, 2))
mu <- c(3, -1)
eS <- eigen(Sigma, symmetric = TRUE)
Sroot <- eS$vectors %*% diag(sqrt(eS$values)) %*% t(eS$vectors)
Sinvroot <- eS$vectors %*% diag(eS$values^(-1 / 2)) %*% t(eS$vectors)
a <- sqrt(3 / 2)
Z <- rbind(c(a, 0), c(-a, 0), c(0, a), c(0, -a))
X <- sweep(Z %*% Sroot, 2, mu, "+")
X_centered <- sweep(X, 2, mu, "-")
Z_white <- X_centered %*% Sinvroot
U <- chol(Sigma)
d2_chol <- colSums(forwardsolve(t(U), t(X_centered))^2)
d2_package <- mahalanobis(X, center = mu, cov = Sigma)
c(covariance_construction = max(abs(cov(X) - Sigma)),
  whitening_residual = max(abs(cov(Z_white) - diag(2))),
  mahalanobis_difference = max(abs(d2_chol - d2_package)))
@

The four rows of \texttt{Z} have sample mean zero and sample covariance
\(\bI_2\) exactly; sampling error is absent from both covariance comparisons.

%=============================================================================
\section{Pitfalls}\label{sec:9.5}
%=============================================================================

\subsection{Nonnegative leading minors do not test semidefiniteness}
\label{sec:9.5.1}

\[
\bA=\begin{pmatrix}0&0&1\\0&-1&0\\1&0&0\end{pmatrix},
\qquad
(\Delta_1,\Delta_2,\Delta_3)=(0,0,1),
\]
\[
(\eu_1+\eu_3)'\bA(\eu_1+\eu_3)=2,
\qquad
\eu_2'\bA\eu_2=-1.
\]
Sylvester's criterion uses strict positivity for positive definiteness.  A
semidefinite criterion cannot be obtained by replacing \(>\) with
\(\geqslant\) only for the leading minors.

\subsection{The Löwner order is not entrywise}\label{sec:9.5.2}

\[
\begin{pmatrix}1&-1\\-1&1\end{pmatrix}\psdge\bO,
\qquad
\begin{pmatrix}1&2\\2&1\end{pmatrix}
\text{ has eigenvalues }3,-1.
\]
A positive semidefinite matrix may have negative entries; an entrywise
nonnegative symmetric matrix may be indefinite.

\subsection{The order is partial and squaring need not preserve it}
\label{sec:9.5.3}

\[
\begin{pmatrix}1&0\\0&0\end{pmatrix}
-\begin{pmatrix}0&0\\0&1\end{pmatrix}
=\begin{pmatrix}1&0\\0&-1\end{pmatrix},
\]
so the two diagonal matrices are incomparable.  Also, with
\[
\bB=\begin{pmatrix}1&0\\0&0\end{pmatrix},
\qquad
\bA=\begin{pmatrix}2&1\\1&1\end{pmatrix},
\]
\[
\bA-\bB=\begin{pmatrix}1&1\\1&1\end{pmatrix}\psdge\bO,
\qquad
\bA^2-\bB^2=\begin{pmatrix}4&3\\3&2\end{pmatrix},
\qquad
\det(\bA^2-\bB^2)=-1.
\]

\subsection{A singular covariance has no inverse-based distance}
\label{sec:9.5.4}

\[
\bSig=\begin{pmatrix}1&1\\1&1\end{pmatrix},
\qquad
\det(\bSig)=0,
\qquad
\rank(\bSig)=1.
\]
The expression \((\bx-\bmu)'\bSig^{-1}(\bx-\bmu)\) is undefined.  The
rank-reduced whitening matrix in Theorem~\ref{thm:whitening} remains defined.

%=============================================================================
\section{Exercises}\label{sec:9.6}
%=============================================================================

\begin{exercise}[Recovering a symmetric matrix from its quadratic form]
\label{ex:recover-form}
Let \(\bA=(a_{ij})=\bA'\) and suppose that the values of
\(q_{\bA}\) are known.  Recover every entry of \(\bA\) from the values at
\(\eu_i\) and \(\eu_i+\eu_j\).
\origin{A\&M Ex.~8.3; H Cor.~14.1.3}
\end{exercise}

\begin{solution}
\[
a_{ii}=q_{\bA}(\eu_i),
\]
and, for \(i<j\),
\[
q_{\bA}(\eu_i+\eu_j)=a_{ii}+2a_{ij}+a_{jj},
\]
so
\[
a_{ij}=a_{ji}
=\frac12\{q_{\bA}(\eu_i+\eu_j)
-q_{\bA}(\eu_i)-q_{\bA}(\eu_j)\}.
\]
These \(n+n(n-1)/2\) values determine all symmetric entries.
\end{solution}

\begin{exercise}[Complete \(2\times2\) semidefinite test]
\label{ex:two-by-two-psd}
For
\[
\bA=\begin{pmatrix}a&b\\b&c\end{pmatrix},
\]
prove
\[
\bA\psdge\bO
\iff
a\geqslant0,\quad c\geqslant0,\quad b^2\leqslant ac.
\]
State the corresponding positive definite condition.
\origin{A\&M Ex.~8.7; H Cor.~14.5.14 and Thm.~14.9.5}
\end{exercise}

\begin{solution}
Necessity follows from Lemma~\ref{lem:psd-entries}.  Conversely, if \(a>0\),
\[
ax^2+2bxy+cy^2
=a\left(x+\frac ba y\right)^2
+\left(c-\frac{b^2}{a}\right)y^2\geqslant0.
\]
If \(a=0\), then \(b^2\leqslant ac=0\), so \(b=0\) and the form is
\(cy^2\geqslant0\).  Sylvester's criterion gives
\[
\bA\psdgt\bO\iff a>0\text{ and }ac-b^2>0.
\]
\end{solution}

\begin{exercise}[Kernel of a semidefinite sum]\label{ex:kernel-sum}
If \(\bA,\bB\psdge\bO\), prove
\[
\ker(\bA+\bB)=\ker(\bA)\cap\ker(\bB).
\]
Deduce that \(\bA+\bB\psdgt\bO\) exactly when
\(\ker(\bA)\cap\ker(\bB)=\{\bzero\}\).
\origin{A\&M Ex.~8.8; H Lemma~14.2.4}
\end{exercise}

\begin{solution}
If \((\bA+\bB)\bx=\bzero\), then
\[
0=\bx'(\bA+\bB)\bx=\bx'\bA\bx+\bx'\bB\bx.
\]
Both summands are nonnegative, hence both are zero.  The null criterion gives
\(\bA\bx=\bB\bx=\bzero\).  Conversely, these two equalities give
\((\bA+\bB)\bx=\bzero\).  Since
\(\bA+\bB\psdge\bO\), it is positive definite exactly when its kernel is
zero.
\end{solution}

\begin{exercise}[Low-order principal minors are insufficient]
\label{ex:low-order-minors}
Let \(\bone=(1,1,1)'\) and
\[
\bA=\frac74\bI_3-\frac34\bone\bone'.
\]
Show that every principal minor of order one or two is positive, but that
\(\bA\) is indefinite.
\origin{A\&M Ex.~8.32; H Thm.~14.9.11}
\end{exercise}

\begin{solution}
Every diagonal entry is \(1\), and every principal submatrix of order two is
\[
\begin{pmatrix}1&-3/4\\-3/4&1\end{pmatrix},
\qquad
\det\begin{pmatrix}1&-3/4\\-3/4&1\end{pmatrix}
=1-\frac9{16}=\frac7{16}>0.
\]
Since \(\bone\bone'\bone=3\bone\),
\[
\bA\bone=-\frac12\bone.
\]
For every \(\bx\perp\bone\), \(\bone'\bx=0\) and
\(\bA\bx=(7/4)\bx\).  Hence the eigenvalues are
\(-1/2,7/4,7/4\), so \(\bA\) is indefinite.
\end{solution}

\begin{exercise}[Rank-one positive update]\label{ex:rank-one-update}
Let \(\bA\psdgt\bO\) and \(\bu\in\Real^n\).  Prove
\[
\bA+\bu\bu'\psdgt\bO,
\qquad
\det(\bA+\bu\bu')
=\det(\bA)\{1+\bu'\bA^{-1}\bu\}.
\]
When is the determinant unchanged?
\origin{A\&M Ex.~8.35; H Thm.~18.1.6}
\end{exercise}

\begin{solution}
For \(\bx\ne\bzero\),
\[
\bx'(\bA+\bu\bu')\bx
=\bx'\bA\bx+(\bu'\bx)^2>0.
\]
The rank-one determinant identity from partitioned matrices gives
\[
\det(\bA+\bu\bu')
=\det(\bA)(1+\bu'\bA^{-1}\bu).
\]
Since \(\bA^{-1}\psdgt\bO\),
\(\bu'\bA^{-1}\bu=0\iff\bu=\bzero\).  This is exactly the equality case.
\end{solution}

\begin{exercise}[Null space of the square root]\label{ex:square-root-kernel}
If \(\bA\psdge\bO\), prove
\[
\ker(\bA^{1/2})=\ker(\bA),
\qquad
\col(\bA^{1/2})=\col(\bA),
\qquad
\rank(\bA^{1/2})=\rank(\bA).
\]
\origin{A\&M Ex.~8.24; H Thm.~21.9.1}
\end{exercise}

\begin{solution}
For an orthogonal \(\bQ\),
\[
\bQ'\bA\bQ=\diag(\lambda_1,\ldots,\lambda_n),
\qquad
\bQ'\bA^{1/2}\bQ
=\diag(\sqrt{\lambda_1},\ldots,\sqrt{\lambda_n}).
\]
The two diagonal entries vanish for the same indices.  Hence the two kernels
are equal and both ranks count the same nonzero indices.  For symmetric
matrices, \(\col(\bA)=\ker(\bA)^{\perp}\); equal kernels give equal column
spaces.
\end{solution}

\begin{exercise}[Inverse order equivalence]\label{ex:inverse-order-equivalence}
For \(\bA,\bB\psdgt\bO\), prove
\[
\bA\psdge\bB\iff\bB^{-1}\psdge\bA^{-1},
\qquad
\bA\psdgt\bB\iff\bB^{-1}\psdgt\bA^{-1}.
\]
\origin{A\&M Ex.~12.16; H Thm.~18.3.4}
\end{exercise}

\begin{solution}
The forward implications are Theorem~\ref{thm:inverse-order}.  Conversely,
apply that theorem to
\[
\bB^{-1}\psdge\bA^{-1}\psdgt\bO
\quad\text{or}\quad
\bB^{-1}\psdgt\bA^{-1}\psdgt\bO.
\]
It gives
\[
(\bA^{-1})^{-1}\psdge(\bB^{-1})^{-1}
\quad\text{or}\quad
(\bA^{-1})^{-1}\psdgt(\bB^{-1})^{-1},
\]
which are the required reverse implications.
\end{solution}

\begin{exercise}[All square whitening matrices]\label{ex:all-whiteners}
Let \(\bSig\psdgt\bO\) and \(\bW\in\Real^{p\times p}\).  Prove
\[
\bW\bSig\bW'=\bI_p
\iff
\bW=\bQ\bSig^{-1/2}\text{ for some orthogonal }\bQ.
\]
\origin{Course formulation from H Thm.~21.9.1}
\end{exercise}

\begin{solution}
If \(\bW\bSig\bW'=\bI_p\), set \(\bQ=\bW\bSig^{1/2}\).  Then
\[
\bQ\bQ'=\bW\bSig\bW'=\bI_p.
\]
Thus \(\bQ\) is square and orthogonal, and
\(\bW=\bQ\bSig^{-1/2}\).  Conversely, if \(\bQ\bQ'=\bI_p\), then
\[
\bW\bSig\bW'
=\bQ\bSig^{-1/2}\bSig\bSig^{-1/2}\bQ'
=\bQ\bQ'=\bI_p.
\]
\end{solution}

\begin{exercise}[Generalized eigenvalue interval]\label{ex:generalized-interval}
Let \(\bA=\bA'\), \(\bB\psdgt\bO\), and \(m\leqslant M\).  Prove
\[
m\bB\psdle\bA\psdle M\bB
\iff
m\leqslant\lambda_i\leqslant M
\quad(i=1,\ldots,n),
\]
where \(\lambda_i\) are the generalized eigenvalues of \((\bA,\bB)\).
\origin{H Exs.~21.31--21.32}
\end{exercise}

\begin{solution}
With \(\bC=\bB^{-1/2}\bA\bB^{-1/2}\), congruence gives
\[
\bA-m\bB\psdge\bO
\iff \bC-m\bI\psdge\bO
\iff \lambda_i\geqslant m\quad(i=1,\ldots,n),
\]
and
\[
M\bB-\bA\psdge\bO
\iff M\bI-\bC\psdge\bO
\iff \lambda_i\leqslant M\quad(i=1,\ldots,n).
\]
Combining the two equivalences proves the claim.
\end{solution}

\begin{exercise}[A block norm criterion]\label{ex:block-contraction}
Let \(\bA\psdgt\bO\), \(\bC\psdgt\bO\), and
\(\bB\in\Real^{p\times q}\).  Set
\[
\bK=\bA^{-1/2}\bB\bC^{-1/2}.
\]
\tcbbreak
Prove
\[
\begin{pmatrix}\bA&\bB\\\bB'&\bC\end{pmatrix}\psdge\bO
\iff
\norm{\bK\bz}\leqslant\norm{\bz}
\quad(\bz\in\Real^q).
\]
\origin{H Cor.~14.8.6; S Ex.~11.6}
\end{exercise}

\begin{solution}
The Schur complement of \(\bA\) is
\[
\bC-\bB'\bA^{-1}\bB
=\bC^{1/2}(\bI_q-\bK'\bK)\bC^{1/2}.
\]
The block criterion and congruence give
\[
\begin{pmatrix}\bA&\bB\\\bB'&\bC\end{pmatrix}\psdge\bO
\iff \bI_q-\bK'\bK\psdge\bO.
\]
For \(\bz\in\Real^q\),
\[
\bz'(\bI_q-\bK'\bK)\bz
=\norm{\bz}^2-\norm{\bK\bz}^2,
\]
which gives the stated equivalence.
\end{solution}

\begin{exercise}[Covariance of a sum]\label{ex:covariance-sum}
For random vectors \(\bX,\bY\in\Real^p\), with all displayed second moments
finite, prove
\[
\cov(\bX+\bY)
=\cov(\bX)+\cov(\bY)
+\cov(\bX,\bY)+\cov(\bY,\bX).
\]
Give the corresponding identity for \(\bX-\bY\).
\origin{Course formulation}
\end{exercise}

\begin{solution}
Set \(\widetilde{\bX}=\bX-\bmu_{\bX}\) and
\(\widetilde{\bY}=\bY-\bmu_{\bY}\).  Then
\[
\cov(\bX+\bY)
=\expc[(\widetilde{\bX}+\widetilde{\bY})
(\widetilde{\bX}+\widetilde{\bY})'],
\]
and expansion gives the four stated terms.  Replacing
\(\widetilde{\bY}\) by \(-\widetilde{\bY}\) gives
\[
\cov(\bX-\bY)
=\cov(\bX)+\cov(\bY)
-\cov(\bX,\bY)-\cov(\bY,\bX).
\]
\end{solution}

\begin{exercise}[Hadamard's determinant inequality]\label{ex:hadamard}
Let \(\bA=(a_{ij})=\bA'\psdgt\bO\).  Prove
\[
\det(\bA)\leqslant\prod_{i=1}^n a_{ii},
\]
with equality exactly when \(\bA\) is diagonal.  Deduce that, if
\(\br_i'\) is row \(i\) of \(\bM\in\Real^{n\times n}\), then
\[
|\det(\bM)|\leqslant\prod_{i=1}^n\norm{\br_i}.
\]
If \(\bM\) is nonsingular, identify the equality condition.
\origin{A\&M Ex.~12.26; S Prop.~6.5 and Thm.~6.9}
\end{exercise}

\begin{solution}
Let \(\bA=\bL\bL'\) be its positive-diagonal Cholesky factorisation.  Then
\[
a_{ii}=\sum_{j=1}^i\ell_{ij}^2\geqslant\ell_{ii}^2,
\qquad
\det(\bA)=\prod_{i=1}^n\ell_{ii}^2
\leqslant\prod_{i=1}^n a_{ii}.
\]
All factors are positive; equality holds if and only if
\[
a_{ii}=\ell_{ii}^2\quad(i=1,\ldots,n)
\iff
\ell_{ij}=0\quad(j<i)
\iff \bL\text{ is diagonal}
\iff \bA\text{ is diagonal}.
\]
If \(\det(\bM)=0\), the row inequality holds.  If \(\bM\) is nonsingular,
\(\bM\bM'\psdgt\bO\), so
\[
|\det(\bM)|^2
=\det(\bM\bM')
\leqslant\prod_{i=1}^n(\bM\bM')_{ii}
=\prod_{i=1}^n\norm{\br_i}^2.
\]
The nonnegative square roots give the inequality.  Equality holds exactly when
\(\bM\bM'\) is diagonal, equivalently when the rows of \(\bM\) are pairwise
orthogonal.
\end{solution}

\begin{exercise}[Residual orthogonality]\label{ex:residual-orthogonality}
Use the notation and assumptions of Theorem~\ref{thm:residual-covariance}.
Prove
\[
\cov(\bR_{\bB},\bX)=\bO
\iff \bB=\bB_*.
\]
For \(\bB=\bB_*\), decompose \(\bY-\bmu_{\bY}\) into two vectors with
zero cross-covariance.
\origin{Course formulation from H Cor.~14.8.6}
\end{exercise}

\begin{solution}
Covariance calculus gives
\[
\cov(\bR_{\bB},\bX)
=\bSig_{YX}-\bB\bSig_{XX}.
\]
Since \(\bSig_{XX}\) is nonsingular, this matrix is zero exactly when
\(\bB=\bSig_{YX}\bSig_{XX}^{-1}=\bB_*\).  With
\(\bR_*=\bR_{\bB_*}\),
\[
\bY-\bmu_{\bY}
=\bB_*(\bX-\bmu_{\bX})+\bR_*,
\]
and
\[
\cov(\bB_*(\bX-\bmu_{\bX}),\bR_*)
=\bB_*\cov(\bX,\bR_*)=\bO.
\]
\end{solution}

\begin{exercise}[A constrained linear maximum]\label{ex:ellipsoid-support}
Let \(\bA\psdgt\bO\) and \(\ba\in\Real^n\).  Prove
\[
\max_{\bx'\bA\bx\leqslant1}\ba'\bx
=\sqrt{\ba'\bA^{-1}\ba}.
\]
For \(\ba\ne\bzero\), identify the unique maximiser.
\origin{A\&M Ex.~12.1; H Thm.~14.10.1}
\end{exercise}

\begin{solution}
Set \(\by=\bA^{1/2}\bx\) and \(\bc=\bA^{-1/2}\ba\).  Then
\[
\bx'\bA\bx=\norm{\by}^2,
\qquad
\ba'\bx=\bc'\by\leqslant\norm{\bc}\norm{\by}
\leqslant\norm{\bc}.
\]
Moreover,
\[
\norm{\bc}^2=\ba'\bA^{-1}\ba.
\]
If \(\ba\ne\bzero\), equality in both inequalities requires
\(\by=\bc/\norm{\bc}\), hence the unique maximiser is
\[
\bx_*=
\frac{\bA^{-1}\ba}{\sqrt{\ba'\bA^{-1}\ba}}.
\]
If \(\ba=\bzero\), the maximum is zero at every feasible point.
\end{solution}

\begin{exercise}[Mahalanobis distance after a rank-one update]
\label{ex:mahalanobis-inflation}
Let \(\bSig\psdgt\bO\), \(\bu,\bx\in\Real^p\), and
\(\widetilde{\bSig}=\bSig+\bu\bu'\).  Prove
\tcbbreak
\[
\bx'\widetilde{\bSig}^{-1}\bx
=\bx'\bSig^{-1}\bx
-\frac{(\bx'\bSig^{-1}\bu)^2}
{1+\bu'\bSig^{-1}\bu}
\leqslant\bx'\bSig^{-1}\bx.
\]
Give the equality condition.
\origin{Course formulation from H Thm.~18.2.8 and Thm.~18.3.4; A\&M Ex.~12.16}
\end{exercise}

\begin{solution}
The rank-one inverse identity gives
\[
\widetilde{\bSig}^{-1}
=\bSig^{-1}
-\frac{\bSig^{-1}\bu\bu'\bSig^{-1}}
{1+\bu'\bSig^{-1}\bu}.
\]
Premultiplication and postmultiplication by \(\bx'\) and \(\bx\) give the
displayed equality.  Since
\[
1+\bu'\bSig^{-1}\bu>0,
\]
the subtracted term is nonnegative.  Equality holds exactly when
\(\bx'\bSig^{-1}\bu=0\).
\end{solution}

