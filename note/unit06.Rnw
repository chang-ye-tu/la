%=============================================================================
\section{Orthonormal bases and QR}\label{sec:6.1}
%=============================================================================

\subsection{Orthonormal sets}\label{sec:6.1.1}

\begin{definition}[Orthonormal set]\label{def:orthonormal-set}
A finite list $\bq_1,\ldots,\bq_k\in\Real^n$ is \emph{orthonormal} if
\[
\bq_i'\bq_j=
\begin{cases}
1,&i=j,\\
0,&i\ne j.
\end{cases}
\]
For $\bQ=(\bq_1,\ldots,\bq_k)$, this condition is $\bQ'\bQ=\bI_k$.
The empty list is orthonormal.
\origin{H \S6.2a}
\end{definition}

\begin{definition}[Frobenius inner product and norm]\label{def:frobenius-norm}
For $\bA,\bB\in\Real^{m\times n}$, define
\[
 \langle\bA,\bB\rangle_F=\tr(\bA'\bB)
 =\sum_{i=1}^m\sum_{j=1}^n a_{ij}b_{ij},
 \qquad
 \norm{\bA}_F=\langle\bA,\bA\rangle_F^{1/2}.
\]
Thus
\[
 \norm{\bA}_F^2=\tr(\bA'\bA)
 =\sum_{i=1}^m\sum_{j=1}^n a_{ij}^2.
\]
\origin{Course formulation from H \S6.1b, Eqs.~(6.1.5)--(6.1.6)}
\end{definition}

\begin{theorem}[Orthogonal nonzero vectors are independent]\label{thm:orthogonal-independent}
If $\bv_1,\ldots,\bv_k$ are nonzero and
$\bv_i'\bv_j=0$ for $i\ne j$, then they are linearly independent.
\origin{H Lemma~6.2.1}
\end{theorem}

\begin{proof}
If $\sum_{j=1}^k a_j\bv_j=\bzero$, then, for each $i$,
\[
0=\bv_i'\sum_{j=1}^k a_j\bv_j
=a_i\bv_i'\bv_i
=a_i\norm{\bv_i}^2.
\]
Since $\norm{\bv_i}^2>0$, $a_i=0$ for every $i$.
\end{proof}

\begin{theorem}[Gram--Schmidt orthonormalisation]\label{thm:gram-schmidt}
Let $k\geqslant1$ and let $\bv_1,\ldots,\bv_k\in\Real^n$ be linearly independent.
Define
\[
\bu_1=\bv_1,
\qquad
\bq_1=\frac{\bu_1}{\norm{\bu_1}},
\]
and, for $j=2,\ldots,k$,
\[
\bu_j=\bv_j-\sum_{i=1}^{j-1}(\bq_i'\bv_j)\bq_i,
\qquad
\bq_j=\frac{\bu_j}{\norm{\bu_j}}.
\]
Then every $\bu_j$ is nonzero, $\bq_1,\ldots,\bq_k$ are orthonormal, and
\[
\spn\{\bq_1,\ldots,\bq_j\}
=\spn\{\bv_1,\ldots,\bv_j\},
\qquad j=1,\ldots,k.
\]
\origin{H Thm.~6.4.1 and Cor.~6.4.2}
\end{theorem}

\begin{proof}
For $j=1$, $\bu_1\ne\bzero$,
\[
\norm{\bq_1}=\frac{\norm{\bu_1}}{\norm{\bu_1}}=1,
\qquad
\spn\{\bq_1\}=\spn\{\bv_1\}.
\]
Suppose the claims hold through $j-1$.  If $\bu_j=\bzero$, then
\[
\bv_j=\sum_{i=1}^{j-1}(\bq_i'\bv_j)\bq_i
\in\spn\{\bv_1,\ldots,\bv_{j-1}\},
\]
contrary to independence.  Thus $\norm{\bu_j}>0$.  For $1\leqslant \ell<j$,
\[
\bq_\ell'\bu_j
=\bq_\ell'\bv_j
-\sum_{i=1}^{j-1}(\bq_i'\bv_j)\bq_\ell'\bq_i
=\bq_\ell'\bv_j-\bq_\ell'\bv_j=0,
\]
and $\bq_j'\bq_j=1$.  Moreover,
\[
\bu_j\in\spn\{\bv_1,\ldots,\bv_j\},
\qquad
\bv_j=\bu_j+\sum_{i=1}^{j-1}(\bq_i'\bv_j)\bq_i.
\]
The two inclusions give the span equality for $j$.
\end{proof}

\begin{corollary}[Existence and extension of orthonormal bases]\label{cor:on-basis-extension}
Every subspace of $\Real^n$ has an orthonormal basis.  If an orthonormal list is
contained in a subspace $\calS$, then it extends to an orthonormal basis of $\calS$.
\origin{H Thms.~6.4.3 and 6.4.5}
\end{corollary}

\begin{proof}
The empty list is a basis of $\{\bzero\}$.  For a nonzero subspace $\calS$, apply
Gram--Schmidt to any basis of $\calS$.

Let $\bq_1,\ldots,\bq_k\in\calS$ be orthonormal.  It is independent, so the
basis-extension theorem gives a basis
\[
\bq_1,\ldots,\bq_k,\bv_{k+1},\ldots,\bv_d
\]
of $\calS$, where $d=\dim\calS$.  Gram--Schmidt leaves the first $k$ vectors
unchanged because
\[
\bq_j-\sum_{i=1}^{j-1}(\bq_i'\bq_j)\bq_i=\bq_j,
\qquad \norm{\bq_j}=1.
\]
Its output is the required extension.
\end{proof}

\subsection{Orthonormal coordinates}\label{sec:6.1.2}

\begin{theorem}[Orthonormal coordinates and Parseval's identity]\label{thm:on-coordinates}
Let $\bq_1,\ldots,\bq_k$ be an orthonormal basis of $\calS\subseteq\Real^n$.
For every $\bx\in\calS$,
\[
\bx=\sum_{j=1}^k(\bq_j'\bx)\bq_j,
\qquad
\norm{\bx}^2=\sum_{j=1}^k\abs{\bq_j'\bx}^2.
\]
If $k>0$, $\bQ=(\bq_1,\ldots,\bq_k)$, and $\bx=\bQ\bc$, then, equivalently,
\[
\bc=\bQ'\bx,
\qquad
\norm{\bx}=\norm{\bc}.
\]
\origin{H Thm.~6.4.4}
\end{theorem}

\begin{proof}
If $k=0$, then $\calS=\{\bzero\}$ and both displayed identities are the
empty-sum identity $0=0$.  Suppose $k>0$.
Write $\bx=\sum_{j=1}^k c_j\bq_j$.  For each $i$,
\[
\bq_i'\bx=\sum_{j=1}^k c_j\bq_i'\bq_j=c_i.
\]
Therefore $\bc=\bQ'\bx$, and
\[
\norm{\bx}^2
=\bc'\bQ'\bQ\bc
=\bc'\bc
=\sum_{j=1}^k\abs{\bq_j'\bx}^2.
\]
\end{proof}

\begin{example}[Exact orthonormalisation]\label{ex:exact-gs}
For
\[
\bv_1=\begin{pmatrix}1\\1\\0\end{pmatrix},
\qquad
\bv_2=\begin{pmatrix}1\\0\\1\end{pmatrix},
\]
Gram--Schmidt gives
\[
\bq_1=\frac1{\sqrt2}\begin{pmatrix}1\\1\\0\end{pmatrix},
\qquad
\bu_2=\bv_2-(\bq_1'\bv_2)\bq_1
=\begin{pmatrix}1/2\\-1/2\\1\end{pmatrix},
\qquad
\bq_2=\frac1{\sqrt6}\begin{pmatrix}1\\-1\\2\end{pmatrix}.
\]
Thus $\bQ=(\bq_1,\bq_2)$ satisfies $\bQ'\bQ=\bI_2$ and has the same column
space as $(\bv_1,\bv_2)$.
\origin{Course formulation from H Thm.~6.4.1}
\end{example}

\subsection{Thin QR factorisation}\label{sec:6.1.3}

\begin{theorem}[Thin QR factorisation]\label{thm:thin-qr}
Let $\bA\in\Real^{m\times p}$ have rank $p$, where $1\leqslant p\leqslant m$.  There are
unique matrices $\bQ\in\Real^{m\times p}$ and $\bR\in\Real^{p\times p}$ such that
\[
\bA=\bQ\bR,
\qquad
\bQ'\bQ=\bI_p,
\qquad
\bR\text{ is upper triangular},
\qquad
r_{jj}>0.
\]
\origin{H \S6.4d; A\&M Exs.~7.34--7.35}
\end{theorem}

\begin{proof}
Write $\bA=(\ba_1,\ldots,\ba_p)$ and apply Gram--Schmidt to its independent
columns.  Let $\bQ=(\bq_1,\ldots,\bq_p)$ and $\bR=\bQ'\bA$.  Since
$\ba_j\in\col(\bQ)$, orthonormal coordinates give
\[
\ba_j=\sum_{i=1}^p(\bq_i'\ba_j)\bq_i,
\qquad
\bA=\bQ\bR.
\]
For $i>j$, $\ba_j\in\spn\{\bq_1,\ldots,\bq_{i-1}\}$, so
$r_{ij}=\bq_i'\ba_j=0$.  If $\bu_j$ is the $j$th Gram--Schmidt residual, then
\[
r_{jj}=\bq_j'\ba_j=\bq_j'\bu_j=\norm{\bu_j}>0.
\]

For uniqueness, the first column satisfies
\[
\ba_1=r_{11}\bq_1,
\qquad
r_{11}=\norm{\ba_1}>0,
\qquad
\bq_1=\ba_1/r_{11}.
\]
Suppose columns $\bq_1,\ldots,\bq_{j-1}$ have been determined.  From
$\ba_j=\sum_{i=1}^j r_{ij}\bq_i$,
\[
r_{ij}=\bq_i'\ba_j\quad(i<j),
\qquad
\bw_j=\ba_j-\sum_{i=1}^{j-1}r_{ij}\bq_i=r_{jj}\bq_j.
\]
Hence $r_{jj}=\norm{\bw_j}>0$ and $\bq_j=\bw_j/r_{jj}$.  Induction determines
$\bQ$ and $\bR$.
\end{proof}

\begin{example}[An exact thin QR factorisation]\label{ex:exact-qr}
The vectors in Example~\ref{ex:exact-gs} give
\[
\begin{pmatrix}1&1\\1&0\\0&1\end{pmatrix}
=
\begin{pmatrix}
1/\sqrt2&1/\sqrt6\\
1/\sqrt2&-1/\sqrt6\\
0&2/\sqrt6
\end{pmatrix}
\begin{pmatrix}
\sqrt2&1/\sqrt2\\
0&\sqrt{3/2}
\end{pmatrix}.
\]
The left factor has orthonormal columns; the right factor is upper triangular with
positive diagonal.
\origin{Course formulation from H \S6.4d}
\end{example}

% \periodmark{End of period 1 of 3.}

%=============================================================================
\section{Orthogonal complements and projection}\label{sec:6.2}
%=============================================================================

\subsection{Complements and the four fundamental subspaces}\label{sec:6.2.1}

\begin{definition}[Orthogonal complement]\label{def:orthogonal-complement}
For $\calS\subseteq\Real^n$, its \emph{orthogonal complement} is
\[
\perpc{\calS}=\{\bx\in\Real^n:\bx'\bs=0\text{ for every }\bs\in\calS\}.
\]
\origin{H \S12.5a; S \S2.3.1}
\end{definition}

\begin{lemma}[Complement subspace and zero intersection]\label{lem:complement-subspace}
For every $\calS\subseteq\Real^n$, $\perpc{\calS}$ is a subspace.  If $\calS$ is a
subspace, then
\[
\calS\cap\perpc{\calS}=\{\bzero\}.
\]
\origin{S Prop.~2.4}
\end{lemma}

\begin{proof}
For every $\bs\in\calS$,
\[
\bzero'\bs=0,
\]
so $\bzero\in\perpc{\calS}$.  For
$\bx,\by\in\perpc{\calS}$, $a,b\in\Real$, and $\bs\in\calS$,
\[
(a\bx+b\by)'\bs=a\bx'\bs+b\by'\bs=0.
\]
Thus $a\bx+b\by\in\perpc{\calS}$.  If $\bx\in\calS\cap\perpc{\calS}$, then
\[
\norm{\bx}^2=\bx'\bx=0,
\]
so $\bx=\bzero$.
\end{proof}

\begin{theorem}[Orthogonal decomposition]\label{thm:orthogonal-decomposition}
For every subspace $\calS\subseteq\Real^n$,
\[
\Real^n=\calS\dsum\perpc{\calS},
\qquad
\dim\perpc{\calS}=n-\dim\calS,
\qquad
\perpc{(\perpc{\calS})}=\calS.
\]
Thus every $\by\in\Real^n$ has unique $\bs\in\calS$ and
$\bt\in\perpc{\calS}$ such that $\by=\bs+\bt$.
\origin{H Thms.~12.5.4, 12.5.11, and 12.5.12; S Props.~2.4--2.5}
\end{theorem}

\begin{proof}
Let $\bq_1,\ldots,\bq_k$ be an orthonormal basis of $\calS$ and extend it to
an orthonormal basis $\bq_1,\ldots,\bq_n$ of $\Real^n$.  For
$\by=\sum_{j=1}^n c_j\bq_j$, put
\[
\bs=\sum_{j=1}^k c_j\bq_j,
\qquad
\bt=\sum_{j=k+1}^n c_j\bq_j.
\]
Then $\bs\in\calS$ and, for $1\leqslant i\leqslant k$,
\[
\bq_i'\bt=\sum_{j=k+1}^n c_j\bq_i'\bq_j=0,
\]
so $\bt\in\perpc{\calS}$.  If also $\by=\bs_1+\bt_1$, then
\[
\bs-\bs_1=\bt_1-\bt\in\calS\cap\perpc{\calS}=\{\bzero\}.
\]
Hence the sum is direct and the decomposition is unique.  The list
$\bq_{k+1},\ldots,\bq_n$ is an orthonormal basis of $\perpc{\calS}$, giving
$\dim\perpc{\calS}=n-k$.  Since
\[
\calS\subseteq\perpc{(\perpc{\calS})},
\qquad
\dim\perpc{(\perpc{\calS})}=n-(n-k)=k=\dim\calS,
\]
the two subspaces are equal.
\end{proof}

\begin{theorem}[Four fundamental subspaces]\label{thm:four-fundamental}
For $\bA\in\Real^{m\times n}$,
\[
\perpc{\col(\bA)}=\nul(\bA'),
\qquad
\perpc{\row(\bA)}=\nul(\bA).
\]
Consequently,
\[
\Real^m=\col(\bA)\dsum\nul(\bA'),
\qquad
\Real^n=\row(\bA)\dsum\nul(\bA).
\]
\origin{S Prop.~2.6}
\end{theorem}

\begin{proof}
Writing $\bA=(\ba_1,\ldots,\ba_n)$, for $\by\in\Real^m$,
\[
\begin{split}
\by\in\perpc{\col(\bA)}
&\iff \by'\ba_j=0\quad(j=1,\ldots,n)\\
&\iff \bA'\by=\bzero
\iff \by\in\nul(\bA').
\end{split}
\]
Apply this identity to $\bA'$ and use $\row(\bA)=\col(\bA')$:
\[
\perpc{\row(\bA)}
=\perpc{\col(\bA')}
=\nul(\bA).
\]
The two direct sums are the orthogonal-decomposition theorem applied to
$\col(\bA)$ and $\row(\bA)$.
\end{proof}

\subsection{Projection and best approximation}\label{sec:6.2.2}

\begin{definition}[Orthogonal projection]\label{def:orthogonal-projection}
Let $\calS\subseteq\Real^n$ be a subspace.  If
\[
\by=\bs+\bt,
\qquad
\bs\in\calS,
\qquad
\bt\in\perpc{\calS},
\]
then the \emph{orthogonal projection} of $\by$ onto $\calS$ is
$P_{\calS}\by=\bs$.  The map $P_{\calS}$ is the \emph{orthogonal projector}
onto $\calS$.
\origin{H \S12.1}
\end{definition}

\begin{theorem}[Matrix of an orthogonal projection]\label{thm:projection-qqt}
Let $\calS\subseteq\Real^n$ have dimension $k$.  If $k>0$, let
$\bQ\in\Real^{n\times k}$ have orthonormal columns spanning $\calS$.  Then
\[
P_{\calS}\by=\bQ\bQ'\by,
\qquad
\bP_{\calS}=\bQ\bQ'.
\]
If $k=0$, then $\bP_{\calS}=\bO$.  In both cases,
\[
\bM_{\calS}=\bI_n-\bP_{\calS}=\bP_{\perpc{\calS}}.
\]
The map $P_{\calS}$ is linear, and
\[
\col(\bP_{\calS})=\calS,
\quad
\nul(\bP_{\calS})=\perpc{\calS},
\quad
\bP_{\calS}'=\bP_{\calS},
\quad
\bP_{\calS}^2=\bP_{\calS},
\]
\[
\bM_{\calS}'=\bM_{\calS},
\quad
\bM_{\calS}^2=\bM_{\calS},
\quad
\bP_{\calS}\bM_{\calS}=\bM_{\calS}\bP_{\calS}=\bO.
\]
The matrix $\bP_{\calS}$ is independent of the orthonormal basis used for
$\calS$.
\origin{H Thms.~12.1.3--12.1.4 and 12.5.8}
\end{theorem}

\begin{proof}
If $k=0$, then $\calS=\{\bzero\}$ and the orthogonal decomposition is
$\by=\bzero+\by$, giving $\bP_{\calS}=\bO$ and $\bM_{\calS}=\bI_n$.
Moreover,
\[
\col(\bO)=\{\bzero\},
\quad
\nul(\bO)=\Real^n,
\quad
\bO'=\bO^2=\bO,
\quad
\bI_n'=\bI_n^2=\bI_n,
\quad
\bO\bI_n=\bI_n\bO=\bO.
\]
Suppose $k>0$.
Orthonormal coordinates give
\[
\bs=\sum_{j=1}^k(\bq_j'\by)\bq_j=\bQ\bQ'\by\in\calS.
\]
For $\bx=\bQ\bc\in\calS$,
\[
\bx'(\by-\bs)
=\bc'\bQ'(\bI_n-\bQ\bQ')\by
=\bc'(\bQ'-\bQ')\by=0.
\]
Thus $\by-\bs\in\perpc{\calS}$, so uniqueness of the orthogonal decomposition
gives $P_{\calS}\by=\bQ\bQ'\by$.  Matrix multiplication gives linearity and
\[
(\bQ\bQ')'=\bQ\bQ',
\qquad
(\bQ\bQ')^2=\bQ(\bQ'\bQ)\bQ'=\bQ\bQ'.
\]
Moreover,
\[
\bP_{\calS}\bx=\bx\quad(\bx\in\calS),
\qquad
\bP_{\calS}\bx=\bzero\iff\bQ'\bx=\bzero\iff\bx\in\perpc{\calS}.
\]
Hence $\col(\bP_{\calS})=\calS$ and
$\nul(\bP_{\calS})=\perpc{\calS}$.  Since
\[
\by=P_{\calS}\by+(\bI_n-\bP_{\calS})\by
\]
is its orthogonal decomposition, $\bI_n-\bP_{\calS}$ projects onto
$\perpc{\calS}$.  From $\bP_{\calS}'=\bP_{\calS}^2=\bP_{\calS}$,
\[
\bM_{\calS}'=\bI_n-\bP_{\calS}'=\bM_{\calS},
\qquad
\bM_{\calS}^2=\bI_n-2\bP_{\calS}+\bP_{\calS}^2=\bM_{\calS},
\]
\[
\bP_{\calS}\bM_{\calS}
=\bP_{\calS}-\bP_{\calS}^2=\bO,
\qquad
\bM_{\calS}\bP_{\calS}
=\bP_{\calS}-\bP_{\calS}^2=\bO.
\]
Uniqueness of $P_{\calS}\by$ for every $\by$
makes its matrix independent of the chosen basis.
\end{proof}

\begin{theorem}[Best approximation]\label{thm:best-approximation}
For $\by\in\Real^n$ and a subspace $\calS\subseteq\Real^n$,
$P_{\calS}\by$ is the unique minimiser of $\norm{\by-\bs}$ over $\bs\in\calS$.
For every $\bs\in\calS$,
\[
\norm{\by-\bs}^2
=\norm{\by-P_{\calS}\by}^2
+\norm{P_{\calS}\by-\bs}^2.
\]
\origin{H Thm.~12.4.1}
\end{theorem}

\begin{proof}
The vectors $\by-P_{\calS}\by\in\perpc{\calS}$ and
$P_{\calS}\by-\bs\in\calS$ are orthogonal.  Therefore
\[
\norm{\by-\bs}^2
=\norm{(\by-P_{\calS}\by)+(P_{\calS}\by-\bs)}^2
=\norm{\by-P_{\calS}\by}^2+\norm{P_{\calS}\by-\bs}^2.
\]
The second term is nonnegative and is zero if and only if
$\bs=P_{\calS}\by$.
\end{proof}

\begin{theorem}[Characterisation of orthogonal projectors]\label{thm:symmetric-idempotent}
A matrix $\bP\in\Real^{n\times n}$ is the matrix of an orthogonal projection if
and only if
\[
\bP'=\bP,
\qquad
\bP^2=\bP.
\]
In that case it projects onto $\col(\bP)$ and
\[
\nul(\bP)=\perpc{\col(\bP)}.
\]
\origin{H Thm.~12.3.9}
\end{theorem}

\begin{proof}
Every orthogonal projection matrix is symmetric and idempotent by
Theorem~\ref{thm:projection-qqt}.  Conversely, suppose $\bP'=\bP^2=\bP$.
For every $\bx$,
\[
\bx=\bP\bx+(\bI_n-\bP)\bx,
\qquad
\bP\bx\in\col(\bP),
\]
and, for $\bs=\bP\ba\in\col(\bP)$,
\[
\bs'(\bI_n-\bP)\bx
=\ba'\bP'(\bI_n-\bP)\bx
=\ba'(\bP-\bP^2)\bx=0.
\]
Thus $(\bI_n-\bP)\bx\in\perpc{\col(\bP)}$, so $\bP\bx$ is the orthogonal
projection of $\bx$ onto $\col(\bP)$.  If $\bP\bx=\bzero$, then, for every
$\bs=\bP\ba$,
\[
\bs'\bx=\ba'\bP'\bx=\ba'\bP\bx=0,
\]
so $\bx\in\perpc{\col(\bP)}$.  Conversely, if
$\bx\in\perpc{\col(\bP)}$, then
\[
\norm{\bP\bx}^2
=\bx'\bP'\bP\bx
=\bx'\bP\bx=0,
\]
so $\bP\bx=\bzero$.
\end{proof}

\subsection{Full-rank formulas and complementary projectors}\label{sec:6.2.3}

\begin{theorem}[Full-column-rank projection formula]\label{thm:full-rank-projection}
If $\bX\in\Real^{n\times p}$ has rank $p$, then
\[
\bP_{\col(\bX)}
=\bX(\bX'\bX)^{-1}\bX',
\qquad
\bM_{\col(\bX)}
=\bI_n-\bX(\bX'\bX)^{-1}\bX'.
\]
If $\bX=\bQ\bR$ is its thin QR factorisation, then
\[
\bP_{\col(\bX)}=\bQ\bQ'.
\]
\origin{H Cor.~12.2.3; CLM Thms.~2.2--2.3}
\end{theorem}

\begin{proof}
Since $\bR$ is nonsingular,
\[
\col(\bX)=\col(\bQ\bR)=\col(\bQ),
\qquad
\bX'\bX=\bR'\bQ'\bQ\bR=\bR'\bR.
\]
Hence
\[
\begin{split}
\bX(\bX'\bX)^{-1}\bX'
&=\bQ\bR(\bR'\bR)^{-1}\bR'\bQ'\\
&=\bQ\bR\bR^{-1}(\bR')^{-1}\bR'\bQ'
=\bQ\bQ'.
\end{split}
\]
The complementary formula is $\bM_{\calS}=\bI_n-\bP_{\calS}$.
\end{proof}

\begin{theorem}[Trace and rank of an orthogonal projector]\label{thm:projector-trace-rank}
If $\bP$ is the orthogonal projector onto a $k$-dimensional subspace of
$\Real^n$, then
\[
\rank(\bP)=\tr(\bP)=k.
\]
\origin{Adapted from H Cor.~10.2.2 and \S12.1}
\end{theorem}

\begin{proof}
If $k=0$, then $\bP=\bO$, so $\rank(\bP)=\tr(\bP)=0$.  Suppose $k>0$.
Let $\bQ\in\Real^{n\times k}$ have orthonormal columns spanning the subspace.
Then $\bP=\bQ\bQ'$ and $\col(\bP)=\col(\bQ)$, so
\[
\rank(\bP)=\dim\col(\bP)=k.
\]
The cyclic trace identity gives
\[
\tr(\bP)=\tr(\bQ\bQ')=\tr(\bQ'\bQ)=\tr(\bI_k)=k.
\]
\end{proof}

\begin{example}[Mean and centred components]\label{ex:centering-projector}
For $\calS=\spn\{\bone\}\subseteq\Real^n$,
\[
\bq=\frac1{\sqrt n}\bone,
\qquad
\bP_{\calS}=\frac1n\bone\bone',
\qquad
\bM_{\calS}=\bI_n-\frac1n\bone\bone'.
\]
For $\by=(y_1,\ldots,y_n)'$ and $\bar y=n^{-1}\sum_i y_i$,
\[
\bP_{\calS}\by=\bar y\bone,
\qquad
\bM_{\calS}\by=\by-\bar y\bone,
\qquad
\bone'\bM_{\calS}\by=0.
\]
\origin{A\&M Ex.~8.71(a); H \S12.1}
\end{example}

% \periodmark{End of period 2 of 3.}

%=============================================================================
\section{Least squares}\label{sec:6.3}
%=============================================================================

\subsection{Normal equations and all minimisers}\label{sec:6.3.1}

\begin{definition}[Least-squares problem]\label{def:least-squares}
For $\bX\in\Real^{n\times p}$ and $\by\in\Real^n$, a \emph{least-squares
minimiser} is any $\widehat\bb\in\Real^p$ satisfying
\[
\norm{\by-\bX\widehat\bb}^2
=\min_{\bb\in\Real^p}\norm{\by-\bX\bb}^2.
\]
Its fitted vector and residual vector are
\[
\widehat\by=\bX\widehat\bb,
\qquad
\widehat\be=\by-\widehat\by.
\]
\origin{H \S12.4; CLM \S2.1}
\end{definition}

\begin{theorem}[Normal equations and the minimiser set]\label{thm:normal-equations}
For arbitrary $\bX\in\Real^{n\times p}$, the normal equations
\[
\bX'\bX\bb=\bX'\by
\]
are consistent.  For $\bb_0\in\Real^p$, the following are equivalent:
\begin{enumerate}[label=\textup{(\roman*)}]
\item $\bb_0$ is a least-squares minimiser;
\item $\bX\bb_0=P_{\col(\bX)}\by$;
\item $\by-\bX\bb_0\in\nul(\bX')$;
\item $\bX'\bX\bb_0=\bX'\by$.
\end{enumerate}
If $\bb_0$ is one minimiser, then all minimisers form
\[
\bb_0+\nul(\bX).
\]
The fitted vector and residual vector are unique.  The coefficient minimiser is unique
if and only if $\rank(\bX)=p$.
\origin{H Thm.~7.4.1, Cors.~12.2.3--12.2.4, and Thms.~12.4.2--12.4.3}
\end{theorem}

\begin{proof}
Put $\calS=\col(\bX)$ and $\widehat\by=P_{\calS}\by$.  Since
$\widehat\by\in\col(\bX)$, choose $\bb_*$ with
$\bX\bb_*=\widehat\by$.  For every $\bb\in\Real^p$,
\[
\by-\bX\bb=(\by-\widehat\by)+(\widehat\by-\bX\bb),
\]
where the two terms lie in $\perpc{\calS}$ and $\calS$, respectively.  Hence
\[
\norm{\by-\bX\bb}^2
=\norm{\by-\widehat\by}^2
+\norm{\widehat\by-\bX\bb}^2.
\]
Thus $\bb$ minimises the objective if and only if
$\bX\bb=\widehat\by$.  Taking $\bb=\bb_*$ proves existence; taking
$\bb=\bb_0$ proves (i)$\iff$(ii).
The four-fundamental-subspaces theorem gives
\[
\begin{split}
\bX\bb=\widehat\by
&\iff \by-\bX\bb\in\perpc{\col(\bX)}\\
&\iff \by-\bX\bb\in\nul(\bX')\\
&\iff \bX'(\by-\bX\bb)=\bzero,
\end{split}
\]
which proves the remaining equivalences.  If $\bb_0$ is a minimiser, then
\[
\bX\bb=\bX\bb_0
\iff \bX(\bb-\bb_0)=\bzero
\iff \bb\in\bb_0+\nul(\bX).
\]
Every minimiser therefore has the same fit and residual, and it is unique exactly when
\[
\nul(\bX)=\{\bzero\}
\iff \rank(\bX)=p.
\]
\end{proof}

\begin{corollary}[Full-rank least squares by QR]\label{cor:ls-qr}
Let $\bX\in\Real^{n\times p}$ have rank $p$ and thin QR factorisation
$\bX=\bQ\bR$.  The unique least-squares minimiser is
\[
\widehat\bb
=\bR^{-1}\bQ'\by
=(\bX'\bX)^{-1}\bX'\by.
\]
Moreover,
\[
\norm{\by-\bX\bb}^2
=\norm{\bQ'\by-\bR\bb}^2
+\norm{(\bI_n-\bQ\bQ')\by}^2.
\]
\origin{H \S6.4d and Cor.~12.2.3; A\&M Ex.~7.35}
\end{corollary}

\begin{proof}
The orthogonal decomposition of $\by$ gives
\[
\by-\bQ\bR\bb
=\bQ(\bQ'\by-\bR\bb)+(\bI_n-\bQ\bQ')\by.
\]
The summands lie in $\col(\bQ)$ and $\perpc{\col(\bQ)}$, so Parseval's identity
and Pythagoras give the displayed norm identity.  Its first term is zero exactly when
\[
\bR\bb=\bQ'\by
\iff \bb=\bR^{-1}\bQ'\by.
\]
The full-column-rank projection formula gives
\[
\bX(\bX'\bX)^{-1}\bX'\by
=\bQ\bQ'\by
=\bX\bR^{-1}\bQ'\by.
\]
Cancellation by the full-column-rank matrix $\bX$ proves the second coefficient
formula.
\end{proof}

\subsection{Hat, residual, and leverage}\label{sec:6.3.2}

\begin{definition}[Hat matrix, residual maker, and leverage]\label{def:hat-leverage}
For $\bX\in\Real^{n\times p}$, define
\[
\bH=\bP_{\col(\bX)},
\qquad
\bM=\bI_n-\bH.
\]
The diagonal entry $h_{ii}=\eu_i'\bH\eu_i$ is the \emph{leverage} of row $i$.
\origin{CLM Thms.~2.3 and 2.5}
\end{definition}

\begin{theorem}[Fitted and residual identities]\label{thm:hat-residual-identities}
For every least-squares minimiser,
\[
\widehat\by=\bH\by,
\qquad
\widehat\be=\bM\by,
\qquad
\bX'\widehat\be=\bzero,
\qquad
\bH\widehat\be=\bzero,
\qquad
\bM\widehat\by=\bzero,
\]
and
\[
\norm{\by}^2=\norm{\widehat\by}^2+\norm{\widehat\be}^2.
\]
If $\bone\in\col(\bX)$, then $\bone'\widehat\be=0$.
\origin{CLM Thms.~2.3--2.4; H Thm.~12.2.5}
\end{theorem}

\begin{proof}
The normal-equation theorem and complementary projection give
\[
\widehat\by=P_{\col(\bX)}\by=\bH\by,
\qquad
\widehat\be=\by-\widehat\by=\bM\by
\in\perpc{\col(\bX)}=\nul(\bX').
\]
Thus $\bX'\widehat\be=\bzero$.  Since
$\widehat\by\in\col(\bH)$ and
$\widehat\be\in\nul(\bH)=\perpc{\col(\bH)}$,
\[
\bH\widehat\be=\bzero,
\qquad
\bM\widehat\by=(\bI_n-\bH)\widehat\by=\bzero,
\qquad
\widehat\by'\widehat\be=0.
\]
Pythagoras yields the norm identity.  If $\bone\in\col(\bX)$, then
$\widehat\be\perp\bone$, so $\bone'\widehat\be=0$.
\end{proof}

\begin{theorem}[Leverage identities and bounds]\label{thm:leverage}
Let $r=\rank(\bX)$.  If $r>0$, let $\bQ\in\Real^{n\times r}$ have
orthonormal columns spanning $\col(\bX)$.  Then
\[
h_{ii}=\sum_{j=1}^r q_{ij}^2,
\qquad
0\leqslant h_{ii}\leqslant1,
\qquad
\sum_{i=1}^n h_{ii}=r.
\]
For $r=0$, the sum defining $h_{ii}$ is empty and equals zero.
Moreover,
\[
h_{ii}=1\iff \eu_i\in\col(\bX),
\qquad
h_{ii}=0\iff \eu_i\in\perpc{\col(\bX)}.
\]
Writing $\widehat\be=(\widehat\varepsilon_1,\ldots,
\widehat\varepsilon_n)'$, if $h_{ii}=1$, then
$\widehat\varepsilon_i=0$ for every response $\by$.
\origin{CLM Thm.~2.5; H Cor.~10.2.2}
\end{theorem}

\begin{proof}
If $r=0$, then $\col(\bX)=\{\bzero\}$ and $\bH=\bO$, so
\[
h_{ii}=0,
\qquad
\sum_{i=1}^n h_{ii}=0,
\qquad
\eu_i\notin\{\bzero\},
\qquad
\eu_i\in\Real^n=\perpc{\{\bzero\}}.
\]
Suppose $r>0$.
Since $\bH=\bQ\bQ'$,
\[
h_{ii}=\eu_i'\bQ\bQ'\eu_i
=\norm{\bQ'\eu_i}^2
=\sum_{j=1}^r q_{ij}^2
=\norm{\bH\eu_i}^2\geqslant0.
\]
For $\bM=\bI_n-\bH$,
\[
1-h_{ii}=\eu_i'\bM\eu_i=\norm{\bM\eu_i}^2\geqslant0.
\]
The trace-rank theorem gives $\sum_i h_{ii}=\tr(\bH)=r$.  Also,
\[
h_{ii}=1
\iff\bM\eu_i=\bzero
\iff\eu_i\in\nul(\bM)=\col(\bX),
\]
and
\[
h_{ii}=0
\iff\bH\eu_i=\bzero
\iff\eu_i\in\nul(\bH)=\perpc{\col(\bX)}.
\]
If $h_{ii}=1$, then
\[
\widehat\varepsilon_i
=\eu_i'\bM\by
=(\bM\eu_i)'\by=0.
\]
\end{proof}

\subsection{Frisch--Waugh--Lovell decomposition}\label{sec:6.3.3}

\begin{theorem}[Frisch--Waugh--Lovell]\label{thm:fwl}
Let
\[
\bX=(\bX_1,\bX_2)\in\Real^{n\times(p_1+p_2)}
\]
have full column rank, where $p_1,p_2\geqslant1$.  Let $\bP_2$ project onto
$\col(\bX_2)$,
$\bM_2=\bI_n-\bP_2$, and $\bZ=\bM_2\bX_1$.  Write
\[
\bP_{\bX}=\bP_{\col(\bX)},
\qquad
\bP_{\bZ}=\bP_{\col(\bZ)}.
\]
Then $\bZ$ has full column rank,
\[
\col(\bX)=\col(\bX_2)\dsum\col(\bZ),
\qquad
\bP_{\bX}=\bP_2+\bP_{\bZ},
\]
and, for the unique least-squares coefficient
\[
\widehat\bb=(\widehat\bb_1',\widehat\bb_2')',
\]
the first block is
\[
\widehat\bb_1
=(\bX_1'\bM_2\bX_1)^{-1}\bX_1'\bM_2\by
=(\bZ'\bZ)^{-1}\bZ'\bM_2\by.
\]
If $\bM_{\bX}=\bI_n-\bP_{\bX}$ and
$\bM_{\bZ}=\bI_n-\bP_{\bZ}$, then
\[
\bM_{\bX}=\bM_{\bZ}\bM_2=\bM_2\bM_{\bZ}.
\]
\origin{CLM Thm.~8.1; H Thm.~12.3.5}
\end{theorem}

\begin{proof}
If $\bZ\ba=\bzero$, then
\[
\bX_1\ba=\bP_2\bX_1\ba\in\col(\bX_2).
\]
Choose $\bc$ with $\bX_1\ba=\bX_2\bc$.  Full column rank of $\bX$ gives
\[
\bX\begin{pmatrix}\ba\\-\bc\end{pmatrix}=\bzero
\implies \ba=\bzero,
\]
so $\bZ$ has full column rank.  Moreover,
\[
\bX_2'\bZ=\bX_2'\bM_2\bX_1=\bO,
\]
and
\[
\bX_1\ba+\bX_2\bc
=\bZ\ba+(\bP_2\bX_1\ba+\bX_2\bc).
\]
Both summands on the right belong to $\col(\bX)$; they belong respectively to
$\col(\bZ)$ and $\col(\bX_2)$.  Thus
\[
\col(\bX)=\col(\bX_2)\dsum\col(\bZ).
\]
For every $\by$, $\bP_2\by+\bP_{\bZ}\by$ lies in this direct sum.  For
$\bs_2\in\col(\bX_2)$ and $\bz_0\in\col(\bZ)$,
\[
\bs_2'(\by-\bP_2\by-\bP_{\bZ}\by)
=\bs_2'(\by-\bP_2\by)-\bs_2'\bP_{\bZ}\by=0,
\]
\[
\bz_0'(\by-\bP_2\by-\bP_{\bZ}\by)
=\bz_0'(\by-\bP_{\bZ}\by)-\bz_0'\bP_2\by=0.
\]
Hence $\bP_{\bX}=\bP_2+\bP_{\bZ}$.

Since $\bP_2\bX_1\in\col(\bX_2)$, choose $\bC$ such that
$\bP_2\bX_1=\bX_2\bC$.  Then
\[
\bX_1\bb_1+\bX_2\bb_2
=\bZ\bb_1+\bX_2(\bC\bb_1+\bb_2).
\]
The $\col(\bZ)$ component of the fitted vector is $\bP_{\bZ}\by$, so uniqueness
of coordinates in the full-column-rank matrix $\bZ$ gives
\[
\widehat\bb_1=(\bZ'\bZ)^{-1}\bZ'\by.
\]
Because $\bM_2'=\bM_2^2=\bM_2$,
\[
\bZ'\bZ=\bX_1'\bM_2\bX_1,
\qquad
\bZ'\by=\bX_1'\bM_2\by=\bZ'\bM_2\by.
\]
Finally, $\bP_2\bP_{\bZ}=\bP_{\bZ}\bP_2=\bO$, and therefore
\[
\bM_{\bX}
=\bI_n-\bP_2-\bP_{\bZ}
=(\bI_n-\bP_{\bZ})(\bI_n-\bP_2)
=(\bI_n-\bP_2)(\bI_n-\bP_{\bZ}).
\]
\end{proof}

%=============================================================================
\section{Computation: Numerical Checks in R}\label{sec:6.4}
%=============================================================================

\subsection{Gram--Schmidt and QR residuals}\label{sec:6.4.1}

<<gram-schmidt-qr>>=
cgs <- function(A) {
  n <- nrow(A); p <- ncol(A)
  Q <- matrix(0, n, p); R <- matrix(0, p, p)
  for (j in seq_len(p)) {
    if (j == 1L) {
      v <- A[, j]
    } else {
      R[seq_len(j - 1L), j] <- crossprod(Q[, seq_len(j - 1L), drop = FALSE], A[, j])
      v <- A[, j] - Q[, seq_len(j - 1L), drop = FALSE] %*% R[seq_len(j - 1L), j]
    }
    R[j, j] <- sqrt(sum(v^2))
    Q[, j] <- v / R[j, j]
  }
  list(Q = Q, R = R)
}

mgs <- function(A) {
  n <- nrow(A); p <- ncol(A)
  Q <- matrix(0, n, p); R <- matrix(0, p, p)
  for (j in seq_len(p)) {
    v <- A[, j]
    if (j > 1L) {
      for (i in seq_len(j - 1L)) {
        R[i, j] <- sum(Q[, i] * v)
        v <- v - R[i, j] * Q[, i]
      }
    }
    R[j, j] <- sqrt(sum(v^2))
    Q[, j] <- v / R[j, j]
  }
  list(Q = Q, R = R)
}

grid <- seq(0, 1, length.out = 80)
A <- outer(grid, 0:7, `^`)
fac_cgs <- cgs(A)
fac_mgs <- mgs(A)
fac_qr <- qr(A, LAPACK = TRUE)
Q_qr <- qr.Q(fac_qr)
R_qr <- qr.R(fac_qr)
A_qr <- A[, fac_qr$pivot, drop = FALSE]
rbind(
  classical = c(reconstruction = max(abs(A - fac_cgs$Q %*% fac_cgs$R)),
                orthogonality = max(abs(crossprod(fac_cgs$Q) - diag(ncol(A))))),
  modified = c(reconstruction = max(abs(A - fac_mgs$Q %*% fac_mgs$R)),
               orthogonality = max(abs(crossprod(fac_mgs$Q) - diag(ncol(A))))),
  package_qr = c(reconstruction = max(abs(A_qr - Q_qr %*% R_qr)),
                 orthogonality = max(abs(crossprod(Q_qr) - diag(ncol(A)))))
)
@

\subsection{Projection is basis-free}\label{sec:6.4.2}

<<projection-basis-free>>=
data(Boston, package = "ISLR2")
X <- cbind(intercept = 1, as.matrix(Boston[, c("lstat", "rm", "age")]))
H_formula <- X %*% solve(crossprod(X), t(X))
Q <- qr.Q(qr(X, LAPACK = TRUE))
H_qr <- tcrossprod(Q)
Xs <- X[, c(2, 1, 4, 3)] %*% diag(c(10, 1, 0.1, 5))
Qs <- qr.Q(qr(Xs, LAPACK = TRUE))
H_rescaled <- tcrossprod(Qs)
c(formula_vs_qr = max(abs(H_formula - H_qr)),
  qr_vs_rescaled = max(abs(H_qr - H_rescaled)))
@

\subsection{Normal equations and QR}\label{sec:6.4.3}

<<normal-equations-qr>>=
y <- Boston$medv
b_ne <- solve(crossprod(X), crossprod(X, y))
b_qr <- qr.solve(X, y)
fit_ne <- as.vector(X %*% b_ne)
fit_qr <- as.vector(X %*% b_qr)
c(coefficient_difference = max(abs(b_ne - b_qr)),
  fitted_difference = max(abs(fit_ne - fit_qr)),
  normal_residual_normal_equations = max(abs(crossprod(X, y - fit_ne))),
  normal_residual_qr = max(abs(crossprod(X, y - fit_qr))))
@

\subsection{FWL and leverage}\label{sec:6.4.4}

<<fwl-leverage>>=
X1 <- X[, "rm", drop = FALSE]
X2 <- X[, c("intercept", "lstat", "age"), drop = FALSE]
Q2 <- qr.Q(qr(X2, LAPACK = TRUE))
z <- X1 - Q2 %*% crossprod(Q2, X1)
y2 <- y - Q2 %*% crossprod(Q2, y)
b_fwl <- as.numeric(crossprod(z, y2) / crossprod(z))
b_full <- unname(b_qr[match("rm", colnames(X))])
res_full <- y - fit_qr
res_fwl <- as.vector(y2 - z * b_fwl)
h_qr <- rowSums(Q^2)
h_lm <- hatvalues(lm(medv ~ lstat + rm + age, data = Boston))
c(coefficient_difference = abs(b_full - b_fwl),
  residual_difference = max(abs(res_full - res_fwl)),
  leverage_difference = max(abs(h_qr - h_lm)),
  residual_sum = abs(sum(res_full)),
  normal_residual = max(abs(crossprod(X, res_full))))
@

%=============================================================================
\section{Pitfalls}\label{sec:6.5}
%=============================================================================

\subsection{Forming the full hat matrix for its diagonal}\label{sec:6.5.1}

\[
\bQ'\bQ=\bI_r,
\qquad
\col(\bQ)=\col(\bX),
\qquad
\bH=\bQ\bQ'\in\Real^{n\times n},
\qquad
h_{ii}=\sum_{j=1}^r q_{ij}^2.
\]
For $r\geqslant1$, the row sums use $nr$ multiplications and $n(r-1)$ additions.
Forming $\bQ\bQ'$ by scalar products uses $n^2r$ multiplications,
$n^2(r-1)$ additions, and stores $n^2$ entries.

\subsection{Confusing a projection matrix with an orthogonal matrix}\label{sec:6.5.2}

\[
\bP'=\bP,\qquad \bP^2=\bP,\qquad \bP'\bP=\bI_n
\implies
\bI_n=\bP'\bP=\bP^2=\bP.
\]
Thus an orthogonal projection matrix is an orthogonal matrix only when it is
$\bI_n$.

\subsection{Confusing a unique fit with unique coefficients}\label{sec:6.5.3}

\[
\widehat\bb+\bn,\qquad \bn\in\nul(\bX)
\implies
\bX(\widehat\bb+\bn)=\bX\widehat\bb.
\]
The fit is unique for every $\bX$; the coefficient vector is unique exactly when
$\nul(\bX)=\{\bzero\}$.

%=============================================================================
\section{Exercises}\label{sec:6.6}
%=============================================================================

\begin{exercise}\label{ex:gs-dependent-list}
Let $k\geqslant1$ and $\bv_1,\ldots,\bv_k\in\Real^n$.  Set
$\calS_0=\{\bzero\}$ and
$\calS_j=\spn\{\bv_1,\ldots,\bv_j\}$.  At step $j$,
define
\[
\bu_j=\bv_j-P_{\calS_{j-1}}\bv_j.
\]
If $\bu_j\ne\bzero$, retain $\bq=\bu_j/\norm{\bu_j}$; if
$\bu_j=\bzero$, retain no vector.  Prove that the retained vectors are an
orthonormal basis of $\spn\{\bv_1,\ldots,\bv_k\}$.
\origin{H Ex.~6.4}
\end{exercise}

\begin{solution}
For every $j$,
\[
\bu_j=(\bI_n-\bP_{\calS_{j-1}})\bv_j
\in\perpc{\calS_{j-1}},
\qquad
\bv_j=P_{\calS_{j-1}}\bv_j+\bu_j.
\]
If $\bu_j=\bzero$, then $\bv_j\in\calS_{j-1}$ and
$\calS_j=\calS_{j-1}$.  If $\bu_j\ne\bzero$, then the retained unit vector is
orthogonal to every earlier retained vector and
\[
\calS_j=\calS_{j-1}\dsum\spn\{\bu_j\}.
\]
Induction gives an orthonormal basis of
$\calS_k=\spn\{\bv_1,\ldots,\bv_k\}$.
\end{solution}

\begin{exercise}\label{ex:rank-deficient-qr}
Let $\bA\in\Real^{m\times n}$ have rank $r$, where $0<r<n$.  Prove that there
are a permutation matrix $\boldsymbol{\Pi}\in\Real^{n\times n}$, a matrix
$\bQ\in\Real^{m\times r}$ with $\bQ'\bQ=\bI_r$, and
$\bR=(\bR_{11},\bR_{12})\in\Real^{r\times n}$ such that
\[
\bA\boldsymbol{\Pi}=\bQ\bR,
\]
where $\bR_{11}\in\Real^{r\times r}$ is upper triangular with positive
diagonal.
\origin{H Ex.~6.5}
\end{exercise}

\begin{solution}
Select $r$ independent columns of $\bA$ and permute them to the front:
\[
\bA\boldsymbol{\Pi}=(\bB,\bC),
\qquad
\col(\bB)=\col(\bA).
\]
The thin QR factorisation gives
\[
\bB=\bQ\bR_{11},
\qquad
\bQ'\bQ=\bI_r,
\]
with $\bR_{11}$ upper triangular and positive on its diagonal.  Every column of
$\bC$ belongs to $\col(\bQ)$, so orthonormal coordinates give
\[
\bC=\bQ\bQ'\bC.
\]
Taking $\bR_{12}=\bQ'\bC$ yields
\[
\bA\boldsymbol{\Pi}=(\bQ\bR_{11},\bQ\bR_{12})
=\bQ(\bR_{11},\bR_{12}).
\]
\end{solution}

\begin{exercise}\label{ex:gs-residual-projection}
In Gram--Schmidt, let
\[
\bQ_{j-1}=(\bq_1,\ldots,\bq_{j-1}),
\qquad
\calS_{j-1}=\spn\{\bv_1,\ldots,\bv_{j-1}\}.
\]
For $j=2,\ldots,k$, prove
\[
\bu_j=(\bI_n-\bQ_{j-1}\bQ_{j-1}')\bv_j
=P_{\perpc{\calS_{j-1}}}\bv_j,
\]
and
\[
\norm{\bu_j}=\min_{\bs\in\calS_{j-1}}\norm{\bv_j-\bs}.
\]
\origin{H Ex.~12.8}
\end{exercise}

\begin{solution}
The prefix-span identity gives $\col(\bQ_{j-1})=\calS_{j-1}$.  Hence
\[
P_{\calS_{j-1}}=\bQ_{j-1}\bQ_{j-1}',
\qquad
P_{\perpc{\calS_{j-1}}}=\bI_n-\bQ_{j-1}\bQ_{j-1}',
\]
and the first identity is the Gram--Schmidt formula.  Best approximation gives
\[
\norm{\bv_j-P_{\calS_{j-1}}\bv_j}
=\min_{\bs\in\calS_{j-1}}\norm{\bv_j-\bs}.
\]
\end{solution}

\begin{exercise}\label{ex:qr-gram-normal-equations}
Let $\bA=\bQ\bR$ be the thin QR factorisation of a full-column-rank matrix.
Prove
\[
\bA'\bA=\bR'\bR
\]
and show that the normal equations for $\min_{\bx}\norm{\bbb-\bA\bx}^2$ are
equivalent to
\[
\bR\bx=\bQ'\bbb.
\]
\origin{H Ex.~14.23; H \S12.4}
\end{exercise}

\begin{solution}
\[
\bA'\bA=\bR'\bQ'\bQ\bR=\bR'\bR.
\]
The normal equations reduce to
\[
\bR'\bR\bx=\bR'\bQ'\bbb.
\]
The positive diagonal of $\bR$ makes $\bR'$ nonsingular, so multiplication by
$(\bR')^{-1}$ gives $\bR\bx=\bQ'\bbb$; multiplication by $\bR'$ proves the
reverse implication.
\end{solution}

\begin{exercise}\label{ex:reflection-from-projector}
Let $\bP$ be the orthogonal projector onto $\calS\subseteq\Real^n$ and define
$\bR=\bI_n-2\bP$.  Prove
\[
\bR'=\bR,
\qquad
\bR'\bR=\bI_n,
\qquad
\bR\bs=-\bs\ (\bs\in\calS),
\qquad
\bR\bt=\bt\ (\bt\in\perpc{\calS}).
\]
\origin{H Ex.~10.3}
\end{exercise}

\begin{solution}
Since $\bP'=\bP^2=\bP$,
\[
\bR'=\bI_n-2\bP'=\bR,
\qquad
\bR'\bR=\bR^2
=\bI_n-4\bP+4\bP^2=\bI_n.
\]
For $\bs\in\calS$ and $\bt\in\perpc{\calS}$,
\[
\bP\bs=\bs,
\qquad
\bP\bt=\bzero,
\]
which gives the two action identities.
\end{solution}

\begin{exercise}\label{ex:idempotent-split}
Let $\bE\in\Real^{n\times n}$ satisfy $\bE^2=\bE$.  Prove
\[
\Real^n=\col(\bE)\dsum\nul(\bE).
\]
Prove that $\bE$ is symmetric if and only if
$\col(\bE)\perp\nul(\bE)$.
\origin{S Ex.~3.5(a); H Thm.~12.3.9}
\end{exercise}

\begin{solution}
For every $\bx$,
\[
\bx=\bE\bx+(\bI_n-\bE)\bx,
\qquad
\bE\bx\in\col(\bE),
\qquad
\bE(\bI_n-\bE)\bx=\bzero.
\]
If $\bx\in\col(\bE)\cap\nul(\bE)$, write $\bx=\bE\ba$; then
\[
\bx=\bE\ba=\bE^2\ba=\bE\bx=\bzero.
\]
This proves the direct sum.  If $\bE'=\bE$, $\bs=\bE\ba$, and
$\bn\in\nul(\bE)$, then
\[
\bs'\bn=\ba'\bE'\bn=\ba'\bE\bn=0.
\]
Conversely, if the two summands are orthogonal, the displayed decomposition is the
orthogonal decomposition onto $\col(\bE)$ and $\bE\bx$ is its orthogonal
projection.  The projector characterisation gives $\bE'=\bE$.
\end{solution}

\begin{exercise}\label{ex:nested-projector-difference}
Let $\calT\subseteq\calS\subseteq\Real^n$ with orthogonal projectors
$\bP_{\calT}$ and $\bP_{\calS}$.  Prove
\[
\bP_{\calT}\bP_{\calS}=\bP_{\calS}\bP_{\calT}=\bP_{\calT}
\]
and prove that $\bP_{\calS}-\bP_{\calT}$ is the orthogonal projector onto
$\calS\cap\perpc{\calT}$.  Deduce
\[
\tr(\bP_{\calS}-\bP_{\calT})=\dim\calS-\dim\calT.
\]
\origin{H Thm.~12.3.5; A\&M Ex.~8.70}
\end{exercise}

\begin{solution}
For every $\bx$,
\[
\bP_{\calS}\bP_{\calT}\bx=\bP_{\calT}\bx
\]
because $\bP_{\calT}\bx\in\calT\subseteq\calS$.  Also
$\bx-\bP_{\calS}\bx\in\perpc{\calS}\subseteq\perpc{\calT}$, so
\[
\bP_{\calT}\bx
=\bP_{\calT}\bP_{\calS}\bx
+\bP_{\calT}(\bx-\bP_{\calS}\bx)
=\bP_{\calT}\bP_{\calS}\bx.
\]
Put $\bD=\bP_{\calS}-\bP_{\calT}$.  Then
\[
\bD'=\bD,
\qquad
\bD^2
=\bP_{\calS}-\bP_{\calT}-\bP_{\calT}+\bP_{\calT}
=\bD.
\]
Thus $\bD$ is an orthogonal projector.  For every $\bx$,
\[
\bD\bx\in\calS,
\qquad
\bP_{\calT}\bD\bx=\bzero,
\]
so $\col(\bD)\subseteq\calS\cap\perpc{\calT}$.  If
$\bz\in\calS\cap\perpc{\calT}$, then
\[
\bD\bz=\bP_{\calS}\bz-\bP_{\calT}\bz=\bz,
\]
which proves the reverse inclusion.  Finally,
\[
\tr(\bD)=\tr(\bP_{\calS})-\tr(\bP_{\calT})
=\dim\calS-\dim\calT.
\]
\end{solution}

\begin{exercise}\label{ex:orthogonal-sum-projector}
Let $\calS\perp\calT$, with orthogonal projectors $\bP_{\calS}$ and
$\bP_{\calT}$.  Prove that $\bP_{\calS}+\bP_{\calT}$ is the orthogonal
projector onto $\calS\dsum\calT$, and deduce
\[
\rank(\bP_{\calS}+\bP_{\calT})
=\rank(\bP_{\calS})+\rank(\bP_{\calT}).
\]
\origin{A\&M Ex.~8.64}
\end{exercise}

\begin{solution}
For $\bs\in\calS$, $\bt\in\calT$,
\[
\bP_{\calS}\bt=\bzero,
\qquad
\bP_{\calT}\bs=\bzero,
\]
so $\bP_{\calS}\bP_{\calT}=\bP_{\calT}\bP_{\calS}=\bO$.  Hence
\[
(\bP_{\calS}+\bP_{\calT})'
=\bP_{\calS}+\bP_{\calT},
\qquad
(\bP_{\calS}+\bP_{\calT})^2
=\bP_{\calS}+\bP_{\calT}.
\]
Its column space is contained in $\calS+\calT$, and it fixes every
$\bs+\bt\in\calS+\calT$.  It is therefore the orthogonal projector onto
$\calS\dsum\calT$.  The trace-rank identity gives
\[
\rank(\bP_{\calS}+\bP_{\calT})
=\tr(\bP_{\calS}+\bP_{\calT})
=\rank(\bP_{\calS})+\rank(\bP_{\calT}).
\]
\end{solution}

\begin{exercise}\label{ex:frobenius-least-squares}
Let $\bX\in\Real^{n\times p}$ and $\bY\in\Real^{n\times q}$.  Prove that
$\bB_0\in\Real^{p\times q}$ minimises
$\norm{\bY-\bX\bB}_F^2$ if and only if
\[
\bX'\bX\bB_0=\bX'\bY.
\]
Prove that $\bX\bB_0=\bH\bY$ is unique even when $\bB_0$ is not.
\origin{H Ex.~12.3}
\end{exercise}

\begin{solution}
Write $\bY=(\by_1,\ldots,\by_q)$ and
$\bB=(\bb_1,\ldots,\bb_q)$.  Then
\[
\norm{\bY-\bX\bB}_F^2
=\sum_{j=1}^q\norm{\by_j-\bX\bb_j}^2.
\]
The sum is minimised if and only if every summand is minimised.  The normal-equation
theorem gives
\[
(\forall j)\ \bX'\bX\bb_j=\bX'\by_j
\iff
\bX'\bX\bB=\bX'\bY.
\]
For every minimiser and every $j$,
\[
\bX\bb_j=\bH\by_j,
\]
so $\bX\bB=\bH\bY$ is unique.
\end{solution}

\newpage
\begin{exercise}\label{ex:model-space-least-squares}
Let $\bX\in\Real^{n\times p}$ and $\bZ\in\Real^{n\times q}$ satisfy
$\col(\bX)=\col(\bZ)$.  Prove that, for every response $\by$, least squares
with $\bX$ and least squares with $\bZ$ have the same fitted vector, residual vector,
and minimum residual sum of squares.  If
\[
\bX=\bZ\bF,
\qquad
\bZ=\bX\bG,
\]
and $\bb_0,\bgamma_0$ are respective minimisers, prove that the two coefficient
minimiser sets are
\[
\bb_0+\nul(\bX),
\qquad
\bgamma_0+\nul(\bZ).
\]
Prove also that $\bF$ maps every $\bX$-coefficient minimiser to a
$\bZ$-coefficient minimiser, while $\bG$ maps in the reverse direction.
\origin{H Thm.~12.4.3 and Lemma~4.2.2}
\end{exercise}

\begin{solution}
The common column space has one orthogonal projector $\bH$.  In both problems,
\[
\widehat\by=\bH\by,
\qquad
\widehat\be=(\bI_n-\bH)\by,
\]
Moreover,
\[
\min_{\bb}\norm{\by-\bX\bb}^2
=\norm{(\bI_n-\bH)\by}^2
=\min_{\bgamma}\norm{\by-\bZ\bgamma}^2.
\]
The normal-equation theorem gives the coefficient minimiser sets
\[
\bb_0+\nul(\bX),
\qquad
\bgamma_0+\nul(\bZ).
\]
If $\widehat\bb$ minimises the $\bX$ problem, then
\[
\bZ(\bF\widehat\bb)=\bX\widehat\bb=\bH\by,
\]
so $\bF\widehat\bb$ minimises the $\bZ$ problem.  If $\widehat\bgamma$
minimises the $\bZ$ problem, then
\[
\bX(\bG\widehat\bgamma)=\bZ\widehat\bgamma=\bH\by,
\]
so $\bG\widehat\bgamma$ minimises the $\bX$ problem.
\end{solution}

\begin{exercise}\label{ex:nested-rss}
Let $\calT\subseteq\calS\subseteq\Real^n$ and define
\[
\RSS_{\calS}(\by)=\norm{(\bI_n-\bP_{\calS})\by}^2,
\qquad
\RSS_{\calT}(\by)=\norm{(\bI_n-\bP_{\calT})\by}^2.
\]
Prove
\[
\RSS_{\calT}(\by)-\RSS_{\calS}(\by)
=\norm{(\bP_{\calS}-\bP_{\calT})\by}^2\geqslant0,
\]
and determine when equality holds.
\origin{CLM Ex.~11.14(a); H Thm.~12.4.1}
\end{exercise}

\begin{solution}[qedhere]
The three vectors
\[
\bP_{\calT}\by,
\qquad
(\bP_{\calS}-\bP_{\calT})\by,
\qquad
(\bI_n-\bP_{\calS})\by
\]
belong respectively to $\calT$, $\calS\cap\perpc{\calT}$, and
$\perpc{\calS}$, so they are pairwise orthogonal.  Since
\[
(\bI_n-\bP_{\calT})\by
=(\bP_{\calS}-\bP_{\calT})\by
+(\bI_n-\bP_{\calS})\by,
\]
Pythagoras gives the identity.  Equality holds exactly when
\[
(\bP_{\calS}-\bP_{\calT})\by=\bzero
\iff
\bP_{\calS}\by=\bP_{\calT}\by.
\tag*{\textcolor{solFR}{$\blacksquare$}}
\]
\end{solution}

\begin{exercise}\label{ex:sequential-fwl}
Let $(\bX_1,\bX_2,\bX_3)$ have full column rank and put
$\bC=(\bX_2,\bX_3)$.  Let $\bP_3$ project onto $\col(\bX_3)$, put
$\bM_3=\bI_n-\bP_3$, and let $\bP_{23}$ project onto $\col(\bC)$.  If
$\bW=\bM_3\bX_2$, let $\bP_{\bW}$ project onto $\col(\bW)$, and put
$\bM_{\bW}=\bI_n-\bP_{\bW}$.  Prove
\[
\bI_n-\bP_{23}=\bM_{\bW}\bM_3=\bM_3\bM_{\bW}.
\]
Deduce that the coefficient on $\bX_1$ can be obtained after successively
residualising $\bX_1$ and $\by$ on $\bX_3$ and then on $\bW$.
\origin{CLM Thm.~8.1 and Ex.~11.18}
\end{exercise}

\begin{solution}
Apply the FWL decomposition to $(\bX_2,\bX_3)$:
\[
\bP_{23}=\bP_3+\bP_{\bW},
\qquad
\bP_3\bP_{\bW}=\bP_{\bW}\bP_3=\bO.
\]
Therefore
\[
\bI_n-\bP_{23}
=(\bI_n-\bP_{\bW})(\bI_n-\bP_3)
=(\bI_n-\bP_3)(\bI_n-\bP_{\bW}).
\]
Put $\bM_{23}=\bI_n-\bP_{23}$, $\bX_1^*=\bM_{23}\bX_1$, and
$\by^*=\bM_{23}\by$.  FWL applied to
$(\bX_1,\bC)$ gives
\[
(\bX_1^*)'\bX_1^*=\bX_1'\bM_{23}\bX_1,
\qquad
(\bX_1^*)'\by^*=\bX_1'\bM_{23}\by,
\]
\[
\widehat\bb_1
=(\bX_1'\bM_{23}\bX_1)^{-1}\bX_1'\bM_{23}\by
=((\bX_1^*)'\bX_1^*)^{-1}(\bX_1^*)'\by^*.
\]
The identity $\bM_{23}=\bM_{\bW}\bM_3$ is the asserted successive
residualisation.
\end{solution}

\begin{exercise}\label{ex:short-full-coefficient-identity}
Let $\bX=(\bX_1,\bX_2)$ have full column rank and suppose $\bX_1$ has full
column rank.  Let $\widetilde\bb_1$ be the coefficient from least squares of
$\by$ on $\bX_1$ alone, and let $(\widehat\bb_1',\widehat\bb_2')'$ be the
coefficient from least squares on $\bX$.  Prove the deterministic identity
\[
\widetilde\bb_1
=\widehat\bb_1
+(\bX_1'\bX_1)^{-1}\bX_1'\bX_2\widehat\bb_2.
\]
\origin{CLM Thm.~8.2 and Ex.~11.19}
\end{exercise}

\begin{solution}
The full residual
\[
\widehat\be
=\by-\bX_1\widehat\bb_1-\bX_2\widehat\bb_2
\]
satisfies $\bX_1'\widehat\be=\bzero$.  Hence
\[
\begin{split}
\widetilde\bb_1
&=(\bX_1'\bX_1)^{-1}\bX_1'\by\\
&=(\bX_1'\bX_1)^{-1}\bX_1'
(\bX_1\widehat\bb_1+\bX_2\widehat\bb_2+\widehat\be)\\
&=\widehat\bb_1
+(\bX_1'\bX_1)^{-1}\bX_1'\bX_2\widehat\bb_2.
\end{split}
\]
\end{solution}

\begin{exercise}\label{ex:leverage-intercept-bound}
Let $\bX\in\Real^{n\times p}$ have rank $r$ and satisfy
$\bone\in\col(\bX)$.  Prove
\[
\frac1n\leqslant h_{ii}\leqslant1,
\qquad i=1,\ldots,n.
\]
Also prove
\[
\min_i h_{ii}\leqslant\frac rn\leqslant\max_i h_{ii}.
\]
\origin{CLM Thm.~2.5 and Ex.~11.12(a)--(b)}
\end{exercise}

\begin{solution}
The unit vector $\bq_1=n^{-1/2}\bone$ extends to an orthonormal basis
$\bq_1,\ldots,\bq_r$ of $\col(\bX)$.  Therefore
\[
h_{ii}=\sum_{j=1}^r q_{ij}^2
=\frac1n+\sum_{j=2}^r q_{ij}^2
\geqslant\frac1n.
\]
The upper bound was proved in the leverage theorem.  Since
\[
\frac1n\sum_{i=1}^n h_{ii}=\frac rn,
\]
the mean lies between the minimum and maximum.
\end{solution}

\begin{exercise}\label{ex:demeaning-fwl}
Let $(\bone,\bZ)\in\Real^{n\times(q+1)}$ have full column rank.  Put
\[
\bM_1=\bI_n-\frac1n\bone\bone',
\qquad
\bar y=\frac1n\bone'\by,
\qquad
\bar\bz'=\frac1n\bone'\bZ.
\]
\tcbbreak
For least squares of $\by$ on $(\bone,\bZ)$, prove
\[
\widehat\bb_Z
=(\bZ'\bM_1\bZ)^{-1}\bZ'\bM_1\by,
\qquad
\widehat\beta_0=\bar y-\bar\bz'\widehat\bb_Z,
\qquad
\bone'\widehat\be=0.
\]
\origin{A\&M Ex.~8.71(a)--(c); CLM Thm.~8.1}
\end{exercise}

\begin{solution}
The projector onto $\spn\{\bone\}$ is $n^{-1}\bone\bone'$, so FWL with
$\bX_1=\bZ$ and $\bX_2=\bone$ gives
\[
\widehat\bb_Z
=(\bZ'\bM_1\bZ)^{-1}\bZ'\bM_1\by.
\]
The intercept normal equation is
\[
0=\bone'(\by-\bone\widehat\beta_0-\bZ\widehat\bb_Z)
=n\bar y-n\widehat\beta_0-n\bar\bz'\widehat\bb_Z,
\]
which gives the intercept formula and $\bone'\widehat\be=0$.
\end{solution}


