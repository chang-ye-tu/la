%=============================================================================
\section{Rank}\label{sec:3.1}
%=============================================================================

\subsection{Full-rank factorisation}\label{sec:3.1.1}

\begin{definition}[Singular and nonsingular]\label{def:singular}
A square $\bA\in\Real^{n\times n}$ is \emph{nonsingular} if $\rank(\bA)=n$ and
\emph{singular} if $\rank(\bA)<n$.
\origin{H \S4.4(c); A\&M \S4.1}
\end{definition}

\begin{theorem}[Full-rank factorisation]\label{thm:full-rank-factorization}
If $\bA\in\Real^{m\times n}$ has rank $r$, then
\[
\bA=\bB\bC,
\qquad
\bB\in\Real^{m\times r},\quad \rank(\bB)=r,
\qquad
\bC\in\Real^{r\times n},\quad \rank(\bC)=r.
\]
For $r=0$, both factors have no columns or no rows, respectively, and their product is
$\bO$.
\origin{H Thm.~4.4.8; A\&M Ex.~4.11(a)}
\end{theorem}

\begin{proof}
For $r>0$, choose basis columns $\bu_1,\ldots,\bu_r$ of $\col(\bA)$ and set
$\bB=(\bu_1,\ldots,\bu_r)$.  For each column $\ba_j$ of $\bA$, unique coordinates
$c_{1j},\ldots,c_{rj}$ satisfy
\[
\ba_j=\sum_{i=1}^r c_{ij}\bu_i.
\]
With $\bC=(c_{ij})$, these $n$ identities give $\bA=\bB\bC$.  The columns of $\bB$
are independent, so $\rank(\bB)=r$.  Every row of $\bA=\bB\bC$ is a linear
combination of the rows of $\bC$; equality of row and column rank gives
\[
r=\rank(\bA)\leqslant\rank(\bC)\leqslant r.
\]
Thus $\rank(\bC)=r$.  If $r=0$, $\bA=\bO$.
\end{proof}

\begin{corollary}[Rank-one expansion]\label{cor:rank-one-expansion}
Every rank-$r$ matrix admits
\[
\bA=\sum_{k=1}^r\bu_k\bc_k',
\]
\tcbbreak
where every nonzero summand has rank one.  No sum of fewer than $r$ rank-one matrices
can equal $\bA$.
\origin{Course formulation from H Ex.~4.10; A\&M Ex.~4.11(b); S \S3.8}
\end{corollary}

\begin{proof}
Write the factorisation of Theorem~\ref{thm:full-rank-factorization} as
\[
\bA=(\bu_1,\ldots,\bu_r)
\begin{pmatrix}\bc_1'\\ \vdots\\ \bc_r'\end{pmatrix}
=\sum_{k=1}^r\bu_k\bc_k'.
\]
For nonzero $\bu,\bv$, every column of $\bu\bv'$ is a multiple of $\bu$, and at least
one is nonzero; hence $\rank(\bu\bv')=1$.  If
$\bA=\sum_{k=1}^s\bA_k$ and $\rank(\bA_k)=1$, choose nonzero
$\bu_k\in\col(\bA_k)$.  Then
\[
\col(\bA_k)=\spn\{\bu_k\},
\qquad
\col(\bA)\subseteq\spn\{\bu_1,\ldots,\bu_s\},
\]
so $r\leqslant s$.
\end{proof}

\begin{example}[A $3$ by $4$ factorisation]\label{ex:rank-factorization}
\[
\bA=
\begin{pmatrix}
1&0&-1&0\\0&1&3&2\\1&1&2&2
\end{pmatrix}
=
\underbrace{\begin{pmatrix}1&0\\0&1\\1&1\end{pmatrix}}_{\bB}
\underbrace{\begin{pmatrix}1&0&-1&0\\0&1&3&2\end{pmatrix}}_{\bC}.
\]
The first two columns of $\bA$ are independent, and every column belongs to their span;
hence $\rank(\bA)=2$.  Also
\[
\bA=
\begin{pmatrix}1\\0\\1\end{pmatrix}
\begin{pmatrix}1&0&-1&0\end{pmatrix}
+
\begin{pmatrix}0\\1\\1\end{pmatrix}
\begin{pmatrix}0&1&3&2\end{pmatrix}.
\]
\origin{Course formulation from H Thm.~4.4.8}
\end{example}

\subsection{Products and sums}\label{sec:3.1.2}

\begin{theorem}[Rank of a product]\label{thm:rank-product}
For $\bA\in\Real^{m\times n}$ and $\bB\in\Real^{n\times p}$,
\[
\rank(\bA\bB)\leqslant\min\{\rank(\bA),\rank(\bB)\}.
\]
Moreover,
\[
\begin{array}{ll}
\rank(\bA\bB)=\rank(\bB),&\text{if $\bA$ has full column rank},\\
\rank(\bA\bB)=\rank(\bA),&\text{if $\bB$ has full row rank}.
\end{array}
\]
\origin{H Cor.~4.4.5 and Lemma~8.3.2; A\&M Ex.~4.15 and 4.25(c)--(d)}
\end{theorem}

\begin{proof}
Since $\col(\bA\bB)\subseteq\col(\bA)$,
$\rank(\bA\bB)\leqslant\rank(\bA)$.  Applying this result to
$(\bA\bB)'=\bB'\bA'$ gives $\rank(\bA\bB)\leqslant\rank(\bB)$.

If $\bA$ has full column rank, then $\nul(\bA)=\{\bzero\}$ and
\[
\bA\bB\bx=\bzero
\iff \bB\bx\in\nul(\bA)
\iff \bB\bx=\bzero.
\]
Thus $\nul(\bA\bB)=\nul(\bB)$; rank--nullity gives equal ranks.  If $\bB$ has full
row rank, then $\col(\bB)=\Real^n$, so
\[
\col(\bA\bB)=\{\bA\by:\by\in\col(\bB)\}
=\{\bA\by:\by\in\Real^n\}=\col(\bA).
\]
\end{proof}

\begin{theorem}[Sylvester's rank inequality]\label{thm:sylvester-rank}
For $\bA\in\Real^{m\times n}$ and $\bB\in\Real^{n\times p}$,
\[
\rank(\bA\bB)\geqslant\rank(\bA)+\rank(\bB)-n.
\]
More precisely,
\[
\rank(\bA\bB)
=\rank(\bB)-\dim\bigl(\col(\bB)\cap\nul(\bA)\bigr).
\]
\origin{H Cor.~17.5.2 and Eq.~17.5.17; A\&M Ex.~5.47(b)}
\end{theorem}

\begin{proof}
Define $S:\col(\bB)\to\Real^m$ by $S(\by)=\bA\by$.  Then
\[
\im(S)=\{\bA\bB\bx:\bx\in\Real^p\}=\col(\bA\bB),
\qquad
\ker(S)=\col(\bB)\cap\nul(\bA).
\]
Rank--nullity for $S$ gives the equality.  Since
\[
\dim\bigl(\col(\bB)\cap\nul(\bA)\bigr)
\leqslant\dim\nul(\bA)=n-\rank(\bA),
\]
the inequality follows.
\end{proof}

\begin{theorem}[Ranks of a sum and a difference]\label{thm:rank-sum}
For $\bA,\bB\in\Real^{m\times n}$,
\[
\rank(\bA+\bB)\leqslant\rank(\bA)+\rank(\bB),
\qquad
|\rank(\bA)-\rank(\bB)|\leqslant\rank(\bA-\bB).
\]
\origin{H Cor.~4.5.9; A\&M Ex.~4.14}
\end{theorem}

\begin{proof}
Every column of $\bA+\bB$ lies in $\col(\bA)+\col(\bB)$; hence the dimension formula
gives
\[
\rank(\bA+\bB)
\leqslant\dim(\col(\bA)+\col(\bB))
\leqslant\rank(\bA)+\rank(\bB).
\]
Apply this inequality to $\bA=(\bA-\bB)+\bB$ and
$\bB=-(\bA-\bB)+\bA$:
\[
\rank(\bA)-\rank(\bB)\leqslant\rank(\bA-\bB),
\quad
\rank(\bB)-\rank(\bA)\leqslant\rank(\bA-\bB).
\]
\end{proof}

\begin{example}[Sharp and strict rank bounds]\label{ex:rank-bounds}
For
\[
\bA=\begin{pmatrix}1&0\\0&0\end{pmatrix},
\qquad
\bB=\begin{pmatrix}0&0\\0&1\end{pmatrix},
\]
\[
\rank(\bA)=\rank(\bB)=1,
\quad \rank(\bA\bB)=0,
\quad \rank(\bA+\bB)=2.
\]
Thus the product upper bound can be strict, while Sylvester's lower bound and the sum
upper bound are attained.
\origin{Course formulation from A\&M Ex.~4.14--4.15}
\end{example}

\subsection{The Gram matrix}\label{sec:3.1.3}

\begin{theorem}[Gram rank theorem]\label{thm:gram-rank}
For every $\bA\in\Real^{m\times n}$,
\[
\nul(\bA'\bA)=\nul(\bA),
\qquad
\rank(\bA'\bA)=\rank(\bA),
\qquad
\col(\bA'\bA)=\col(\bA').
\]
The transposed statements give
$\rank(\bA\bA')=\rank(\bA)$ and $\col(\bA\bA')=\col(\bA)$.
\origin{H Cor.~7.4.5; A\&M Ex.~4.13}
\end{theorem}

\begin{proof}
For $\bx\in\Real^n$,
\[
\bA\bx=\bzero\implies\bA'\bA\bx=\bzero.
\]
Conversely,
\[
\bA'\bA\bx=\bzero
\implies
0=\bx'\bA'\bA\bx=(\bA\bx)'(\bA\bx)=\|\bA\bx\|^2
\implies \bA\bx=\bzero.
\]
Equal nullities and rank--nullity give equal ranks.  Since
$\col(\bA'\bA)\subseteq\col(\bA')$ and the two spaces have equal dimension, they are
equal.  Replace $\bA$ by $\bA'$ for the remaining identities.
\end{proof}

\begin{corollary}[Full column rank and the Gram matrix]\label{cor:gram-nonsingular}
For $\bA\in\Real^{m\times n}$,
\[
\bA\text{ has full column rank}
\iff \bA'\bA\text{ is nonsingular}.
\]
Similarly, $\bA$ has full row rank if and only if $\bA\bA'$ is nonsingular.
\origin{H Cor.~7.4.5--7.4.6; A\&M Ex.~4.13(d)}
\end{corollary}

\begin{proof}
The square matrix $\bA'\bA$ has order $n$.  By Theorem~\ref{thm:gram-rank},
\[
\rank(\bA'\bA)=n\iff\rank(\bA)=n.
\]
Apply the same argument to $\bA'$ for the row statement.
\end{proof}

\begin{example}[A rank-deficient Gram matrix]\label{ex:gram-rank}
Let
\[
\bX=\begin{pmatrix}1&0&1\\0&1&1\\1&1&2\end{pmatrix},
\qquad
\bX'\bX=\begin{pmatrix}2&1&3\\1&2&3\\3&3&6\end{pmatrix}.
\]
The third column of $\bX$ is the sum of the first two, and
\[
\bX\begin{pmatrix}1\\1\\-1\end{pmatrix}=\bzero,
\qquad
\bX'\bX\begin{pmatrix}1\\1\\-1\end{pmatrix}=\bzero.
\]
The first two columns of $\bX$ are independent, so both matrices have rank $2$.
\origin{Course formulation from H Cor.~7.4.5}
\end{example}

% \periodmark{End of period 1 of 3.}

%=============================================================================
\section{The inverse}\label{sec:3.2}
%=============================================================================

\subsection{Existence, uniqueness, and algebra}\label{sec:3.2.1}

\begin{definition}[One-sided and two-sided inverses]\label{def:inverse}
For $\bA\in\Real^{m\times n}$, a matrix $\bR\in\Real^{n\times m}$ is a
\emph{right inverse} if $\bA\bR=\bI_m$, and a matrix
$\bL\in\Real^{n\times m}$ is a \emph{left inverse} if $\bL\bA=\bI_n$.
If one matrix $\bB$ is both, then $\bA$ is \emph{invertible} and
$\bB=\bA^{-1}$.
\origin{H \S8.1; A\&M \S4.2}
\end{definition}

\begin{theorem}[Existence of one-sided inverses]\label{thm:one-sided-existence}
For $\bA\in\Real^{m\times n}$:
\[
\begin{aligned}
\bA\text{ has a right inverse}&\iff\rank(\bA)=m,\\
\bA\text{ has a left inverse}&\iff\rank(\bA)=n.
\end{aligned}
\]
Consequently, a right inverse requires $m\leqslant n$, and a left inverse requires
$n\leqslant m$.
\origin{H Lemma~8.1.1}
\end{theorem}

\begin{proof}
If $\bA\bR=\bI_m$, then
\[
m=\rank(\bI_m)=\rank(\bA\bR)\leqslant\rank(\bA)\leqslant m.
\]
Conversely, if $\rank(\bA)=m$, each $\eu_j\in\Real^m$ has the form
$\eu_j=\bA\br_j$.  Then $\bR=(\br_1,\ldots,\br_m)$ satisfies $\bA\bR=\bI_m$.
The left-inverse assertion follows by applying the right-inverse assertion to $\bA'$ and
transposing.
\end{proof}

\begin{theorem}[Square inverse theorem]\label{thm:square-inverse}
For $\bA\in\Real^{n\times n}$, the following are equivalent:
\begin{enumerate}[label=\textup{(\roman*)}]
\item $\bA$ is nonsingular;
\item $\bA$ has a right inverse;
\item $\bA$ has a left inverse;
\item $\bA$ is invertible.
\end{enumerate}
Every one-sided inverse is the unique two-sided inverse.
\origin{H Lemma~8.1.3 and Thm.~8.1.4; A\&M Ex.~4.20--4.21}
\end{theorem}

\begin{proof}
Theorem~\ref{thm:one-sided-existence} gives (i)$\iff$(ii)$\iff$(iii).  Suppose
$\bA\bR=\bI_n$.  Then $\bA$ also has a left inverse $\bL$, and
\[
\bL=\bL(\bA\bR)=(\bL\bA)\bR=\bR.
\]
Thus $\bR\bA=\bI_n$, proving (ii)$\implies$(iv); the left-sided case is symmetric.
If $\bB$ and $\bC$ are inverses, then
\[
\bB=\bB(\bA\bC)=(\bB\bA)\bC=\bC.
\]
\end{proof}

\begin{theorem}[Inverse identities]\label{thm:inverse-identities}
For invertible square matrices $\bA,\bB$ of the same order and $c\neq0$,
\[
\begin{gathered}
(c\bA)^{-1}=c^{-1}\bA^{-1},
\qquad
(\bA')^{-1}=(\bA^{-1})',
\qquad
(\bA^{-1})^{-1}=\bA,\\
(\bA\bB)^{-1}=\bB^{-1}\bA^{-1}.
\end{gathered}
\]
\origin{H Eqs.~8.2.1--8.2.8; S Prop.~3.6; A\&M Ex.~4.22}
\end{theorem}

\begin{proof}
Each proposed inverse is verified on both sides:
\[
(c\bA)(c^{-1}\bA^{-1})=\bI=(c^{-1}\bA^{-1})(c\bA),
\]
\[
\bA'(\bA^{-1})'=(\bA^{-1}\bA)'=\bI,
\qquad
(\bA^{-1})'\bA'=(\bA\bA^{-1})'=\bI,
\]
\[
(\bA\bB)(\bB^{-1}\bA^{-1})=\bI
=(\bB^{-1}\bA^{-1})(\bA\bB).
\]
The defining equalities for $\bA^{-1}$ prove the third identity.
\end{proof}

\begin{example}[Exact inverses of orders $2$ and $3$]\label{ex:small-inverses}
\[
\begin{pmatrix}2&1\\1&1\end{pmatrix}
\begin{pmatrix}1&-1\\-1&2\end{pmatrix}
=\begin{pmatrix}1&-1\\-1&2\end{pmatrix}
\begin{pmatrix}2&1\\1&1\end{pmatrix}=\bI_2.
\]
\[
\bA=\begin{pmatrix}2&-1&0\\1&2&1\\3&0&1\end{pmatrix},
\qquad
\bM=\begin{pmatrix}2&1&-1\\2&2&-2\\-6&-3&5\end{pmatrix},
\qquad
\bA\bM=\bM\bA=2\bI_3.
\]
\[
\begin{pmatrix}2&1\\1&1\end{pmatrix}^{-1}
=\begin{pmatrix}1&-1\\-1&2\end{pmatrix},
\qquad
\bA^{-1}=\tfrac12\bM.
\]
\origin{Course formulation from H Eq.~8.1.2}
\end{example}

\subsection{Orthogonal matrices}\label{sec:3.2.2}

\begin{definition}[Orthogonal matrix]\label{def:orthogonal}
A real square matrix $\bQ$ is \emph{orthogonal} if
\[
\bQ'\bQ=\bI.
\]
\origin{H \S8.4(a); A\&M Ex.~4.27}
\end{definition}

\begin{theorem}[Orthogonal inverse and orthonormal rows]\label{thm:orthogonal-inverse}
For a square matrix $\bQ$, the following are equivalent:
\[
\bQ'\bQ=\bI,
\qquad
\bQ\bQ'=\bI,
\qquad
\bQ^{-1}=\bQ'.
\]
Thus the columns of $\bQ$ are orthonormal if and only if its rows are orthonormal.
\origin{H \S8.4(a); A\&M Ex.~4.27(a)--(c)}
\end{theorem}

\begin{proof}
The equality $\bQ'\bQ=\bI$ makes $\bQ'$ a left inverse.  The square inverse theorem
gives $\bQ^{-1}=\bQ'$ and hence $\bQ\bQ'=\bI$.  The reverse implication is symmetric.
The $(i,j)$ entries of $\bQ'\bQ$ and $\bQ\bQ'$ are, respectively, inner products of
columns and of rows.
\end{proof}

\begin{theorem}[Orthogonal invariance]\label{thm:orthogonal-invariance}
If $\bQ$ is orthogonal, then for $\bx,\by\in\Real^n$,
\[
(\bQ\bx)'(\bQ\by)=\bx'\by,
\qquad
\|\bQ\bx\|=\|\bx\|.
\]
The transpose and every finite product of orthogonal matrices are orthogonal.
\origin{H Lemma~8.4.1 and \S8.4(a); A\&M Ex.~4.27(c)--(d)}
\end{theorem}

\begin{proof}
\[
(\bQ\bx)'(\bQ\by)=\bx'\bQ'\bQ\by=\bx'\by.
\]
Set $\by=\bx$ and take nonnegative square roots for the norm identity.  Also
\[
\bQ\bQ'=\bI,
\qquad
(\bQ_1\bQ_2)'(\bQ_1\bQ_2)
=\bQ_2'\bQ_1'\bQ_1\bQ_2=\bI;
\]
induction gives the finite-product statement.
\end{proof}

\begin{example}[A rational orthogonal matrix]\label{ex:rational-rotation}
\[
\bQ=\frac15\begin{pmatrix}3&-4\\4&3\end{pmatrix},
\qquad
\bQ'\bQ=\bI_2,
\qquad
\bQ\begin{pmatrix}5\\0\end{pmatrix}
=\begin{pmatrix}3\\4\end{pmatrix}.
\]
\[
\left\|\begin{pmatrix}5\\0\end{pmatrix}\right\|
=\left\|\begin{pmatrix}3\\4\end{pmatrix}\right\|=5.
\]
\origin{Course formulation from H \S8.4(a)}
\end{example}

\subsection{Equivalent nonsingularity criteria}\label{sec:3.2.3}

\begin{theorem}[Nonsingularity criteria]\label{thm:nonsingularity-criteria}
For $\bA\in\Real^{n\times n}$, the following are equivalent:
\begin{enumerate}[label=\textup{(\roman*)}]
\item $\rank(\bA)=n$;
\item $\nul(\bA)=\{\bzero\}$;
\item the columns of $\bA$ are linearly independent;
\item the columns of $\bA$ form a basis of $\Real^n$;
\item $\col(\bA)=\Real^n$;
\item $\bA\bx=\bbb$ has exactly one solution for every $\bbb\in\Real^n$;
\item $\bA$ is invertible.
\end{enumerate}
The same independence and basis criteria hold for the rows.
\origin{H \S4.4(c) and Thm.~8.1.4; A\&M Ex.~4.21}
\end{theorem}

\begin{proof}
Rank--nullity gives (i)$\iff$(ii).  The definition of linear independence gives
(ii)$\iff$(iii).  A list of $n$ vectors in $\Real^n$ is independent if and only if it
is a basis, so (iii)$\iff$(iv); the definition of a basis gives (iv)$\iff$(v).

Condition (v) gives existence in (vi), while (ii) gives uniqueness because
\[
\bA\bx_1=\bA\bx_2
\iff \bx_1-\bx_2\in\nul(\bA).
\]
Condition (vi) implies (v), and (i)$\iff$(v) by dimension.  Finally,
(i)$\iff$(vii) is the square inverse theorem.  Apply (iii) to $\bA'$ and use
$\rank(\bA')=\rank(\bA)$ for the row criteria.
\end{proof}

\begin{corollary}[Cancellation by full-rank factors]\label{cor:matrix-cancellation}
For conformable matrices:
\[
\begin{aligned}
\bC\bA=\bC\bB, \bC\text{ full column rank}
&\implies \bA=\bB,\\
\bA\bD=\bB\bD, \bD\text{ full row rank}
&\implies \bA=\bB.
\end{aligned}
\]
\origin{H Lemma~8.3.1}
\end{corollary}

\begin{proof}
A full-column-rank $\bC$ has a left inverse $\bL$, and a full-row-rank $\bD$ has a
right inverse $\bR$.  Hence
\[
\bC\bA=\bC\bB\implies\bA=\bL\bC\bA=\bL\bC\bB=\bB,
\]
\[
\bA\bD=\bB\bD\implies\bA=\bA\bD\bR=\bB\bD\bR=\bB.
\]
\end{proof}

% \periodmark{End of period 2 of 3.}

