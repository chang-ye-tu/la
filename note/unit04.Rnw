%=============================================================================
\section{Block factors}\label{sec:4.1}
%=============================================================================

\subsection{Block-triangular forms}\label{sec:4.1.1}

\begin{definition}[Block diagonal and block triangular]
\label{def:block-partition}
Let
\[
\bM=
\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix}
\in\Real^{(m+n)\times(m+n)},
\quad
\bA\in\Real^{m\times m},
\quad
\bD\in\Real^{n\times n}.
\]
It is \emph{block diagonal}, \emph{upper block triangular}, or
\emph{lower block triangular} when it has, respectively, one of the forms
\[
\begin{pmatrix}\bA&\bO\\\bO&\bD\end{pmatrix},\qquad
\begin{pmatrix}\bA&\bB\\\bO&\bD\end{pmatrix},\qquad
\begin{pmatrix}\bA&\bO\\\bC&\bD\end{pmatrix}.
\]
\origin{H \S2.1; A\&M Ex.~5.5}
\end{definition}

\begin{theorem}[Unit block factors]\label{thm:unit-block-factors}
For $\bX,\bZ\in\Real^{m\times n}$ and
$\bY,\bW\in\Real^{n\times m}$, define
\[
\bU(\bX)=\begin{pmatrix}\bI_m&\bX\\\bO&\bI_n\end{pmatrix},
\qquad
\bL(\bY)=\begin{pmatrix}\bI_m&\bO\\\bY&\bI_n\end{pmatrix}.
\]
Then
\[
\bU(\bX)^{-1}=\bU(-\bX),\qquad
\bL(\bY)^{-1}=\bL(-\bY),\qquad
\det\bU(\bX)=\det\bL(\bY)=1,
\]
and
\[
\bU(\bX)\bU(\bZ)=\bU(\bX+\bZ),
\qquad
\bL(\bY)\bL(\bW)=\bL(\bY+\bW).
\]
\origin{H Lemma~8.5.2, Eqs.~8.5.6a--b; A\&M Ex.~5.9 and 5.13(a)}
\end{theorem}

\begin{proof}
Block multiplication gives
\[
\bU(\bX)\bU(-\bX)=
\begin{pmatrix}\bI_m&\bO\\\bO&\bI_n\end{pmatrix},
\qquad
\bU(\bX)\bU(\bZ)=
\begin{pmatrix}\bI_m&\bX+\bZ\\\bO&\bI_n\end{pmatrix}.
\]
The lower-block identities follow with $\bY,\bW$ in place of $\bX,\bZ$.  Both matrices are triangular
with every diagonal entry equal to $1$; hence both determinants equal $1$.
\end{proof}

\subsection{Block-triangular algebra}\label{sec:4.1.2}

\begin{theorem}[Block-triangular determinant and inverse]
\label{thm:block-triangular}
Let $\bA\in\Real^{m\times m}$, $\bD\in\Real^{n\times n}$,
$\bB\in\Real^{m\times n}$, and $\bC\in\Real^{n\times m}$.  Then
\[
\det\begin{pmatrix}\bA&\bB\\\bO&\bD\end{pmatrix}
=
\det\begin{pmatrix}\bA&\bO\\\bC&\bD\end{pmatrix}
=\det(\bA)\det(\bD).
\]
Either block-triangular matrix is nonsingular if and only if both $\bA$ and $\bD$
are nonsingular.  In that case,
\begin{align*}
\begin{pmatrix}\bA&\bB\\\bO&\bD\end{pmatrix}^{-1}
&=
\begin{pmatrix}
\bA^{-1}&-\bA^{-1}\bB\bD^{-1}\\
\bO&\bD^{-1}
\end{pmatrix},\\
\begin{pmatrix}\bA&\bO\\\bC&\bD\end{pmatrix}^{-1}
&=
\begin{pmatrix}
\bA^{-1}&\bO\\
-\bD^{-1}\bC\bA^{-1}&\bD^{-1}
\end{pmatrix}.
\end{align*}
\tcbbreak
Moreover,
\[
\rank\begin{pmatrix}\bA&\bO\\\bO&\bD\end{pmatrix}
=\rank(\bA)+\rank(\bD).
\]
\origin{H Lemma~8.5.4, Thm.~13.3.1, and Lemma~4.5.11; A\&M Ex.~5.13, 5.25, and 5.41(a)}
\end{theorem}

\begin{proof}
Set $N=m+n$ and
$\bT=\begin{pmatrix}\bA&\bB\\\bO&\bD\end{pmatrix}$.
In the permutation formula for $\det(\bT)$,
\[
\prod_{i=1}^{N}t_{i,\sigma(i)}\neq0
\implies
\{\sigma(m+1),\ldots,\sigma(N)\}=\{m+1,\ldots,N\}.
\]
Thus there are unique $\sigma_A\in S_m$ and $\sigma_D\in S_n$ such that
\[
\sigma(i)=\sigma_A(i),\quad
\sigma(m+j)=m+\sigma_D(j).
\]
There are no cross-block inversions, so
$\sgn(\sigma)=\sgn(\sigma_A)\sgn(\sigma_D)$.  Hence
\[
\det(\bT)
=\sum_{\sigma_A\in S_m}\sgn(\sigma_A)
 \prod_{i=1}^m a_{i,\sigma_A(i)}
 \sum_{\sigma_D\in S_n}\sgn(\sigma_D)
 \prod_{j=1}^n d_{j,\sigma_D(j)}
=\det(\bA)\det(\bD).
\]
Transpose invariance gives the lower-block formula.  The determinant criterion gives
\[
\bT\text{ nonsingular}
\iff \det(\bA)\det(\bD)\neq0
\iff \bA,\bD\text{ nonsingular}.
\]
Direct multiplication of each matrix by its displayed candidate inverse gives
$\bI_{m+n}$.

For $\bK=\begin{pmatrix}\bA&\bO\\\bO&\bD\end{pmatrix}$,
\[
\col(\bK)=
\left\{\begin{pmatrix}\bu\\\bzero\end{pmatrix}:\bu\in\col(\bA)\right\}
\mathbin{\oplus}
\left\{\begin{pmatrix}\bzero\\\bv\end{pmatrix}:\bv\in\col(\bD)\right\}.
\]
Taking dimensions proves the rank identity.
\end{proof}

\begin{example}[An exact block-triangular inverse]\label{ex:block-triangular-inverse}
With a $2+1$ partition,
\[
\bT=
\begin{pmatrix}
1&1&1\\
0&1&-1\\
0&0&2
\end{pmatrix}
=
\begin{pmatrix}
\begin{matrix}1&1\\0&1\end{matrix}&
\begin{matrix}1\\-1\end{matrix}\\[1mm]
\begin{matrix}0&0\end{matrix}&2
\end{pmatrix}.
\]
Since
\[
\bA^{-1}=\begin{pmatrix}1&-1\\0&1\end{pmatrix},\qquad
-\bA^{-1}\bB\bD^{-1}=\begin{pmatrix}-1\\1/2\end{pmatrix},
\]
\[
\bT^{-1}=
\begin{pmatrix}
1&-1&-1\\
0&1&1/2\\
0&0&1/2
\end{pmatrix},\qquad \det(\bT)=2.
\]
\origin{Course formulation from H Lemma~8.5.4 and Thm.~13.3.1}
\end{example}

\subsection{Schur complements and block factorisation}\label{sec:4.1.3}

\begin{definition}[Schur complements]\label{def:schur-complement}
For
\[
\bM=\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix},
\quad
\bA\in\Real^{m\times m},\quad \bD\in\Real^{n\times n},
\]
the Schur complement of $\bA$ in $\bM$, when $\bA$ is nonsingular, is
\[
\bS_A=\bD-\bC\bA^{-1}\bB.
\]
When $\bD$ is nonsingular, the Schur complement of $\bD$ in $\bM$ is
\[
\bS_D=\bA-\bB\bD^{-1}\bC.
\]
\origin{H \S8.5e after Eq.~8.5.18; A\&M Ex.~5.10--5.11; S Def.~3.3}
\end{definition}

\begin{theorem}[Schur factorisations]\label{thm:schur-factorizations}
If $\bA$ is nonsingular, then
\begin{align}
&\begin{pmatrix}\bI_m&\bO\\-\bC\bA^{-1}&\bI_n\end{pmatrix}
\bM
\begin{pmatrix}\bI_m&-\bA^{-1}\bB\\\bO&\bI_n\end{pmatrix}
=
\begin{pmatrix}\bA&\bO\\\bO&\bS_A\end{pmatrix},\label{eq:schur-diagonalize-A}\\
&\bM=
\begin{pmatrix}\bI_m&\bO\\\bC\bA^{-1}&\bI_n\end{pmatrix}
\begin{pmatrix}\bA&\bO\\\bO&\bS_A\end{pmatrix}
\begin{pmatrix}\bI_m&\bA^{-1}\bB\\\bO&\bI_n\end{pmatrix}.
\label{eq:schur-ldu-A}
\end{align}
If $\bD$ is nonsingular, then
\begin{align}
&\begin{pmatrix}\bI_m&-\bB\bD^{-1}\\\bO&\bI_n\end{pmatrix}
\bM
\begin{pmatrix}\bI_m&\bO\\-\bD^{-1}\bC&\bI_n\end{pmatrix}
=
\begin{pmatrix}\bS_D&\bO\\\bO&\bD\end{pmatrix},\label{eq:schur-diagonalize-D}\\
&\bM=
\begin{pmatrix}\bI_m&\bB\bD^{-1}\\\bO&\bI_n\end{pmatrix}
\begin{pmatrix}\bS_D&\bO\\\bO&\bD\end{pmatrix}
\begin{pmatrix}\bI_m&\bO\\\bD^{-1}\bC&\bI_n\end{pmatrix}.
\label{eq:schur-ldu-D}
\end{align}
\origin{H Eq.~8.5.18 and Thm.~13.3.8; A\&M Ex.~5.10--5.11; S Prop.~3.9}
\end{theorem}

\begin{proof}
Using the nonsingular block $\bA$,
\begin{align*}
\begin{pmatrix}\bI_m&\bO\\-\bC\bA^{-1}&\bI_n\end{pmatrix}
\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix}
&=
\begin{pmatrix}\bA&\bB\\\bO&\bS_A\end{pmatrix},\\
\begin{pmatrix}\bA&\bB\\\bO&\bS_A\end{pmatrix}
\begin{pmatrix}\bI_m&-\bA^{-1}\bB\\\bO&\bI_n\end{pmatrix}
&=
\begin{pmatrix}\bA&\bO\\\bO&\bS_A\end{pmatrix}.
\end{align*}
Multiplication by the inverses from Theorem~\ref{thm:unit-block-factors} gives
\eqref{eq:schur-ldu-A}.  Using the nonsingular block $\bD$,
\begin{align*}
\begin{pmatrix}\bI_m&-\bB\bD^{-1}\\\bO&\bI_n\end{pmatrix}
\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix}
&=
\begin{pmatrix}\bS_D&\bO\\\bC&\bD\end{pmatrix},\\
\begin{pmatrix}\bS_D&\bO\\\bC&\bD\end{pmatrix}
\begin{pmatrix}\bI_m&\bO\\-\bD^{-1}\bC&\bI_n\end{pmatrix}
&=
\begin{pmatrix}\bS_D&\bO\\\bO&\bD\end{pmatrix}.
\end{align*}
Inverting the two unit factors gives \eqref{eq:schur-ldu-D}.
\end{proof}

\begin{example}[Exact Schur factors]\label{ex:exact-schur-factors}
Let
\[
\bM=\begin{pmatrix}2&1&1\\1&1&2\\3&1&4\end{pmatrix},\quad
\bA=\begin{pmatrix}2&1\\1&1\end{pmatrix},\quad
\bB=\begin{pmatrix}1\\2\end{pmatrix},\quad
\bC=\begin{pmatrix}3&1\end{pmatrix},\quad \bD=(4).
\]
Then
\[
\bA^{-1}=\begin{pmatrix}1&-1\\-1&2\end{pmatrix},\qquad
\bA^{-1}\bB=\begin{pmatrix}-1\\3\end{pmatrix},\qquad
\bC\bA^{-1}=\begin{pmatrix}2&-1\end{pmatrix},\qquad
\bS_A=(4).
\]
Thus
\[
\bM=
\begin{pmatrix}1&0&0\\0&1&0\\2&-1&1\end{pmatrix}
\begin{pmatrix}2&1&0\\1&1&0\\0&0&4\end{pmatrix}
\begin{pmatrix}1&0&-1\\0&1&3\\0&0&1\end{pmatrix}.
\]
\origin{Course formulation from A\&M Ex.~5.10; H Eq.~8.5.18}
\end{example}

% \periodmark{End of period 1 of 3.}

%=============================================================================
\section{Schur consequences}\label{sec:4.2}
%=============================================================================

\subsection{Rank and nonsingularity}\label{sec:4.2.1}

\begin{theorem}[Schur rank and nonsingularity]\label{thm:schur-rank}
Let
\[
\bM=\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix},\qquad
\bA\in\Real^{m\times m},\quad
\bD\in\Real^{n\times n}.
\]
If $\bA$ is nonsingular, then
\[
\rank(\bM)=m+\rank(\bD-\bC\bA^{-1}\bB).
\]
Moreover,
\[
\bM\text{ is nonsingular}
\iff \bS_A\text{ is nonsingular}.
\]
If $\bD$ is nonsingular,
\[
\rank(\bM)=n+\rank(\bS_D),\qquad
\bM\text{ is nonsingular}\iff\bS_D\text{ is nonsingular}.
\]
\origin{H Thm.~8.5.10--8.5.11, Eq.~8.5.15; A\&M Ex.~5.48}
\end{theorem}

\begin{proof}
The two unit factors in \eqref{eq:schur-diagonalize-A} are nonsingular.  Rank is
invariant under multiplication by nonsingular matrices, so
\[
\rank(\bM)
=\rank\begin{pmatrix}\bA&\bO\\\bO&\bS_A\end{pmatrix}
=\rank(\bA)+\rank(\bS_A)
=m+\rank(\bS_A).
\]
\[
\rank(\bM)=m+n
\iff \rank(\bS_A)=n
\iff \bS_A\text{ is nonsingular}.
\]
The $\bD$ formulas follow from \eqref{eq:schur-diagonalize-D}.
\end{proof}

\begin{example}[A null direction exposed by the complement]
\label{ex:schur-null-direction}
For
\[
\bM=
\begin{pmatrix}
1&0&1\\
0&1&2\\
3&4&11
\end{pmatrix}
=
\begin{pmatrix}
\bI_2&\begin{matrix}1\\2\end{matrix}\\[1mm]
\begin{matrix}3&4\end{matrix}&11
\end{pmatrix},
\]
\tcbbreak
\[
\bS_A=11-\begin{pmatrix}3&4\end{pmatrix}
\begin{pmatrix}1\\2\end{pmatrix}=0,\qquad
\rank(\bM)=2,\qquad
\bM\begin{pmatrix}-1\\-2\\1\end{pmatrix}=\bzero.
\]
\origin{Course formulation from H Thm.~8.5.10}
\end{example}

\subsection{The block inverse}\label{sec:4.2.2}

\begin{theorem}[Block inverse]\label{thm:block-inverse}
If $\bA$ and $\bS_A$ are nonsingular, then
\begin{equation}
\bM^{-1}=
\begin{pmatrix}
\bA^{-1}+\bA^{-1}\bB\bS_A^{-1}\bC\bA^{-1}
&-\bA^{-1}\bB\bS_A^{-1}\\
-\bS_A^{-1}\bC\bA^{-1}&\bS_A^{-1}
\end{pmatrix}.
\label{eq:block-inverse-A}
\end{equation}
If $\bD$ and $\bS_D$ are nonsingular, then
\begin{equation}
\bM^{-1}=
\begin{pmatrix}
\bS_D^{-1}&-\bS_D^{-1}\bB\bD^{-1}\\
-\bD^{-1}\bC\bS_D^{-1}
&\bD^{-1}+\bD^{-1}\bC\bS_D^{-1}\bB\bD^{-1}
\end{pmatrix}.
\label{eq:block-inverse-D}
\end{equation}
\origin{H Thm.~8.5.11, Eqs.~8.5.16--8.5.18; A\&M Ex.~5.16}
\end{theorem}

\begin{proof}
Invert the three factors in \eqref{eq:schur-ldu-A}:
\begin{align*}
\bM^{-1}
&=
\begin{pmatrix}\bI_m&-\bA^{-1}\bB\\\bO&\bI_n\end{pmatrix}
\begin{pmatrix}\bA^{-1}&\bO\\\bO&\bS_A^{-1}\end{pmatrix}
\begin{pmatrix}\bI_m&\bO\\-\bC\bA^{-1}&\bI_n\end{pmatrix}\\
&=
\begin{pmatrix}
\bA^{-1}+\bA^{-1}\bB\bS_A^{-1}\bC\bA^{-1}
&-\bA^{-1}\bB\bS_A^{-1}\\
-\bS_A^{-1}\bC\bA^{-1}&\bS_A^{-1}
\end{pmatrix}.
\end{align*}
Likewise, \eqref{eq:schur-ldu-D} gives
\[
\bM^{-1}=
\begin{pmatrix}\bI_m&\bO\\-\bD^{-1}\bC&\bI_n\end{pmatrix}
\begin{pmatrix}\bS_D^{-1}&\bO\\\bO&\bD^{-1}\end{pmatrix}
\begin{pmatrix}\bI_m&-\bB\bD^{-1}\\\bO&\bI_n\end{pmatrix},
\]
whose product is \eqref{eq:block-inverse-D}.
\end{proof}

\Needspace{.42\textheight}
\begin{corollary}[A diagonal inverse block determines the complement]
\label{cor:inverse-block-duality}
Suppose $\bM$ and $\bA$ are nonsingular and write
\[
\bM^{-1}=\begin{pmatrix}\bP&\bQ\\\bR&\bT\end{pmatrix}.
\]
Then $\bT$ is nonsingular and
\[
\bS_A=\bT^{-1},\qquad
\bA^{-1}=\bP-\bQ\bT^{-1}\bR,
\]
\[
\bA^{-1}\bB=-\bQ\bT^{-1},\qquad
\bC\bA^{-1}=-\bT^{-1}\bR.
\]
\origin{H Cor.~8.5.12, Eqs.~8.5.19--8.5.24; A\&M Ex.~5.17}
\end{corollary}

\begin{proof}
Theorem~\ref{thm:schur-rank} makes $\bS_A$ nonsingular.  Comparing blocks in
\eqref{eq:block-inverse-A} gives
\[
\bT=\bS_A^{-1},\quad
\bQ=-\bA^{-1}\bB\bT,\quad
\bR=-\bT\bC\bA^{-1},
\]
and
\[
\bP-\bQ\bT^{-1}\bR
=\bA^{-1}+\bA^{-1}\bB\bT\bC\bA^{-1}
-\bA^{-1}\bB\bT\bC\bA^{-1}
=\bA^{-1}.
\]
\end{proof}

\begin{example}[The inverse from one scalar complement]\label{ex:schur-inverse}
For the matrix in Example~\ref{ex:exact-schur-factors}, $\bS_A=(4)$, and
\[
\bM^{-1}=
\begin{pmatrix}
1/2&-3/4&1/4\\
1/2&5/4&-3/4\\
-1/2&1/4&1/4
\end{pmatrix}.
\]
Its lower-right entry is $\bS_A^{-1}=1/4$, and
\[
\bM\bM^{-1}=\bI_3.
\]
\origin{Course formulation from H Thm.~8.5.11; A\&M Ex.~5.16}
\end{example}

\subsection{Determinants on the smaller block}\label{sec:4.2.3}

\begin{theorem}[Schur determinant identities]\label{thm:schur-determinant}
For square $\bM=\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix}$,
\[
\det(\bM)=\det(\bA)\det(\bS_A)
\quad\text{if $\bA$ is nonsingular},
\]
and
\[
\det(\bM)=\det(\bD)\det(\bS_D)
\quad\text{if $\bD$ is nonsingular}.
\]
\origin{H Thm.~13.3.8, Eq.~13.3.13; A\&M Ex.~5.30; S Prop.~3.9}
\end{theorem}

\begin{proof}
Determinant multiplicativity, Theorem~\ref{thm:unit-block-factors}, and
\eqref{eq:schur-ldu-A} give
\begin{align*}
\det(\bM)
&=\det\begin{pmatrix}\bI_m&\bO\\\bC\bA^{-1}&\bI_n\end{pmatrix}
\det\begin{pmatrix}\bA&\bO\\\bO&\bS_A\end{pmatrix}
\det\begin{pmatrix}\bI_m&\bA^{-1}\bB\\\bO&\bI_n\end{pmatrix}\\
&=1\cdot\det(\bA)\det(\bS_A)\cdot1.
\end{align*}
The same calculation applied to \eqref{eq:schur-ldu-D} gives the second identity.
\end{proof}

\begin{corollary}[Sylvester's determinant identity]\label{cor:sylvester-determinant}
For $\bU\in\Real^{m\times k}$ and $\bV\in\Real^{k\times m}$,
\[
\det(\bI_m+\bU\bV)=\det(\bI_k+\bV\bU).
\]
\tcbbreak
Consequently,
\[
\bI_m+\bU\bV\text{ is nonsingular}
\iff
\bI_k+\bV\bU\text{ is nonsingular}.
\]
\origin{H Cor.~18.1.2, Eq.~18.1.2; A\&M Ex.~5.37(b)}
\end{corollary}

\begin{proof}
Apply the two identities of Theorem~\ref{thm:schur-determinant} to
\[
\bK=\begin{pmatrix}\bI_m&\bU\\-\bV&\bI_k\end{pmatrix}.
\]
The two complements are $\bI_k+\bV\bU$ and $\bI_m+\bU\bV$; hence
\[
\det(\bK)=\det(\bI_k+\bV\bU)=\det(\bI_m+\bU\bV).
\]
The determinant criterion proves the equivalence.
\end{proof}

\begin{example}[Two determinant orders]\label{ex:determinant-orders}
Let
\[
\bU=\begin{pmatrix}1&0\\0&1\\1&1\end{pmatrix},\qquad
\bV=\begin{pmatrix}1&2&0\\0&1&1\end{pmatrix}.
\]
Then
\[
\bI_3+\bU\bV=
\begin{pmatrix}2&2&0\\0&2&1\\1&3&2\end{pmatrix},\qquad
\bI_2+\bV\bU=
\begin{pmatrix}2&2\\1&3\end{pmatrix},
\]
and both determinants equal $4$.
\origin{Course formulation from H Cor.~18.1.2; A\&M Ex.~5.37(b)}
\end{example}

% \periodmark{End of period 2 of 3.}

%=============================================================================
\newpage
\section{Determinant and inverse updates}\label{sec:4.3}
%=============================================================================

\subsection{A small determinant update}\label{sec:4.3.1}

\begin{theorem}[General determinant update]\label{thm:determinant-update}
Let
\[
\bA\in\Real^{n\times n},\quad
\bU\in\Real^{n\times k},\quad
\bC\in\Real^{k\times k},\quad
\bV\in\Real^{k\times n},
\]
where $\bA$ and $\bC$ are nonsingular.  Then
\[
\det(\bA+\bU\bC\bV)
=\det(\bA)\det(\bC)
 \det(\bC^{-1}+\bV\bA^{-1}\bU).
\]
\origin{H Thm.~18.1.1, Eq.~18.1.1; A\&M Ex.~5.37(c)}
\end{theorem}

\begin{proof}
By multiplicativity and Corollary~\ref{cor:sylvester-determinant},
\begin{align*}
\det(\bA+\bU\bC\bV)
&=\det(\bA)\det(\bI_n+\bA^{-1}\bU\bC\bV)\\
&=\det(\bA)\det(\bI_k+\bV\bA^{-1}\bU\bC)\\
&=\det(\bA)\det\bigl((\bC^{-1}+\bV\bA^{-1}\bU)\bC\bigr)\\
&=\det(\bA)\det(\bC^{-1}+\bV\bA^{-1}\bU)\det(\bC).
\end{align*}
\end{proof}

\newpage
\subsection{Woodbury's identity}\label{sec:4.3.2}

\begin{theorem}[Woodbury identity]\label{thm:woodbury}
Under the hypotheses of Theorem~\ref{thm:determinant-update},
\[
\bA+\bU\bC\bV\text{ is nonsingular}
\iff
\bE:=\bC^{-1}+\bV\bA^{-1}\bU\text{ is nonsingular}.
\]
When these conditions hold,
\[
(\bA+\bU\bC\bV)^{-1}
=\bA^{-1}-\bA^{-1}\bU\bE^{-1}\bV\bA^{-1}.
\]
\origin{H Thm.~18.2.8, Eq.~18.2.22; A\&M Ex.~5.17}
\end{theorem}

\begin{proof}
The equivalence follows from Theorem~\ref{thm:determinant-update} and
$\det(\bA)\det(\bC)\neq0$.  For the inverse, set
\[
\bK=\begin{pmatrix}\bA&\bU\\-\bV&\bC^{-1}\end{pmatrix}.
\]
Its complements formed from $\bA$ and $\bC^{-1}$ are
\[
\bC^{-1}-(-\bV)\bA^{-1}\bU=\bE,
\qquad
\bA-\bU\bC(-\bV)=\bA+\bU\bC\bV.
\]
The upper-left block of \eqref{eq:block-inverse-A} is
\[
\bA^{-1}-\bA^{-1}\bU\bE^{-1}\bV\bA^{-1},
\]
whereas the upper-left block of \eqref{eq:block-inverse-D} is
$(\bA+\bU\bC\bV)^{-1}$.
\end{proof}

\begin{corollary}[Push-through identities]\label{cor:push-through}
For $\bU\in\Real^{m\times k}$ and $\bV\in\Real^{k\times m}$, if
$\bI_k+\bV\bU$ is nonsingular, then
\[
(\bI_m+\bU\bV)^{-1}
=\bI_m-\bU(\bI_k+\bV\bU)^{-1}\bV,
\]
and
\[
(\bI_m+\bU\bV)^{-1}\bU
=\bU(\bI_k+\bV\bU)^{-1}.
\]
\origin{H Cor.~18.2.9, Eq.~18.2.24}
\end{corollary}

\begin{proof}
The first identity is Theorem~\ref{thm:woodbury} with both diagonal matrices equal
to identities.  Put $\bK=\bI_k+\bV\bU$.  Then
\begin{align*}
[\bI_m-\bU\bK^{-1}\bV]\bU
&=\bU[\bI_k-\bK^{-1}\bV\bU]\\
&=\bU\bK^{-1}[\bK-\bV\bU]
=\bU\bK^{-1}.\qedhere
\end{align*}
\end{proof}

\subsection{Rank-one updates and borders}\label{sec:4.3.3}

\begin{corollary}[Sherman--Morrison identity]\label{cor:sherman-morrison}
Let $\bA\in\Real^{n\times n}$ be nonsingular and $\bu,\bv\in\Real^n$.  Then
\[
\bA+\bu\bv'\text{ is nonsingular}
\iff
1+\bv'\bA^{-1}\bu\neq0.
\]
Under this condition,
\[
(\bA+\bu\bv')^{-1}
=\bA^{-1}
-\frac{\bA^{-1}\bu\bv'\bA^{-1}}
{1+\bv'\bA^{-1}\bu}.
\]
\origin{H Cor.~18.2.10, Eq.~18.2.25; S Prop.~3.21; A\&M Ex.~4.28}
\end{corollary}

\begin{proof}
Take $k=1$, $\bU=\bu$, $\bC=(1)$, and $\bV=\bv'$ in
Theorem~\ref{thm:woodbury}.  The matrix $\bE$ is the scalar
$1+\bv'\bA^{-1}\bu$.
\end{proof}

\begin{corollary}[A scalar border]\label{cor:scalar-border}
Let $\bA\in\Real^{n\times n}$ be nonsingular, $\bx,\by\in\Real^n$, and
$\delta\in\Real$.  Put
\[
\varepsilon=\delta-\bx'\bA^{-1}\by,\qquad
\bK=\begin{pmatrix}\bA&\by\\\bx'&\delta\end{pmatrix}.
\]
Then
\[
\det(\bK)=\det(\bA)\varepsilon,\qquad
\bK\text{ is nonsingular}\iff\varepsilon\neq0.
\]
If $\varepsilon\neq0$, then
\[
\bK^{-1}=
\begin{pmatrix}
\bA^{-1}+\varepsilon^{-1}\bA^{-1}\by\bx'\bA^{-1}
&-\varepsilon^{-1}\bA^{-1}\by\\
-\varepsilon^{-1}\bx'\bA^{-1}&\varepsilon^{-1}
\end{pmatrix}.
\]
\origin{H Thm.~8.5.11 and Ex.~13.12; A\&M Ex.~5.15 and 5.29}
\end{corollary}

\begin{proof}
Here $\bS_A=(\varepsilon)$.  Apply Theorems~\ref{thm:schur-rank},
\ref{thm:block-inverse}, and \ref{thm:schur-determinant}.
\end{proof}

\begin{example}[An exact rank-one update]\label{ex:rank-one-update}
Let
\[
\bA=\begin{pmatrix}2&0\\0&1\end{pmatrix},\qquad
\bu=\begin{pmatrix}1\\1\end{pmatrix},\qquad
\bv=\begin{pmatrix}1\\-1\end{pmatrix}.
\]
\tcbbreak
Then
\[
1+\bv'\bA^{-1}\bu=\frac12,\qquad
\bA+\bu\bv'=\begin{pmatrix}3&-1\\1&0\end{pmatrix},
\]
and
\[
(\bA+\bu\bv')^{-1}
=\begin{pmatrix}1/2&0\\0&1\end{pmatrix}
-2\begin{pmatrix}1/2\\1\end{pmatrix}
  \begin{pmatrix}1/2&-1\end{pmatrix}
=\begin{pmatrix}0&1\\-1&3\end{pmatrix}.
\]
\origin{Course formulation from H Cor.~18.2.10; S Prop.~3.21}
\end{example}

%=============================================================================
\section{Computation: Numerical Checks in R}\label{sec:4.4}
%=============================================================================

\subsection{Block factorisation (§\ref{sec:4.1.3})}\label{sec:4.4.1}

<<block-factorisation>>=
A <- matrix(c(2, 1,
              1, 1), 2, 2, byrow = TRUE)
B <- matrix(c(1, 2), 2, 1)
C <- matrix(c(3, 1), 1, 2)
D <- matrix(4, 1, 1)
Ainv <- solve(A)
S <- D - C %*% Ainv %*% B
M <- rbind(cbind(A, B), cbind(C, D))
L <- rbind(cbind(diag(2), matrix(0, 2, 1)),
           cbind(C %*% Ainv, diag(1)))
Delta <- rbind(cbind(A, matrix(0, 2, 1)),
               cbind(matrix(0, 1, 2), S))
Ufac <- rbind(cbind(diag(2), Ainv %*% B),
              cbind(matrix(0, 1, 2), diag(1)))
c(schur_complement = S[1, 1],
  reconstruction_residual = max(abs(M - L %*% Delta %*% Ufac)))
@

\subsection{Block inverse and determinant (§\ref{sec:4.2.2}, §\ref{sec:4.2.3})}
\label{sec:4.4.2}

<<block-inverse-determinant>>=
Sinv <- solve(S)
manual_inverse <- rbind(
  cbind(Ainv + Ainv %*% B %*% Sinv %*% C %*% Ainv,
        -Ainv %*% B %*% Sinv),
  cbind(-Sinv %*% C %*% Ainv, Sinv)
)
package_inverse <- solve(M)
c(inverse_difference = max(abs(manual_inverse - package_inverse)),
  inverse_residual = max(abs(M %*% manual_inverse - diag(3))),
  determinant_difference = det(M) - det(A) * det(S))
@

\subsection{The smaller determinant (§\ref{sec:4.2.3})}\label{sec:4.4.3}

<<small-side-determinant>>=
set.seed(4)
U <- matrix(rnorm(160), 80, 2)
V <- matrix(rnorm(160), 2, 80) / 80
large_det <- det(diag(80) + U %*% V)
small_det <- det(diag(2) + V %*% U)
c(order_80 = large_det,
  order_2 = small_det,
  difference = large_det - small_det)
@

\subsection{Woodbury against \texttt{solve} (§\ref{sec:4.3.2})}\label{sec:4.4.4}

<<woodbury-solve>>=
set.seed(44)
n <- 12
k <- 2
A <- diag(seq(2, 3, length.out = n))
C <- matrix(c(2, 0.25,
              0.25, 1.5), 2, 2, byrow = TRUE)
U <- matrix(rnorm(n * k), n, k)
V <- matrix(rnorm(k * n), k, n) / n
Ainv <- solve(A)
E <- solve(C) + V %*% Ainv %*% U
manual_inverse <- Ainv - Ainv %*% U %*% solve(E) %*% V %*% Ainv
updated <- A + U %*% C %*% V
package_inverse <- solve(updated)
direct_det <- det(updated)
update_det <- det(A) * det(C) * det(E)
c(inverse_difference = max(abs(manual_inverse - package_inverse)),
  inverse_residual = max(abs(updated %*% manual_inverse - diag(n))),
  determinant_relative_difference =
    (direct_det - update_det) / max(1, abs(direct_det)))
@

%=============================================================================
\section{Pitfalls}\label{sec:4.5}
%=============================================================================

\subsection{Using the scalar 2 by 2 determinant rule}\label{sec:4.5.1}

For
\[
\bA=\bD=\bI_2,\qquad
\bB=\begin{pmatrix}1&1\\0&1\end{pmatrix},\qquad
\bC=\begin{pmatrix}1&0\\1&1\end{pmatrix},
\]
\[
\det\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix}
=\det(\bI_2-\bC\bB)=-1,\qquad
\det(\bA)\det(\bD)-\det(\bB)\det(\bC)=0.
\]

\subsection{Requiring a nonsingular diagonal block}\label{sec:4.5.2}

Both diagonal blocks of
\[
\begin{pmatrix}\bO&\bI_n\\\bI_n&\bO\end{pmatrix}
\]
are singular, but the matrix is its own inverse.  A Schur formula based on one diagonal block
does not characterize all nonsingular block matrices.

\subsection{Inverting each displayed block}\label{sec:4.5.3}

For nonsingular $\bB$,
\[
\begin{pmatrix}\bI&\bB\\\bO&\bI\end{pmatrix}^{-1}
=\begin{pmatrix}\bI&-\bB\\\bO&\bI\end{pmatrix}
\neq
\begin{pmatrix}\bI&\bB^{-1}\\\bO&\bI\end{pmatrix}.
\]

\subsection{Ignoring the update denominator}\label{sec:4.5.4}

For $\bA=\bI_n$, $\bu=\eu_1$, and $\bv=-\eu_1$,
\[
1+\bv'\bA^{-1}\bu=0,\qquad
\bA+\bu\bv'=\diag(0,1,\ldots,1).
\]
The zero denominator in Corollary~\ref{cor:sherman-morrison} is exactly the
singular case.

%=============================================================================
\newpage
\section{Exercises}\label{sec:4.6}
%=============================================================================

\begin{exercise}[Unit block factors and positive powers]
\label{ex:unit-block-group}
For $\bX,\bY\in\Real^{m\times n}$ and
$r\in\{1,2,\ldots\}$, prove
\[
\bU(\bX)\bU(\bY)=\bU(\bY)\bU(\bX)=\bU(\bX+\bY),
\qquad
\bU(\bX)^r=\bU(r\bX).
\]
\origin{H Lemma~8.5.2; A\&M Ex.~5.9 and 5.21}
\end{exercise}

\begin{solution}
Theorem~\ref{thm:unit-block-factors} gives the product identity.  The power
formula holds for $r=1$.  If it holds for $r\geqslant1$, then
\[
\bU(\bX)^{r+1}=\bU(r\bX)\bU(\bX)=\bU((r+1)\bX).
\]
\end{solution}

\begin{exercise}[A partitioned linear system]\label{ex:partitioned-system}
Let
\[
\bM=\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix},
\qquad
\bS_A=\bD-\bC\bA^{-1}\bB,
\]
where $\bA$ and $\bS_A$ are nonsingular.  For conformable $\mathbf f,\bg$,
prove that the unique solution of
\[
\bM
\begin{pmatrix}\bx\\\by\end{pmatrix}
=\begin{pmatrix}\mathbf f\\\bg\end{pmatrix}
\]
is
\[
\by=\bS_A^{-1}(\bg-\bC\bA^{-1}\mathbf f),
\qquad
\bx=\bA^{-1}(\mathbf f-\bB\by).
\]
\origin{Course formulation from H Thm.~8.5.11; A\&M Ex.~5.16}
\end{exercise}

\begin{solution}
The first block equation gives
\[
\bx=\bA^{-1}(\mathbf f-\bB\by).
\]
Substitution in the second gives
\[
\bC\bA^{-1}(\mathbf f-\bB\by)+\bD\by=\bg
\iff
\bS_A\by=\bg-\bC\bA^{-1}\mathbf f.
\]
Nonsingularity of $\bS_A$ gives the displayed $\by$, then the displayed
$\bx$.  Theorem~\ref{thm:schur-rank} gives nonsingularity of the coefficient
matrix, so the solution is unique.
\end{solution}

\begin{exercise}[Off-diagonal coupling]\label{ex:off-diagonal-coupling}
Let $\bB,\bC\in\Real^{n\times n}$ be nonsingular and
\[
\bK=\begin{pmatrix}\bO&\bB\\\bC&\bO\end{pmatrix}.
\]
Find $\bK^{-1}$, $\det(\bK)$, and $\rank(\bK)$.
\origin{H Cor.~13.3.2; A\&M Ex.~5.12(b), 5.23, and 5.41(b)}
\end{exercise}

\begin{solution}[qedhere]
\[
\bK\begin{pmatrix}\bO&\bC^{-1}\\\bB^{-1}&\bO\end{pmatrix}
=\bI_{2n},\qquad \rank(\bK)=2n.
\]
Let $\bP=\begin{pmatrix}\bO&\bI_n\\\bI_n&\bO\end{pmatrix}$.  Its permutation is
$(n+1,\ldots,2n,1,\ldots,n)$: precisely the $n^2$ cross-block pairs are
inversions.  Hence $\det(\bP)=(-1)^{n^2}=(-1)^n$.  Since
\[
\bK=\begin{pmatrix}\bB&\bO\\\bO&\bC\end{pmatrix}\bP,
\]
\[
\det(\bK)=(-1)^n\det(\bB)\det(\bC).\tag*{\textcolor{solFR}{$\blacksquare$}}
\]
\end{solution}

\begin{exercise}[A bordered determinant without an inverse]
\label{ex:bordered-adjugate}
For $\bA\in\Real^{n\times n}$, $\bx,\by\in\Real^n$, and $c\in\Real$, prove
\[
\det\begin{pmatrix}\bA&\by\\\bx'&c\end{pmatrix}
=c\det(\bA)-\bx'\adj(\bA)\by.
\]
No nonsingularity assumption is permitted.
\origin{H Ex.~13.12, Eq.~13.E.1}
\end{exercise}

\begin{solution}[qedhere]
Let $\bA_{-i,-j}$ delete row $i$ and column $j$ of $\bA$.  Expansion along the
last row and then along the last column of each resulting minor gives
\begin{align*}
\det\begin{pmatrix}\bA&\by\\\bx'&c\end{pmatrix}
&=c\det(\bA)
+\sum_{j=1}^n(-1)^{n+1+j}x_j
 \sum_{i=1}^n(-1)^{i+n}y_i\det(\bA_{-i,-j})\\
&=c\det(\bA)
-\sum_{j=1}^n\sum_{i=1}^n
 x_j(-1)^{i+j}\det(\bA_{-i,-j})y_i\\
&=c\det(\bA)-\bx'\adj(\bA)\by.\tag*{\textcolor{solFR}{$\blacksquare$}}
\end{align*}
\end{solution}

\begin{exercise}[Schur complements under block recoding]
\label{ex:schur-recoding}
Let
\[
\bM=\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix},\qquad
\bA\in\Real^{m\times m},\quad \bD\in\Real^{n\times n},
\]
where $\bA$ is nonsingular.  Let $\bP,\bR\in\Real^{m\times m}$ and
$\bQ,\bT\in\Real^{n\times n}$ be nonsingular.  Define
\[
\widetilde{\bM}=
\begin{pmatrix}\bP&\bO\\\bO&\bQ\end{pmatrix}
\bM
\begin{pmatrix}\bR&\bO\\\bO&\bT\end{pmatrix}.
\]
Prove that the Schur complement of $\bP\bA\bR$ in $\widetilde{\bM}$ is
\[
\bQ(\bD-\bC\bA^{-1}\bB)\bT.
\]
Deduce that its rank equals $\rank(\bS_A)$.
\origin{Course formulation from H Thm.~8.5.10; A\&M Ex.~5.10}
\end{exercise}

\begin{solution}
The four blocks of $\widetilde{\bM}$ are
\[
\bP\bA\bR,\quad \bP\bB\bT,\quad
\bQ\bC\bR,\quad \bQ\bD\bT.
\]
Since $(\bP\bA\bR)^{-1}=\bR^{-1}\bA^{-1}\bP^{-1}$, its complement is
\begin{align*}
&\bQ\bD\bT
-\bQ\bC\bR(\bP\bA\bR)^{-1}\bP\bB\bT\\
&\qquad=\bQ\bD\bT-\bQ\bC\bA^{-1}\bB\bT
=\bQ\bS_A\bT.
\end{align*}
Rank is invariant under nonsingular left and right factors.
\end{solution}

\begin{exercise}[Kernel parametrisation after block cancellation]
\label{ex:schur-kernel}
Let $\bA\in\Real^{m\times m}$ be nonsingular and let
\[
\bM=\begin{pmatrix}\bA&\bB\\\bC&\bD\end{pmatrix}
\]
have $q$ columns in its second column block.  Put
$\bS=\bD-\bC\bA^{-1}\bB$.  Prove
\[
\nul(\bM)=
\left\{
\begin{pmatrix}-\bA^{-1}\bB\by\\\by\end{pmatrix}:
\by\in\nul(\bS)
\right\}.
\]
Deduce $\dim\nul(\bM)=\dim\nul(\bS)$.
\origin{H Thm.~8.5.10, Eq.~8.5.15; A\&M Ex.~5.48}
\end{exercise}

\begin{solution}
For $\bx\in\Real^m$ and $\by\in\Real^q$,
\begin{align*}
\bM\begin{pmatrix}\bx\\\by\end{pmatrix}=\bzero
&\iff
\bA\bx+\bB\by=\bzero,
\quad \bC\bx+\bD\by=\bzero\\
&\iff
\bx=-\bA^{-1}\bB\by,
\quad (\bD-\bC\bA^{-1}\bB)\by=\bzero.
\end{align*}
The map
$\by\mapsto(-\bA^{-1}\bB\by,\by)'$ is linear and one-to-one, so it is an
isomorphism from $\nul(\bS)$ onto $\nul(\bM)$.
\end{solution}

\begin{exercise}[Rectangular rank twins]\label{ex:rank-twins}
For $\bB\in\Real^{m\times n}$ and $\bC\in\Real^{n\times m}$, prove
\[
\rank(\bI_m-\bB\bC)
=\rank(\bI_n-\bC\bB)+m-n.
\]
\origin{A\&M Ex.~5.50; H Thm.~8.5.10}
\end{exercise}

\begin{solution}
Apply Theorem~\ref{thm:schur-rank} to
\[
\bK=\begin{pmatrix}\bI_m&\bB\\\bC&\bI_n\end{pmatrix}
\]
once with each identity block as the nonsingular diagonal block:
\[
\rank(\bK)=m+\rank(\bI_n-\bC\bB)
=n+\rank(\bI_m-\bB\bC).
\]
Rearrangement gives the identity.
\end{solution}

\begin{exercise}[A determinant identity with a scalar parameter]
\label{ex:scaled-det-twins}
For $\bB\in\Real^{m\times n}$, $\bC\in\Real^{n\times m}$, and $t\neq0$, prove
\[
\det(t\bI_m-\bB\bC)
=t^{m-n}\det(t\bI_n-\bC\bB).
\]
\origin{H Cor.~18.1.2; A\&M Ex.~5.37(b)}
\end{exercise}

\begin{solution}
Corollary~\ref{cor:sylvester-determinant}, with
$\bU=-t^{-1}\bB$ and $\bV=\bC$, gives
\[
\det(\bI_m-t^{-1}\bB\bC)
=\det(\bI_n-t^{-1}\bC\bB).
\]
Since
\[
\det(t\bI_m-\bB\bC)=t^m\det(\bI_m-t^{-1}\bB\bC),
\]
and the corresponding factor on the right is $t^n$, the stated identity follows.
\end{solution}

\begin{exercise}[A block sum-and-difference identity]
\label{ex:block-sum-difference}
For $\bA,\bB\in\Real^{n\times n}$, with no nonsingularity or commutativity
assumptions, prove
\[
\det\begin{pmatrix}\bA&\bB\\\bB&\bA\end{pmatrix}
=\det(\bA+\bB)\det(\bA-\bB).
\]
\origin{A\&M Ex.~5.38}
\end{exercise}

\begin{solution}
Block multiplication gives
\begin{align*}
&\begin{pmatrix}\bI&\bI\\\bO&\bI\end{pmatrix}
\begin{pmatrix}\bA&\bB\\\bB&\bA\end{pmatrix}\\
&\quad=
\begin{pmatrix}\bA+\bB&\bO\\\bO&\bI\end{pmatrix}
\begin{pmatrix}\bI&\bO\\\bB&\bI\end{pmatrix}
\begin{pmatrix}\bI&\bI\\\bO&\bA-\bB\end{pmatrix}.
\end{align*}
The two unit block factors have determinant $1$.  The block-triangular determinant
formula applied to the remaining factors gives the identity.
\end{solution}

\newpage
\begin{exercise}[A three-block arrow matrix]\label{ex:three-block-arrow}
Let
\[
\bZ=
\begin{pmatrix}
\bA&\bB&\bC\\
\bB'&\bD&\bO\\
\bC'&\bO&\bE
\end{pmatrix},
\]
where $\bD$ and $\bE$ are nonsingular square matrices.  Prove
\begin{align*}
\det(\bZ)
&=\det(\bD)\det(\bE)
\det(\bA-\bB\bD^{-1}\bB'-\bC\bE^{-1}\bC'),\\
\rank(\bZ)
&=\rank(\bD)+\rank(\bE)
+\rank(\bA-\bB\bD^{-1}\bB'-\bC\bE^{-1}\bC').
\end{align*}
\origin{A\&M Ex.~5.39 and 5.52}
\end{exercise}

\begin{solution}
Regroup $\bZ$ into a $2$ by $2$ partition:
\[
\widetilde{\bB}=(\bB\ \bC),\qquad
\widetilde{\bD}=\begin{pmatrix}\bD&\bO\\\bO&\bE\end{pmatrix},\qquad
\bZ=\begin{pmatrix}\bA&\widetilde{\bB}\\
\widetilde{\bB}'&\widetilde{\bD}\end{pmatrix}.
\]
Then
\[
\widetilde{\bD}^{-1}
=\begin{pmatrix}\bD^{-1}&\bO\\\bO&\bE^{-1}\end{pmatrix},\quad
\det(\widetilde{\bD})=\det(\bD)\det(\bE),\quad
\rank(\widetilde{\bD})=\rank(\bD)+\rank(\bE),
\]
and
\[
\bA-\widetilde{\bB}\widetilde{\bD}^{-1}\widetilde{\bB}'
=\bA-\bB\bD^{-1}\bB'-\bC\bE^{-1}\bC'.
\]
Apply Theorems~\ref{thm:schur-determinant} and \ref{thm:schur-rank} with the
$\widetilde{\bD}$ as the nonsingular diagonal block.
\end{solution}

\begin{exercise}[An updated block column]\label{ex:updated-block-column}
Let $\bA\in\Real^{n\times n}$ be nonsingular, $\bU\in\Real^{n\times k}$,
$\bC\in\Real^{k\times k}$, and $\bV\in\Real^{k\times n}$.  Suppose
$\bI_k+\bC\bV\bA^{-1}\bU$ is nonsingular.  Prove
\[
(\bA+\bU\bC\bV)^{-1}\bU
=\bA^{-1}\bU(\bI_k+\bC\bV\bA^{-1}\bU)^{-1}.
\]
\origin{Course formulation from H Cor.~18.2.9 and Thm.~18.2.8}
\end{exercise}

\begin{solution}
Set $\bK=\bI_k+\bC\bV\bA^{-1}\bU$.  Then
\[
(\bA+\bU\bC\bV)\bA^{-1}\bU
=\bU+\bU\bC\bV\bA^{-1}\bU
=\bU\bK.
\]
Multiplicativity and Corollary~\ref{cor:sylvester-determinant} give
\[
\det(\bA+\bU\bC\bV)
=\det(\bA)\det(\bI_k+\bC\bV\bA^{-1}\bU)
\neq0,
\]
without requiring $\bC$ to be nonsingular.  Premultiplication by
$(\bA+\bU\bC\bV)^{-1}$ and postmultiplication by $\bK^{-1}$ yield the formula.
\end{solution}

\begin{exercise}[Equivalent determinant updates]\label{ex:equivalent-det-updates}
Let $\bR\in\Real^{n\times n}$ be nonsingular,
$\bS\in\Real^{n\times m}$, $\bT\in\Real^{m\times m}$, and
$\bU\in\Real^{m\times n}$.  Prove, without assuming $\bT$ nonsingular, that
\[
\det(\bR+\bS\bT\bU)
=\det(\bR)\det(\bI_m+\bU\bR^{-1}\bS\bT)
=\det(\bR)\det(\bI_m+\bT\bU\bR^{-1}\bS).
\]
\origin{H Ex.~18.2}
\end{exercise}

\begin{solution}
Multiplicativity and Corollary~\ref{cor:sylvester-determinant} give
\begin{align*}
\det(\bR+\bS\bT\bU)
&=\det(\bR)\det(\bI_n+\bR^{-1}\bS\bT\bU)\\
&=\det(\bR)\det(\bI_m+\bU\bR^{-1}\bS\bT).
\end{align*}
A second application of that corollary, now to
$\bU\bR^{-1}\bS$ and $\bT$, gives
\[
\det(\bI_m+\bU\bR^{-1}\bS\bT)
=\det(\bI_m+\bT\bU\bR^{-1}\bS).
\]
\end{solution}

\begin{exercise}[The null direction of a rank-one update]
\label{ex:rank-one-null}
Let $\bA\in\Real^{n\times n}$ be nonsingular and let nonzero
$\bu,\bv\in\Real^n$.  Prove that
\[
\bA+\bu\bv'\text{ is singular}
\iff 1+\bv'\bA^{-1}\bu=0.
\]
In the singular case, prove
\[
(\bA+\bu\bv')\bA^{-1}\bu=\bzero,\qquad
\rank(\bA+\bu\bv')=n-1.
\]
\origin{H Cor.~18.2.10; S Prop.~3.21}
\end{exercise}

\begin{solution}
The equivalence is Corollary~\ref{cor:sherman-morrison}.  If its scalar condition
vanishes, then
\[
(\bA+\bu\bv')\bA^{-1}\bu
=\bu+\bu\bv'\bA^{-1}\bu
=\bu(1+\bv'\bA^{-1}\bu)=\bzero.
\]
Since $\bA^{-1}\bu\neq\bzero$, the update is singular.  The rank inequality for
a sum gives
\[
n=\rank(\bA)
=\rank((\bA+\bu\bv')-\bu\bv')
\leqslant\rank(\bA+\bu\bv')+\rank(\bu\bv')
=\rank(\bA+\bu\bv')+1.
\]
Singularity gives $\rank(\bA+\bu\bv')<n$; hence its rank is $n-1$.
\end{solution}

\begin{exercise}[A rank-one update without chosen factors]
\label{ex:rank-one-trace-update}
Let $\bR\in\Real^{n\times n}$ be nonsingular and let
$\bB\in\Real^{n\times n}$ have rank one.  Prove
\[
\bR+\bB\text{ is nonsingular}
\iff 1+\tr(\bR^{-1}\bB)\neq0,
\]
and, in that case,
\[
(\bR+\bB)^{-1}
=\bR^{-1}
-\frac{\bR^{-1}\bB\bR^{-1}}
{1+\tr(\bR^{-1}\bB)}.
\]
\origin{H Ex.~18.8(a)}
\end{exercise}

\begin{solution}
The rank-one expansion theorem gives
$\bB=\bu\bv'$ for nonzero $\bu,\bv$.  Componentwise,
\[
\tr(\bR^{-1}\bB)
=\tr((\bR^{-1}\bu)\bv')
=\sum_{i=1}^n(\bR^{-1}\bu)_iv_i
=\bv'\bR^{-1}\bu.
\]
Substitute $\bB=\bu\bv'$ into Corollary~\ref{cor:sherman-morrison}.
\end{solution}

