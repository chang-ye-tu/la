%=============================================================================
\section{Idempotent matrices}\label{sec:10.1}
%=============================================================================

\subsection{Range, null space, and canonical form}\label{sec:10.1.1}

\begin{definition}[Idempotent matrix]\label{def:10-idempotent}
A matrix $\bP\in\Real^{n\times n}$ is \emph{idempotent} if
\[
\bP^2=\bP.
\]
The definition includes the unique $0\times0$ matrix.
\origin{H \S10.1; A\&M \S8.3}
\end{definition}

\begin{theorem}[Range--null decomposition]\label{thm:10-range-null}
For an idempotent $\bP\in\Real^{n\times n}$,
\begin{align*}
\Real^n&=\col(\bP)\dsum\nul(\bP),\\
\col(\bP)&=\nul(\bI_n-\bP),\\
\nul(\bP)&=\col(\bI_n-\bP).
\end{align*}
\tcbbreak
For every $\bx\in\Real^n$, the corresponding unique decomposition is
\[
\bx=\bP\bx+(\bI_n-\bP)\bx.
\]
\origin{H Thm.~11.7.1 and Cor.~11.7.2}
\end{theorem}

\begin{proof}
For every $\bx$,
\begin{align*}
\bP(\bP\bx)&=\bP\bx,&
\bP(\bI_n-\bP)\bx&=(\bP-\bP^2)\bx=\bzero.
\end{align*}
Hence $\bP\bx\in\col(\bP)$ and
$(\bI_n-\bP)\bx\in\nul(\bP)$.  If
$\bz\in\col(\bP)\cap\nul(\bP)$, then
\[
\bz=\bP\by,
\qquad
\bzero=\bP\bz=\bP^2\by=\bP\by=\bz.
\]
Thus $\Real^n=\col(\bP)\dsum\nul(\bP)$.

Moreover,
\begin{align*}
\bx\in\col(\bP)
&\iff \bP\bx=\bx
\iff(\bI_n-\bP)\bx=\bzero,\\
\bx\in\nul(\bP)
&\iff \bx=(\bI_n-\bP)\bx
\iff\bx\in\col(\bI_n-\bP).
\end{align*}
The same identities are valid when $n=0$.
\end{proof}

\begin{definition}[Projection along a complementary subspace]\label{def:10-oblique}
Let $\calS,\calT\subseteq\Real^n$ satisfy
$\Real^n=\calS\dsum\calT$.  The \emph{projection onto $\calS$ along
$\calT$} is the linear map
\[
\bP(\bs+\bt)=\bs,
\qquad \bs\in\calS,\quad\bt\in\calT.
\]
It is \emph{oblique} when $\calT\ne\perpc{\calS}$.
\origin{H \S14.12, p.~336}
\end{definition}

\begin{proposition}[Idempotents are projections]\label{prop:10-idem-proj}
A linear map $\bP:\Real^n\to\Real^n$ is idempotent if and only if it is
the projection onto $\col(\bP)$ along $\nul(\bP)$.
Conversely, the projection onto $\calS$ along $\calT$ is idempotent, has
range $\calS$, and has null space $\calT$.
\origin{H Thm.~11.7.1}
\end{proposition}

\begin{proof}
If $\bP^2=\bP$, Theorem~\ref{thm:10-range-null} gives
\[
\bP(\bs+\bt)=\bP\bs+\bP\bt=\bs,
\quad
\bs\in\col(\bP),\quad\bt\in\nul(\bP).
\]
Conversely, for $\bx=\bs+\bt$,
\[
\bP^2\bx=\bP\bs=\bs=\bP\bx.
\]
The range and null assertions follow from
$\bP(\bs+\bt)=\bs$ and the uniqueness of the direct-sum decomposition.
\end{proof}

\begin{theorem}[Canonical similarity]\label{thm:10-idem-canonical}
Let $\bP\in\Real^{n\times n}$ be idempotent and
$r=\rank(\bP)$.  There is a nonsingular $\bT\in\Real^{n\times n}$ such
that
\[
\bT^{-1}\bP\bT=
\begin{pmatrix}
\bI_r&\bO\\
\bO&\bO
\end{pmatrix}.
\]
Conversely, every matrix similar to this block matrix is idempotent.
The empty diagonal blocks cover $r=0$ and $r=n$.
\origin{A\&M Ex.~8.60; H \S10.2, p.~189}
\end{theorem}

\begin{proof}
Choose bases $\bs_1,\ldots,\bs_r$ of $\col(\bP)$ and
$\bt_1,\ldots,\bt_{n-r}$ of $\nul(\bP)$, and set
\[
\bT=(\bs_1,\ldots,\bs_r,\bt_1,\ldots,\bt_{n-r}),
\qquad
\bD=\diag(\bI_r,\bO).
\]
Theorem~\ref{thm:10-range-null} gives $\bP\bT=\bT\bD$; hence
$\bT^{-1}\bP\bT=\bD$.  Conversely,
\[
(\bT\bD\bT^{-1})^2
=\bT\bD^2\bT^{-1}
=\bT\bD\bT^{-1}.
\]
\end{proof}

\begin{corollary}[Spectrum, trace, and rank]\label{cor:10-trace-rank}
If $\bP\in\Real^{n\times n}$ is idempotent of rank $r$, then
\[
\operatorname{spec}(\bP)\subseteq\{0,1\},
\qquad
\tr(\bP)=\rank(\bP)=r,
\qquad
\rank(\bI_n-\bP)=n-r.
\]
The matrix $\bP$ is diagonalizable over $\Real$.
\origin{H Cor.~10.2.2 and Lemma~10.2.4; A\&M Exs.~8.56 and 8.61}
\end{corollary}

\begin{proof}
Similarity preserves characteristic polynomials, trace, and rank.  Apply
Theorem~\ref{thm:10-idem-canonical} to
$\diag(\bI_r,\bO)$ and to its complement
$\diag(\bO,\bI_{n-r})$.
\end{proof}

\begin{example}[An oblique projection]\label{ex:10-oblique}
For $a\in\Real$,
\[
\bP_a=
\begin{pmatrix}1&a\\0&0\end{pmatrix},
\qquad
\bP_a^2=\bP_a,
\qquad
\col(\bP_a)=\spn\{\eu_1\},
\qquad
\nul(\bP_a)=\spn\{(-a,1)'\}.
\]
For $a\ne0$, $\nul(\bP_a)\ne\perpc{\col(\bP_a)}$ and
$\bP_a'\ne\bP_a$.
\origin{Adapted from A\&M Ex.~8.55}
\end{example}

\subsection{Orthogonal and complementary projections}\label{sec:10.1.2}

\begin{theorem}[Orthogonal versus oblique]\label{thm:10-orthogonal-idem}
For an idempotent $\bP\in\Real^{n\times n}$, the following are equivalent:
\begin{enumerate}[(i)]
\item $\bP'=\bP$;
\item $\col(\bP)\perp\nul(\bP)$;
\item $\nul(\bP)=\perpc{\col(\bP)}$;
\item $\bP$ is the orthogonal projector onto $\col(\bP)$.
\end{enumerate}
\origin{H Thm.~12.3.9; A\&M \S8.3, p.~202}
\end{theorem}

\begin{proof}
(i)$\Rightarrow$(ii): if $\bs=\bP\bx$ and $\bP\bt=\bzero$, then
\[
\bs'\bt=\bx'\bP'\bt=\bx'\bP\bt=0.
\]
(ii)$\Rightarrow$(iii): Theorem~\ref{thm:10-range-null} and rank--nullity
give
\[
\nul(\bP)\subseteq\perpc{\col(\bP)},
\qquad
\dim\nul(\bP)=n-r=\dim\perpc{\col(\bP)}.
\]
(iii)$\Rightarrow$(iv) is Definition~\ref{def:10-oblique} with an
orthogonal complement.  For (iv)$\Rightarrow$(i), let
$\bx=\bs+\bt$ and $\by=\bu+\bv$, with
$\bs,\bu\in\col(\bP)$ and
$\bt,\bv\in\perpc{\col(\bP)}$.  Then
\[
\bx'\bP\by=(\bs+\bt)'\bu=\bs'\bu
=\bs'(\bu+\bv)=(\bP\bx)'\by.
\]
Thus $\bx'(\bP-\bP')\by=0$ for all $\bx,\by$, so $\bP=\bP'$.
\end{proof}

\begin{proposition}[Complement]\label{prop:10-complement}
The matrix $\bP$ is idempotent if and only if $\bI_n-\bP$ is
idempotent.  In that case,
\[
\bP(\bI_n-\bP)=(\bI_n-\bP)\bP=\bO,
\]
and the two matrices project along the exchanged decomposition
\[
\Real^n=\col(\bP)\dsum\nul(\bP).
\]
If $\bP$ is symmetric, both projections are orthogonal.
\origin{H Lemma~10.1.2; A\&M Ex.~8.53}
\end{proposition}

\begin{proof}
\[
(\bI_n-\bP)^2-(\bI_n-\bP)=\bP^2-\bP.
\]
If this matrix is zero, then
\[
\bP(\bI_n-\bP)=\bP-\bP^2=\bO
=(\bI_n-\bP)\bP.
\]
The range and null spaces follow from Theorem~\ref{thm:10-range-null};
symmetry is preserved by complementation.
\end{proof}

\begin{corollary}[Symmetric idempotents are positive semidefinite]
\label{cor:10-idem-psd}
If $\bP'=\bP=\bP^2$, then
\[
\bx'\bP\bx=\bx'\bP'\bP\bx=\norm{\bP\bx}^2\geqslant0,
\qquad
\bx'(\bI_n-\bP)\bx=\norm{(\bI_n-\bP)\bx}^2\geqslant0.
\]
Thus $\bO\psdle\bP\psdle\bI_n$.
\origin{H Lemma~14.2.17; A\&M Ex.~8.66(a)}
\end{corollary}

\begin{proof}
The displayed identities use symmetry and idempotency.  The two inequalities
are the definitions of positive semidefiniteness and the L\"owner order.
\end{proof}

\subsection{Sums and products}\label{sec:10.1.3}

\begin{theorem}[Sum of two idempotents]\label{thm:10-idem-sum}
Let $\bP,\bQ\in\Real^{n\times n}$ be idempotent.  Then
\[
\bP+\bQ\text{ is idempotent}
\iff
\bP\bQ=\bQ\bP=\bO.
\]
Under these equivalent conditions,
\[
\col(\bP+\bQ)=\col(\bP)\dsum\col(\bQ),
\qquad
\rank(\bP+\bQ)=\rank(\bP)+\rank(\bQ).
\]
\origin{H Lemma~18.4.3; A\&M Ex.~8.64}
\end{theorem}

\begin{proof}
\[
(\bP+\bQ)^2-(\bP+\bQ)=\bP\bQ+\bQ\bP.
\]
If the left side is zero, premultiplication and postmultiplication by $\bP$
give
\[
\bP\bQ+\bP\bQ\bP=\bO,
\qquad
\bP\bQ\bP+\bQ\bP=\bO.
\]
Hence $\bP\bQ=\bQ\bP$; together with
$\bP\bQ+\bQ\bP=\bO$, this gives
$\bP\bQ=\bQ\bP=\bO$.  The converse follows from the first display.

If $\bz\in\col(\bP)\cap\col(\bQ)$, then
$\bz=\bP\bx=\bQ\by$ and
\[
\bz=\bP\bz=\bP\bQ\by=\bzero.
\]
The inclusion
$\col(\bP+\bQ)\subseteq\col(\bP)+\col(\bQ)$ is immediate.  Conversely,
\[
\bP\bx+\bQ\by
=(\bP+\bQ)(\bP\bx+\bQ\by).
\]
Thus the ranges are equal and their dimensions add.
\end{proof}

\begin{proposition}[Commuting product]\label{prop:10-idem-product}
If idempotents $\bP$ and $\bQ$ commute, then $\bP\bQ$ is idempotent and
\[
\col(\bP\bQ)=\col(\bP)\cap\col(\bQ).
\]
If $\bP$ and $\bQ$ are also symmetric, then $\bP\bQ$ is the orthogonal
projector onto this intersection.
\origin{Course formulation}
\end{proposition}

\begin{proof}
Commutation gives
\[
(\bP\bQ)^2=\bP\bQ\bP\bQ=\bP^2\bQ^2=\bP\bQ.
\]
If $\bz=\bP\bQ\bx$, then
$\bP\bz=\bz=\bQ\bz$, so
$\bz\in\col(\bP)\cap\col(\bQ)$.  If
$\bz\in\col(\bP)\cap\col(\bQ)$, then
$\bP\bQ\bz=\bP\bz=\bz$.  Symmetry follows from
$(\bP\bQ)'=\bQ\bP=\bP\bQ$; apply
Theorem~\ref{thm:10-orthogonal-idem}.
\end{proof}

\begin{example}[An idempotent product without commutation]
\label{ex:10-product-counterexample}
For $c\ne0$,
\[
\bP=\begin{pmatrix}1&0\\0&0\end{pmatrix},
\qquad
\bQ=\begin{pmatrix}1&0\\c&0\end{pmatrix}
\]
are idempotent, while
\[
\bP\bQ=\bP,
\qquad
\bQ\bP=\bQ\ne\bP.
\]
Thus idempotency of $\bP\bQ$ does not imply commutation for general
idempotents.
\origin{Course formulation}
\end{example}

% \periodmark{End of period 1 of 3.}

%=============================================================================
\section{Quadratic forms and inertia}\label{sec:10.2}
%=============================================================================

\subsection{Polarization, entrywise products, and inertia}\label{sec:10.2.1}

\begin{definition}[Bilinear form]\label{def:10-forms}
For $\bA\in\Real^{n\times n}$, define
\[
b_{\bA}(\bx,\by)=\bx'\bA\by.
\]
For scalars $\alpha,\beta$,
\begin{align*}
b_{\bA}(\alpha\bx_1+\beta\bx_2,\by)
&=\alpha b_{\bA}(\bx_1,\by)+\beta b_{\bA}(\bx_2,\by),\\
b_{\bA}(\bx,\alpha\by_1+\beta\by_2)
&=\alpha b_{\bA}(\bx,\by_1)+\beta b_{\bA}(\bx,\by_2).
\end{align*}
Thus $b_{\bA}$ is a \emph{bilinear form}; it is symmetric when
$\bA'=\bA$.
\origin{H \S14.1, pp.~265--266; S \S1.3}
\end{definition}

\Needspace{.35\textheight}
\begin{theorem}[Polarization identity]
\label{thm:10-polarization}
If $\bA'=\bA$, then
\[
b_{\bA}(\bx,\by)
=\frac12\{q_{\bA}(\bx+\by)-q_{\bA}(\bx)-q_{\bA}(\by)\}
=\frac14\{q_{\bA}(\bx+\by)-q_{\bA}(\bx-\by)\}.
\]
Consequently, $q_{\bA}$ determines $b_{\bA}$ and $\bA$.
\origin{H Ex.~14.1; A\&M Ex.~8.3}
\end{theorem}

\begin{proof}
\begin{align*}
q_{\bA}(\bx+\by)-q_{\bA}(\bx)-q_{\bA}(\by)
&=\bx'\bA\by+\by'\bA\bx
=2\bx'\bA\by,\\
q_{\bA}(\bx+\by)-q_{\bA}(\bx-\by)
&=2\bx'\bA\by+2\by'\bA\bx\\
&=4\bx'\bA\by.
\end{align*}
Finally,
\[
a_{ij}=b_{\bA}(\eu_i,\eu_j).
\]
\end{proof}

\begin{definition}[Hadamard product]\label{def:10-hadamard-product}
For matrices $\bA=(a_{ij})$ and $\bB=(b_{ij})$ of the same size, their
\emph{Hadamard product}, or \emph{entrywise product}, is
\[
\bA\circ\bB=(a_{ij}b_{ij}).
\]
\origin{H Ex.~14.31; A\&M Ex.~12.32; S Ex.~6.9}
\end{definition}

\begin{definition}[Inertia]\label{def:10-congruence-inertia}
If symmetric $\bA\in\Real^{n\times n}$ has
$n_+(\bA)$ positive, $n_-(\bA)$ negative, and $n_0(\bA)$ zero
eigenvalues, counted with multiplicity, its \emph{inertia} is
\[
\operatorname{In}(\bA)=\bigl(n_+(\bA),n_-(\bA),n_0(\bA)\bigr).
\]
For the $0\times0$ matrix, $\operatorname{In}(\bA)=(0,0,0)$.
\origin{H Ex.~14.11(c); S \S5.4}
\end{definition}

\subsection{Canonical signs and Sylvester's law}\label{sec:10.2.2}

\begin{theorem}[Canonical form under congruence]\label{thm:10-sign-canonical}
For every symmetric $\bA\in\Real^{n\times n}$ there is a nonsingular
$\bT$ such that
\[
\bT'\bA\bT
=\diag(\bI_p,-\bI_q,\bO_s),
\qquad p+q+s=n,
\]
where
\[
(p,q,s)=\operatorname{In}(\bA).
\]
\origin{H Cor.~14.3.5 and Ex.~14.11(b); S \S5.4}
\end{theorem}

\begin{proof}
By the symmetric spectral theorem,
\[
\bA=\bQ\diag(\lambda_1,\ldots,\lambda_n)\bQ',
\qquad \bQ'\bQ=\bI_n.
\]
After permuting the diagonal, define
\[
d_i=
\begin{cases}
|\lambda_i|^{-1/2},&\lambda_i\ne0,\\
1,&\lambda_i=0,
\end{cases}
\qquad
\bT=\bQ\diag(d_1,\ldots,d_n).
\]
Then $\bT$ is nonsingular and
\[
\bT'\bA\bT
=\diag(d_1^2\lambda_1,\ldots,d_n^2\lambda_n)
=\diag(\bI_p,-\bI_q,\bO_s).
\]
The $n=0$ case is the empty identity.
\end{proof}

\begin{lemma}[Maximal definite subspaces]\label{lem:10-max-positive}
For symmetric $\bA$,
\begin{align*}
n_+(\bA)
&=\max\{\dim\calS:q_{\bA}(\bx)>0
\text{ for every }\bzero\ne\bx\in\calS\},\\
n_-(\bA)
&=\max\{\dim\calS:q_{\bA}(\bx)<0
\text{ for every }\bzero\ne\bx\in\calS\}.
\end{align*}
For $n_+(\bA)=0$ or $n_-(\bA)=0$, the maximum is attained by
$\{\bzero\}$.
\origin{Adapted from H Ex.~14.11(a); S \S5.4}
\end{lemma}

\begin{proof}
Let $\calE_+,\calE_-,\calE_0$ be the mutually orthogonal spans of
eigenvectors with positive, negative, and zero eigenvalues.  The form is
positive definite on $\calE_+$, so the first maximum is at least
$\dim\calE_+=n_+(\bA)$.  If $\dim\calS>n_+(\bA)$, then
\[
\dim\calS+\dim(\calE_-\dsum\calE_0)>n,
\]
so $\calS\cap(\calE_-\dsum\calE_0)$ contains a nonzero $\bx$.
For this vector, $q_{\bA}(\bx)\leqslant0$.  Thus the first maximum is
$n_+(\bA)$.  Apply the same argument to $-\bA$ for the second formula.
\end{proof}

\begin{theorem}[Sylvester's law of inertia]\label{thm:10-inertia-law}
Congruent real symmetric matrices have the same inertia.
Equivalently,
\[
\operatorname{In}(\bT'\bA\bT)=\operatorname{In}(\bA)
\]
for every symmetric $\bA$ and every nonsingular $\bT$.
\origin{H Ex.~14.11(c); S \S5.4}
\end{theorem}

\begin{proof}
Let $\bB=\bT'\bA\bT$.  The bijection
$\calS\mapsto\bT\calS$ preserves dimension, and
\[
q_{\bB}(\by)=q_{\bA}(\bT\by).
\]
Lemma~\ref{lem:10-max-positive} gives
$n_+(\bB)=n_+(\bA)$ and $n_-(\bB)=n_-(\bA)$.
The nonsingularity of $\bT$ gives
\[
\rank(\bB)=\rank(\bT'\bA\bT)=\rank(\bA),
\qquad
n_0(\bB)=n-\rank(\bB)=n_0(\bA).
\]
\end{proof}

\subsection{Completing the square}\label{sec:10.2.3}

\begin{theorem}[Block completion and inertia additivity]
\label{thm:10-block-completion}
Let $k\geqslant1$, $m\geqslant0$, and
\[
\bA=
\begin{pmatrix}
\bB&\bC\\
\bC'&\bD
\end{pmatrix},
\qquad
\bB'=\bB\in\Real^{k\times k},
\qquad
\bD'=\bD\in\Real^{m\times m},
\]
where $\bB$ is nonsingular.  With the symmetric matrix
$\bS=\bD-\bC'\bB^{-1}\bC$,
\begin{align*}
\begin{pmatrix}\bx\\\bz\end{pmatrix}'
\bA
\begin{pmatrix}\bx\\\bz\end{pmatrix}
&=(\bx+\bB^{-1}\bC\bz)'\bB
(\bx+\bB^{-1}\bC\bz)+\bz'\bS\bz,\\
\operatorname{In}(\bA)
&=\operatorname{In}(\bB)+\operatorname{In}(\bS),
\end{align*}
where triples are added componentwise.  If $m=0$, $\bS$ is the
$0\times0$ matrix and the formula reduces to
$\operatorname{In}(\bA)=\operatorname{In}(\bB)$.
\origin{H Thm.~14.8.4; A\&M Ex.~8.45}
\end{theorem}

\begin{proof}
Since $(\bB^{-1})'=(\bB')^{-1}=\bB^{-1}$, $\bS'=\bS$.  Set
\[
\bT=
\begin{pmatrix}
\bI_k&-\bB^{-1}\bC\\
\bO&\bI_m
\end{pmatrix}.
\]
Then $\bT$ is nonsingular and
\[
\bT'\bA\bT=
\begin{pmatrix}
\bB&\bO\\
\bO&\bS
\end{pmatrix}.
\]
Substitution of
$\bx=(\bx+\bB^{-1}\bC\bz)-\bB^{-1}\bC\bz$
gives the quadratic identity.  The eigenvalues of a block-diagonal
matrix are those of its diagonal blocks.  Apply
Theorem~\ref{thm:10-inertia-law}.
\end{proof}

\begin{corollary}[Affine completion]\label{cor:10-affine-completion}
Let $\bA\in\Real^{n\times n}$ be positive definite, $\bbb\in\Real^n$,
and $c\in\Real$.  Then
\[
\bx'\bA\bx-2\bbb'\bx+c
=(\bx-\bA^{-1}\bbb)'\bA(\bx-\bA^{-1}\bbb)
+c-\bbb'\bA^{-1}\bbb.
\]
Hence the unique minimizer is $\bA^{-1}\bbb$, and the minimum is
$c-\bbb'\bA^{-1}\bbb$.
\origin{A\&M Ex.~8.15; H Thm.~14.12.20}
\end{corollary}

\begin{proof}
Expansion gives the identity.  Positive definiteness gives
\[
(\bx-\bA^{-1}\bbb)'\bA(\bx-\bA^{-1}\bbb)\geqslant0,
\]
with equality if and only if $\bx=\bA^{-1}\bbb$.
\end{proof}

\begin{example}[Inertia by completion]\label{ex:10-inertia-completion}
For
\[
\bA=\begin{pmatrix}2&1\\1&-2\end{pmatrix},
\]
\[
\begin{pmatrix}x&y\end{pmatrix}
\bA\begin{pmatrix}x\\y\end{pmatrix}
=2\left(x+\frac y2\right)^2-\frac52y^2.
\]
Thus $\operatorname{In}(\bA)=(1,1,0)$ without solving its
characteristic equation.
\origin{Adapted from A\&M Ex.~8.2(c)}
\end{example}

% \periodmark{End of period 2 of 3.}

%=============================================================================
\section{Orthogonal sums and second moments}\label{sec:10.3}
%=============================================================================

\subsection{The algebraic Cochran criterion}\label{sec:10.3.1}

\begin{definition}[Orthogonal resolution of the identity]
\label{def:10-resolution}
A finite family of symmetric matrices
$\bP_1,\ldots,\bP_k\in\Real^{n\times n}$ is an
\emph{orthogonal resolution of the identity} if
\[
\sum_{i=1}^k\bP_i=\bI_n,
\qquad
\bP_i^2=\bP_i,
\qquad
\bP_i\bP_j=\bO\quad(i\ne j).
\]
For $n=0$, the empty family is a resolution; for $n>0$, a resolution
has at least one member.
\origin{Adapted from H Thm.~18.4.5; A\&M Ex.~8.72}
\end{definition}

\begin{theorem}[Algebraic Cochran rank criterion]
\label{thm:10-algebraic-cochran}
Let $k\geqslant1$ and let symmetric
$\bA_1,\ldots,\bA_k\in\Real^{n\times n}$ satisfy
\[
\sum_{i=1}^k\bA_i=\bI_n.
\]
The following are equivalent:
\begin{enumerate}[(i)]
\item $\bA_i^2=\bA_i$ for every $i$;
\item $\bA_i\bA_j=\bO$ for every $i\ne j$;
\item $\sum_{i=1}^k\rank(\bA_i)=n$.
\end{enumerate}
Under these conditions,
\[
\Real^n=\col(\bA_1)\dsum\cdots\dsum\col(\bA_k)
\]
is an orthogonal direct sum.
\origin{H Thm.~18.4.5; A\&M Ex.~8.72}
\end{theorem}

\begin{proof}
(ii)$\Rightarrow$(i):
\[
\bA_i=\bA_i\bI_n
=\sum_{j=1}^k\bA_i\bA_j
=\bA_i^2.
\]
(i)$\Rightarrow$(iii), by Corollary~\ref{cor:10-trace-rank}:
\[
\sum_{i=1}^k\rank(\bA_i)
=\sum_{i=1}^k\tr(\bA_i)
=\tr\left(\sum_{i=1}^k\bA_i\right)=n.
\]

Assume (iii).  Since every $\bx$ satisfies
$\bx=\sum_i\bA_i\bx$,
\[
\Real^n=\sum_{i=1}^k\col(\bA_i).
\]
The dimension of this sum is $n=\sum_i\dim\col(\bA_i)$, so the sum is
direct.  For $\by=\bA_i\bx\in\col(\bA_i)$,
\[
\by=\sum_{j=1}^k\bA_j\by
\]
is its unique decomposition.  Hence
$\bA_i\by=\by$ and $\bA_j\by=\bzero$ for $j\ne i$, which gives
$\bA_i^2=\bA_i$ and $\bA_j\bA_i=\bO$.
Thus (iii)$\Rightarrow$(i),(ii).  Finally, symmetry gives
\[
(\bA_i\bx)'(\bA_j\by)=\bx'\bA_i\bA_j\by=0
\quad(i\ne j),
\]
so the direct sum is orthogonal.  The proof includes $n=0$.
\end{proof}

\begin{corollary}[Quadratic decomposition]\label{cor:10-quadratic-decomp}
For an orthogonal resolution $\bP_1,\ldots,\bP_k$ and every
$\by\in\Real^n$,
\[
\by=\sum_{i=1}^k\bP_i\by,
\qquad
\norm{\by}^2=\sum_{i=1}^k\norm{\bP_i\by}^2
=\sum_{i=1}^k\by'\bP_i\by,
\qquad
\sum_{i=1}^k\rank(\bP_i)=n.
\]
\origin{H Thm.~18.4.4; A\&M Ex.~8.72}
\end{corollary}

\begin{proof}
The first identity uses $\sum_i\bP_i=\bI_n$.  Pairwise orthogonality and
symmetry give
\[
\norm{\by}^2
=\left\|\sum_i\bP_i\by\right\|^2
=\sum_i\norm{\bP_i\by}^2,
\qquad
\norm{\bP_i\by}^2=\by'\bP_i'\bP_i\by=\by'\bP_i\by.
\]
The rank identity is Theorem~\ref{thm:10-algebraic-cochran}.
\end{proof}

\subsection{Regression projectors and sums of squares}\label{sec:10.3.2}

\begin{theorem}[Three regression projectors]\label{thm:10-regression-resolution}
Let $1\leqslant p\leqslant n$, let $\bX\in\Real^{n\times p}$ have rank $p$, and
assume $\bone\in\col(\bX)$.  Define
\[
\bH=\bX(\bX'\bX)^{-1}\bX',
\qquad
\bH_0=\frac1n\bone\bone',
\qquad
\bP=\bH-\bH_0,
\qquad
\bM=\bI_n-\bH.
\]
Then $\bH_0,\bP,\bM$ form an orthogonal resolution of $\bI_n$, with
\[
\rank(\bH_0)=1,
\qquad
\rank(\bP)=p-1,
\qquad
\rank(\bM)=n-p.
\]
Thus $p=1$ gives $\bP=\bO$, and $p=n$ gives $\bM=\bO$.
\origin{CLM Thm.~6.1; H Thm.~18.4.5}
\end{theorem}

\begin{proof}
Direct multiplication gives
\[
\bH' =\bH,
\quad
\bH^2=\bH,
\quad
\col(\bH)=\col(\bX),
\quad
\bH_0'=\bH_0,
\quad
\bH_0^2=\bH_0.
\]
Since $\bone\in\col(\bX)$,
\[
\bH\bone=\bone,
\qquad
\bH\bH_0=\bH_0,
\qquad
\bH_0\bH=(\bH\bH_0)'=\bH_0.
\]
Hence
\begin{align*}
\bP^2&=(\bH-\bH_0)^2=\bH-\bH_0=\bP,\\
\bM^2&=(\bI_n-\bH)^2=\bM,\\
\bH_0\bP&=\bO,
&\bH_0\bM&=\bO,
&\bP\bM&=\bO,\\
\bH_0+\bP+\bM&=\bI_n.
\end{align*}
All three matrices are symmetric.  Corollary~\ref{cor:10-trace-rank}
and $\rank(\bH)=\rank(\bX)=p$ give
\begin{align*}
\rank(\bH_0)&=1,\\
\rank(\bP)&=\tr(\bH)-\tr(\bH_0)=p-1,\\
\rank(\bM)&=n-\rank(\bH)=n-p.
\end{align*}
An idempotent of rank zero is the zero matrix.
\end{proof}

\begin{corollary}[Total, fitted, and residual sums of squares]
\label{cor:10-anova}
Under the hypotheses of Theorem~\ref{thm:10-regression-resolution}, for
every $\by\in\Real^n$ define
\[
\TSS=\by'(\bI_n-\bH_0)\by,
\qquad
\SSR=\by'\bP\by,
\qquad
\SSE=\by'\bM\by.
\]
Then
\[
\TSS=\SSR+\SSE,
\qquad
\TSS,\SSR,\SSE\geqslant0.
\]
\origin{CLM Thm.~6.1}
\end{corollary}

\begin{proof}
Theorem~\ref{thm:10-regression-resolution} gives
$\bI_n-\bH_0=\bP+\bM$.  Hence
\[
\TSS=\by'(\bP+\bM)\by=\SSR+\SSE.
\]
Each matrix is symmetric idempotent, hence positive semidefinite by
Corollary~\ref{cor:10-idem-psd}.
\end{proof}

\begin{example}[A degenerate fitted component]\label{ex:10-intercept-only}
If $p=1$ and $\bX=\bone$, then
\[
\bH=\bH_0,
\qquad
\bP=\bO,
\qquad
\SSR=0,
\qquad
\TSS=\SSE.
\]
If $p=n$, then $\bH=\bI_n$, $\bM=\bO$, and $\SSE=0$ for every
$\by$.
\origin{CLM Thm.~6.1}
\end{example}

\subsection{Second-moment identities}\label{sec:10.3.3}

\begin{theorem}[Expectation of a quadratic form]
\label{thm:10-quadratic-expectation}
Let $\by=(Y_1,\ldots,Y_n)'$ have finite second moments, mean $\bmu$, and
covariance matrix $\bSig=(\sigma_{ij})$.  For every constant
$\bA\in\Real^{n\times n}$,
\[
\expc[\by'\bA\by]
=\tr(\bA\bSig)+\bmu'\bA\bmu.
\]
The formula also holds for nonsymmetric $\bA$.
\origin{CLM Lemma~3.2}
\end{theorem}

\begin{proof}
For $\mu_i=\expc[Y_i]$,
\[
\sigma_{ij}
=\expc[(Y_i-\mu_i)(Y_j-\mu_j)]
=\expc[Y_iY_j]-\mu_i\mu_j.
\]
Hence, using $\sigma_{ij}=\sigma_{ji}$,
\begin{align*}
\expc[\by'\bA\by]
&=\sum_{i=1}^n\sum_{j=1}^n
a_{ij}\expc[Y_iY_j]\\
&=\sum_{i,j}a_{ij}\sigma_{ij}
+\sum_{i,j}a_{ij}\mu_i\mu_j\\
&=\sum_i\sum_j a_{ij}\sigma_{ji}+\bmu'\bA\bmu\\
&=\tr(\bA\bSig)+\bmu'\bA\bmu.
\end{align*}
\end{proof}

\begin{corollary}[Expected orthogonal components]
\label{cor:10-expected-components}
If $\bP_1,\ldots,\bP_k$ is an orthogonal resolution of $\bI_n$ and
\[
\expc[\by]=\bmu,
\qquad
\bSig=\sigma^2\bI_n,
\qquad \sigma^2\geqslant0,
\]
then
\[
\expc[\by'\bP_i\by]
=\sigma^2\rank(\bP_i)+\bmu'\bP_i\bmu,
\qquad i=1,\ldots,k.
\]
Summing these identities gives
\[
\expc[\by'\by]=n\sigma^2+\bmu'\bmu.
\]
\origin{H Cor.~10.2.2; CLM Lemma~3.2}
\end{corollary}

\begin{proof}
Theorem~\ref{thm:10-quadratic-expectation} and
Corollary~\ref{cor:10-trace-rank} give
\[
\expc[\by'\bP_i\by]
=\sigma^2\tr(\bP_i)+\bmu'\bP_i\bmu
=\sigma^2\rank(\bP_i)+\bmu'\bP_i\bmu.
\]
Use $\sum_i\bP_i=\bI_n$ and
$\sum_i\rank(\bP_i)=n$ to sum.
\end{proof}

\begin{theorem}[Expectation of the residual mean square]
\label{thm:10-mse-expectation}
Let $\bX\in\Real^{n\times p}$ have rank $p<n$, and suppose
\[
\by=\bX\bb+\be,
\qquad
\expc[\be]=\bzero,
\qquad
\expc[\be\be']=\sigma^2\bI_n.
\]
With $\bM=\bI_n-\bX(\bX'\bX)^{-1}\bX'$, define
\[
\SSE=\by'\bM\by,
\qquad
\MSE=\frac{\SSE}{n-p}.
\]
Then
\[
\expc[\SSE]=\sigma^2(n-p),
\qquad
\expc[\MSE]=\sigma^2.
\]
If instead $p=n$, $\bM=\bO$ and $\SSE=0$; the displayed quotient is
undefined.
\origin{CLM Thm.~3.4; H Cor.~10.2.2}
\end{theorem}

\begin{proof}
Since $\bM\bX=\bO$,
\[
\bM\by=\bM\be,
\qquad
\SSE=\by'\bM'\bM\by=\be'\bM\be.
\]
Theorem~\ref{thm:10-quadratic-expectation} and
Corollary~\ref{cor:10-trace-rank} give
\[
\expc[\SSE]
=\tr(\bM\sigma^2\bI_n)
=\sigma^2\rank(\bM)
=\sigma^2(n-p).
\]
Division by $n-p>0$ proves the second identity.  If $p=n$, the
full-rank square $\bX$ has $\col(\bX)=\Real^n$, so $\bH=\bI_n$ and
$\bM=\bO$.
\end{proof}

%=============================================================================
\section{Computation: Numerical Checks in R}\label{sec:10.4}
%=============================================================================

\subsection{An oblique projector and its canonical form}\label{sec:10.4.1}

\[
\bP=\begin{pmatrix}1&2\\0&0\end{pmatrix},
\qquad
\bT=\begin{pmatrix}1&-2\\0&1\end{pmatrix}.
\]

<<oblique-canonical>>=
P <- matrix(c(1, 0, 2, 0), 2, 2)
Tmat <- matrix(c(1, 0, -2, 1), 2, 2)
D <- diag(c(1, 0))
c(idempotency_residual = max(abs(P %*% P - P)),
  canonical_residual = max(abs(solve(Tmat) %*% P %*% Tmat - D)),
  trace = sum(diag(P)),
  rank_qr_tol_1e_12 = qr(P, tol = 1e-12)$rank)
@

The columns of $\bT$ are bases of $\col(\bP)$ and $\nul(\bP)$.
The rank is computed by QR with tolerance $10^{-12}$.

\subsection{Commuting and noncommuting products}\label{sec:10.4.2}

<<idempotent-products>>=
P <- diag(c(1, 0, 0))
Q_comm <- diag(c(1, 1, 0))
Q_noncomm <- matrix(c(1, 1, 0,
                      0, 0, 0,
                      0, 0, 1), 3, 3, byrow = TRUE)
prod_comm <- P %*% Q_comm
prod_noncomm <- P %*% Q_noncomm
c(commutator_comm = max(abs(P %*% Q_comm - Q_comm %*% P)),
  product_comm_idempotency = max(abs(prod_comm %*% prod_comm - prod_comm)),
  factor_noncomm_idempotency = max(abs(
    Q_noncomm %*% Q_noncomm - Q_noncomm)),
  commutator_noncomm = max(abs(P %*% Q_noncomm - Q_noncomm %*% P)),
  product_noncomm_idempotency = max(abs(
    prod_noncomm %*% prod_noncomm - prod_noncomm)))
@

The second product happens to be idempotent although its factors do not
commute, as in Example~\ref{ex:10-product-counterexample}.

\subsection{Completion against a congruence transform}\label{sec:10.4.3}

<<completion-inertia>>=
A <- matrix(c(2, 1, 1, -2), 2, 2)
Tmat <- matrix(c(1, 0, -1/2, 1), 2, 2)
D <- diag(c(2, -5/2))
lam <- eigen(A, symmetric = TRUE)$values
c(congruence_residual = max(abs(t(Tmat) %*% A %*% Tmat - D)),
  positive_eigenvalues = sum(lam > 1e-12),
  negative_eigenvalues = sum(lam < -1e-12),
  zero_eigenvalues = sum(abs(lam) <= 1e-12))
@

Eigenvalue signs use the stated tolerance $10^{-12}$; the manual
congruence gives the same inertia.

\subsection{Exact finite-support second moments}\label{sec:10.4.4}

<<exact-moment-enumeration>>=
support <- rbind(c(0, 0), c(2, 0), c(0, 2), c(2, 2))
prob <- c(1, 2, 1, 4) / 8
A <- matrix(c(2, -1, -1, 3), 2, 2)
mu <- colSums(support * prob)
centered <- sweep(support, 2, mu)
Sigma <- t(centered) %*% sweep(centered, 1, prob, "*")
q_values <- rowSums((support %*% A) * support)
direct <- sum(prob * q_values)
formula <- sum(diag(A %*% Sigma)) + drop(t(mu) %*% A %*% mu)
c(direct_enumeration = direct,
  trace_formula = formula,
  difference = direct - formula)
@

All support coordinates and probabilities are dyadic, so the printed zero
does not depend on Monte Carlo sampling.

\subsection{Regression resolution and sums of squares}\label{sec:10.4.5}

<<regression-resolution>>=
x <- -2:2
X <- cbind(1, x)
y <- c(2, 1, 3, 6, 8)
n <- nrow(X)
H <- X %*% solve(crossprod(X), t(X))
H0 <- matrix(1 / n, n, n)
P <- H - H0
M <- diag(n) - H
pieces <- list(H0 = H0, P = P, M = M)
pair_residual <- max(abs(P %*% M), abs(P %*% H0), abs(M %*% H0))
ranks <- vapply(pieces, function(B) qr(B, tol = 1e-10)$rank, numeric(1))
ss <- c(TSS = drop(t(y) %*% (diag(n) - H0) %*% y),
        SSR = drop(t(y) %*% P %*% y),
        SSE = drop(t(y) %*% M %*% y))
c(identity_residual = max(abs(H0 + P + M - diag(n))),
  pairwise_product_residual = pair_residual,
  rank_sum_minus_n = sum(ranks) - n,
  TSS_minus_SSR_minus_SSE = ss[1] - ss[2] - ss[3])
@

Numerical ranks use QR with tolerance $10^{-10}$.

%=============================================================================
\section{Pitfalls}\label{sec:10.5}
%=============================================================================

\subsection{Trace equal to rank does not imply idempotency}
\label{sec:10.5.1}

\[
\bA=\diag(2,2,-1),
\qquad
\tr(\bA)=3=\rank(\bA),
\qquad
\bA^2=\diag(4,4,1)\ne\bA.
\]

\subsection{Eigenvalues zero and one do not suffice without diagonalizability}
\label{sec:10.5.2}

\[
\bA=
\begin{pmatrix}
0&1&0\\
0&0&0\\
0&0&1
\end{pmatrix},
\qquad
(\lambda_1,\lambda_2,\lambda_3)=(0,0,1),
\qquad
\bA^2=
\begin{pmatrix}
0&0&0\\
0&0&0\\
0&0&1
\end{pmatrix}\ne\bA.
\]

\subsection{An idempotent product need not have commuting factors}
\label{sec:10.5.3}

\[
\bP=\begin{pmatrix}1&0\\0&0\end{pmatrix},
\qquad
\bQ=\begin{pmatrix}1&0\\1&0\end{pmatrix},
\qquad
\bP\bQ=\bP,
\qquad
\bQ\bP=\bQ.
\]

\subsection{Congruence does not preserve eigenvalues}
\label{sec:10.5.4}

\[
\bA=\bI_2,
\qquad
\bT=\diag(2,1),
\qquad
\bT'\bA\bT=\diag(4,1).
\]
The two spectra differ; both inertias equal $(2,0,0)$.

\subsection{The algebraic Cochran criterion requires the sum condition}
\label{sec:10.5.5}

\[
\bA_1=\bA_2=\begin{pmatrix}1&0\\0&0\end{pmatrix}
\]
are symmetric idempotents, but
$\bA_1+\bA_2\ne\bI_2$ and
$\bA_1\bA_2\ne\bO$.

\subsection{The residual mean-square denominator may be zero}
\label{sec:10.5.6}

If $p=\rank(\bX)=n$, then $\bH=\bI_n$, $\bM=\bO$, and $\SSE=0$.
The quotient $\SSE/(n-p)$ is undefined.

\Needspace{.24\textheight}
\subsection{The moment identity has no independence premise}
\label{sec:10.5.7}

\[
\expc[\by'\bA\by]=\tr(\bA\bSig)+\bmu'\bA\bmu
\]
requires finite second moments.  Independence, normality, and a density are
absent from its hypotheses.

\newpage

%=============================================================================
\section{Exercises}\label{sec:10.6}
%=============================================================================

\Needspace{.42\textheight}
\begin{exercise}[Fixed points characterize the range]\label{ex:10-fixed-points}
Let $\bP$ be idempotent.  Prove
\[
\col(\bP)=\{\bx:\bP\bx=\bx\}.
\]
Deduce that two idempotents with the same range and the same null space are
equal.
\origin{H Thm.~11.7.1}
\end{exercise}

\begin{solution}
If $\bx=\bP\by$, then $\bP\bx=\bP^2\by=\bx$.  Conversely,
$\bP\bx=\bx$ implies $\bx\in\col(\bP)$.

Let $\bP,\bQ$ have common range $\calS$ and common null space $\calT$.
For the unique decomposition $\bx=\bs+\bt$ with
$\bs\in\calS$, $\bt\in\calT$,
\[
\bP\bx=\bs=\bQ\bx.
\]
Thus $\bP=\bQ$.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[Constructing an oblique projector]\label{ex:10-projector-basis}
Let $\bS\in\Real^{n\times r}$ and
$\bT\in\Real^{n\times(n-r)}$ have full column rank, and suppose
$\bB=(\bS,\bT)$ is nonsingular.  Show that
\[
\bP=\bB
\begin{pmatrix}\bI_r&\bO\\\bO&\bO\end{pmatrix}
\bB^{-1}
\]
is the unique projection onto $\col(\bS)$ along $\col(\bT)$.
Include $r=0$ and $r=n$.
\origin{Adapted from A\&M Ex.~8.60; H \S11.7, p.~212}
\end{exercise}

\begin{solution}
Let $\bD=\diag(\bI_r,\bO)$.  Then
\[
\bP^2=\bB\bD^2\bB^{-1}=\bP,
\qquad
\bP\bS=\bS,
\qquad
\bP\bT=\bO.
\]
Hence $\col(\bP)=\col(\bS)$ and
$\nul(\bP)=\col(\bT)$.  Uniqueness is Exercise~\ref{ex:10-fixed-points}.
For $r=0$, $\bP=\bO$; for $r=n$, $\bP=\bI_n$.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[Contractive idempotents are orthogonal]
\label{ex:10-contractive-idempotent}
Let $\bP$ be idempotent.  Prove
\[
\norm{\bP\bx}\leqslant\norm{\bx}\quad(\bx\in\Real^n)
\iff
\bP'=\bP.
\]
Deduce that every nonsymmetric idempotent expands at least one vector.
\origin{Course formulation from H Thm.~12.3.9 and \S12.1}
\end{exercise}

\begin{solution}
If $\bP'=\bP$, then
\[
\bx=\bP\bx+(\bI_n-\bP)\bx,
\qquad
(\bP\bx)'(\bI_n-\bP)\bx=0,
\]
so
\[
\norm{\bx}^2
=\norm{\bP\bx}^2+\norm{(\bI_n-\bP)\bx}^2
\geqslant\norm{\bP\bx}^2.
\]

Conversely, let $\bs\in\col(\bP)$ and $\bt\in\nul(\bP)$.  For every
$\alpha\in\Real$,
\[
\norm{\bs}^2
=\norm{\bP(\bs+\alpha\bt)}^2
\leqslant\norm{\bs+\alpha\bt}^2
=\norm{\bs}^2+2\alpha\bs'\bt+\alpha^2\norm{\bt}^2.
\]
The quadratic on the right is nonnegative for every $\alpha$, hence
$\bs'\bt=0$.  Thus
$\col(\bP)\perp\nul(\bP)$, and
Theorem~\ref{thm:10-orthogonal-idem} gives $\bP'=\bP$.
The contrapositive gives the last assertion.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[Products of orthogonal projectors]\label{ex:10-orth-product}
Let $\bP$ and $\bQ$ be symmetric idempotents.  Prove
\[
\bP\bQ\text{ is idempotent}
\iff
\bP\bQ=\bQ\bP.
\]
In that case, identify its range.
\origin{Course formulation}
\end{exercise}

\begin{solution}
The reverse implication is Proposition~\ref{prop:10-idem-product}.  Suppose
$(\bP\bQ)^2=\bP\bQ$ and set $\bC=\bP\bQ-\bQ\bP$.  Transposition gives
$(\bQ\bP)^2=\bQ\bP$.  Since
\[
\tr(\bC'\bC)
=\tr(\bQ\bP\bQ)-\tr((\bQ\bP)^2)
-\tr((\bP\bQ)^2)+\tr(\bP\bQ\bP)=0,
\]
and
$\tr(\bC'\bC)=\sum_{i,j}c_{ij}^2$, $\bC=\bO$.  Thus
$\bP\bQ=\bQ\bP$.  Proposition~\ref{prop:10-idem-product} gives
\[
\col(\bP\bQ)=\col(\bP)\cap\col(\bQ).
\]
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[Calculus with a resolution of identity]
\label{ex:10-resolution-calculus}
Let $\bP_1,\ldots,\bP_k$ be an orthogonal resolution of $\bI_n$, and
let $a_1,\ldots,a_k\in\Real$.  Define
$\bA=\sum_i a_i\bP_i$.  Prove, for every polynomial $f$, that
\[
f(\bA)=\sum_{i=1}^k f(a_i)\bP_i.
\]
Deduce that $\bA$ is nonsingular if and only if every $a_i$ attached to a
nonzero $\bP_i$ is nonzero, in which case
\[
\bA^{-1}=\sum_{i:\,\bP_i\ne\bO}a_i^{-1}\bP_i.
\]
\origin{Adapted from A\&M Ex.~8.73; S \S5.5}
\end{exercise}

\begin{solution}
For $m\geqslant1$, pairwise annihilation gives
\[
\bA^m=\left(\sum_i a_i\bP_i\right)^m
=\sum_i a_i^m\bP_i.
\]
The constant term satisfies $\bI_n=\sum_i\bP_i$, so linearity gives the
polynomial identity.

If $a_j=0$ and $\bP_j\ne\bO$, choose
$\bzero\ne\bx\in\col(\bP_j)$; then $\bA\bx=\bzero$.  If all relevant
$a_i$ are nonzero, then
\[
\left(\sum_i a_i\bP_i\right)
\left(\sum_i a_i^{-1}\bP_i\right)
=\sum_i\bP_i=\bI_n,
\]
where zero members may be omitted.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[Resolution of an idempotent]\label{ex:10-resolution-of-P}
Let $\bP$ be a symmetric idempotent and let symmetric matrices
$\bA_1,\ldots,\bA_k$ satisfy
\[
\sum_{i=1}^k\bA_i=\bP.
\]
Prove that the following are equivalent:
\begin{enumerate}[(i)]
\item every $\bA_i$ is idempotent;
\item $\bA_i\bA_j=\bO$ for $i\ne j$;
\item $\sum_i\rank(\bA_i)=\rank(\bP)$.
\end{enumerate}
\origin{Adapted from H Thms.~18.4.1 and 18.4.5}
\end{exercise}

\begin{solution}
Add $\bA_0=\bI_n-\bP$.  Since
\[
\bA_0+\sum_{i=1}^k\bA_i=\bI_n,
\qquad
\rank(\bA_0)=n-\rank(\bP),
\]
condition (iii) is equivalent to
$\sum_{i=0}^k\rank(\bA_i)=n$.  Theorem~\ref{thm:10-algebraic-cochran}
then gives (i) and (ii).

If (i) holds, Corollary~\ref{cor:10-trace-rank} gives
\[
\sum_i\rank(\bA_i)=\sum_i\tr(\bA_i)
=\tr(\bP)=\rank(\bP),
\]
so (iii) holds.  If (ii) holds, then
\[
\bzero=\bP^2-\bP=\sum_i(\bA_i^2-\bA_i).
\]
Each $(\bA_i^2-\bA_i)\bx$ lies in $\col(\bA_i)$.  These column spaces
are pairwise orthogonal because the matrices are symmetric and
$\bA_i\bA_j=\bO$.  Thus every summand is zero for every $\bx$, so
$\bA_i^2=\bA_i$ and (i) holds.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[A diagonal entry of an inverse]
\label{ex:10-inverse-diagonal}
Let $\bA=(a_{ij})\psdgt\bO$ and
$\bA^{-1}=(b_{ij})$.  Prove, for $i=1,\ldots,n$,
\[
b_{ii}\geqslant \frac1{a_{ii}},
\]
with equality if and only if $a_{ij}=0$ for every $j\ne i$.
\origin{H Ex.~14.8}
\end{exercise}

\begin{solution}
Simultaneously permute rows and columns so that $i=1$, and write
\[
\bA=\begin{pmatrix}a&\br'\\\br&\bC\end{pmatrix}.
\]
For $n=1$, $b_{11}=a^{-1}$.  For $n>1$, $\bC\psdgt\bO$.  If the first
column of $\bA^{-1}$ is $(\beta,\bz')'$, then
\[
\br\beta+\bC\bz=\bzero,
\qquad
a\beta+\br'\bz=1.
\]
Thus
\[
\bz=-\beta\bC^{-1}\br,
\qquad
b_{11}=\beta
=\frac1{a-\br'\bC^{-1}\br}.
\]
Block completion gives
\[
a-\br'\bC^{-1}\br>0,
\qquad
\br'\bC^{-1}\br\geqslant0.
\]
Therefore $b_{11}\geqslant a^{-1}$, with equality exactly when
$\br'\bC^{-1}\br=0$, equivalently $\br=\bzero$.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[Two quadratic penalties]\label{ex:10-two-penalties}
Let $\bA,\bB\in\Real^{n\times n}$ be positive definite and let
$\ba,\bbb\in\Real^n$.  Find the unique minimizer of
\[
g(\bx)=(\bx-\ba)'\bA(\bx-\ba)
+(\bx-\bbb)'\bB(\bx-\bbb),
\]
and give the minimum as an exact quadratic form in $\ba-\bbb$.
\origin{Adapted from A\&M Ex.~8.15}
\end{exercise}

\begin{solution}
Set $\bC=\bA+\bB$ and
$\bd=\bA\ba+\bB\bbb$.  Then
\[
g(\bx)=\bx'\bC\bx-2\bd'\bx
+\ba'\bA\ba+\bbb'\bB\bbb.
\]
Corollary~\ref{cor:10-affine-completion} gives the minimizer
\[
\bx_*=(\bA+\bB)^{-1}(\bA\ba+\bB\bbb).
\]
Let $\bu=\ba-\bbb$ and substitute
$\bx=\bbb+\bz$.  The minimum over $\bz$ of
\[
(\bz-\bu)'\bA(\bz-\bu)+\bz'\bB\bz
\]
is
\[
\bu'\{\bA-\bA(\bA+\bB)^{-1}\bA\}\bu
=\bu'(\bA^{-1}+\bB^{-1})^{-1}\bu,
\]
because
\[
\bA-\bA(\bA+\bB)^{-1}\bA
=\bA(\bA+\bB)^{-1}\bB
\]
and the inverse of the last matrix is
$\bB^{-1}(\bA+\bB)\bA^{-1}=\bA^{-1}+\bB^{-1}$.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[A rank-one change of positive inertia]
\label{ex:10-rank-one-inertia}
Let $n\geqslant1$, $\bA=\bA'\in\Real^{n\times n}$, and $\bu\in\Real^n$.
Prove
\[
n_+(\bA)
\leqslant n_+(\bA+\bu\bu')
\leqslant n_+(\bA)+1.
\]
Construct examples attaining either bound.
\origin{S \S5.4}
\end{exercise}

\begin{solution}
If $q_{\bA}$ is positive on $\calS\setminus\{\bzero\}$, then
\[
\bx'(\bA+\bu\bu')\bx
=\bx'\bA\bx+(\bu'\bx)^2>0
\]
there; Lemma~\ref{lem:10-max-positive} gives the lower bound.

Let $\calT$ be a maximal positive subspace for $\bA+\bu\bu'$.
Since $\calT\cap\perpc{\spn\{\bu\}}$ has dimension at least
$\dim\calT-1$, and on this intersection
\[
\bx'(\bA+\bu\bu')\bx=\bx'\bA\bx,
\]
Lemma~\ref{lem:10-max-positive} gives
$n_+(\bA)\geqslant\dim\calT-1$.

The lower bound is attained by $\bA=\bI_n$ and any $\bu$.  For the upper
bound, for $0\leqslant p<n$, take $\bA=\diag(\bI_p,-1,\bO)$ and
$\bu=\sqrt2\,\eu_{p+1}$; the entry $-1$ becomes $1$.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[Inertia and a Schur complement]\label{ex:10-inertia-schur}
Let
\[
\bA=\begin{pmatrix}\bB&\bC\\\bC'&\bD\end{pmatrix}
\]
be symmetric with nonsingular $\bB$.  Prove:
\begin{enumerate}[(a)]
\item $\bA$ is nonsingular if and only if
$\bD-\bC'\bB^{-1}\bC$ is nonsingular;
\item $\bA$ and $\bB$ have the same positive and negative inertia counts
if and only if the Schur complement is a zero matrix;
\item if $\bB$ is positive definite, then $\bA$ is positive definite if
and only if its Schur complement is positive definite.
\end{enumerate}
\origin{H Thm.~14.8.4; A\&M Ex.~8.45}
\end{exercise}

\begin{solution}
Theorem~\ref{thm:10-block-completion} gives
\[
\operatorname{In}(\bA)
=\operatorname{In}(\bB)
+\operatorname{In}(\bD-\bC'\bB^{-1}\bC).
\]
(a) A symmetric matrix is nonsingular exactly when its zero inertia count
is zero.  Since $\bB$ is nonsingular, the displayed equality proves (a).

(b) The positive and negative counts contributed by the Schur complement
are both zero exactly when all its eigenvalues are zero.  A real symmetric
matrix with only zero eigenvalues is the zero matrix.

(c) Positive definiteness is equivalent to inertia $(n,0,0)$; componentwise
addition proves the equivalence.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[Nested model reduction]\label{ex:10-nested-projectors}
Let $\calS_0\subseteq\calS_1\subseteq\Real^n$, with orthogonal projectors
$\bH_0,\bH_1$ and residual projectors
$\bM_j=\bI_n-\bH_j$.  Prove that
\[
\bP=\bH_1-\bH_0
\]
is a symmetric idempotent of rank
$\dim\calS_1-\dim\calS_0$, and
\[
\bM_0=\bP+\bM_1,
\qquad
\by'\bM_0\by-\by'\bM_1\by=\by'\bP\by\geqslant0.
\]
\origin{Adapted from CLM Ex.~11.14(a); H Thm.~18.4.5}
\end{exercise}

\begin{solution}
Since $\bH_0\bx\in\calS_0\subseteq\calS_1$ for every $\bx$,
\[
\bH_1\bH_0\bx=\bH_0\bx,
\qquad
\bH_0\bH_1=(\bH_1\bH_0)'=\bH_0.
\]
Hence
\[
\bP'=\bP,
\qquad
\bP^2=\bH_1-2\bH_0+\bH_0=\bP.
\]
Therefore
\[
\rank(\bP)=\tr(\bP)
=\rank(\bH_1)-\rank(\bH_0)
=\dim\calS_1-\dim\calS_0.
\]
Finally,
\[
\bM_0=\bI_n-\bH_0
=(\bH_1-\bH_0)+(\bI_n-\bH_1)=\bP+\bM_1,
\]
and $\by'\bP\by\geqslant0$ by
Corollary~\ref{cor:10-idem-psd}.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[Schur product theorem]\label{ex:10-schur-product}
If $\bA,\bB\psdge\bO$ have the same order, prove
$\bA\circ\bB\psdge\bO$.  If
$\bA,\bB\psdgt\bO$, prove $\bA\circ\bB\psdgt\bO$.
\origin{H Ex.~14.31; A\&M Ex.~12.32; S Ex.~6.9}
\end{exercise}

\begin{solution}
For $\bD=\diag(x_1,\ldots,x_n)$,
\[
\bx'(\bA\circ\bB)\bx
=\sum_{i,j}a_{ij}b_{ij}x_ix_j
=\tr(\bA\bD\bB\bD).
\]
Moreover, $(\bA\circ\bB)'=\bA\circ\bB$.
Let $\bA^{1/2}$ and $\bB^{1/2}$ be the symmetric square roots and set
$\bM=\bA^{1/2}\bD\bB^{1/2}$.  Then
\[
\tr(\bA\bD\bB\bD)
=\tr(\bM\bM')
=\sum_{i,j}m_{ij}^2\geqslant0.
\]
Thus $\bA\circ\bB\psdge\bO$.  If $\bA,\bB\psdgt\bO$, their square
roots are nonsingular, so
\[
\bM=\bO\iff\bD=\bO\iff\bx=\bzero.
\]
Hence the quadratic form is positive for $\bx\ne\bzero$.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[A second-moment comparison]\label{ex:10-moment-comparison}
Let $\by$ have mean $\bmu$ and covariance $\bSig$, and let symmetric
$\bA,\bB$ satisfy $\bA\psdge\bB$.  Prove
\[
\expc[\by'\bA\by]\geqslant\expc[\by'\bB\by].
\]
Give exact equality conditions in terms of
$\bC=\bA-\bB$, $\bmu$, and $\bSig^{1/2}$.
\origin{H Cor.~14.3.11; CLM Lemma~3.2}
\end{exercise}

\begin{solution}
Since $\bC\psdge\bO$,
\[
\expc[\by'\bA\by]-\expc[\by'\bB\by]
=\tr(\bC\bSig)+\bmu'\bC\bmu.
\]
Let $\bC^{1/2}$ and $\bSig^{1/2}$ be the symmetric square roots.  Then
\begin{align*}
\tr(\bC\bSig)
&=\tr(\bSig^{1/2}\bC\bSig^{1/2})
=\tr\{(\bC^{1/2}\bSig^{1/2})'
(\bC^{1/2}\bSig^{1/2})\}\geqslant0,\\
\bmu'\bC\bmu&=\norm{\bC^{1/2}\bmu}^2\geqslant0.
\end{align*}
Equality holds if and only if
\[
\bC^{1/2}\bSig^{1/2}=\bO,
\qquad
\bC^{1/2}\bmu=\bzero.
\]
Equivalently, $\bC\bSig^{1/2}=\bO$ and $\bC\bmu=\bzero$.
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[A quadratic form with prescribed expectation]
\label{ex:10-quadratic-scale-expectation}
Suppose
\[
\expc[\by]=\bX\bb,
\qquad
\cov(\by)=\sigma^2\bI_n,
\]
where $\bX\in\Real^{n\times p}$ is fixed and
$\bb\in\Real^p$ and $\sigma^2\geqslant0$ are arbitrary.
For symmetric constant $\bA$, prove
\[
\expc[\by'\bA\by]=\sigma^2
\quad\text{for all }\bb,\sigma^2
\]
if and only if
\[
\tr(\bA)=1,
\qquad
\bX'\bA\bX=\bO.
\]
Show that $\bA=\bM/(n-p)$ satisfies these conditions when
$\rank(\bX)=p<n$.
\origin{Adapted from CLM Thm.~3.4; A\&M Ex.~13.60}
\end{exercise}

\begin{solution}
Theorem~\ref{thm:10-quadratic-expectation} gives
\[
\expc[\by'\bA\by]
=\sigma^2\tr(\bA)+\bb'\bX'\bA\bX\bb.
\]
If this equals $\sigma^2$ for every $\bb,\sigma^2$, set $\bb=\bzero$
and $\sigma^2=1$ to get $\tr(\bA)=1$.  Then set $\sigma^2=0$:
\[
\bb'\bX'\bA\bX\bb=0\quad\forall\bb.
\]
Theorem~\ref{thm:10-polarization} gives
$\bX'\bA\bX=\bO$.  The converse follows by substitution.

For $\bM=\bI_n-\bX(\bX'\bX)^{-1}\bX'$,
\[
\bM\bX=\bO,
\qquad
\tr\left(\frac{\bM}{n-p}\right)
=\frac{\rank(\bM)}{n-p}=1.
\]
\end{solution}

\Needspace{.42\textheight}
\begin{exercise}[Idempotent Gram matrices]
\label{ex:10-idempotent-grams}
Let $\bA\in\Real^{m\times n}$.  Prove
\[
\bA'\bA\text{ is idempotent}
\iff
\bA\bA'\text{ is idempotent}.
\]
Under either condition, prove
\[
\bA=\bA\bA'\bA.
\]
\origin{Adapted from H Ex.~10.4}
\end{exercise}

\begin{solution}
Suppose $\bC=\bA'\bA$ is idempotent.  Since $\bC'=\bC$,
\[
\norm{\bA(\bI_n-\bC)\bx}^2
=\bx'(\bI_n-\bC)\bC(\bI_n-\bC)\bx=0
\qquad(\bx\in\Real^n).
\]
Thus $\bA(\bI_n-\bC)=\bO$, and hence
\[
\bA=\bA\bC=\bA\bA'\bA,
\qquad
(\bA\bA')^2=\bA(\bA'\bA)\bA'=\bA\bA'.
\]
Applying this implication to $\bA'$ proves the converse and the same
identity.
\end{solution}

