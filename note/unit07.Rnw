%=============================================================================
\section{Complex roots and the eigenvalue problem}\label{sec:7.1}
%=============================================================================

\subsection{Complex scalars and finite-dimensional algebra}\label{sec:7.1.1}

\begin{definition}[Complex number, conjugate, and modulus]\label{def:complex-number}
\[
\mathbb C=\{a+\mathrm{i}b:a,b\in\mathbb R\},
\qquad \mathrm{i}^{\,2}=-1.
\]
For $z=a+\mathrm{i}b$ and $w=c+\mathrm{i}d$,
\[
z+w=(a+c)+\mathrm{i}(b+d),\qquad
zw=(ac-bd)+\mathrm{i}(ad+bc).
\]
The \emph{conjugate}, \emph{real part}, \emph{imaginary part}, and
\emph{modulus} of $z$ are
\[
\bar z=a-\mathrm{i}b,\qquad
\Re z=a,\qquad
\Im z=b,\qquad
|z|=(a^2+b^2)^{1/2}.
\]
A real number is identified with $a+\mathrm{i}0$.
\origin{A\&M \S1.2 and Exs.~1.17--1.19}
\end{definition}

\begin{theorem}[Complex scalar identities]\label{thm:complex-scalar}
For $z,w\in\mathbb C$,
\[
\overline{z+w}=\bar z+\bar w,\qquad
\overline{zw}=\bar z\,\bar w,\qquad
\overline{\bar z}=z,
\]
\[
z\bar z=|z|^2,\qquad |zw|=|z||w|,\qquad
|\bar z|=|z|.
\]
Moreover,
\[
z\ne0
\quad\Longrightarrow\quad
z^{-1}=\frac{\bar z}{|z|^2}.
\]
With the preceding addition and multiplication, $\mathbb C$ is a field.
\origin{A\&M Exs.~1.17--1.19}
\end{theorem}

\begin{proof}
Writing $z=a+\mathrm{i}b$ and $w=c+\mathrm{i}d$ gives
\[
\overline{zw}
=(ac-bd)-\mathrm{i}(ad+bc)
=(a-\mathrm{i}b)(c-\mathrm{i}d)
=\bar z\,\bar w,
\]
\[
z\bar z=(a+\mathrm{i}b)(a-\mathrm{i}b)=a^2+b^2=|z|^2,
\]
and the remaining conjugation identities follow entrywise.  Hence
\[
|zw|^2=zw\overline{zw}
=z\bar z\,w\bar w
=|z|^2|w|^2.
\]
Both sides are nonnegative, so $|zw|=|z||w|$.  If $z\ne0$, then
$|z|^2=a^2+b^2>0$ and
\[
z\frac{\bar z}{|z|^2}=1.
\]
Associativity, commutativity, distributivity, and the identities $0,1$ follow
by expanding real and imaginary parts and applying the real field laws.
\end{proof}

\begin{definition}[Complex vectors and matrices]\label{def:complex-matrices}
For positive integers $m,n$,
\[
\mathbb C^n=\{(z_1,\ldots,z_n)':z_j\in\mathbb C\},
\qquad
\mathbb C^{m\times n}=\{\bA=(a_{ij}):a_{ij}\in\mathbb C\}.
\]
\tcbbreak
Addition, scalar multiplication, matrix multiplication, span, linear
independence, basis, dimension, kernel, image, rank, trace, transpose, and
block partitioning are defined by the same coordinate formulas as over
$\mathbb R$.  Write $\mathbb F\in\{\mathbb R,\mathbb C\}$ when a statement
holds over either field.  Then
\[
\det\bA
=\sum_{\sigma}
\sgn(\sigma)\prod_{i=1}^n a_{i,\sigma(i)},
\qquad \bA\in\mathbb F^{n\times n},
\]
where the sum is over the permutations of $\{1,\ldots,n\}$.
\origin{S \S\S1.1--1.3 and \S3.1; A\&M \S1.2}
\end{definition}

\Needspace{.90\textheight}
\begin{theorem}[Field transfer for finite-dimensional algebra]\label{thm:field-transfer}
Let $\mathbb F\in\{\mathbb R,\mathbb C\}$.  The basis-extension theorem,
rank--nullity, row reduction, row rank equals column rank, and the square
inverse criterion hold in $\mathbb F^n$.  Moreover,
\[
\dim\mathbb F^{m\times n}=mn,\qquad
\rank(\bA')=\rank(\bA)
\quad\bigl(\bA\in\mathbb F^{m\times n}\bigr).
\]
The determinant over $\mathbb F$ is multilinear and alternating and satisfies
\[
\det(\bA\bB)=\det\bA\,\det\bB,\qquad
\det(\bA')=\det\bA,\qquad
\bA\adj(\bA)=\adj(\bA)\bA=(\det\bA)\bI.
\]
Block-triangular determinant identities and Sylvester's identity also hold:
\[
\det\begin{pmatrix}\bA&\bB\\\bO&\bD\end{pmatrix}
=\det\bA\,\det\bD,
\qquad
\det(\bI_m-\bX\bY)=\det(\bI_n-\bY\bX)
\]
for $\bX\in\mathbb F^{m\times n}$ and
$\bY\in\mathbb F^{n\times m}$.
\origin{S \S\S1.1--1.3 and \S\S3.1--3.3}
\end{theorem}

\begin{proof}
Every nonzero pivot in $\mathbb F$ has an inverse.  The elimination algorithm
therefore produces echelon form over either field.  Pivot columns give a
basis of the image; nonzero rows give a basis of the row space; free variables
give a basis of the kernel; appending vectors and eliminating their
coordinates proves basis extension.  For
$T:\mathbb F^d\to\mathbb F^e$, counting pivots gives
\[
\dim\ker T+\dim\im T=\dim\dom T.
\]
For every matrix $\bA$,
\[
\dim\row(\bA)
=\#\{\hbox{pivots of }\bA\}
=\dim\col(\bA).
\]
The $mn$ matrices having one entry equal to $1$ and all other entries zero
form a basis of $\mathbb F^{m\times n}$.  Transposition exchanges row rank and
column rank.
The earlier proofs of the displayed determinant identities expand only finite
sums and products, cancel a nonzero pivot, or multiply unit block factors.
The complex scalar identities supply every field operation used in those
proofs, so each equality is unchanged over $\mathbb C$.
\end{proof}

\subsection{Polynomials over the two fields}\label{sec:7.1.2}

\begin{definition}[Polynomial, root, factor, and multiplicity]\label{def:polynomial}
For $\mathbb F\in\{\mathbb R,\mathbb C\}$,
\[
\mathbb F[t]
=\left\{\sum_{j=0}^d c_jt^j:d\geqslant0,\ c_j\in\mathbb F\right\}.
\]
For a nonzero polynomial $p(t)=\sum_{j=0}^d c_jt^j$ with $c_d\ne0$,
$\deg p=d$.  A polynomial $q$ \emph{divides} $p$, written $q\mid p$, if
$p=qr$ for some $r\in\mathbb F[t]$.  A scalar $\lambda\in\mathbb F$ is a
\emph{root} of $p$ if $p(\lambda)=0$.  Its \emph{multiplicity} is
\[
m_p(\lambda)
=\max\{r\geqslant1:(t-\lambda)^r\mid p\}.
\]
\tcbbreak
A degree-$d$ polynomial \emph{splits over $\mathbb F$} if it has the form
\[
c\prod_{j=1}^d(t-\lambda_j),
\qquad c,\lambda_1,\ldots,\lambda_d\in\mathbb F.
\]
\origin{H Appendix~21.A, p.~485}
\end{definition}

\begin{theorem}[Division, factors, and polynomial identity]\label{thm:polynomial-basics}
Let $p,q\in\mathbb F[t]$ and $q\ne0$.

\begin{enumerate}[(a)]
\item There are unique $b,r\in\mathbb F[t]$ such that
\[
p=bq+r,\qquad r=0\ \hbox{or}\ \deg r<\deg q.
\]
\item $p(\lambda)=0$ if and only if $(t-\lambda)\mid p$.
\item A nonzero polynomial of degree $d$ has at most $d$ distinct roots.
\item If two polynomials agree at infinitely many scalars, they are equal.
\end{enumerate}
\origin{H Thms.~21.A.1--21.A.3 and 21.A.5}
\end{theorem}

\begin{proof}
If $p=0$, take $b=r=0$.  Let $p\ne0$, $\deg p=m$, and $\deg q=d$, with
leading coefficients $a_m,b_d$.
For nonzero $f,g\in\mathbb F[t]$, their leading coefficients have nonzero
product, so
\[
\deg(fg)=\deg f+\deg g.
\]
If $m<d$, take $b=0$, $r=p$.  If $m\geqslant d$, then
\[
p_1(t)=p(t)-a_mb_d^{-1}t^{m-d}q(t)
\]
has degree less than $m$.  Induction on $m$ gives existence.  If
$p=bq+r=\tilde bq+\tilde r$, then
\[
(b-\tilde b)q=\tilde r-r.
\]
A nonzero left side has degree at least $d$, while a nonzero right side has
degree less than $d$; hence both vanish.

Division by $t-\lambda$ gives $p(t)=(t-\lambda)b(t)+r$ with constant $r$.
Evaluation at $\lambda$ gives $r=p(\lambda)$, proving (b).  If
$p=(t-\lambda_1)q_1$ and $\lambda_2\ne\lambda_1$ is another root, then
\[
0=p(\lambda_2)
=(\lambda_2-\lambda_1)q_1(\lambda_2)
\quad\Longrightarrow\quad
q_1(\lambda_2)=0.
\]
Repeating this argument gives
\[
\lambda_1,\ldots,\lambda_k\ \hbox{distinct roots}
\quad\Longrightarrow\quad
\prod_{j=1}^k(t-\lambda_j)\mid p,
\]
so $k\leqslant\deg p$.  The difference of two polynomials agreeing at infinitely
many scalars has infinitely many roots; (c) forces that difference to be zero.
\end{proof}

\begin{theorem}[Factorisation over $\mathbb C$]\label{thm:fta-factorisation}
If $p\in\mathbb C[t]$ has degree $d\geqslant1$ and leading coefficient $c_d$, then
there are $\lambda_1,\ldots,\lambda_d\in\mathbb C$ such that
\[
p(t)=c_d\prod_{j=1}^d(t-\lambda_j).
\]
Each root occurs in this list according to its multiplicity.
\origin{Adapted from H \S21.1, Eqs.~(21.1.10)--(21.1.11), and Thm.~21.A.3}
\end{theorem}

\begin{proof}
The fundamental theorem of algebra supplies a root $\lambda_1$.  The factor
theorem gives
\[
p(t)=(t-\lambda_1)p_1(t),\qquad \deg p_1=d-1.
\]
If $d-1>0$, apply the fundamental theorem of algebra to $p_1$ and repeat.
After $d$ steps the remaining factor is the leading coefficient $c_d$.
If $\lambda$ occurs $r$ times, then
\[
p(t)=(t-\lambda)^rh(t),\qquad
h(\lambda)
=c_d\prod_{\lambda_j\ne\lambda}(\lambda-\lambda_j)\ne0.
\]
The factor theorem excludes $(t-\lambda)\mid h$, so
$m_p(\lambda)=r$.
\end{proof}

\subsection{Eigenvalues and the characteristic polynomial}\label{sec:7.1.3}

\begin{definition}[Spectrum and multiplicities over a field]\label{def:eigendata}
Let $\mathbb F\in\{\mathbb R,\mathbb C\}$ and
$\bA\in\mathbb F^{n\times n}$.  A scalar $\lambda\in\mathbb F$ is an
\emph{eigenvalue} of $\bA$ if
\[
\bA\bx=\lambda\bx
\]
for some \emph{eigenvector} $\bx\in\mathbb F^n\setminus\{\bzero\}$.  The
\emph{eigenspace}, \emph{spectrum}, and \emph{characteristic polynomial} are
\[
\calE_\lambda(\bA)=\ker(\bA-\lambda\bI_n),\qquad
\sigma_{\mathbb F}(\bA)=\{\lambda\in\mathbb F:
\calE_\lambda(\bA)\ne\{\bzero\}\},
\]
\[
\chi_{\bA}(t)=\det(t\bI_n-\bA).
\]
For $\lambda\in\sigma_{\mathbb F}(\bA)$, its \emph{algebraic multiplicity} is
$a_{\bA}(\lambda)=m_{\chi_{\bA}}(\lambda)$ and its
\emph{geometric multiplicity} is
\[
g_{\bA}(\lambda)=\dim\calE_\lambda(\bA)
=n-\rank(\bA-\lambda\bI_n).
\]
For a real matrix, $\sigma_{\mathbb R}(\bA)$ and
$\sigma_{\mathbb C}(\bA)$ distinguish eigenpairs in $\mathbb R^n$ from
eigenpairs obtained when its entries are regarded as complex.
\origin{H \S21.1, eqs.~(21.1.1)--(21.1.11); A\&M \S7.1}
\end{definition}

\Needspace{.42\textheight}
\begin{theorem}[Characteristic criterion and coefficients]\label{thm:characteristic-coefficients}
For $\bA\in\mathbb F^{n\times n}$ and $\lambda\in\mathbb F$,
\[
\lambda\in\sigma_{\mathbb F}(\bA)
\quad\Longleftrightarrow\quad
\chi_{\bA}(\lambda)=0.
\]
Moreover,
\[
\chi_{\bA}(t)
=t^n-(\tr\bA)t^{n-1}+\cdots+(-1)^n\det\bA.
\]
\origin{H \S21.1, eqs.~(21.1.2)--(21.1.8); A\&M \S7.1}
\end{theorem}

\begin{proof}
\[
\bA\bx=\lambda\bx\ \hbox{for some }\bx\ne\bzero
\iff
\ker(\lambda\bI-\bA)\ne\{\bzero\}
\iff
\det(\lambda\bI-\bA)=0.
\]
In the Leibniz expansion of $\det(t\bI-\bA)$, the identity permutation gives
\[
\prod_{i=1}^n(t-a_{ii})
=t^n-\left(\sum_{i=1}^na_{ii}\right)t^{n-1}+\cdots.
\]
A nonidentity permutation has at most $n-2$ fixed points, so every other term
has degree at most $n-2$.  Thus the first two coefficients are $1$ and
$-\tr\bA$.  At $t=0$,
\[
\chi_{\bA}(0)=\det(-\bA)=(-1)^n\det\bA.
\]
\end{proof}

\begin{theorem}[Complex spectrum, trace, and determinant]\label{thm:spectrum-trace-det}
Every $\bA\in\mathbb C^{n\times n}$ has complex eigenvalues
$\lambda_1,\ldots,\lambda_n$, listed with algebraic multiplicity, and
\[
\chi_{\bA}(t)=\prod_{j=1}^n(t-\lambda_j),
\qquad
\tr\bA=\sum_{j=1}^n\lambda_j,
\qquad
\det\bA=\prod_{j=1}^n\lambda_j.
\]
Consequently,
\[
\bA\ \hbox{is singular}
\quad\Longleftrightarrow\quad
0\in\sigma_{\mathbb C}(\bA).
\]
\origin{H \S21.6, Thm.~21.6.1; A\&M Exs.~7.26--7.27}
\end{theorem}

\begin{proof}
The factorisation theorem and the leading coefficient of $\chi_{\bA}$ give
\[
\chi_{\bA}(t)=\prod_{j=1}^n(t-\lambda_j)
=t^n-\left(\sum_{j=1}^n\lambda_j\right)t^{n-1}
+\cdots+(-1)^n\prod_{j=1}^n\lambda_j.
\]
Coefficient comparison with Theorem~\ref{thm:characteristic-coefficients}
gives the trace and determinant identities.  The last equivalence follows
from $\det\bA=\prod_j\lambda_j$ and the determinant criterion.
\end{proof}

\begin{theorem}[Conjugate pairs for real matrices]\label{thm:conjugate-pairs}
If $\bA\in\mathbb R^{n\times n}$ and
$\lambda\in\sigma_{\mathbb C}(\bA)$, then
$\bar\lambda\in\sigma_{\mathbb C}(\bA)$ and
\[
a_{\bA}(\bar\lambda)=a_{\bA}(\lambda).
\]
If $n$ is odd, $\sigma_{\mathbb R}(\bA)\ne\varnothing$.
\origin{A\&M Ex.~7.17; S \S5.2}
\end{theorem}

\begin{proof}
The coefficients of $\chi_{\bA}$ are real, so
\[
\chi_{\bA}(\bar z)=\overline{\chi_{\bA}(z)}.
\]
Thus $\chi_{\bA}(\lambda)=0$ implies
$\chi_{\bA}(\bar\lambda)=0$.  If
\[
\chi_{\bA}(t)=(t-\lambda)^m q(t),\qquad q(\lambda)\ne0,
\]
then
\[
\chi_{\bA}(t)
=\overline{\chi_{\bA}(\bar t)}
=(t-\bar\lambda)^m\overline{q(\bar t)},
\qquad
\overline{q(\lambda)}\ne0.
\]
Hence $a_{\bA}(\bar\lambda)\geqslant m$; conjugating again gives the reverse
inequality.  Nonreal roots occur in distinct pairs with equal multiplicity.
If no root were real, $n$ would be even.
\end{proof}

\begin{example}[A real rotation over two fields]\label{ex:rotation-fields}
For
\[
\bR=\begin{pmatrix}0&-1\\1&0\end{pmatrix},
\qquad
\chi_{\bR}(t)=t^2+1=(t-\mathrm{i})(t+\mathrm{i}),
\]
\[
\sigma_{\mathbb R}(\bR)=\varnothing,\qquad
\sigma_{\mathbb C}(\bR)=\{-\mathrm{i},\mathrm{i}\}.
\]
Complex eigenvectors are
\[
\bR\begin{pmatrix}1\\-\mathrm{i}\end{pmatrix}
=\mathrm{i}\begin{pmatrix}1\\-\mathrm{i}\end{pmatrix},
\qquad
\bR\begin{pmatrix}1\\\mathrm{i}\end{pmatrix}
=-\mathrm{i}\begin{pmatrix}1\\\mathrm{i}\end{pmatrix}.
\]
\origin{H \S21.1, pp.~509--510; A\&M Ex.~7.22}
\end{example}

