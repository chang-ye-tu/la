%=============================================================================
\section{Methods of Proof}\label{sec:P.1}
%=============================================================================

\subsection{Direct proof, contraposition, contradiction}\label{sec:P.1.1}

\begin{definition}[Statements and implication]\label{def:P-statements}
A \emph{statement} is a declarative sentence that is either true or false.  If $P$ and
$Q$ are statements, the implication
\[
P\implies Q
\]
says that whenever $P$ is true, $Q$ is true.  The statement $P$ is the
\emph{hypothesis}, and $Q$ is the \emph{conclusion}.  Its \emph{converse} is
$Q\implies P$ and its \emph{contrapositive} is
$\mathop{\mathrm{not}}Q\implies\mathop{\mathrm{not}}P$.
\end{definition}

The converse is a different implication and need not be true.  The contrapositive is
logically equivalent to the original implication.

\begin{theorem}[Contrapositive]\label{thm:P-contrapositive}
The implication $P\implies Q$ is true if and only if
$\mathop{\mathrm{not}}Q\implies\mathop{\mathrm{not}}P$ is true.
\end{theorem}

\begin{proof}
Suppose first that $P\implies Q$ is true.  If $Q$ is false but $P$ were true, the
implication would make $Q$ true, a contradiction.  Thus $P$ is false.  Conversely,
suppose the contrapositive is true and that $P$ is true.  If $Q$ were false, the
contrapositive would make $P$ false.  Therefore $Q$ is true.
\end{proof}

\begin{definition}[Three proof methods]\label{def:P-proof-methods}
To prove $P\implies Q$:
\begin{enumerate}[label=\textup{(\roman*)}]
\item a \emph{direct proof} assumes $P$ and derives $Q$;
\item a \emph{proof by contraposition} assumes that $Q$ is false and derives that $P$
is false;
\item a \emph{proof by contradiction} assumes $P$ and that $Q$ is false, and derives
two incompatible statements.
\end{enumerate}
A proof of a statement $Q$ by contradiction assumes that $Q$ is false and derives a
contradiction.
\end{definition}

\begin{example}[Direct proof]\label{ex:P-direct}
Suppose $\bA$ and $\bB$ are square symmetric matrices of the same order and
$\bA\bB=\bB\bA$.  Then $\bA\bB$ is symmetric.  Indeed,
\[
(\bA\bB)'=\bB'\bA'=\bB\bA=\bA\bB.
\]
The displayed calculation starts from the hypothesis and ends at the defining equality
for the conclusion.
\end{example}

\begin{example}[Contraposition]\label{ex:P-contraposition}
For a real matrix $\bA$, if $\bA'\bA=\bO$, then $\bA=\bO$.  Prove the contrapositive.
If $\bA\neq\bO$, some entry $a_{ij}$ is nonzero.  The $j$th diagonal entry of
$\bA'\bA$ is
\[
\sum_k a_{kj}^2\geqslant a_{ij}^2>0,
\]
so $\bA'\bA\neq\bO$.  Theorem~\ref{thm:P-contrapositive} now gives the original
implication.
\end{example}

\begin{example}[Contradiction]\label{ex:P-contradiction}
There is no largest real number.  If there were one, call it $M$.  Then $M+1$ would be a
real number and $M+1>M$, contradicting the assertion that $M$ is largest.
\end{example}

\newpage
\begin{theorem}[Negating quantifiers]\label{thm:P-quantifiers}
For any property $P(x)$ on a set $D$,
\[
\mathop{\mathrm{not}}\bigl[\text{for every }x\in D,\ P(x)\bigr]
\quad\Longleftrightarrow\quad
\bigl[\text{for some }x\in D,\ P(x)\text{ is false}\bigr],
\]
and
\[
\mathop{\mathrm{not}}\bigl[\text{for some }x\in D,\ P(x)\bigr]
\quad\Longleftrightarrow\quad
\bigl[\text{for every }x\in D,\ P(x)\text{ is false}\bigr].
\]
\end{theorem}

\begin{proof}
If it is false that $P(x)$ holds for every $x$, at least one member of $D$ fails the
property; and the existence of such a member makes the universal claim false.  Likewise,
the assertion that no member has the property says exactly that every member fails it.
\end{proof}

\begin{definition}[Counterexample]\label{def:P-counterexample}
A \emph{counterexample} to a universal statement is one object for which the claimed
property fails.  By Theorem~\ref{thm:P-quantifiers}, producing a counterexample proves
that the universal statement is false.
\end{definition}

\begin{example}[Zero products]\label{ex:P-zero-product}
The claim that $\bA\bB=\bO$ implies $\bA=\bO$ or $\bB=\bO$ is false for matrices.  The
two nonzero matrices
\[
\bA=\begin{pmatrix}1&0\\0&0\end{pmatrix},
\qquad
\bB=\begin{pmatrix}0&0\\0&1\end{pmatrix}
\]
satisfy $\bA\bB=\bO$.  This pair is a counterexample to the universal claim.
\end{example}

\subsection{Induction}\label{sec:P.1.2}

\begin{definition}[Positive integers]\label{def:P-natural}
A subset $S$ of $\Real$ is \emph{inductive} if $1\in S$ and $x+1\in S$ whenever
$x\in S$.  Define $\mathbb N$ to be the intersection of all inductive subsets of
$\Real$.  The collection is nonempty because $\Real$ is inductive.  Every inductive set
contains $1$, so their intersection contains $1$; and if $x$ belongs to every inductive
set, then $x+1$ belongs to every one of them.  Thus $\mathbb N$ is itself inductive and
is contained in every inductive subset of $\Real$.
\end{definition}

\begin{theorem}[Principle of mathematical induction]\label{thm:P-induction}
Let $P(n)$ be a statement for each $n\in\mathbb N$.  If
\begin{enumerate}[label=\textup{(\roman*)}]
\item $P(1)$ is true; and
\item for every $k\in\mathbb N$, the truth of $P(k)$ implies the truth of $P(k+1)$,
\end{enumerate}
then $P(n)$ is true for every $n\in\mathbb N$.
\end{theorem}

\begin{proof}
Let $S=\{n\in\mathbb N:P(n)\text{ is true}\}$.  Assumption (i) puts $1$ in $S$, and
assumption (ii) puts $k+1$ in $S$ whenever $k\in S$.  Hence $S$ is inductive.  By
Definition~\ref{def:P-natural}, $\mathbb N$ is contained in every inductive set, so
$\mathbb N\subseteq S$.  The reverse inclusion is part of the definition of $S$;
therefore $S=\mathbb N$.
\end{proof}

\begin{theorem}[Strong induction]\label{thm:P-strong-induction}
Let $P(n)$ be a statement for each $n\in\mathbb N$.  Suppose $P(1)$ is true and, for
every $k\in\mathbb N$, the joint truth of
$P(1),\ldots,P(k)$ implies $P(k+1)$.  Then $P(n)$ is true for every
$n\in\mathbb N$.
\end{theorem}

\begin{proof}
Let $Q(k)$ be the statement that $P(1),\ldots,P(k)$ are all true.  The hypothesis gives
$Q(1)$.  If $Q(k)$ is true, the hypothesis gives $P(k+1)$, so $Q(k+1)$ is true.
Theorem~\ref{thm:P-induction} gives $Q(k)$ for every $k$, and hence $P(k)$ for every $k$.
\end{proof}

\begin{example}[A finite sum]\label{ex:P-sum}
For every $n\in\mathbb N$,
\[
1+2+\cdots+n=\frac{n(n+1)}2.
\]
For $n=1$ both sides equal $1$.  If the identity holds at $n=k$, then
\[
1+\cdots+k+(k+1)
=\frac{k(k+1)}2+(k+1)
=\frac{(k+1)(k+2)}2,
\]
which is the identity at $k+1$.  Theorem~\ref{thm:P-induction} completes the proof.
\end{example}

\begin{example}[Transpose of a finite product]\label{ex:P-product-transpose}
If $\bA_1,\ldots,\bA_n$ have conformable sizes, then
\[
(\bA_1\bA_2\cdots\bA_n)'=\bA_n'\bA_{n-1}'\cdots\bA_1'.
\]
At $n=1$ the claim is immediate.  Suppose it holds for $n=k$.  The transpose rule for
a product of two matrices gives
\[
(\bA_1\cdots\bA_k\bA_{k+1})'
=\bA_{k+1}'(\bA_1\cdots\bA_k)'
=\bA_{k+1}'\bA_k'\cdots\bA_1',
\]
which is the claim for $k+1$.  Induction proves the identity for every finite product.
\end{example}

%=============================================================================
\section{Complex Numbers and Polynomials}\label{sec:P.2}
%=============================================================================

\subsection{Complex arithmetic}\label{sec:P.2.1}

\begin{plan}
\item Definition of $\mathbb{C}$, conjugate, modulus, polar form. Theorem: $\overline{zw}=\bar z\bar w$ and $|zw|=|z||w|$.
\item Definition of the conjugate transpose $\bA^{*}$, of a Hermitian matrix, and of a unitary matrix. These appear only in Schur's theorem and are otherwise not used.
\end{plan}

\subsection{Polynomials and their roots}\label{sec:P.2.2}

\begin{plan}
\item Theorem (fundamental theorem of algebra), stated with a proof sketch and a pointer to where a full proof needs analysis this course does not assume.
\item Corollary: a real polynomial has its non-real roots in conjugate pairs, so a real matrix of odd order has a real eigenvalue.
\item Theorem (Vieta): the elementary symmetric functions of the roots as the coefficients, which is what makes $\tr\bA=\sum\lambda_i$ and $|\bA|=\prod\lambda_i$ work.
\end{plan}

%=============================================================================
\section{Series and the Neumann Expansion}\label{sec:P.3}
%=============================================================================

\subsection{Geometric and power series}\label{sec:P.3.1}

\begin{plan}
\item The geometric series and its radius of convergence, stated for the scalar case.
\item Definition of a matrix power series and of convergence entrywise.
\end{plan}

\subsection{The Neumann series}\label{sec:P.3.2}

\begin{plan}
\item Theorem: $\bI-\bA$ is nonsingular with $(\bI-\bA)^{-1}=\sum_{k\geqslant0}\bA^k$ when every eigenvalue of $\bA$ has modulus below one.
\item Corollary: the perturbation bound behind the conditioning theorem of the elimination unit.
\item Definition of $\exp(\bA)$ by its series, used once, in the remark on functions of a symmetric matrix.
\end{plan}

%=============================================================================
\section{Calculus in Several Variables}\label{sec:P.4}
%=============================================================================

\subsection{Differentiability}\label{sec:P.4.1}

\begin{plan}
\item Definition of the partial derivative and of (total) differentiability, and the standard example separating them.
\item Theorem: continuous partial derivatives imply differentiability. This is the hypothesis every result in the matrix calculus units quietly needs.
\end{plan}

\subsection{Taylor's theorem}\label{sec:P.4.2}

\begin{plan}
\item Theorem: the first- and second-order expansions with remainder, in the form the second differential unit uses to classify stationary points.
\end{plan}

\subsection{Implicit functions and differentiation under the integral}\label{sec:P.4.3}

\begin{plan}
\item Theorem (implicit function theorem), needed for the eigenvalue and eigenvector differentials.
\item Theorem: differentiation under the integral sign, needed once, for the score of the normal likelihood.
\end{plan}

%=============================================================================
\section{Notation}\label{sec:P.5}
%=============================================================================

\begin{plan}
\item One table: every symbol the course uses, in the spelling of the macros in \texttt{la\_preamble.tex}.
\item The collisions worth naming in print, all of them inherited from the linear-model notation the applied courses share: $\be$ is the error vector and $\eu_j$ the standard basis vector; $\bb$ is the regression coefficient vector and $\bbb$ the right-hand side of a linear system; $\bD_n$ is the duplication matrix and $\bD_s$ the diagonal matrix of standard deviations.
\item The Abadir and Magnus spellings that differ from this course's, so the textbook can be read alongside the notes without translation errors.
\end{plan}

