# GitHub: course README and student notes only.
# Teacher boards/print layouts, authoring records, exams and agent/editor
# data stay local. Ignore everything unless explicitly allowed below.
/*
!/.gitignore
!/README.md
!/note/
!/handout/

# Authoring materials (chapter sources, plans, audit reports, verification scripts,
# snapshots, test builds) stay local, even if the allow-list above is widened.
/authoring/

# The textbook: one self-contained file (source and PDF). Other files and subdirectories
# in note/ (including book-src.tex and .build/) stay ignored.
/note/*
!/note/Makefile
!/note/book.tex
!/note/book.pdf
# The 10/21 version (Chapters 1-12) and the table of its numbers in the new version.
!/note/lecture-1021.pdf
!/note/concordance-1021.pdf

# Per-session lectures: each PDF and its single-file source.
/handout/*
!/handout/*.pdf
!/handout/*.tex

# Editor lock/backup files can resemble source filenames.
**/.#*
**/#*#
**/*~
**/*.swp
**/*.swo

# Files already tracked by Git are not affected by ignore rules.
# Stage the existing deletions when publishing to remove obsolete notes.
